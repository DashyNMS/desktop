root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{csproj,props,targets,slnx,xml,config,json,yml,yaml,axaml,xaml,html,css}]
indent_size = 2

[*.{sh,swift}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false
