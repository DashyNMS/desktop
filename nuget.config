<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    DashyNMS.Core comes from GitHub Packages (DashyNMS/core); everything else
    from nuget.org. GitHub Packages needs a login even for public packages:
    set DASHYNMS_PACKAGES_TOKEN to a token with read:packages - in Actions,
    secrets.GITHUB_TOKEN with "packages: read"; locally, for example,
    `gh auth token` after `gh auth refresh -s read:packages`.
  -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="dashynms" value="https://nuget.pkg.github.com/DashyNMS/index.json" />
  </packageSources>

  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
    <packageSource key="dashynms">
      <package pattern="DashyNMS.*" />
    </packageSource>
  </packageSourceMapping>

  <packageSourceCredentials>
    <dashynms>
      <add key="Username" value="DashyNMS" />
      <add key="ClearTextPassword" value="%DASHYNMS_PACKAGES_TOKEN%" />
    </dashynms>
  </packageSourceCredentials>
</configuration>