<Project>

  <PropertyGroup>
    <DebugType Condition="'$(Configuration)' == 'Release'">embedded</DebugType>
    <PathMap>$(MSBuildThisFileDirectory)=/_/dashynms/</PathMap>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>false</InvariantGlobalization>
    <Product>DashyNMS</Product>
    <Company>DashyNMS</Company>
    <Authors>Thomas Pickup</Authors>
    <Copyright>Copyright (c) 2026 Thomas Pickup. All rights reserved.</Copyright>
    <!-- The version being built towards: edge and nightly builds are
         2.0.0-edge.N and 2.0.0-nightly.N, and a release is 2.0.0. -->
    <Version>2.0.0</Version>
    <NeutralLanguage>en-GB</NeutralLanguage>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <DashyNMSSentryDsn Condition="'$(DashyNMSSentryDsn)' == ''">$(DASHYNMS_SENTRY_DSN)</DashyNMSSentryDsn>
    <!-- DashyNMS/core, from GitHub Packages (see nuget.config): an exact edge
         package between Core releases. -->
    <DashyNMSCoreVersion>2.0.0-ci.84</DashyNMSCoreVersion>
    <!-- The DashyNMS/mcp commit whose server the installers bundle. -->
    <DashyNMSMcpRevision>8563a2cf0e9c2055f5b4fdb911a1888af39aca5d</DashyNMSMcpRevision>
  </PropertyGroup>

</Project>
