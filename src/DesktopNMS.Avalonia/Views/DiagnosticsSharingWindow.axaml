<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:DesktopNMS.ViewModels;assembly=DesktopNMS.Presentation"
        x:Class="DesktopNMS.Views.DiagnosticsSharingWindow"
        x:DataType="vm:DiagnosticsSharingViewModel"
        Title="Help improve DashyNMS" Width="560" SizeToContent="Height"
        CanResize="False" WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BackgroundBrush}">
    <StackPanel Margin="28" Spacing="14">
        <TextBlock Text="Help improve DashyNMS" FontSize="22" FontWeight="SemiBold" />
        <TextBlock Text="Choose what to share with DashyNMS through Sentry. Error reporting and usage metrics are separate choices. You can change your choice in Settings → Diagnostics."
                   TextWrapping="Wrap" />
        <CheckBox Content="Share error reports" IsChecked="{Binding ShareErrors}" />
        <TextBlock Text="App version, operating system, architecture, exception types, app method names and source-code locations (repository-relative files and line numbers, where available)."
                   Margin="28,-8,0,0" TextWrapping="Wrap" Opacity="0.75" />
        <CheckBox Content="Share usage and performance metrics" IsChecked="{Binding ShareUsage}" />
        <TextBlock Text="Launch and feature-use counts, startup and screen-loading times, request and update outcomes, responsiveness and memory measurements. Includes app version, operating system and architecture; no persistent user or installation identifier. Selecting both choices also shares session duration and healthy, errored, managed-crash or unknown outcomes, using a fresh per-session ID."
                   Margin="28,-8,0,0" TextWrapping="Wrap" Opacity="0.75" />
        <TextBlock Text="Reports exclude network addresses, credentials, log files and Intelligence content. Sentry receives connection information when reports are sent."
                   TextWrapping="Wrap" Opacity="0.75" />
        <TextBlock Text="Closing this window keeps your previous choice and asks again next time."
                   TextWrapping="Wrap" Opacity="0.75" />
        <HyperlinkButton Content="Read the privacy details"
                         NavigateUri="https://dashynms.pckp.net/desktop/privacy/" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" Margin="0,6,0,0">
            <Button Content="Don't share" Command="{Binding DeclineCommand}" />
            <Button Content="Allow selected" Command="{Binding AllowSelectedCommand}" />
        </StackPanel>
    </StackPanel>
</Window>
