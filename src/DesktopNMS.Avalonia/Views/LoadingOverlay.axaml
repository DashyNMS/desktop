<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="using:DesktopNMS.Views"
             x:Class="DesktopNMS.Views.LoadingOverlay"
             x:Name="Root"
             HorizontalAlignment="Center"
             VerticalAlignment="Center"
             IsHitTestVisible="False">

    <!-- The logo over what's being waited for (#228), on a card so it reads
         over a busy page. -->
    <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
            CornerRadius="8" Padding="20,16" BoxShadow="0 2 14 0 #40000000">
        <StackPanel>
            <views:HeartbeatLogo Width="40" Height="40" HorizontalAlignment="Center" IsBeating="True" />
            <TextBlock Text="{Binding #Root.Text}" Classes="subtle" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,10,0,0" />
        </StackPanel>
    </Border>
</UserControl>
