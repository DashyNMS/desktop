<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:DesktopNMS.ViewModels" xmlns:views="using:DesktopNMS.Views" x:Class="DesktopNMS.Views.DeviceDetail.OverviewSection" x:DataType="vm:DeviceDetailViewModel" xmlns:dd="using:DesktopNMS.Views.DeviceDetail">

    <!-- Overview: stat tiles, then cards fitted into the available columns.
         Busiest ports spans two columns; hidden cards leave no reserved space.
         A card that opens a section does so
         when clicked. -->
    <UserControl.Styles>
        <!-- Unknown neighbours are information, even when there is no device to open. -->
        <Style Selector="Button.connectionRow:disabled">
            <Setter Property="Cursor" Value="Arrow" />
        </Style>
        <Style Selector="Button.connectionRow:disabled /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Opacity" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <!-- A stat tile: a number and its label, with a bar down the left edge in
             its BorderBrush's colour. -->
        <Style Selector="Button.statTile">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Background="{TemplateBinding BorderBrush}" CornerRadius="12" Padding="3,0,0,0">
                        <Border Name="Root" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,1,1" CornerRadius="9,12,12,9" Padding="14,12">
                            <ContentPresenter Content="{TemplateBinding Content}" />
                        </Border>
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="Button.statTile:pointerover /template/ Border#Root">
            <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
        </Style>
        <Style Selector="TextBlock.statValue">
            <Setter Property="FontSize" Value="22" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>
        <Style Selector="TextBlock.statLabel">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="FontSize" Value="11.5" />
        </Style>
    </UserControl.Styles>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24,14,24,24">

            <!-- ==================== Stat tiles ==================== -->
            <!-- UniformGrid lays out its visible children only, so a hidden Ports tile leaves no gap. -->
            <UniformGrid Rows="1">
                <Button Classes="statTile" BorderBrush="{Binding AvailabilityTileSeverity, Converter={x:Static views:Converters.SeverityToBrush}}" Command="{Binding ShowPingGraphCommand}" ToolTip.Tip="Availability over the last 30 days" Margin="0,0,7,0">
                    <StackPanel>
                        <TextBlock Classes="statValue" Text="{Binding Availability30DayText}" Foreground="{Binding AvailabilityTileSeverity, Converter={x:Static views:Converters.SeverityToBrush}}" />
                        <TextBlock Classes="statLabel" Text="Availability · 30 days" />
                    </StackPanel>
                </Button>
                <Button Classes="statTile" BorderBrush="{DynamicResource AccentBrush}" Command="{Binding SelectGraphsCommand}" Margin="7,0">
                    <StackPanel>
                        <TextBlock Classes="statValue" Text="{Binding UptimeText}" />
                        <TextBlock Classes="statLabel" Text="Uptime" />
                    </StackPanel>
                </Button>
                <Button Classes="statTile" BorderBrush="{Binding PortsTileSeverity, Converter={x:Static views:Converters.SeverityToBrush}}" Command="{Binding SelectPortsCommand}" Margin="7,0" IsVisible="{Binding ShowPortsNav}">
                    <StackPanel>
                        <TextBlock Classes="statValue" Text="{Binding PortsUpText}" Foreground="{Binding PortsTileSeverity, Converter={x:Static views:Converters.SeverityToBrush}}" />
                        <TextBlock Classes="statLabel" Text="Ports up" />
                    </StackPanel>
                </Button>
                <Button Classes="statTile" BorderBrush="{Binding AlertsTileSeverity, Converter={x:Static views:Converters.SeverityToBrush}}" Command="{Binding SelectAlertsCommand}" Margin="7,0,0,0">
                    <StackPanel>
                        <TextBlock Classes="statValue" Text="{Binding ActiveAlerts.Count}" Foreground="{Binding AlertsTileSeverity, Converter={x:Static views:Converters.SeverityToBrush}}" />
                        <TextBlock Classes="statLabel" Text="Active alerts" />
                    </StackPanel>
                </Button>
            </UniformGrid>

            <dd:OverviewPanel Margin="0,14,0,0">
                <Border Classes="card" Margin="0" VerticalAlignment="Top">
                    <StackPanel>
                        <TextBlock Text="DEVICE" Classes="cardTitle" />

                        <!-- Only the names that really differ from the one shown (#219); the tooltip says which is which. -->
                        <DockPanel Classes="keyRow" Background="Transparent" ToolTip.Tip="{Binding AlsoKnownAsToolTip}" IsVisible="{Binding HasAlsoKnownAs}">
                            <TextBlock Text="Also known as" Classes="key" />
                            <TextBlock Text="{Binding AlsoKnownAs}" TextWrapping="Wrap" />
                        </DockPanel>
                        <DockPanel Classes="keyRow">
                            <TextBlock Text="IP address" Classes="key" />
                            <SelectableTextBlock Text="{Binding Ip}" TextWrapping="Wrap" />
                        </DockPanel>
                        <DockPanel Classes="keyRow">
                            <TextBlock Text="Operating system" Classes="key" />
                            <TextBlock Text="{Binding Os}" TextWrapping="Wrap" />
                        </DockPanel>
                        <DockPanel Classes="keyRow">
                            <TextBlock Text="Hardware" Classes="key" />
                            <TextBlock Text="{Binding Hardware}" TextWrapping="Wrap" />
                        </DockPanel>
                        <DockPanel Classes="keyRow" IsVisible="{Binding HasSerial}">
                            <TextBlock Text="Serial" Classes="key" />
                            <SelectableTextBlock Text="{Binding Serial}" TextWrapping="Wrap" />
                        </DockPanel>
                        <DockPanel Classes="keyRow">
                            <TextBlock Text="Location" Classes="key" />
                            <Button Classes="link" HorizontalAlignment="Left" Command="{Binding ShowDevicesForLocationCommand}" Tag="{Binding IntelligenceLocation}" ToolTip.Tip="Show every device at this location">
                                <TextBlock Text="{Binding Location}" TextWrapping="Wrap" />
                            </Button>
                        </DockPanel>
                        <DockPanel Classes="keyRow" IsVisible="{Binding HasContact}">
                            <TextBlock Text="Contact" Classes="key" />
                            <TextBlock Text="{Binding Contact}" TextWrapping="Wrap" />
                        </DockPanel>
                        <!-- Each group links to the Devices tab, filtered to it. -->
                        <DockPanel Classes="keyRow" IsVisible="{Binding HasDeviceGroups}">
                            <TextBlock Text="Groups" Classes="key" VerticalAlignment="Top" Margin="0,2,0,0" />
                            <ItemsControl ItemsSource="{Binding DeviceGroups}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:DeviceGroupItemViewModel">
                                        <Border CornerRadius="10" Padding="8,1" Margin="0,0,4,4" Background="{DynamicResource SurfaceHoverBrush}">
                                            <Button Classes="link" Command="{Binding ShowDevicesForGroupCommand}" ToolTip.Tip="{Binding Description}">
                                                <TextBlock Text="{Binding Name}" FontSize="11.5" />
                                            </Button>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </DockPanel>
                        <DockPanel Classes="keyRow" IsVisible="{Binding HasDependencyParent}">
                            <TextBlock Text="Depends on" Classes="key" />
                            <TextBlock Text="{Binding DependencyParentText}" TextWrapping="Wrap" />
                        </DockPanel>
                        <DockPanel Classes="keyRow" IsVisible="{Binding HasInserted}">
                            <TextBlock Text="Added" Classes="key" />
                            <TextBlock Text="{Binding InsertedText}" TextWrapping="Wrap" />
                        </DockPanel>
                        <DockPanel Classes="keyRow" IsVisible="{Binding HasLastDiscovered}">
                            <TextBlock Text="Last discovered" Classes="key" />
                            <TextBlock Text="{Binding LastDiscoveredText}" TextWrapping="Wrap" />
                        </DockPanel>
                        <DockPanel Classes="keyRow" IsVisible="{Binding HasLastPolled}">
                            <TextBlock Text="Last polled" Classes="key" />
                            <TextBlock Text="{Binding LastPolledText}" TextWrapping="Wrap" />
                        </DockPanel>
                        <DockPanel Classes="keyRow" IsVisible="{Binding HasSysObjectId}">
                            <TextBlock Text="Object ID" Classes="key" />
                            <SelectableTextBlock Text="{Binding SysObjectId}" TextWrapping="Wrap" />
                        </DockPanel>
                        <DockPanel Classes="keyRow" IsVisible="{Binding HasSysDescr}">
                            <TextBlock Text="Description" Classes="key" VerticalAlignment="Top" />
                            <TextBlock Text="{Binding SysDescr}" TextWrapping="Wrap" Classes="subtle" />
                        </DockPanel>
                    </StackPanel>
                </Border>
                <Button Classes="cardButton" Command="{Binding SelectPortsCommand}" Margin="0" IsVisible="{Binding HasOverviewPorts}" dd:OverviewPanel.ColumnSpan="2">
                <StackPanel>
                    <Panel>
                        <TextBlock Text="BUSIEST PORTS" Classes="cardTitle" />
                        <TextBlock Text="in / out" Classes="cardNote" />
                    </Panel>
                    <ItemsControl ItemsSource="{Binding OverviewPorts}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:PortItemViewModel">
                                <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,7">
                                    <Grid ColumnDefinitions="18,150,*,100,100">
                                        <Ellipse Width="8" Height="8" HorizontalAlignment="Left" VerticalAlignment="Center" Fill="{Binding StatusSeverity, Converter={x:Static views:Converters.SeverityToBrush}}" />
                                        <TextBlock Grid.Column="1" Text="{Binding DisplayName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="2" Text="{Binding SecondaryName}" Classes="subtle" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="3" Text="{Binding InRateText}" HorizontalAlignment="Right" Classes="subtle" />
                                        <TextBlock Grid.Column="4" Text="{Binding OutRateText}" HorizontalAlignment="Right" Classes="subtle" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Button>
                <Button Classes="cardButton" Command="{Binding ShowPingGraphCommand}" Margin="0" IsVisible="{Binding OverviewGraph.Svg, Converter={x:Static ObjectConverters.IsNotNull}}">
                            <Grid RowDefinitions="Auto,*">
                                <TextBlock Text="PING RESPONSE" Classes="cardTitle" />
                                <TextBlock Text="24h" Classes="cardNote" />
                                <Image Grid.Row="1" Source="{Binding OverviewGraph.Svg, Converter={x:Static views:Converters.SvgToImage}}" Stretch="Uniform" MaxHeight="170" IsHitTestVisible="False" />
                            </Grid>
                        </Button>
                <Border Classes="card" Margin="0" IsVisible="{Binding HasAvailability}">
                            <StackPanel>
                                <TextBlock Text="AVAILABILITY" Classes="cardTitle" />
                                <StackPanel Orientation="Horizontal">
                                    <Viewbox Width="84" Height="84">
                                        <Panel Width="100" Height="100">
                                            <Ellipse Width="80" Height="80" Stroke="{DynamicResource SurfaceHoverBrush}" StrokeThickness="11" />
                                            <Path Data="{Binding Availability30DayFraction, Converter={x:Static views:Converters.GaugeArc}}" Stroke="{Binding AvailabilityTileSeverity, Converter={x:Static views:Converters.SeverityToBrush}}" StrokeThickness="11" StrokeLineCap="Round" />
                                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                                <TextBlock Text="{Binding Availability30DayText}" FontSize="15" FontWeight="Bold" HorizontalAlignment="Center" />
                                                <TextBlock Text="30 days" FontSize="10" Classes="subtle" HorizontalAlignment="Center" />
                                            </StackPanel>
                                        </Panel>
                                    </Viewbox>
                                    <StackPanel Margin="14,0,0,0" VerticalAlignment="Center" Spacing="4">
                                        <StackPanel Orientation="Horizontal" Spacing="4"><TextBlock Text="24h" Classes="subtle" /><TextBlock Text="{Binding Availability1DayText}" FontSize="12" /></StackPanel>
                                        <StackPanel Orientation="Horizontal" Spacing="4"><TextBlock Text="7d" Classes="subtle" /><TextBlock Text="{Binding Availability7DayText}" FontSize="12" /></StackPanel>
                                        <StackPanel Orientation="Horizontal" Spacing="4"><TextBlock Text="1y" Classes="subtle" /><TextBlock Text="{Binding Availability1YearText}" FontSize="12" /></StackPanel>
                                    </StackPanel>
                                </StackPanel>

                                <!-- A segment per day for the last 30 days, red on any day with downtime. -->
                                <ItemsControl ItemsSource="{Binding AvailabilityTimeline}" Margin="0,14,0,0">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Rows="1" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:OutageDayViewModel">
                                            <Border Height="14" Margin="0.5,0" CornerRadius="1.5" Background="{Binding Severity, Converter={x:Static views:Converters.SeverityToBrush}}" ToolTip.Tip="{Binding TooltipText}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <ToggleButton Name="OutagesToggle" Classes="chip" Margin="0,10,0,0" IsVisible="{Binding HasOutages}">
                                    <TextBlock Text="{Binding Outages.Count, StringFormat='Recent outages ({0})'}" />
                                </ToggleButton>
                                <ItemsControl ItemsSource="{Binding Outages}" Margin="0,10,0,0" IsVisible="{Binding #OutagesToggle.IsChecked}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:OutageItemViewModel">
                                            <StackPanel Margin="0,0,0,6">
                                                <StackPanel Orientation="Horizontal" Spacing="4">
                                                    <TextBlock Text="{Binding StartedText}" FontSize="12" />
                                                    <TextBlock Text="→" FontSize="12" Classes="subtle" />
                                                    <TextBlock Text="{Binding EndedText}" FontSize="12" />
                                                </StackPanel>
                                                <TextBlock Text="{Binding DurationText}" Classes="subtle" FontSize="11" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                <Button Classes="cardButton" Command="{Binding SelectAlertsCommand}" Margin="0">
                            <StackPanel>
                                <Panel>
                                    <TextBlock Text="ACTIVE ALERTS" Classes="cardTitle" />
                                    <TextBlock Text="{Binding ActiveAlerts.Count, StringFormat='{}{0} open'}" Classes="cardNote" />
                                </Panel>
                                <TextBlock Text="No active alerts." Classes="subtle" IsVisible="{Binding !HasActiveAlerts}" />
                                <ItemsControl ItemsSource="{Binding ActiveAlerts}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:ActiveAlertItemViewModel">
                                            <DockPanel Margin="0,0,0,9">
                                                <Ellipse DockPanel.Dock="Left" Width="8" Height="8" Margin="0,0,10,0" VerticalAlignment="Center" Fill="{Binding Severity, Converter={x:Static views:Converters.SeverityToBrush}}" />
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding AgeText}" Classes="subtle" FontSize="11.5" Margin="10,0,0,0" />
                                                <TextBlock Text="{Binding RuleName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            </DockPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Button>
                <Button Classes="cardButton" Command="{Binding SelectResourcesCommand}" Margin="0" IsVisible="{Binding HasOverviewResources}">
                            <StackPanel>
                                <TextBlock Text="RESOURCES" Classes="cardTitle" />
                                <ItemsControl ItemsSource="{Binding OverviewResources}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:OverviewResourceRow">
                                            <StackPanel Margin="0,0,0,11">
                                                <DockPanel>
                                                    <TextBlock DockPanel.Dock="Right" Text="{Binding ValueText}" Foreground="{Binding Severity, Converter={x:Static views:Converters.SeverityToBrush}}" />
                                                    <TextBlock Text="{Binding Label}" />
                                                </DockPanel>
                                                <ProgressBar Classes="usage" Value="{Binding PercentValue}" Foreground="{Binding Severity, Converter={x:Static views:Converters.SeverityToBrush}}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Button>
                <Button Classes="cardButton" Command="{Binding SelectSensorsCommand}" Margin="0" IsVisible="{Binding HasSensors}">
                            <StackPanel>
                                <Panel>
                                    <TextBlock Text="SENSORS" Classes="cardTitle" />
                                    <TextBlock Text="{Binding SensorsCardNote}" Classes="cardNote" />
                                </Panel>
                                <ItemsControl ItemsSource="{Binding OverviewSensors}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:SensorItemViewModel">
                                            <StackPanel Margin="0,0,0,11">
                                                <DockPanel>
                                                    <TextBlock DockPanel.Dock="Right" Text="{Binding ValueText}" Margin="10,0,0,0" Foreground="{Binding Severity, Converter={x:Static views:Converters.SeverityToBrush}}" />
                                                    <TextBlock Text="{Binding Description}" TextTrimming="CharacterEllipsis" />
                                                </DockPanel>
                                                <ProgressBar Classes="usage" Value="{Binding LimitPercent}" Foreground="{Binding Severity, Converter={x:Static views:Converters.SeverityToBrush}}" IsVisible="{Binding HasLimitFraction}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Button>
                <Border Classes="card" Margin="0" IsVisible="{Binding HasNeighbours}">
                            <StackPanel>
                                <Panel>
                                    <TextBlock Text="CONNECTED TO" Classes="cardTitle" />
                                    <TextBlock Text="{Binding NeighboursSummaryText}" Classes="cardNote" />
                                </Panel>
                                <ItemsControl ItemsSource="{Binding ConnectedTo}" Margin="-4,-6,-4,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:DeviceNeighbourItemViewModel">
                                            <Button Classes="cardRow connectionRow" Command="{Binding OpenCommand}" ToolTip.Tip="{Binding SourceText}" ToolTip.ShowOnDisabled="True">
                                                <DockPanel>
                                                    <Ellipse DockPanel.Dock="Left" Width="8" Height="8" Margin="0,5,10,0" VerticalAlignment="Top" Fill="{Binding StateSeverity, Converter={x:Static views:Converters.SeverityToBrush}}" />
                                                    <StackPanel>
                                                        <DockPanel>
                                                            <TextBlock DockPanel.Dock="Right" Text="{Binding ConnectionText}" Classes="subtle" FontSize="11.5" Margin="10,0,0,0" />
                                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                        </DockPanel>
                                                        <TextBlock Text="{Binding Description}" Classes="subtle" FontSize="11.5" TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                </DockPanel>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Button Classes="link" Margin="0,6,0,0" HorizontalAlignment="Left" Command="{Binding SelectNeighboursCommand}" IsVisible="{Binding HasMoreNeighbours}">
                                    <TextBlock Text="{Binding MoreNeighboursText}" FontSize="12" />
                                </Button>
                            </StackPanel>
                        </Border>
            </dd:OverviewPanel>

            <!-- ==================== Busiest ports ==================== -->

        </StackPanel>
    </ScrollViewer>
</UserControl>
