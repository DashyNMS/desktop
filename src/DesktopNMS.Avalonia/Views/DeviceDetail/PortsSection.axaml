<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:infra="using:DesktopNMS.Infrastructure"
             xmlns:vm="using:DesktopNMS.ViewModels"
             xmlns:views="using:DesktopNMS.Views"
             xmlns:dd="using:DesktopNMS.Views.DeviceDetail"
             x:Class="DesktopNMS.Views.DeviceDetail.PortsSection"
             x:DataType="vm:DeviceDetailViewModel">

    <UserControl.Styles>
        <!-- #569: a port card is one button - click, Enter or Space picks the
             port - drawn as a card, with hover, picked and keyboard-focus states. -->
        <Style Selector="Button.portCard">
            <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        </Style>
        <Style Selector="Button.portCard:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        </Style>
        <Style Selector="Button.portCard:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
        </Style>
        <Style Selector="Button.portCard.selected /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
        </Style>
        <!-- A focus ring as well as Fluent's own adorner, so keyboard focus is plain on either theme. -->
        <Style Selector="Button.portCard:focus-visible /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
            <Setter Property="BorderThickness" Value="2" />
        </Style>
        <Style Selector="ItemsControl.cardRow">
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>
        <Style Selector="ItemsControl.cardRow.endsGroup">
            <Setter Property="Margin" Value="0,0,0,16" />
        </Style>
        <Style Selector="Button.portCard TextBlock.critical">
            <Setter Property="Foreground" Value="{DynamicResource CriticalBrush}" />
        </Style>
    </UserControl.Styles>

    <!-- The device's ports as a table or cards (#569), grouped if chosen (#272), and the picked port's graphs (#8). -->
    <Grid RowDefinitions="Auto,*,Auto">
        <Grid Grid.Row="0" Margin="24,24,24,10" ColumnDefinitions="Auto,Auto,*,Auto">
            <TextBox Classes="search" PlaceholderText="Search ports" Text="{Binding PortSearchText, Delay=200}"
                     ToolTip.Tip="Search by interface name or description" Width="320" />
            <!-- #272: group the ports; remembered for every device. -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" Margin="16,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="Group by" Classes="subtle" VerticalAlignment="Center" />
                <ComboBox ItemsSource="{Binding PortGroupingOptions}" SelectedItem="{Binding SelectedPortGrouping}"
                          DisplayMemberBinding="{ReflectionBinding Label}" MinWidth="110" VerticalAlignment="Center" />
            </StackPanel>
            <views:CsvExportButton Grid.Column="3" Export="{Binding PortsCsv}" VerticalAlignment="Center" />
        </Grid>

        <Panel Grid.Row="1" Margin="24,0">
            <DataGrid infra:GridLayoutMemory.Key="DeviceDetail.Ports" Name="PortsGrid" ItemsSource="{Binding PortsView}" SelectedItem="{Binding SelectedPort}">
                <DataGrid.IsVisible>
                    <MultiBinding Converter="{x:Static BoolConverters.And}">
                        <Binding Path="HasVisiblePorts" />
                        <Binding Path="IsPortTableLayout" />
                    </MultiBinding>
                </DataGrid.IsVisible>
                <DataGrid.Columns>
                    <!-- The same status wording, colour and order as the cards (#569, PortStatus):
                         sorting puts errored, then down, then up, then disabled, not monitored and unknown. -->
                    <DataGridTemplateColumn Header="Status" Width="120" SortMemberPath="StatusRank">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate x:DataType="vm:PortItemViewModel">
                                <StackPanel Orientation="Horizontal" Spacing="6" Margin="8,0" ToolTip.Tip="{Binding StatusLabel}">
                                    <Ellipse Width="9" Height="9" VerticalAlignment="Center" Fill="{Binding StatusTone, Converter={x:Static views:Converters.SeverityToBrush}}" />
                                    <TextBlock Text="{Binding StatusLabel}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="#" Width="44" SortMemberPath="Model.IfIndex">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate x:DataType="vm:PortItemViewModel">
                                <TextBlock Text="{Binding Model.IfIndex}" Margin="8,0" VerticalAlignment="Center" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Interface" Width="*" MinWidth="140" SortMemberPath="DisplayName">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate x:DataType="vm:PortItemViewModel">
                                <StackPanel Margin="8,4" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding SecondaryName}" Classes="subtle" FontSize="11" TextTrimming="CharacterEllipsis" IsVisible="{Binding HasSecondaryName}" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Media" Width="90" SortMemberPath="MediaText">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate x:DataType="vm:PortItemViewModel">
                                <TextBlock Text="{Binding MediaText}" Margin="8,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Traffic" Width="120" SortMemberPath="InRateText">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate x:DataType="vm:PortItemViewModel">
                                <StackPanel Margin="8,4" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding InRateText, StringFormat='← {0}'}" Foreground="{DynamicResource OkBrush}" />
                                    <TextBlock Text="{Binding OutRateText, StringFormat='→ {0}'}" Foreground="{DynamicResource AccentBrush}" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Speed" Width="90" SortMemberPath="SpeedText">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate x:DataType="vm:PortItemViewModel">
                                <StackPanel Margin="8,4" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding SpeedText}" />
                                    <TextBlock Text="{Binding DuplexText}" Classes="subtle" FontSize="11" IsVisible="{Binding HasDuplex}" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Errors" Width="70" SortMemberPath="ErrorCount">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate x:DataType="vm:PortItemViewModel">
                                <TextBlock Text="{Binding ErrorCount}" Margin="8,0" VerticalAlignment="Center" Foreground="{DynamicResource CriticalBrush}" IsVisible="{Binding HasErrors}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="MAC address" Width="140" SortMemberPath="MacAddressText">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate x:DataType="vm:PortItemViewModel">
                                <StackPanel Margin="8,4" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding MacAddressText}" />
                                    <TextBlock Text="{Binding MtuText, StringFormat='MTU {0}'}" Classes="subtle" FontSize="11" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="IP address" Width="160" SortMemberPath="IpAddressesText">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate x:DataType="vm:PortItemViewModel">
                                <TextBlock Text="{Binding IpAddressesText}" ToolTip.Tip="{Binding IpAddressesText}" Margin="8,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Neighbour" Width="180" SortMemberPath="NeighborText">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate x:DataType="vm:PortItemViewModel">
                                <Panel Margin="8,0">
                                    <!-- A link only when the neighbour is itself a monitored device. -->
                                    <Button Classes="link" VerticalAlignment="Center" Command="{Binding OpenNeighborCommand}" ToolTip.Tip="{Binding NeighborToolTip}" IsVisible="{Binding CanOpenNeighbor}">
                                        <TextBlock Text="{Binding NeighborText}" TextTrimming="CharacterEllipsis" />
                                    </Button>
                                    <TextBlock Text="{Binding NeighborText}" Classes="subtle" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" IsVisible="{Binding !CanOpenNeighbor}" />
                                </Panel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>

            <!-- #569: the cards, in the table's groups. #572: flattened into headings and
                 rows of cards (PortCardRows) in a virtualising list, so only the rows on
                 screen are built; the code-behind sets how many cards fit across and keeps
                 Tab moving card by card, since recycled rows leave the panel's children
                 out of order. TabNavigation Once makes focus leave the list cleanly. -->
            <ScrollViewer Name="PortCardsScroller" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                <ScrollViewer.IsVisible>
                    <MultiBinding Converter="{x:Static BoolConverters.And}">
                        <Binding Path="HasVisiblePorts" />
                        <Binding Path="IsPortCardLayout" />
                    </MultiBinding>
                </ScrollViewer.IsVisible>
                <ItemsControl Name="PortCardsList" ItemsSource="{Binding PortCardRows}" Margin="0,0,0,4" KeyboardNavigation.TabNavigation="Once">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <!-- A viewport's worth of rows either side, so a Tab or Shift+Tab
                                 to the next card usually finds its row already built. -->
                            <VirtualizingStackPanel CacheLength="1" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.DataTemplates>
                        <DataTemplate DataType="vm:PortCardHeaderRow">
                            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
                                <TextBlock Text="{Binding Header}" Classes="section" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding CountText}" Classes="subtle" VerticalAlignment="Center" />
                            </StackPanel>
                        </DataTemplate>
                        <!-- The same gaps as before: 12 between rows, 16 after a group's last row. -->
                        <DataTemplate DataType="vm:PortCardItemsRow">
                            <ItemsControl ItemsSource="{Binding Cards}" Classes="cardRow" Classes.endsGroup="{Binding EndsGroup}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <!-- Inherits the row as its DataContext, so it knows the full row's width in cards. -->
                                        <dd:PortCardPanel x:DataType="vm:PortCardItemsRow" Columns="{Binding Columns}"
                                                          MinItemWidth="{x:Static dd:PortsSection.CardMinWidth}" Spacing="{x:Static dd:PortsSection.CardSpacing}" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:PortCard">
                                        <!-- Only what people compare between ports: the rest stays in the table (#569). -->
                                        <Button Classes="portCard" Classes.selected="{Binding IsSelected}" Command="{Binding SelectCommand}"
                                                AutomationProperties.Name="{Binding Port.CardAutomationName}">
                                            <Grid ColumnDefinitions="4,*">
                                                <Border CornerRadius="5,0,0,5" Background="{Binding Port.StatusTone, Converter={x:Static views:Converters.SeverityToBrush}}" />
                                                <StackPanel Grid.Column="1" Margin="12,10,12,10" Spacing="6">
                                                    <TextBlock Text="{Binding Port.DisplayName}" FontWeight="SemiBold" FontSize="14" TextWrapping="Wrap" />
                                                    <TextBlock Text="{Binding Port.SecondaryName}" Classes="subtle" TextWrapping="Wrap" IsVisible="{Binding Port.HasSecondaryName}" />
                                                    <Grid ColumnDefinitions="Auto,*,Auto">
                                                        <Ellipse Width="9" Height="9" VerticalAlignment="Center" Fill="{Binding Port.StatusTone, Converter={x:Static views:Converters.SeverityToBrush}}" />
                                                        <TextBlock Grid.Column="1" Text="{Binding Port.StatusLabel}" Margin="6,0,8,0" VerticalAlignment="Center" TextWrapping="Wrap" />
                                                        <TextBlock Grid.Column="2" Text="{Binding Port.CardSpeedText}" Classes="subtle" VerticalAlignment="Center" />
                                                    </Grid>
                                                    <Border Height="1" Background="{DynamicResource BorderBrush}" />
                                                    <Grid ColumnDefinitions="Auto,*,*" RowDefinitions="Auto,Auto,Auto">
                                                        <TextBlock Grid.Column="1" Text="IN ↓" Classes="subtle" FontSize="11" Margin="12,0,0,2" />
                                                        <TextBlock Grid.Column="2" Text="OUT ↑" Classes="subtle" FontSize="11" Margin="12,0,0,2" />
                                                        <TextBlock Grid.Row="1" Text="Traffic" Classes="subtle" />
                                                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Port.TrafficInText}" FontWeight="SemiBold" Margin="12,0,0,0" TextWrapping="Wrap" />
                                                        <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding Port.TrafficOutText}" FontWeight="SemiBold" Margin="12,0,0,0" TextWrapping="Wrap" />
                                                        <TextBlock Grid.Row="2" Text="Errors" Classes="subtle" Margin="0,2,0,0" />
                                                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Port.ErrorsInText}" Classes.critical="{Binding Port.HasErrorsIn}"
                                                                   FontWeight="SemiBold" Margin="12,2,0,0" TextWrapping="Wrap" />
                                                        <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding Port.ErrorsOutText}" Classes.critical="{Binding Port.HasErrorsOut}"
                                                                   FontWeight="SemiBold" Margin="12,2,0,0" TextWrapping="Wrap" />
                                                    </Grid>
                                                    <Border Height="1" Background="{DynamicResource BorderBrush}" />
                                                    <TextBlock TextWrapping="Wrap">
                                                        <Run Text="VLANs" Foreground="{DynamicResource TextSecondaryBrush}" /><Run Text="  " /><Run Text="{Binding Port.VlansText}" />
                                                    </TextBlock>
                                                </StackPanel>
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </DataTemplate>
                    </ItemsControl.DataTemplates>
                </ItemsControl>
            </ScrollViewer>

            <views:LoadingOverlay Text="Loading ports…" IsVisible="{Binding IsLoadingPorts}" />
            <views:EmptyState Icon="PlugConnected" Title="No ports" Hint="LibreNMS reports none for this device." IsVisible="{Binding ShowPortsEmptyMessage}" />
            <views:EmptyState Icon="Filter" Title="No ports match" Hint="Clear the search to see them all." IsVisible="{Binding ShowPortsNoMatchesMessage}" />
        </Panel>

        <dd:PortGraphsPanel Grid.Row="2" Margin="0,12,0,0" DataContext="{Binding PortGraphs}" />
    </Grid>
</UserControl>
