<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:DesktopNMS.ViewModels"
        xmlns:signin="using:DesktopNMS.Core.SignIn"
        xmlns:infra="using:DesktopNMS.Infrastructure"
        x:Class="DesktopNMS.Views.ConnectionWindow"
        x:DataType="vm:ConnectionViewModel"
        Title="Connect to LibreNMS"
        Width="480"
        SizeToContent="Height"
        CanResize="False"
        Icon="/Assets/app.ico"
        WindowStartupLocation="CenterScreen">

    <!-- Signing in to LibreNMS with an API token (#250, from the WPF app's
         ConnectionWindow). "Sign in with LibreNMS" needs a web view, and the
         demo needs its own restart, so both wait for later. -->
    <StackPanel Margin="24">
        <TextBlock Text="Connect to LibreNMS" Classes="heading" />
        <TextBlock Classes="subtle" TextWrapping="Wrap" Margin="0,6,0,0">
            <Run Text="{x:Static signin:SignInHelp.TokenHint}" />
            <Run Text="DashyNMS stores it encrypted for" /><Run Text=" " /><Run Text="{x:Static infra:PlatformText.SecretsKeptFor}" /><Run Text="." />
        </TextBlock>

        <Label Content="_Server address" Target="ServerBox" Classes="section" Padding="0" Margin="0,14,0,6" />
        <TextBox x:Name="ServerBox" Text="{Binding ServerUrl}" />
        <TextBlock Text="For example https://nms.example.com" Classes="subtle" Margin="0,4,0,0" />

        <Label Content="_Backup address (optional)" Target="BackupBox" Classes="section" Padding="0" Margin="0,14,0,6" />
        <TextBox x:Name="BackupBox" Text="{Binding BackupAddress}" />
        <TextBlock Text="Another address for the same server, e.g. https://192.0.2.20/. Used if the server address stops answering twice in a row, until you switch back."
                   Classes="subtle" TextWrapping="Wrap" Margin="0,4,0,0" />

        <DockPanel LastChildFill="False" Margin="0,14,0,6">
            <Label DockPanel.Dock="Left" Content="API _token" Target="TokenBox" Classes="section" Padding="0" Margin="0" />
            <!-- Straight to where tokens are made, for the address above. -->
            <Button DockPanel.Dock="Right" Classes="link" Command="{Binding OpenTokensPageCommand}">
                <TextBlock Text="Open the API Tokens page" />
            </Button>
        </DockPanel>
        <TextBox x:Name="TokenBox" PasswordChar="•" RevealPassword="False" Text="{Binding ApiToken}"
                 AutomationProperties.Name="API token" />

        <!-- A token copied from LibreNMS: offered, never filled in silently. -->
        <Border x:Name="CopiedTokenOffer" IsVisible="False"
                Background="{DynamicResource SurfaceAltBrush}" BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1" CornerRadius="5" Padding="10,6" Margin="0,6,0,0">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Use it" Padding="10,2" Click="OnUseCopiedToken" />
                <TextBlock Text="You've copied a LibreNMS API token. Use it?" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,10,0" />
            </DockPanel>
        </Border>
        <TextBlock Text="Leave blank to use the token already saved." Classes="subtle" Margin="0,4,0,0" />

        <CheckBox Content="Remember this token" IsChecked="{Binding RememberToken}" Margin="0,14,0,0" />
        <CheckBox Content="Allow an untrusted or self-signed certificate" IsChecked="{Binding AllowUntrustedCertificate}" />

        <Border Classes="errorNotice" Margin="0,14,0,0" IsVisible="{Binding HasError}">
            <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Assertive" />
        </Border>
        <Border Classes="okNotice" Margin="0,14,0,0" IsVisible="{Binding HasSuccess}">
            <TextBlock Text="{Binding SuccessMessage}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
        </Border>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,20,0,0">
            <TextBlock Text="Checking…" Classes="subtle" VerticalAlignment="Center" Margin="0,0,4,0" IsVisible="{Binding IsBusy}" />
            <Button Content="Cancel" IsCancel="True" Click="OnCancel" />
            <Button Content="Connect" Command="{Binding ConnectCommand}" Classes="primary" IsDefault="True" />
        </StackPanel>
    </StackPanel>
</Window>
