<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:DesktopNMS.ViewModels"
        x:Class="DesktopNMS.Views.LicencesWindow"
        x:DataType="vm:LicencesViewModel"
        Title="Open-source licences"
        Width="680" Height="640" MinWidth="480" MinHeight="400"
        ShowInTaskbar="False"
        Icon="/Assets/app.ico"
        WindowStartupLocation="CenterOwner">

    <!-- Settings › About › Open-source licences (#266): what DashyNMS ships
         that others made, each with its copyright and licence; the full text
         opens under it. The trademark line at the foot. -->
    <DockPanel Margin="24">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,14">
            <TextBlock Text="Open-source licences" Classes="heading" />
            <TextBlock Text="DashyNMS is built with these, and thanks the people who make them." Classes="subtle" TextWrapping="Wrap" Margin="0,4,0,0" />
        </StackPanel>

        <DockPanel DockPanel.Dock="Bottom" Margin="0,14,0,0" LastChildFill="False">
            <Button DockPanel.Dock="Right" Content="Close" IsCancel="True" IsDefault="True" Padding="14,6" Click="OnClose" />
            <TextBlock Text="{Binding Trademarks}" Classes="subtle" TextWrapping="Wrap" MaxWidth="460" VerticalAlignment="Center" />
        </DockPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Items}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:LicenceItemViewModel">
                        <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                CornerRadius="8" Padding="14,12" Margin="0,0,0,8">
                            <StackPanel>
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Content="{Binding ToggleText}" Command="{Binding ToggleCommand}"
                                            Padding="10,4" VerticalAlignment="Top" IsVisible="{Binding HasLicenceText}" />
                                    <StackPanel Margin="0,0,12,0">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Use}" Classes="subtle" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding Copyright}" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0" />
                                        <Button Classes="link" Command="{Binding OpenCommand}" Margin="0,2,0,0" HorizontalAlignment="Left">
                                            <TextBlock Text="{Binding LicenceLine}" FontSize="12" />
                                        </Button>
                                    </StackPanel>
                                </DockPanel>
                                <TextBox Text="{Binding LicenceText, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap"
                                         FontFamily="{DynamicResource MonoFont}" FontSize="11.5" MaxHeight="280"
                                         Margin="0,10,0,0" IsVisible="{Binding IsExpanded}" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</Window>
