<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:DesktopNMS.ViewModels"
        xmlns:views="using:DesktopNMS.Views"
        x:Class="DesktopNMS.Views.DeviceGroupEditorWindow"
        x:DataType="vm:DeviceGroupEditorViewModel"
        Title="{Binding Title}"
        Width="440" Height="620"
        CanResize="False"
        ShowInTaskbar="False"
        Icon="/Assets/app.ico"
        WindowStartupLocation="CenterOwner">

    <!-- Add or edit a static device group: its name, description and devices. -->
    <Grid Margin="24" RowDefinitions="Auto,*,Auto">
        <StackPanel Grid.Row="0">
            <TextBlock Text="{Binding Title}" Classes="heading" />
            <TextBlock Classes="subtle" TextWrapping="Wrap" Margin="0,6,0,14"
                       Text="This app only creates and edits static groups - an explicit device list. A dynamic (rule-based) group's rules can only be managed in LibreNMS itself." />

            <TextBlock Text="NAME" Classes="section" Margin="0,0,0,6" />
            <TextBox Name="NameBox" Text="{Binding Name}" />

            <TextBlock Text="DESCRIPTION (OPTIONAL)" Classes="section" Margin="0,14,0,6" />
            <TextBox Text="{Binding Description}" />

            <TextBlock Text="DEVICES" Classes="section" Margin="0,14,0,6" />
            <TextBox Classes="search" PlaceholderText="Search devices" Text="{Binding DeviceSearchText, Delay=200}" Margin="0,0,0,8" />
        </StackPanel>

        <!-- Virtualised: a LibreNMS install can have thousands of devices. -->
        <Border Grid.Row="1" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="5">
            <ListBox Classes="checkList" ItemsSource="{Binding DevicePickerView}">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:DevicePickerItemViewModel">
                        <CheckBox IsChecked="{Binding IsChecked}">
                            <TextBlock Text="{Binding Name}" />
                        </CheckBox>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <StackPanel Grid.Row="2">
            <Border Classes="errorNotice" Margin="0,14,0,0" IsVisible="{Binding HasError}">
                <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" />
            </Border>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,16,0,0">
                <TextBlock Text="Saving…" Classes="subtle" VerticalAlignment="Center" Margin="0,0,4,0" IsVisible="{Binding IsBusy}" />
                <Button Content="Cancel" IsCancel="True" Click="OnCancel" />
                <Button Content="Save" Command="{Binding SaveCommand}" Classes="primary" IsDefault="True" views:PermissionGate.Requires="{Binding SavePermission}" />
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
