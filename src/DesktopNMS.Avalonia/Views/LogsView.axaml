<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DesktopNMS.ViewModels"
             xmlns:views="using:DesktopNMS.Views"
             x:Class="DesktopNMS.Views.LogsView"
             x:DataType="vm:LogsViewModel">

    <!-- The Logs tab: LibreNMS's event log and alert log for every device
         (#287), and Graylog (#114) - see LogsViewModel. Which log shows is
         chosen in the sidebar. -->
    <Panel Margin="24,18">
        <Panel IsVisible="{Binding IsFleetLogSelected}">
            <views:FleetLogsView DataContext="{Binding Fleet}" />
        </Panel>

        <Panel IsVisible="{Binding IsGraylogSelected}">
            <!-- On a wrapper: on the view itself it would bind against the view's own DataContext. -->
            <Panel IsVisible="{Binding Graylog.IsConfigured}">
                <views:GraylogMessagesView Name="GraylogView" DataContext="{Binding Graylog}" />
            </Panel>

            <!-- Not set up: say where to do it rather than showing an empty table. -->
            <Border HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="460" Padding="24,20" CornerRadius="8"
                    Background="{DynamicResource SurfaceAltBrush}" IsVisible="{Binding !Graylog.IsConfigured}">
                <StackPanel>
                    <TextBlock Text="Graylog isn't set up" Classes="heading" />
                    <TextBlock Classes="subtle" TextWrapping="Wrap" Margin="0,8,0,16"
                               Text="Connect DashyNMS to your Graylog server to browse and search every device's log messages here. Use the same details as LibreNMS's Settings, External, Graylog." />
                    <Button Classes="primary" HorizontalAlignment="Left" Padding="14,7"
                            Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).SettingsCommand}">
                        <TextBlock Text="Open Settings" />
                    </Button>
                </StackPanel>
            </Border>
        </Panel>
    </Panel>
</UserControl>
