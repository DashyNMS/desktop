<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The cross-platform DashyNMS app (#153): Avalonia on Windows, macOS and
    Linux, on the same view models and services as the WPF app
    (DesktopNMS.Presentation, and Core through it). The shell - main window,
    sidebar, theme, sign-in and dialogs - with the pages ported one by one
    in #250. It replaces the WPF app once they're at parity.
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <WindowsBuild Condition="$([System.String]::Copy('$(RuntimeIdentifier)').StartsWith('win-')) or ('$(RuntimeIdentifier)' == '' and $([MSBuild]::IsOSPlatform('Windows')))">true</WindowsBuild>
    <TargetFramework Condition="'$(WindowsBuild)' == 'true'">net9.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion Condition="'$(WindowsBuild)' == 'true'">10.0.17763.0</SupportedOSPlatformVersion>
    <RootNamespace>DesktopNMS</RootNamespace>
    <AssemblyName>DashyNMS.Avalonia</AssemblyName>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup Condition="'$(WindowsBuild)' == 'true'">
    <PackageReference Include="Microsoft.Toolkit.Uwp.Notifications" Version="7.1.3" />
    <PackageReference Include="System.Drawing.Common" Version="9.0.20" />
  </ItemGroup>
  <ItemGroup Condition="'$(WindowsBuild)' != 'true'">
    <Compile Remove="Services\Windows\**\*.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.4" />
    <PackageReference Include="Avalonia.Controls.DataGrid" Version="12.1.2" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.4" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.4" />
    <PackageReference Include="FluentIcons.Avalonia" Version="2.1.344" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="9.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="9.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="9.0.0" />
    <PackageReference Include="Svg.Controls.Skia.Avalonia" Version="12.0.0.17" />
  </ItemGroup>

  <!-- The WPF app's brand fonts and icon, shared rather than copied (#216). -->
  <ItemGroup>
    <AvaloniaResource Include="..\DesktopNMS\Assets\Fonts\*.ttf" Link="Assets\Fonts\%(Filename)%(Extension)" />
    <AvaloniaResource Include="..\DesktopNMS\Assets\app.ico" Link="Assets\app.ico" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DesktopNMS.Presentation\DesktopNMS.Presentation.csproj" />
  </ItemGroup>

  <!--
    The DashyNMS MCP server, bundled for Intelligence as the WPF app does:
    published by tools/Publish-Mcp.ps1 into artifacts/mcp and copied beside
    the app as mcp/dashynms-mcp.exe. Without it the build still works, and
    the Intelligence tab says the network tools aren't installed. Windows
    only for now - macOS and Linux need their own build of it.
  -->
  <PropertyGroup>
    <McpExecutable>$(MSBuildThisFileDirectory)..\..\artifacts\mcp\dashynms-mcp.exe</McpExecutable>
  </PropertyGroup>
  <ItemGroup Condition="Exists('$(McpExecutable)')">
    <None Include="$(MSBuildThisFileDirectory)..\..\artifacts\mcp\**\*" Link="mcp\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
  </ItemGroup>

</Project>
