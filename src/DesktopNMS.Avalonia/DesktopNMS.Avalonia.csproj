<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The cross-platform DashyNMS app (#153): Avalonia on Windows, macOS and
    Linux, on the same view models and services as the WPF app
    (DesktopNMS.Presentation, and Core through it). For now a scaffold that
    signs in and shows the open alert count; the views are ported in #250,
    and it replaces the WPF app once they're at parity.
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <RootNamespace>DesktopNMS</RootNamespace>
    <AssemblyName>DashyNMS.Avalonia</AssemblyName>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.4" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.4" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.4" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.4" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="9.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="9.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="9.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DesktopNMS.Presentation\DesktopNMS.Presentation.csproj" />
  </ItemGroup>

</Project>
