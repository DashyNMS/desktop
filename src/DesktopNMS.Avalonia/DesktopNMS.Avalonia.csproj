<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The cross-platform DashyNMS app (#153): Avalonia on Windows, macOS and
    Linux. View models and services live in DesktopNMS.Presentation,
    with the API and monitoring supplied by the Core package.
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <WindowsBuild Condition="$([System.String]::Copy('$(RuntimeIdentifier)').StartsWith('win-')) or ('$(RuntimeIdentifier)' == '' and $([MSBuild]::IsOSPlatform('Windows')))">true</WindowsBuild>
    <TargetFramework Condition="'$(WindowsBuild)' == 'true'">net9.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion Condition="'$(WindowsBuild)' == 'true'">10.0.17763.0</SupportedOSPlatformVersion>
    <RootNamespace>DesktopNMS</RootNamespace>
    <AssemblyName>DashyNMS</AssemblyName>
    <AssemblyTitle>DashyNMS</AssemblyTitle>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup Condition="'$(WindowsBuild)' == 'true'">
    <PackageReference Include="Microsoft.Toolkit.Uwp.Notifications" Version="7.1.3" />
    <PackageReference Include="System.Drawing.Common" Version="9.0.20" />
  </ItemGroup>
  <ItemGroup Condition="'$(WindowsBuild)' != 'true'">
    <Compile Remove="Services\Windows\**\*.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.4" />
    <PackageReference Include="Avalonia.Controls.WebView" Version="12.1.1" />
    <PackageReference Include="Avalonia.Controls.DataGrid" Version="12.1.2" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.4" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.4" />
    <PackageReference Include="FluentIcons.Avalonia" Version="2.1.344" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="9.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="9.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="9.0.0" />
    <PackageReference Include="Svg.Controls.Skia.Avalonia" Version="12.0.0.17" />
  </ItemGroup>

  <!-- Brand fonts and icon (#216), retained from the Windows app. -->
  <ItemGroup>
    <AvaloniaResource Include="Assets\Fonts\*.ttf" />
    <AvaloniaResource Include="Assets\app.ico" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DesktopNMS.Presentation\DesktopNMS.Presentation.csproj" />
  </ItemGroup>

  <!--
    The DashyNMS MCP server, bundled for Intelligence:
    published by tools/Publish-Mcp.ps1 into artifacts/mcp/<runtime> and copied
    beside the app in mcp/. Without it a developer build still works, and
    the Intelligence tab says the network tools aren't installed.
  -->
  <PropertyGroup>
    <McpRuntime>$(RuntimeIdentifier)</McpRuntime>
    <McpRuntime Condition="'$(McpRuntime)' == ''">$(NETCoreSdkRuntimeIdentifier)</McpRuntime>
    <McpOutput>$(MSBuildThisFileDirectory)..\..\artifacts\mcp\$(McpRuntime)</McpOutput>
    <McpFileName>dashynms-mcp</McpFileName>
    <McpFileName Condition="$([System.String]::Copy('$(McpRuntime)').StartsWith('win-'))">dashynms-mcp.exe</McpFileName>
    <McpExecutable>$(McpOutput)\$(McpFileName)</McpExecutable>
  </PropertyGroup>
  <ItemGroup Condition="Exists('$(McpExecutable)')">
    <None Include="$(McpOutput)\**\*" Link="mcp\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
  </ItemGroup>

</Project>
