<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The desktop app's view models and services with no UI framework in them
    (#249): plain net9.0, independent of the Avalonia UI. Namespaces are unchanged
    (DesktopNMS.ViewModels, DesktopNMS.Services, DesktopNMS.Infrastructure);
    only the assembly differs, so XAML refers to these types with
    ";assembly=DesktopNMS.Presentation". Nothing here may reference WPF,
    WinForms or Windows-only APIs - a front end supplies those behind
    interfaces.
  -->
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <RootNamespace>DesktopNMS</RootNamespace>
    <AssemblyName>DesktopNMS.Presentation</AssemblyName>
  </PropertyGroup>

  <!--
    DesktopNMS.Core lives in DashyNMS/core (#248) and comes in as the
    DashyNMS.Core package from GitHub Packages - see nuget.config and
    docs/DEVELOPMENT.md. Pinned in Directory.Build.props. The app gets it
    through this project.

    To build against a local checkout of DashyNMS/core instead - for a Core
    change and an app change together - set DASHYNMS_LOCAL_CORE to that
    checkout's folder (an environment variable or -p:DASHYNMS_LOCAL_CORE=...).
  -->
  <ItemGroup Condition="'$(DASHYNMS_LOCAL_CORE)' == ''">
    <PackageReference Include="DashyNMS.Core" Version="$(DashyNMSCoreVersion)" />
  </ItemGroup>
  <ItemGroup Condition="'$(DASHYNMS_LOCAL_CORE)' != ''">
    <ProjectReference Include="$(DASHYNMS_LOCAL_CORE)\src\DesktopNMS.Core\DesktopNMS.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.15" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.15" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.15" />
    <PackageReference Include="ModelContextProtocol.Core" Version="2.4.0" />
    <PackageReference Include="QRCoder" Version="1.9.0" />
  </ItemGroup>

  <!-- Internal types used by the app and its tests. -->
  <ItemGroup>
    <InternalsVisibleTo Include="DashyNMS" />
    <InternalsVisibleTo Include="DesktopNMS.Presentation.Tests" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="DesktopNMS.Core.Services" />
    <!-- UiThread, IUiDispatcher and IUiTimer (#249) are used across the view models. -->
    <Using Include="DesktopNMS.Infrastructure" />
  </ItemGroup>

  <!-- The user guide and its screenshots, read by the app's Help (#604): exactly what's
       in the repository for the version being built, so help works offline. -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\docs\guide\**\*.md" LogicalName="DesktopNMS.Help/docs/guide/%(RecursiveDir)%(Filename)%(Extension)" />
    <EmbeddedResource Include="..\..\docs\screenshots\*.png" LogicalName="DesktopNMS.Help/docs/screenshots/%(Filename)%(Extension)" />
  </ItemGroup>
  <Target Name="RequireGuide" BeforeTargets="CoreCompile">
    <Error Condition="!Exists('..\..\docs\guide\README.md')" Text="The user guide is missing, so Help would be empty." />
  </Target>

  <!-- Packages embed docs/releases/<version>.md, the one growing set of notes for the
       version being built, which GitHub's nightlies and releases publish too. Local
       builds embed none. -->
  <PropertyGroup>
    <PublishedNotesVersion>$([System.Text.RegularExpressions.Regex]::IsMatch('$(Version)', '^\d+\.\d+\.\d+(-(nightly|edge)\.\d+)?$'))</PublishedNotesVersion>
    <ReleaseNotesFile>$(MSBuildThisFileDirectory)..\..\docs\releases\$(Version.Split('-')[0]).md</ReleaseNotesFile>
    <HasReleaseNotes Condition="'$(Configuration)' == 'Release' and '$(PublishedNotesVersion)' == 'True' and Exists('$(ReleaseNotesFile)')">true</HasReleaseNotes>
  </PropertyGroup>
  <ItemGroup Condition="'$(HasReleaseNotes)' == 'true'">
    <EmbeddedResource Include="$(ReleaseNotesFile)" LogicalName="DesktopNMS.ReleaseNotes.md" />
    <AssemblyMetadata Include="ReleaseNotesVersion" Value="$(Version)" />
  </ItemGroup>
  <Target Name="RequireExactReleaseNotes" BeforeTargets="PrepareForBuild" Condition="'$(RequireReleaseNotes)' == 'true'">
    <Error Condition="'$(HasReleaseNotes)' != 'true'" Text="Missing release notes: docs/releases/$(Version.Split('-')[0]).md" />
  </Target>

</Project>
