<Application x:Class="DesktopNMS.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:DesktopNMS.Converters"
             xmlns:vm="clr-namespace:DesktopNMS.ViewModels"
             ShutdownMode="OnExplicitShutdown">
    <!--
      The theme (Themes/Palette.Dark.xaml or Palette.Light.xaml, then
      Themes/Dark.xaml's styles) is merged in programmatically instead of
      declared here - see App.xaml.cs's ApplyTheme. It has to be: which
      palette to use depends on a setting only known once ISettingsStore has
      loaded, and Dark.xaml's styles must not be parsed before that palette
      is already present, or their StaticResource references into it would
      resolve to nothing (WPF resolves StaticResource once, when the XAML
      that declares it is first parsed - never again).
    -->
    <Application.Resources>
        <ResourceDictionary>
            <converters:SeverityToBrushConverter x:Key="SeverityToBrush" />
            <converters:BooleanToVisibilityConverter x:Key="BoolToVisibility" />
            <converters:StringToVisibilityConverter x:Key="StringToVisibility" />
            <converters:NullToVisibilityConverter x:Key="NullToVisibility" />
            <converters:AlertStateToOpacityConverter x:Key="StateToOpacity" />
            <converters:DeviceStateToBrushConverter x:Key="DeviceStateToBrush" />
            <converters:MarkdownToFlowDocumentConverter x:Key="MarkdownToFlowDocument" />
            <converters:GaugeArcConverter x:Key="GaugeArc" />
            <converters:GridUnitToPixelsConverter x:Key="GridUnitToPixels" />
            <converters:PercentToStarWidthConverter x:Key="PercentToStarWidth" />

            <!-- One FilterFacet's search box + checklist + select all/none -
                 shared by the Devices tab's filter dialog (Type, Location,
                 Group) and the Alerts tab's (Group), rather than a copy in
                 each. Uses no StaticResource of its own, so it's safe here
                 ahead of the programmatically-merged theme (see above). -->
            <DataTemplate x:Key="FilterFacetSectionTemplate" DataType="{x:Type vm:FilterFacet}">
                <Grid Margin="18">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBox Grid.Row="0"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Search"
                             Margin="0,0,0,10" />

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding OptionsView}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox Content="{Binding LabelText}" IsChecked="{Binding IsChecked}" Margin="0,4" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <Grid Grid.Row="2" Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="Select all" Command="{Binding CheckAllCommand}" HorizontalAlignment="Left" Padding="8,4" />
                        <Button Grid.Column="1" Content="Select none" Command="{Binding UncheckAllCommand}" HorizontalAlignment="Right" Padding="8,4" />
                    </Grid>
                </Grid>
            </DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
