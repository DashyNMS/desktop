<Application x:Class="DesktopNMS.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:DesktopNMS.Converters"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Dark.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <converters:SeverityToBrushConverter x:Key="SeverityToBrush" />
            <converters:BooleanToVisibilityConverter x:Key="BoolToVisibility" />
            <converters:StringToVisibilityConverter x:Key="StringToVisibility" />
            <converters:NullToVisibilityConverter x:Key="NullToVisibility" />
            <converters:AlertStateToOpacityConverter x:Key="StateToOpacity" />
            <converters:DeviceStateToBrushConverter x:Key="DeviceStateToBrush" />
            <converters:MarkdownToFlowDocumentConverter x:Key="MarkdownToFlowDocument" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
