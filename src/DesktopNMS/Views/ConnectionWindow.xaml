<Window x:Class="DesktopNMS.Views.ConnectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:DesktopNMS.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:ConnectionViewModel}"
        Title="Connect to LibreNMS"
        Width="480"
        SizeToContent="Height"
        ResizeMode="NoResize"
        Icon="pack://application:,,,/Assets/app.ico"
        Background="{StaticResource BackgroundBrush}"
        WindowStartupLocation="CenterScreen">

    <StackPanel Margin="24">

        <TextBlock Text="Connect to LibreNMS" Style="{StaticResource HeadingTextStyle}" />
        <TextBlock Style="{StaticResource SubtleTextStyle}"
                   TextWrapping="Wrap"
                   Margin="0,6,0,0"
                   Text="Create a token in LibreNMS under Settings, API, API Access. DashyNMS stores it encrypted for your Windows account only." />

        <TextBlock Text="Server address" Style="{StaticResource SectionHeaderStyle}" />
        <TextBox Text="{Binding ServerUrl, UpdateSourceTrigger=PropertyChanged}"
                 x:Name="ServerBox"
                 ToolTip="For example https://nms.example.com" />
        <TextBlock Text="For example https://nms.example.com"
                   Style="{StaticResource SubtleTextStyle}"
                   Margin="0,4,0,0" />

        <TextBlock Text="API token" Style="{StaticResource SectionHeaderStyle}" />
        <PasswordBox x:Name="TokenBox" PasswordChanged="OnTokenChanged" />

        <CheckBox Content="Remember this token on this machine"
                  IsChecked="{Binding RememberToken}"
                  Margin="0,14,0,0" />
        <CheckBox Content="Allow an untrusted or self-signed certificate"
                  IsChecked="{Binding AllowUntrustedCertificate}" />

        <Border Background="#33DA3633"
                BorderBrush="{StaticResource CriticalBrush}"
                BorderThickness="1"
                CornerRadius="5"
                Padding="12,10"
                Margin="0,14,0,0"
                Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" />
        </Border>

        <Border Background="#332EA043"
                BorderBrush="{StaticResource OkBrush}"
                BorderThickness="1"
                CornerRadius="5"
                Padding="12,10"
                Margin="0,14,0,0"
                Visibility="{Binding HasSuccess, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Text="{Binding SuccessMessage}" TextWrapping="Wrap" />
        </Border>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <TextBlock Text="Checking..."
                       Style="{StaticResource SubtleTextStyle}"
                       VerticalAlignment="Center"
                       Margin="0,0,12,0"
                       Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
            <!-- IsCancel gives Escape and the button the same behaviour, and
                 sets DialogResult to false on its own. -->
            <Button Content="Cancel"
                    IsCancel="True"
                    Margin="0,0,8,0" />
            <Button Content="Connect"
                    Command="{Binding ConnectCommand}"
                    Style="{StaticResource PrimaryButtonStyle}"
                    IsDefault="True" />
        </StackPanel>
    </StackPanel>
</Window>
