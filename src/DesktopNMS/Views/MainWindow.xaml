<Window x:Class="DesktopNMS.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:DesktopNMS.ViewModels"
        xmlns:views="clr-namespace:DesktopNMS.Views"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Title="DashyNMS"
        Height="720"
        Width="1180"
        MinHeight="480"
        MinWidth="900"
        Icon="pack://application:,,,/Assets/app.ico"
        Background="{StaticResource BackgroundBrush}"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <!-- A plain, full-width menu-item look for the Devices hover flyout
             (see #118) - scoped here rather than promoted to Dark.xaml since
             nothing else uses it yet. -->
        <Style x:Key="FlyoutMenuItemStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{StaticResource SurfaceHoverBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Window.InputBindings>
        <KeyBinding Key="F5" Command="{Binding RefreshCurrentTabCommand}" />
        <KeyBinding Key="A" Modifiers="Control" Command="{Binding AcknowledgeCommand}" />
        <KeyBinding Key="L" Modifiers="Control" Command="{Binding ClearCurrentTabFiltersCommand}" />
        <KeyBinding Key="F1" Command="{Binding ShowKeyboardShortcutsCommand}" />
    </Window.InputBindings>

    <Window.CommandBindings>
        <!-- Ctrl+F puts the caret in whichever tab's search box is showing. -->
        <CommandBinding Command="Find" Executed="OnFindExecuted" />
    </Window.CommandBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ======================== Shell header: tabs + actions ======================== -->
        <Border Grid.Row="0"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="18,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- The connected server's own logo/favicon, if it has one and
                     Settings > Appearance has it turned on - a small
                     per-server touch distinct from the app's own icon/title.
                     Falls back to DashyNMS's own icon (HeaderLogo - see
                     MainViewModel) when that setting is off, or while a
                     server logo has not loaded yet. LogoBackdropBrush is
                     theme-aware (see the palette files): it matches the page
                     background in Dark mode so the logo appears to float
                     with no visible box, and uses the tab bar's own grey in
                     Light mode so light-on-transparent artwork stays
                     visible. Hidden entirely rather than showing a
                     broken-image glyph when there is nothing to show at all. -->
                <Border Grid.Column="0"
                        Background="{StaticResource LogoBackdropBrush}"
                        CornerRadius="6"
                        Padding="12,8"
                        Margin="0,0,10,0"
                        VerticalAlignment="Center"
                        Visibility="{Binding HasHeaderLogo, Converter={StaticResource BoolToVisibility}}">
                    <Image Source="{Binding HeaderLogo}"
                           Height="28"
                           MaxWidth="140"
                           Stretch="Uniform" />
                </Border>

                <Border Grid.Column="1"
                        Style="{StaticResource NavTabTrackStyle}"
                        VerticalAlignment="Center"
                        Margin="0,12,0,12">
                    <StackPanel Orientation="Horizontal">
                        <ToggleButton Content="Dashboard"
                                      Style="{StaticResource NavTabButtonStyle}"
                                      IsChecked="{Binding IsDashboardTabSelected, Mode=OneWay}"
                                      Command="{Binding SelectDashboardTabCommand}" />
                        <!-- Devices' own click still goes straight to the
                             Devices tab; hovering reveals Groups/Locations as
                             a flyout below it, since both are facets of
                             device/inventory management rather than peers of
                             Devices/Health/Alerts (see #118). The flyout's
                             open/close is debounced in code-behind
                             (DevicesTabButton_MouseEnter/Leave,
                             DevicesFlyoutContent_MouseEnter/Leave) so
                             crossing the small gap between the button and
                             the popup below it does not flicker it shut. -->
                        <Grid>
                            <ToggleButton x:Name="DevicesTabButton"
                                          Style="{StaticResource NavTabButtonStyle}"
                                          IsChecked="{Binding IsDevicesFamilyTabSelected, Mode=OneWay}"
                                          Command="{Binding SelectDevicesTabCommand}"
                                          MouseEnter="DevicesTabButton_MouseEnter"
                                          MouseLeave="DevicesTabButton_MouseLeave">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Devices" />
                                    <TextBlock Text="&#xE70D;"
                                               FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                               FontSize="9"
                                               Margin="5,0,0,0"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </ToggleButton>

                            <Popup x:Name="DevicesFlyout"
                                   Placement="Bottom"
                                   AllowsTransparency="True"
                                   StaysOpen="True">
                                <Border x:Name="DevicesFlyoutContent"
                                        Background="{StaticResource SurfaceBrush}"
                                        BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="4"
                                        Margin="0,4,0,0"
                                        MouseEnter="DevicesFlyoutContent_MouseEnter"
                                        MouseLeave="DevicesFlyoutContent_MouseLeave">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.3" />
                                    </Border.Effect>
                                    <StackPanel MinWidth="120">
                                        <Button Content="Groups"
                                                Style="{StaticResource FlyoutMenuItemStyle}"
                                                Command="{Binding SelectGroupsTabCommand}"
                                                Click="DevicesFlyoutItem_Click" />
                                        <Button Content="Locations"
                                                Style="{StaticResource FlyoutMenuItemStyle}"
                                                Command="{Binding SelectLocationsTabCommand}"
                                                Click="DevicesFlyoutItem_Click" />
                                    </StackPanel>
                                </Border>
                            </Popup>
                        </Grid>
                        <!-- Neighbours (#55): the tab's own click opens the
                             table of every view; hovering lists each view,
                             the same flyout pattern as Maps. -->
                        <Grid>
                            <ToggleButton x:Name="NeighboursTabButton"
                                          Style="{StaticResource NavTabButtonStyle}"
                                          IsChecked="{Binding IsNeighboursTabSelected, Mode=OneWay}"
                                          Command="{Binding SelectNeighboursTabCommand}"
                                          MouseEnter="NeighboursTabButton_MouseEnter"
                                          MouseLeave="NeighboursTabButton_MouseLeave">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Neighbours" />
                                    <TextBlock Text="&#xE70D;"
                                               FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                               FontSize="9"
                                               Margin="5,0,0,0"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </ToggleButton>

                            <Popup x:Name="NeighboursFlyout"
                                   Placement="Bottom"
                                   AllowsTransparency="True"
                                   StaysOpen="True">
                                <Border x:Name="NeighboursFlyoutContent"
                                        Background="{StaticResource SurfaceBrush}"
                                        BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="4"
                                        Margin="0,4,0,0"
                                        MouseEnter="NeighboursFlyoutContent_MouseEnter"
                                        MouseLeave="NeighboursFlyoutContent_MouseLeave">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.3" />
                                    </Border.Effect>
                                    <StackPanel MinWidth="160">
                                        <ItemsControl ItemsSource="{Binding Neighbours.Views}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Content="{Binding Name}"
                                                            Style="{StaticResource FlyoutMenuItemStyle}"
                                                            Command="{Binding DataContext.SelectNeighbourViewCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"
                                                            Click="NeighboursFlyoutItem_Click" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBlock Text="No views yet"
                                                   Style="{StaticResource SubtleTextStyle}"
                                                   Margin="10,6"
                                                   Visibility="{Binding Neighbours.HasViews, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}" />
                                    </StackPanel>
                                </Border>
                            </Popup>
                        </Grid>
                        <!-- Maps' own click opens the Default map (Settings);
                             hovering offers all three, same flyout pattern
                             as Devices and Alerts. -->
                        <Grid>
                            <ToggleButton x:Name="MapsTabButton"
                                          Style="{StaticResource NavTabButtonStyle}"
                                          IsChecked="{Binding IsMapsFamilyTabSelected, Mode=OneWay}"
                                          Command="{Binding SelectMapsTabCommand}"
                                          MouseEnter="MapsTabButton_MouseEnter"
                                          MouseLeave="MapsTabButton_MouseLeave">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Maps" />
                                    <TextBlock Text="&#xE70D;"
                                               FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                               FontSize="9"
                                               Margin="5,0,0,0"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </ToggleButton>

                            <Popup x:Name="MapsFlyout"
                                   Placement="Bottom"
                                   AllowsTransparency="True"
                                   StaysOpen="True">
                                <Border x:Name="MapsFlyoutContent"
                                        Background="{StaticResource SurfaceBrush}"
                                        BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="4"
                                        Margin="0,4,0,0"
                                        MouseEnter="MapsFlyoutContent_MouseEnter"
                                        MouseLeave="MapsFlyoutContent_MouseLeave">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.3" />
                                    </Border.Effect>
                                    <StackPanel MinWidth="140">
                                        <Button Content="Network"
                                                Style="{StaticResource FlyoutMenuItemStyle}"
                                                Command="{Binding SelectNetworkMapTabCommand}"
                                                Click="MapsFlyoutItem_Click" />
                                        <Button Content="Geographical"
                                                Style="{StaticResource FlyoutMenuItemStyle}"
                                                Command="{Binding SelectGeoMapTabCommand}"
                                                Click="MapsFlyoutItem_Click" />
                                        <Button Content="Custom Maps"
                                                Style="{StaticResource FlyoutMenuItemStyle}"
                                                Command="{Binding SelectCustomMapsTabCommand}"
                                                Click="MapsFlyoutItem_Click" />
                                    </StackPanel>
                                </Border>
                            </Popup>
                        </Grid>
                        <!-- Logs: Graylog is its only source so far, so no
                             hover menu yet (add one, like Maps, when a second
                             source arrives) - and the tab only shows while
                             Graylog is set up. -->
                        <ToggleButton Content="Logs"
                                      Style="{StaticResource NavTabButtonStyle}"
                                      IsChecked="{Binding IsLogsFamilyTabSelected, Mode=OneWay}"
                                      Command="{Binding SelectLogsTabCommand}"
                                      Visibility="{Binding ShowLogsTab, Converter={StaticResource BoolToVisibility}}" />
                        <ToggleButton Content="Health"
                                      Style="{StaticResource NavTabButtonStyle}"
                                      IsChecked="{Binding IsHealthTabSelected, Mode=OneWay}"
                                      Command="{Binding SelectHealthTabCommand}" />
                        <!-- Alerts' own click still goes straight to the
                             Alerts tab; hovering reveals Rules/Templates as a
                             flyout below it, since both are facets of
                             alerting configuration rather than peers of
                             Devices/Health/Alerts - same "family" pattern as
                             the Devices/Groups/Locations flyout above. -->
                        <Grid>
                            <ToggleButton x:Name="AlertsTabButton"
                                          Style="{StaticResource NavTabButtonStyle}"
                                          IsChecked="{Binding IsAlertsFamilyTabSelected, Mode=OneWay}"
                                          Command="{Binding SelectAlertsTabCommand}"
                                          MouseEnter="AlertsTabButton_MouseEnter"
                                          MouseLeave="AlertsTabButton_MouseLeave">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Alerts" VerticalAlignment="Center" />
                                    <!-- The count badge (Settings, Alert display):
                                         red while any counted alert is
                                         critical, orange otherwise. -->
                                    <Border CornerRadius="8"
                                            MinWidth="18"
                                            Height="18"
                                            Padding="5,0"
                                            Margin="7,0,0,0"
                                            VerticalAlignment="Center"
                                            ToolTip="{Binding AlertBadgeToolTip}"
                                            Visibility="{Binding ShowAlertBadge, Converter={StaticResource BoolToVisibility}}">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="{StaticResource WarningBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding AlertBadgeIsCritical}" Value="True">
                                                        <Setter Property="Background" Value="{StaticResource CriticalBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding AlertBadgeText}"
                                                   Foreground="White"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Text="&#xE70D;"
                                               FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                               FontSize="9"
                                               Margin="5,0,0,0"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </ToggleButton>

                            <Popup x:Name="AlertsFlyout"
                                   Placement="Bottom"
                                   AllowsTransparency="True"
                                   StaysOpen="True">
                                <Border x:Name="AlertsFlyoutContent"
                                        Background="{StaticResource SurfaceBrush}"
                                        BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="4"
                                        Margin="0,4,0,0"
                                        MouseEnter="AlertsFlyoutContent_MouseEnter"
                                        MouseLeave="AlertsFlyoutContent_MouseLeave">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.3" />
                                    </Border.Effect>
                                    <StackPanel MinWidth="120">
                                        <Button Content="Rules"
                                                Style="{StaticResource FlyoutMenuItemStyle}"
                                                Command="{Binding SelectRulesTabCommand}"
                                                Click="AlertsFlyoutItem_Click" />
                                        <Button Content="Templates"
                                                Style="{StaticResource FlyoutMenuItemStyle}"
                                                Command="{Binding SelectTemplatesTabCommand}"
                                                Click="AlertsFlyoutItem_Click" />
                                    </StackPanel>
                                </Border>
                            </Popup>
                        </Grid>
                    </StackPanel>
                </Border>

                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,12,0,12">
                    <!-- The glyph sits in an explicit TextBlock with its
                         FontFamily set as a local value: the app's global
                         implicit TextBlock style (Segoe UI) would otherwise
                         win over the icon font inherited from the button,
                         since a style setter beats an inherited value. -->
                    <Button Command="{Binding RefreshCurrentTabCommand}"
                            Style="{StaticResource IconButtonStyle}"
                            ToolTip="Refresh now (F5)"
                            Margin="0,0,8,0">
                        <TextBlock Text="&#xE72C;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="15" />
                    </Button>
                    <Button Command="{Binding ShowKeyboardShortcutsCommand}"
                            Style="{StaticResource IconButtonStyle}"
                            ToolTip="Keyboard shortcuts (F1)"
                            Margin="0,0,8,0">
                        <TextBlock Text="&#xE765;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="15" />
                    </Button>
                    <Button Command="{Binding SettingsCommand}"
                            Style="{StaticResource IconButtonStyle}"
                            ToolTip="Settings"
                            Margin="0,0,8,0">
                        <TextBlock Text="&#xE713;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="15" />
                    </Button>
                    <Button Command="{Binding SignOutCommand}"
                            Style="{StaticResource IconButtonStyle}"
                            ToolTip="Sign out">
                        <TextBlock Text="&#xE7E8;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="15" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ======================== Backup address in use ======================== -->
        <!-- The server stopped answering at its own address, so the app
             is going through the backup address (see ServerFailover) - it
             stays there until switched back here. -->
        <Border Grid.Row="1"
                Background="#33DB9A04"
                BorderBrush="{StaticResource WarningBrush}"
                BorderThickness="0,0,0,1"
                Padding="18,8"
                Visibility="{Binding IsOnBackupAddress, Converter={StaticResource BoolToVisibility}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           Text="&#xE7BA;"
                           FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                           Foreground="{StaticResource WarningBrush}"
                           VerticalAlignment="Center"
                           Margin="0,0,10,0" />
                <TextBlock Grid.Column="1" Text="{Binding BackupAddressBannerText}" TextWrapping="Wrap" VerticalAlignment="Center" />
                <Button Grid.Column="2"
                        Content="Switch back"
                        Style="{StaticResource ChipButtonStyle}"
                        Command="{Binding SwitchBackToMainAddressCommand}"
                        ToolTip="Go back to the server's own address - if it still doesn't answer, the app moves to the backup again"
                        Margin="12,0,0,0"
                        VerticalAlignment="Center" />
            </Grid>
        </Border>

        <!-- ======================== Content ======================== -->
        <Grid Grid.Row="2">
            <!-- Visibility is bound on this Grid, against the inherited
                 MainViewModel DataContext; DevicesView's own DataContext is
                 overridden below it to DeviceList. A binding on the same
                 element that redefines DataContext resolves against the new
                 one, so the two must live on different elements. -->
            <Grid Visibility="{Binding IsDashboardTabSelected, Converter={StaticResource BoolToVisibility}}">
                <views:DashboardView x:Name="DashboardViewControl" DataContext="{Binding Dashboard}" />
            </Grid>

            <Grid Visibility="{Binding IsDevicesTabSelected, Converter={StaticResource BoolToVisibility}}">
                <views:DevicesView x:Name="DevicesViewControl" DataContext="{Binding DeviceList}" />
            </Grid>

            <Grid Visibility="{Binding IsHealthTabSelected, Converter={StaticResource BoolToVisibility}}">
                <views:HealthView x:Name="HealthViewControl" DataContext="{Binding Health}" />
            </Grid>

            <views:AlertsView x:Name="AlertsViewControl"
                               Visibility="{Binding IsAlertsTabSelected, Converter={StaticResource BoolToVisibility}}" />

            <Grid Visibility="{Binding IsGroupsTabSelected, Converter={StaticResource BoolToVisibility}}">
                <views:GroupsView x:Name="GroupsViewControl" DataContext="{Binding Groups}" />
            </Grid>

            <Grid Visibility="{Binding IsLocationsTabSelected, Converter={StaticResource BoolToVisibility}}">
                <views:LocationsView x:Name="LocationsViewControl" DataContext="{Binding Locations}" />
            </Grid>

            <Grid Visibility="{Binding IsNeighboursTabSelected, Converter={StaticResource BoolToVisibility}}">
                <views:NeighboursView x:Name="NeighboursViewControl" DataContext="{Binding Neighbours}" />
            </Grid>

            <Grid Visibility="{Binding IsNetworkMapTabSelected, Converter={StaticResource BoolToVisibility}}">
                <views:NetworkMapView x:Name="NetworkMapViewControl" DataContext="{Binding NetworkMap}" />
            </Grid>

            <Grid Visibility="{Binding IsGeoMapTabSelected, Converter={StaticResource BoolToVisibility}}">
                <views:GeoMapView x:Name="GeoMapViewControl" DataContext="{Binding GeoMap}" />
            </Grid>

            <Grid Visibility="{Binding IsCustomMapsTabSelected, Converter={StaticResource BoolToVisibility}}">
                <views:CustomMapsView x:Name="CustomMapsViewControl" DataContext="{Binding CustomMaps}" />
            </Grid>

            <Grid Visibility="{Binding IsGraylogLogsTabSelected, Converter={StaticResource BoolToVisibility}}">
                <views:LogsView x:Name="LogsViewControl" DataContext="{Binding Logs}" />
            </Grid>

            <Grid Visibility="{Binding IsRulesTabSelected, Converter={StaticResource BoolToVisibility}}">
                <views:RulesView x:Name="RulesViewControl" DataContext="{Binding Rules}" />
            </Grid>

            <Grid Visibility="{Binding IsTemplatesTabSelected, Converter={StaticResource BoolToVisibility}}">
                <views:TemplatesView x:Name="TemplatesViewControl" DataContext="{Binding Templates}" />
            </Grid>
        </Grid>
    </Grid>
</Window>
