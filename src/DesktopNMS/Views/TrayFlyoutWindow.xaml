<Window x:Class="DesktopNMS.Views.TrayFlyoutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:DesktopNMS.ViewModels"
        xmlns:views="clr-namespace:DesktopNMS.Views"
        xmlns:models="clr-namespace:DesktopNMS.Core.Models;assembly=DesktopNMS.Core"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:TrayViewModel}"
        Title="DashyNMS"
        Width="340"
        SizeToContent="Height"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="True"
        Topmost="True"
        WindowStartupLocation="Manual"
        Background="{StaticResource SurfaceBrush}"
        UseLayoutRounding="True">

    <!-- The tray icon's quick look (#232): what's wrong, without opening the
         main window. Closes as soon as it loses focus, as Windows' own tray
         flyouts do. -->
    <Window.Resources>
        <Style x:Key="FlyoutIconButton" TargetType="Button" BasedOn="{StaticResource IconButtonStyle}">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="30" />
            <Setter Property="FontSize" Value="14" />
        </Style>
        <Style x:Key="TileBorder" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SurfaceAltBrush}" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="10,8" />
        </Style>
        <Style x:Key="LinkButton" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter x:Name="Text" />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Text" Property="TextBlock.TextDecorations" Value="Underline" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
        <StackPanel>
            <!-- Header -->
            <DockPanel Margin="14,14,10,10">
                <Button DockPanel.Dock="Right"
                        Style="{StaticResource FlyoutIconButton}"
                        ToolTip="Settings"
                        Command="{Binding SettingsCommand}">
                    <TextBlock Text="&#xE713;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14" />
                </Button>
                <Button DockPanel.Dock="Right"
                        Style="{StaticResource FlyoutIconButton}"
                        ToolTip="{Binding RefreshText}"
                        Command="{Binding RefreshCommand}">
                    <TextBlock Text="&#xE72C;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14" />
                </Button>
                <views:HeartbeatLogo Width="32"
                                     Height="32"
                                     Margin="0,0,10,0"
                                     IsMuted="{Binding IsMarkMuted}"
                                     IsBeating="{Binding IsSigningIn}" />
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="14" />
                    <TextBlock Text="{Binding Detail}" Style="{StaticResource SubtleTextStyle}" FontSize="11.5" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </DockPanel>

            <!-- Counts -->
            <UniformGrid Columns="3"
                         Margin="10,0,10,12"
                         Visibility="{Binding ShowCounts, Converter={StaticResource BoolToVisibility}}">
                <Border Style="{StaticResource TileBorder}" Margin="4,0">
                    <StackPanel>
                        <TextBlock Text="{Binding CriticalCount}" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource CriticalBrush}" />
                        <TextBlock Text="Critical" Style="{StaticResource SubtleTextStyle}" FontSize="11.5" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource TileBorder}" Margin="4,0">
                    <StackPanel>
                        <TextBlock Text="{Binding WarningCount}" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource WarningBrush}" />
                        <TextBlock Text="Warning" Style="{StaticResource SubtleTextStyle}" FontSize="11.5" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource TileBorder}" Margin="4,0">
                    <StackPanel>
                        <TextBlock Text="{Binding AcknowledgedCount}" FontSize="20" FontWeight="SemiBold" />
                        <TextBlock Text="Acknowledged" Style="{StaticResource SubtleTextStyle}" FontSize="11.5" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- Latest alerts -->
            <StackPanel Visibility="{Binding HasLatestAlerts, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="Latest alerts" Style="{StaticResource SubtleTextStyle}" FontSize="11.5" Margin="14,0,14,4" />
                <ItemsControl ItemsSource="{Binding LatestAlerts}" Margin="6,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:TrayAlertViewModel}">
                            <Button Command="{Binding DataContext.OpenAlertCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    CommandParameter="{Binding}"
                                    Cursor="Hand"
                                    ToolTip="Show this alert">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="Row" Background="Transparent" CornerRadius="4" Padding="8,6">
                                            <ContentPresenter />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Row" Property="Background" Value="{StaticResource SurfaceHoverBrush}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                                <DockPanel>
                                    <Ellipse x:Name="Dot" Width="8" Height="8" Margin="0,0,10,0" VerticalAlignment="Center" Fill="{StaticResource WarningBrush}" />
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding AgeText}" Style="{StaticResource SubtleTextStyle}" FontSize="11.5" VerticalAlignment="Center" Margin="8,0,0,0" />
                                    <StackPanel>
                                        <TextBlock Text="{Binding DeviceName}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding RuleName}" Style="{StaticResource SubtleTextStyle}" FontSize="11.5" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </DockPanel>
                            </Button>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding Severity}" Value="{x:Static models:AlertSeverity.Critical}">
                                    <Setter TargetName="Dot" Property="Fill" Value="{StaticResource CriticalBrush}" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button Style="{StaticResource LinkButton}"
                        Content="{Binding ViewAllText}"
                        Command="{Binding AlertsCommand}"
                        HorizontalAlignment="Left"
                        Margin="14,6,14,0" />
            </StackPanel>

            <TextBlock Text="Nothing needs attention."
                       Style="{StaticResource SubtleTextStyle}"
                       Margin="14,0,14,2"
                       Visibility="{Binding ShowNoAlerts, Converter={StaticResource BoolToVisibility}}" />

            <TextBlock Text="Open DashyNMS to sign in."
                       Style="{StaticResource SubtleTextStyle}"
                       Margin="14,0,14,2"
                       Visibility="{Binding ShowSignedOutMessage, Converter={StaticResource BoolToVisibility}}" />

            <!-- Update ready -->
            <Border Margin="14,12,14,0"
                    Padding="10,8"
                    CornerRadius="6"
                    BorderThickness="1"
                    BorderBrush="{DynamicResource AccentBrush}"
                    Background="{StaticResource SurfaceAltBrush}"
                    Visibility="{Binding IsUpdateReady, Converter={StaticResource BoolToVisibility}}">
                <DockPanel>
                    <TextBlock Text="&#xE896;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <Button DockPanel.Dock="Right" Style="{StaticResource LinkButton}" Content="Restart to update" Command="{Binding InstallUpdateCommand}" VerticalAlignment="Center" Margin="8,0,0,0" />
                    <TextBlock Text="{Binding UpdateReadyText}" TextWrapping="Wrap" FontSize="12" VerticalAlignment="Center" />
                </DockPanel>
            </Border>

            <!-- Actions -->
            <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Margin="0,12,0,0" Padding="14,12">
                <WrapPanel>
                    <Button Content="Open DashyNMS" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding OpenCommand}" Padding="12,5" Margin="0,0,6,0" />
                    <Button Content="Dashboard" Command="{Binding DashboardCommand}" Padding="10,5" Margin="0,0,6,0" />
                    <Button Content="Devices" Command="{Binding DevicesCommand}" Padding="10,5" />
                </WrapPanel>
            </Border>
        </StackPanel>
    </Border>
</Window>
