<Window x:Class="DesktopNMS.Views.AddDeviceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:DesktopNMS.ViewModels"
        xmlns:views="clr-namespace:DesktopNMS.Views"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:AddDeviceViewModel}"
        Title="Add device"
        Width="460"
        SizeToContent="Height"
        MaxHeight="860"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Icon="pack://application:,,,/Assets/app.ico"
        Background="{StaticResource BackgroundBrush}"
        WindowStartupLocation="CenterOwner">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="Add device" Style="{StaticResource HeadingTextStyle}" />
            <TextBlock Style="{StaticResource SubtleTextStyle}"
                       TextWrapping="Wrap"
                       Margin="0,6,0,14"
                       Text="Most fields are optional - leave the SNMP credentials blank to try each configured system credential in turn." />

            <TextBlock Text="Hostname or IP" Style="{StaticResource SectionHeaderStyle}" />
            <TextBox x:Name="HostnameBox" Text="{Binding Hostname, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,14" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,-8,0" Padding="0,0,8,0">
            <views:DeviceAddOptionsView DataContext="{Binding Options}" />
        </ScrollViewer>

        <StackPanel Grid.Row="2">
            <Border Background="#33DA3633"
                    BorderBrush="{StaticResource CriticalBrush}"
                    BorderThickness="1"
                    CornerRadius="5"
                    Padding="12,10"
                    Margin="0,14,0,0"
                    Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" />
            </Border>

            <Grid Margin="0,20,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0"
                        Content="Add several..."
                        Command="{Binding BulkAddCommand}"
                        ToolTip="Paste a list of hostnames or import a CSV to add many devices at once" />
                <TextBlock Grid.Column="1"
                           Text="Adding..."
                           Style="{StaticResource SubtleTextStyle}"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Right"
                           Margin="0,0,12,0"
                           Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Content="Cancel"
                            IsCancel="True"
                            Margin="0,0,8,0" />
                    <Button Content="Add device"
                            Command="{Binding AddCommand}"
                            Style="{StaticResource PrimaryButtonStyle}"
                            IsDefault="True" />
                </StackPanel>
            </Grid>
        </StackPanel>
    </Grid>
</Window>
