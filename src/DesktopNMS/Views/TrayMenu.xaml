<ContextMenu x:Class="DesktopNMS.Views.TrayMenu"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:DesktopNMS.ViewModels"
             xmlns:views="clr-namespace:DesktopNMS.Views"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:TrayViewModel}"
             Background="{StaticResource SurfaceBrush}"
             MinWidth="240"
             Placement="MousePoint">

    <!-- The tray's right-click menu (#232), in the app's theme rather than
         WinForms' grey: who it's connected to is gone from here (#218);
         what's wrong is in the header. -->
    <ContextMenu.Resources>
        <Style x:Key="TrayGlyph" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
        </Style>
        <Style x:Key="TrayChip" TargetType="Border">
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="Padding" Value="8,1" />
            <Setter Property="Margin" Value="0,0,6,0" />
        </Style>
    </ContextMenu.Resources>

    <!-- Header: not an item, so it can't be highlighted or clicked. -->
    <MenuItem IsHitTestVisible="False" Focusable="False" Padding="6,6,10,6">
        <MenuItem.Template>
            <ControlTemplate TargetType="MenuItem">
                <StackPanel Margin="{TemplateBinding Padding}">
                    <DockPanel>
                        <views:HeartbeatLogo Width="28"
                                             Height="28"
                                             Margin="0,0,10,0"
                                             IsMuted="{Binding IsMarkMuted}"
                                             IsBeating="{Binding IsSigningIn}" />
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding Detail}" Style="{StaticResource SubtleTextStyle}" FontSize="11.5" />
                        </StackPanel>
                    </DockPanel>
                    <WrapPanel Margin="0,8,0,0" Visibility="{Binding ShowCounts, Converter={StaticResource BoolToVisibility}}">
                        <Border Style="{StaticResource TrayChip}"
                                Background="{StaticResource CriticalBrush}"
                                Visibility="{Binding ShowCriticalChip, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="{Binding CriticalText}" Foreground="White" FontSize="11.5" />
                        </Border>
                        <Border Style="{StaticResource TrayChip}"
                                Background="{StaticResource WarningBrush}"
                                Visibility="{Binding ShowWarningChip, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="{Binding WarningText}" Foreground="White" FontSize="11.5" />
                        </Border>
                        <Border Style="{StaticResource TrayChip}"
                                Background="{StaticResource OkBrush}"
                                Visibility="{Binding ShowAllClearChip, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="All clear" Foreground="White" FontSize="11.5" />
                        </Border>
                    </WrapPanel>
                </StackPanel>
            </ControlTemplate>
        </MenuItem.Template>
    </MenuItem>

    <Separator />

    <MenuItem Command="{Binding OpenCommand}" FontWeight="SemiBold" Header="Open DashyNMS">
        <MenuItem.Icon>
            <TextBlock Text="&#xE8A7;" Style="{StaticResource TrayGlyph}" />
        </MenuItem.Icon>
    </MenuItem>
    <MenuItem Command="{Binding DashboardCommand}" Header="Dashboard">
        <MenuItem.Icon>
            <TextBlock Text="&#xE8A9;" Style="{StaticResource TrayGlyph}" />
        </MenuItem.Icon>
    </MenuItem>
    <MenuItem Command="{Binding AlertsCommand}">
        <MenuItem.Icon>
            <TextBlock Text="&#xEA8F;" Style="{StaticResource TrayGlyph}" />
        </MenuItem.Icon>
        <MenuItem.Header>
            <DockPanel LastChildFill="False">
                <TextBlock Text="Alerts" />
                <TextBlock DockPanel.Dock="Right" Text="{Binding AlertsCountText}" Style="{StaticResource SubtleTextStyle}" FontSize="11.5" VerticalAlignment="Center" />
            </DockPanel>
        </MenuItem.Header>
    </MenuItem>
    <MenuItem Command="{Binding DevicesCommand}" Header="Devices">
        <MenuItem.Icon>
            <TextBlock Text="&#xE968;" Style="{StaticResource TrayGlyph}" />
        </MenuItem.Icon>
    </MenuItem>
    <MenuItem Command="{Binding RefreshCommand}" Header="{Binding RefreshText}">
        <MenuItem.Icon>
            <TextBlock Text="&#xE72C;" Style="{StaticResource TrayGlyph}" />
        </MenuItem.Icon>
    </MenuItem>

    <MenuItem Command="{Binding InstallUpdateCommand}"
              Header="Restart to update"
              Visibility="{Binding IsUpdateReady, Converter={StaticResource BoolToVisibility}}">
        <MenuItem.Icon>
            <TextBlock Text="&#xE896;" Style="{StaticResource TrayGlyph}" Foreground="{DynamicResource AccentBrush}" />
        </MenuItem.Icon>
    </MenuItem>

    <Separator />

    <MenuItem Command="{Binding SettingsCommand}" Header="Settings…">
        <MenuItem.Icon>
            <TextBlock Text="&#xE713;" Style="{StaticResource TrayGlyph}" />
        </MenuItem.Icon>
    </MenuItem>
    <MenuItem Command="{Binding SignInOrOutCommand}" Header="{Binding SignInOrOutText}">
        <MenuItem.Icon>
            <TextBlock Text="&#xE7E8;" Style="{StaticResource TrayGlyph}" />
        </MenuItem.Icon>
    </MenuItem>

    <Separator />

    <MenuItem Command="{Binding ExitCommand}" Header="Exit">
        <MenuItem.Icon>
            <TextBlock Text="&#xE8BB;" Style="{StaticResource TrayGlyph}" />
        </MenuItem.Icon>
    </MenuItem>
</ContextMenu>
