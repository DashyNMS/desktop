<UserControl x:Class="DesktopNMS.Views.HealthView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:DesktopNMS.ViewModels"
             xmlns:views="clr-namespace:DesktopNMS.Views"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:HealthViewModel}"
             d:DesignHeight="600" d:DesignWidth="1100">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ======================== Category sub-tabs ======================== -->
        <Border Grid.Row="0"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="18,12">
            <Border Style="{StaticResource NavTabTrackStyle}" HorizontalAlignment="Left">
                <StackPanel Orientation="Horizontal">
                    <ToggleButton Content="dBm"
                                  Style="{StaticResource NavTabButtonStyle}"
                                  IsChecked="{Binding IsDbmCategorySelected, Mode=OneWay}"
                                  Command="{Binding SelectDbmCategoryCommand}" />
                    <ToggleButton Content="Signal"
                                  Style="{StaticResource NavTabButtonStyle}"
                                  IsChecked="{Binding IsSignalCategorySelected, Mode=OneWay}"
                                  Command="{Binding SelectSignalCategoryCommand}" />
                    <ToggleButton Content="Temperature"
                                  Style="{StaticResource NavTabButtonStyle}"
                                  IsChecked="{Binding IsTemperatureCategorySelected, Mode=OneWay}"
                                  Command="{Binding SelectTemperatureCategoryCommand}" />
                    <ToggleButton Content="Fan speed"
                                  Style="{StaticResource NavTabButtonStyle}"
                                  IsChecked="{Binding IsFanSpeedCategorySelected, Mode=OneWay}"
                                  Command="{Binding SelectFanSpeedCategoryCommand}" />
                </StackPanel>
            </Border>
        </Border>

        <!-- ======================== Error banner ======================== -->
        <Border Grid.Row="1"
                Background="#33DA3633"
                BorderBrush="{StaticResource CriticalBrush}"
                BorderThickness="0,0,0,1"
                Padding="18,10"
                Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap" />
        </Border>

        <!-- ======================== Category content ======================== -->
        <!-- Visibility is bound on each outer Grid, against the inherited
             HealthViewModel DataContext; the SensorCategoryView's own
             DataContext is overridden below it to that category's view
             model. A binding on the same element that redefines DataContext
             resolves against the new one, so the two must live on different
             elements (see MainWindow.xaml for the same pattern). -->
        <Grid Grid.Row="2">
            <Grid Visibility="{Binding IsDbmCategorySelected, Converter={StaticResource BoolToVisibility}}">
                <views:SensorCategoryView x:Name="DbmCategoryView" DataContext="{Binding Dbm}" />
            </Grid>
            <Grid Visibility="{Binding IsSignalCategorySelected, Converter={StaticResource BoolToVisibility}}">
                <views:SensorCategoryView x:Name="SignalCategoryView" DataContext="{Binding Signal}" />
            </Grid>
            <Grid Visibility="{Binding IsTemperatureCategorySelected, Converter={StaticResource BoolToVisibility}}">
                <views:SensorCategoryView x:Name="TemperatureCategoryView" DataContext="{Binding Temperature}" />
            </Grid>
            <Grid Visibility="{Binding IsFanSpeedCategorySelected, Converter={StaticResource BoolToVisibility}}">
                <views:SensorCategoryView x:Name="FanSpeedCategoryView" DataContext="{Binding FanSpeed}" />
            </Grid>
        </Grid>

        <!-- ======================== Status bar ======================== -->
        <Border Grid.Row="3"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="18,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <TextBlock Text="Refreshing..."
                               Style="{StaticResource SubtleTextStyle}"
                               Margin="0,0,10,0"
                               Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
                    <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource SubtleTextStyle}" />
                </StackPanel>

                <TextBlock Grid.Column="1"
                           Text="{Binding LastUpdatedText, StringFormat=updated {0}}"
                           Style="{StaticResource SubtleTextStyle}" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
