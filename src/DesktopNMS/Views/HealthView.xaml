<UserControl x:Class="DesktopNMS.Views.HealthView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:DesktopNMS.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:HealthViewModel}"
             d:DesignHeight="600" d:DesignWidth="1100">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ======================== Mini header: counts ======================== -->
        <Border Grid.Row="0"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="18,12">
            <StackPanel Orientation="Horizontal">
                <Border Background="{StaticResource SurfaceAltBrush}" CornerRadius="6" Padding="14,7" Margin="0,0,10,0">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="9" Height="9" Fill="{StaticResource CriticalBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding CriticalCount}" FontWeight="SemiBold" Margin="8,0,5,0" />
                        <TextBlock Text="critical" Style="{StaticResource SubtleTextStyle}" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
                <Border Background="{StaticResource SurfaceAltBrush}" CornerRadius="6" Padding="14,7" Margin="0,0,10,0">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="9" Height="9" Fill="{StaticResource WarningBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding WarningCount}" FontWeight="SemiBold" Margin="8,0,5,0" />
                        <TextBlock Text="warning" Style="{StaticResource SubtleTextStyle}" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
                <Border Background="{StaticResource SurfaceAltBrush}" CornerRadius="6" Padding="14,7">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="9" Height="9" Fill="{StaticResource OkBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding OkCount}" FontWeight="SemiBold" Margin="8,0,5,0" />
                        <TextBlock Text="ok" Style="{StaticResource SubtleTextStyle}" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- ======================== Error banner ======================== -->
        <Border Grid.Row="1"
                Background="#33DA3633"
                BorderBrush="{StaticResource CriticalBrush}"
                BorderThickness="0,0,0,1"
                Padding="18,10"
                Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap" />
        </Border>

        <!-- ======================== Filters + content ======================== -->
        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="{StaticResource BackgroundBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="18,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <WrapPanel Grid.Column="0" VerticalAlignment="Center">
                        <ToggleButton Content="Critical"
                                      IsChecked="{Binding ShowCritical}"
                                      Style="{StaticResource ChipToggleStyle}"
                                      Tag="{StaticResource CriticalBrush}" />
                        <ToggleButton Content="Warning"
                                      IsChecked="{Binding ShowWarning}"
                                      Style="{StaticResource ChipToggleStyle}"
                                      Tag="{StaticResource WarningBrush}" />
                        <ToggleButton Content="OK"
                                      IsChecked="{Binding ShowOk}"
                                      Style="{StaticResource ChipToggleStyle}"
                                      Tag="{StaticResource OkBrush}" />
                        <ToggleButton Content="No signal"
                                      IsChecked="{Binding ShowUnknown}"
                                      Style="{StaticResource ChipToggleStyle}"
                                      Tag="{StaticResource TextSecondaryBrush}" />
                    </WrapPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBox x:Name="SearchBox"
                                 Width="240"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=200}"
                                 ToolTip="Filter by device or sensor description"
                                 Margin="0,0,8,0" />
                        <Button Content="Clear" Command="{Binding ClearFiltersCommand}" Padding="10,7" />
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1">
                <DataGrid ItemsSource="{Binding SensorsView}"
                          SelectedItem="{Binding SelectedSensor}">
                    <DataGrid.Columns>

                        <DataGridTemplateColumn Header="Status" Width="110" SortMemberPath="Severity">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="10,0">
                                        <Ellipse Width="9"
                                                 Height="9"
                                                 Margin="0,0,8,0"
                                                 VerticalAlignment="Center"
                                                 Fill="{Binding Severity, Converter={StaticResource SeverityToBrush}}" />
                                        <TextBlock Text="{Binding SeverityText}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="Device" Width="220" Binding="{Binding DeviceName}" />
                        <DataGridTextColumn Header="Sensor" Width="*" Binding="{Binding Description}" />
                        <DataGridTextColumn Header="Value" Width="110" Binding="{Binding ValueText}" />
                        <DataGridTextColumn Header="Last update" Width="140" Binding="{Binding LastUpdateText}" />

                    </DataGrid.Columns>

                    <DataGrid.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Open device in LibreNMS" Command="{Binding OpenDeviceCommand}" />
                        </ContextMenu>
                    </DataGrid.ContextMenu>
                </DataGrid>

                <TextBlock Text="Nothing matches the current filters."
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           IsHitTestVisible="False">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource SubtleTextStyle}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding VisibleCount}" Value="0">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </Grid>

        <!-- ======================== Status bar ======================== -->
        <Border Grid.Row="3"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="18,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <TextBlock Text="Refreshing..."
                               Style="{StaticResource SubtleTextStyle}"
                               Margin="0,0,10,0"
                               Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
                    <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource SubtleTextStyle}" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <TextBlock Text="{Binding VisibleCount, StringFormat={}{0} shown}"
                               Style="{StaticResource SubtleTextStyle}"
                               Margin="0,0,14,0" />
                    <TextBlock Text="{Binding LastUpdatedText, StringFormat=updated {0}}" Style="{StaticResource SubtleTextStyle}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
