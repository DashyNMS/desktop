<UserControl x:Class="DesktopNMS.Views.NeighboursView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:DesktopNMS.ViewModels"
             xmlns:views="clr-namespace:DesktopNMS.Views"
             xmlns:svgc="clr-namespace:SharpVectors.Converters;assembly=SharpVectors.Converters.Wpf"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:NeighboursViewModel}"
             d:DesignHeight="600" d:DesignWidth="1100">

    <!-- The Neighbours tab (#55, #221) - see NeighboursViewModel. Every
         neighbour the switches see over LLDP/CDP, narrowed by a neighbourhood
         chip, search and the state chips, with the selected neighbour's port
         graphs underneath. -->
    <Grid>

        <!-- ======================== Neighbours and neighbourhoods ======================== -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="18,12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Neighbourhoods (#221): All, then each one with its count.
                         Right-click one to edit, delete, move it or show it on
                         the network map; + on the right makes a new one. -->
                    <ItemsControl Grid.Row="0" Grid.Column="0" ItemsSource="{Binding Neighbourhoods}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <RadioButton GroupName="Neighbourhoods"
                                             Style="{StaticResource ChipToggleStyle}"
                                             IsChecked="{Binding IsSelected, Mode=OneWay}"
                                             Command="{Binding DataContext.SelectViewCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                             CommandParameter="{Binding}"
                                             Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                             ToolTip="{Binding RulesText}"
                                             Margin="0,0,6,6">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Name}" />
                                        <TextBlock Text="{Binding CountText}" Margin="6,0,0,0" Opacity="0.7" />
                                    </StackPanel>
                                    <RadioButton.ContextMenu>
                                        <ContextMenu Visibility="{Binding IsNeighbourhood, Converter={StaticResource BoolToVisibility}}">
                                            <MenuItem Header="Edit…"
                                                      Command="{Binding PlacementTarget.Tag.EditViewCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                      CommandParameter="{Binding}" />
                                            <MenuItem Header="Show on network map"
                                                      IsCheckable="False"
                                                      IsChecked="{Binding ShowsOnMap, Mode=OneWay}"
                                                      Command="{Binding PlacementTarget.Tag.ToggleShowOnMapCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                      CommandParameter="{Binding}" />
                                            <Separator />
                                            <MenuItem Header="Move left"
                                                      IsEnabled="{Binding CanMoveLeft}"
                                                      Command="{Binding PlacementTarget.Tag.MoveLeftCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                      CommandParameter="{Binding}" />
                                            <MenuItem Header="Move right"
                                                      IsEnabled="{Binding CanMoveRight}"
                                                      Command="{Binding PlacementTarget.Tag.MoveRightCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                      CommandParameter="{Binding}" />
                                            <Separator />
                                            <MenuItem Header="Delete"
                                                      Foreground="{StaticResource CriticalBrush}"
                                                      Command="{Binding PlacementTarget.Tag.DeleteViewCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                      CommandParameter="{Binding}" />
                                        </ContextMenu>
                                    </RadioButton.ContextMenu>
                                </RadioButton>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Button Grid.Row="0"
                            Grid.Column="1"
                            Command="{Binding NewViewCommand}"
                            Style="{StaticResource IconButtonStyle}"
                            ToolTip="New neighbourhood"
                            VerticalAlignment="Top"
                            Margin="12,0,0,0">
                        <TextBlock Text="&#xE710;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13" />
                    </Button>

                    <!-- Search, the state chips (shift-click shows only that one) and the count. -->
                    <WrapPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,6,0,0">
                        <TextBox x:Name="SearchBox"
                                 Width="300"
                                 Style="{StaticResource SearchTextBoxStyle}"
                                 Tag="Search name, description, IP, switch, port or MAC"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=200}"
                                 ToolTip="Filter by name, description, IP, switch, port or MAC"
                                 Margin="0,0,8,0" />
                        <Button Command="{Binding ClearFiltersCommand}"
                                Style="{StaticResource IconButtonStyle}"
                                ToolTip="Clear search and filters"
                                Margin="0,0,12,0"
                                Visibility="{Binding HasAnyFilterApplied, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="&#xE711;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13" />
                        </Button>

                        <ToggleButton IsChecked="{Binding ShowUp}" Tag="{x:Static vm:NeighbourState.Up}" PreviewMouseLeftButtonDown="StateBadge_PreviewMouseLeftButtonDown" Style="{StaticResource CountBadgeToggleStyle}" ToolTip="Show/hide those that are up (shift-click to show only these)" Margin="0,0,10,0">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="9" Height="9" Fill="{StaticResource OkBrush}" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding UpCount}" FontWeight="SemiBold" Margin="8,0,5,0" />
                                <TextBlock Text="up" Style="{StaticResource SubtleTextStyle}" VerticalAlignment="Center" />
                            </StackPanel>
                        </ToggleButton>
                        <ToggleButton IsChecked="{Binding ShowDown}" Tag="{x:Static vm:NeighbourState.Down}" PreviewMouseLeftButtonDown="StateBadge_PreviewMouseLeftButtonDown" Style="{StaticResource CountBadgeToggleStyle}" ToolTip="Show/hide those that are down - the device itself, its switch port, or the switch (shift-click to show only these)" Margin="0,0,10,0">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="9" Height="9" Fill="{StaticResource CriticalBrush}" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding DownCount}" FontWeight="SemiBold" Margin="8,0,5,0" />
                                <TextBlock Text="down" Style="{StaticResource SubtleTextStyle}" VerticalAlignment="Center" />
                            </StackPanel>
                        </ToggleButton>
                        <ToggleButton IsChecked="{Binding ShowOther}" Tag="{x:Static vm:NeighbourState.Other}" PreviewMouseLeftButtonDown="StateBadge_PreviewMouseLeftButtonDown" Style="{StaticResource CountBadgeToggleStyle}" ToolTip="Show/hide shut-down ports, disabled or in-maintenance devices, and ones LibreNMS no longer sees (shift-click to show only these)"
                                      Margin="0,0,10,0"
                                      Visibility="{Binding HasOther, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="9" Height="9" Fill="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding OtherCount}" FontWeight="SemiBold" Margin="8,0,5,0" />
                                <TextBlock Text="other" Style="{StaticResource SubtleTextStyle}" VerticalAlignment="Center" />
                            </StackPanel>
                        </ToggleButton>

                        <TextBlock Text="{Binding CountText}" Style="{StaticResource SubtleTextStyle}" VerticalAlignment="Center" Margin="4,0,0,0" />
                    </WrapPanel>
                </Grid>
            </Border>

            <!-- ======================== Error banner ======================== -->
            <Border Grid.Row="1"
                    Background="#33DA3633"
                    BorderBrush="{StaticResource CriticalBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="18,10"
                    Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap" />
            </Border>

            <!-- ======================== Neighbour list ======================== -->
            <!-- Right-click a column header to show or hide columns - the
                 extra port details start hidden. -->
            <Grid Grid.Row="2">
                <DataGrid x:Name="NeighboursGrid"
                          ItemsSource="{Binding ItemsView}"
                          SelectedItem="{Binding SelectedItem}"
                          SelectionMode="Single"
                          IsReadOnly="True"
                          PreviewMouseRightButtonUp="NeighboursGrid_HeaderRightClick"
                          Visibility="{Binding LoadState.HasVisibleItems, Converter={StaticResource BoolToVisibility}}">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="State" Width="120" SortMemberPath="State">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="10,0">
                                        <Ellipse Width="9"
                                                 Height="9"
                                                 Margin="0,0,7,0"
                                                 VerticalAlignment="Center"
                                                 Fill="{Binding Severity, Converter={StaticResource SeverityToBrush}}" />
                                        <TextBlock Text="{Binding StateText}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="Name" Width="*" MinWidth="160" SortMemberPath="Name">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Grid Margin="10,0" VerticalAlignment="Center" ToolTip="{Binding ToolTip}">
                                        <!-- A LibreNMS device of its own links to it. -->
                                        <TextBlock Cursor="Hand"
                                                   TextTrimming="CharacterEllipsis"
                                                   Visibility="{Binding IsMonitored, Converter={StaticResource BoolToVisibility}}">
                                            <Hyperlink Command="{Binding DataContext.OpenDeviceCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                       CommandParameter="{Binding}">
                                                <Run Text="{Binding Name, Mode=OneWay}" />
                                            </Hyperlink>
                                        </TextBlock>
                                        <TextBlock Text="{Binding Name}"
                                                   TextTrimming="CharacterEllipsis"
                                                   Visibility="{Binding IsMonitored, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}" />
                                    </Grid>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="Description" Width="*" MinWidth="150" SortMemberPath="DescriptionText">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding DescriptionText}" ToolTip="{Binding DescriptionText}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="10,0" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="IP address" Width="120" Binding="{Binding IpText}" />

                        <DataGridTemplateColumn Header="Switch" Width="*" MinWidth="140" SortMemberPath="SwitchName">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Margin="10,0" VerticalAlignment="Center" Cursor="Hand" TextTrimming="CharacterEllipsis">
                                        <Hyperlink Command="{Binding DataContext.OpenSwitchCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                   CommandParameter="{Binding}"
                                                   ToolTip="Open this switch's Device Details">
                                            <Run Text="{Binding SwitchName, Mode=OneWay}" />
                                        </Hyperlink>
                                    </TextBlock>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="Port" Width="100" Binding="{Binding PortText}" />
                        <DataGridTextColumn Header="Port description" Width="140" Binding="{Binding PortDescriptionText}" Visibility="Collapsed" />
                        <DataGridTextColumn Header="In" Width="90" Binding="{Binding InText}" SortMemberPath="InBps" />
                        <DataGridTextColumn Header="Out" Width="90" Binding="{Binding OutText}" SortMemberPath="OutBps" />
                        <DataGridTemplateColumn Header="Errors" Width="80" SortMemberPath="ErrorsPerSecond">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding ErrorsText}" ToolTip="{Binding ErrorsToolTip}" VerticalAlignment="Center" Margin="10,0" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Utilisation" Width="90" Binding="{Binding UtilisationText}" SortMemberPath="UtilisationPercent" Visibility="Collapsed" />
                        <DataGridTextColumn Header="Packets in" Width="95" Binding="{Binding PacketsInText}" SortMemberPath="PacketsInPerSecond" Visibility="Collapsed" />
                        <DataGridTextColumn Header="Packets out" Width="95" Binding="{Binding PacketsOutText}" SortMemberPath="PacketsOutPerSecond" Visibility="Collapsed" />
                        <DataGridTextColumn Header="Speed" Width="80" Binding="{Binding SpeedText}" Visibility="Collapsed" />
                        <DataGridTextColumn Header="Duplex" Width="70" Binding="{Binding DuplexText}" Visibility="Collapsed" />
                        <DataGridTextColumn Header="VLAN" Width="60" Binding="{Binding VlanText}" Visibility="Collapsed" />
                        <DataGridTextColumn Header="MTU" Width="60" Binding="{Binding MtuText}" Visibility="Collapsed" />
                        <DataGridTextColumn Header="Last change" Width="100" Binding="{Binding LastChangeText}" SortMemberPath="SecondsSinceChange" Visibility="Collapsed" />
                        <DataGridTextColumn Header="MAC" Width="140" Binding="{Binding MacText}" />
                        <DataGridTextColumn Header="Announced port" Width="140" Binding="{Binding AnnouncedPortText}" Visibility="Collapsed" />
                        <DataGridTextColumn Header="Protocol" Width="70" Binding="{Binding ProtocolText}" Visibility="Collapsed" />
                    </DataGrid.Columns>
                </DataGrid>

                <TextBlock Text="Loading neighbours..."
                           Style="{StaticResource SubtleTextStyle}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Visibility="{Binding LoadState.IsLoading, Converter={StaticResource BoolToVisibility}}" />

                <TextBlock Text="Nothing your switches see matches this neighbourhood's rules."
                           Style="{StaticResource SubtleTextStyle}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Visibility="{Binding LoadState.IsEmpty, Converter={StaticResource BoolToVisibility}}" />

                <TextBlock Text="Nothing matches your search or filters."
                           Style="{StaticResource SubtleTextStyle}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Visibility="{Binding LoadState.IsNoMatches, Converter={StaticResource BoolToVisibility}}" />
            </Grid>

            <!-- ======================== Selected neighbour's port graphs ======================== -->
            <views:PortGraphsPanel Grid.Row="3" DataContext="{Binding PortGraphs}" />
        </Grid>
    </Grid>
</UserControl>
