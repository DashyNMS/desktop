<UserControl x:Class="DesktopNMS.Views.NeighboursView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:DesktopNMS.ViewModels"
             xmlns:views="clr-namespace:DesktopNMS.Views"
             xmlns:svgc="clr-namespace:SharpVectors.Converters;assembly=SharpVectors.Converters.Wpf"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:NeighboursViewModel}"
             d:DesignHeight="600" d:DesignWidth="1100">

    <!-- The Neighbours tab (#55) - see NeighboursViewModel. Two modes: the
         table of every view (where clicking the tab lands), and one view
         open - what the switches see over LLDP/CDP that matches its rules,
         with the selected neighbour's port graphs underneath. -->
    <Grid>

        <!-- ======================== Table of views ======================== -->
        <Grid Visibility="{Binding IsViewListMode, Converter={StaticResource BoolToVisibility}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Search + add, right-aligned - the Locations tab's bar. -->
            <Border Grid.Row="0"
                    Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="18,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBox x:Name="ViewSearchBox"
                                 Width="240"
                                 Style="{StaticResource SearchTextBoxStyle}"
                                 Tag="Search views"
                                 Text="{Binding ViewSearchText, UpdateSourceTrigger=PropertyChanged, Delay=200}"
                                 ToolTip="Filter by name or rules"
                                 Margin="0,0,8,0" />
                        <Button Command="{Binding ClearViewSearchCommand}"
                                Style="{StaticResource IconButtonStyle}"
                                ToolTip="Clear search"
                                Visibility="{Binding HasViewSearch, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="&#xE711;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13" />
                        </Button>
                    </StackPanel>

                    <Rectangle Grid.Column="2" Style="{StaticResource ToolBarSeparatorStyle}" Margin="14,4" />

                    <Button Grid.Column="3"
                            Command="{Binding NewViewCommand}"
                            Style="{StaticResource IconButtonStyle}"
                            ToolTip="New view">
                        <TextBlock Text="+" FontFamily="Segoe UI" FontSize="20" FontWeight="SemiBold" />
                    </Button>
                </Grid>
            </Border>

            <Grid Grid.Row="1">
                <DataGrid ItemsSource="{Binding ViewRowsView}"
                          IsReadOnly="True"
                          Visibility="{Binding HasViews, Converter={StaticResource BoolToVisibility}}">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="Name" Width="240" SortMemberPath="Name">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Margin="10,0" VerticalAlignment="Center" Cursor="Hand" TextTrimming="CharacterEllipsis">
                                        <Hyperlink Command="{Binding DataContext.SelectViewCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                   CommandParameter="{Binding}"
                                                   ToolTip="Open this view">
                                            <Run Text="{Binding Name, Mode=OneWay}" />
                                        </Hyperlink>
                                    </TextBlock>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="Rules" Width="*" MinWidth="200" SortMemberPath="RulesText">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding RulesText}" ToolTip="{Binding RulesText}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="10,0" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="Neighbours" Width="100" Binding="{Binding MatchCountText}" SortMemberPath="MatchCount">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextAlignment" Value="Right" />
                                    <Setter Property="Margin" Value="0,0,10,0" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="On map" Width="80" Binding="{Binding OnMapText}" />

                        <DataGridTemplateColumn Header="" Width="90" CanUserSort="False">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="6,0">
                                        <Button Command="{Binding DataContext.EditViewCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource IconButtonStyle}"
                                                Width="28"
                                                Height="28"
                                                ToolTip="Edit this view">
                                            <TextBlock Text="&#xE70F;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13" />
                                        </Button>
                                        <Button Command="{Binding DataContext.DeleteViewCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource IconButtonStyle}"
                                                Width="28"
                                                Height="28"
                                                ToolTip="Delete this view"
                                                Foreground="{StaticResource CriticalBrush}">
                                            <TextBlock Text="&#xE74D;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13" />
                                        </Button>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <TextBlock Text="No views match your search."
                           Style="{StaticResource SubtleTextStyle}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Visibility="{Binding ShowNoViewMatches, Converter={StaticResource BoolToVisibility}}" />

                <!-- No views yet. -->
                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            MaxWidth="460"
                            Visibility="{Binding HasViews, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}">
                    <TextBlock Text="No neighbour views yet" Style="{StaticResource HeadingTextStyle}" HorizontalAlignment="Center" />
                    <TextBlock Style="{StaticResource SubtleTextStyle}"
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               Margin="0,8,0,16"
                               Text="Filter what your switches discover over LLDP and CDP into views of your own. A view lists every neighbour whose LLDP details - system name, system description, port ID, or the switch and port it's connected to - match the rules you set." />
                    <Button Content="New view"
                            Command="{Binding NewViewCommand}"
                            Style="{StaticResource PrimaryButtonStyle}"
                            HorizontalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Grid>

        <!-- ======================== One view ======================== -->
        <Grid Visibility="{Binding HasSelectedView, Converter={StaticResource BoolToVisibility}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="18,12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Button Grid.Row="0"
                            Grid.Column="0"
                            Command="{Binding ShowViewListCommand}"
                            Style="{StaticResource IconButtonStyle}"
                            ToolTip="All views"
                            VerticalAlignment="Center"
                            Margin="0,0,10,0">
                        <TextBlock Text="&#xE72B;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14" />
                    </Button>

                    <StackPanel Grid.Row="0" Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                        <TextBlock Text="{Binding SelectedView.Name}" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding ViewRulesText}" Style="{StaticResource SubtleTextStyle}" FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                    </StackPanel>

                    <!-- Search, then the view's own edit and delete. -->
                    <StackPanel Grid.Row="0" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBox x:Name="SearchBox"
                                 Width="240"
                                 Style="{StaticResource SearchTextBoxStyle}"
                                 Tag="Search"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=200}"
                                 ToolTip="Filter by name, description, IP, switch, port or MAC"
                                 Margin="0,0,8,0" />
                        <Button Command="{Binding ClearFiltersCommand}"
                                Style="{StaticResource IconButtonStyle}"
                                ToolTip="Clear search and filters"
                                Visibility="{Binding HasAnyFilterApplied, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="&#xE711;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13" />
                        </Button>

                        <Rectangle Style="{StaticResource ToolBarSeparatorStyle}" Margin="14,4" />

                        <Button Command="{Binding EditViewCommand}"
                                Style="{StaticResource IconButtonStyle}"
                                ToolTip="Edit this view's name and rules"
                                Margin="0,0,4,0">
                            <TextBlock Text="&#xE70F;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13" />
                        </Button>
                        <Button Command="{Binding DeleteViewCommand}"
                                Style="{StaticResource IconButtonStyle}"
                                ToolTip="Delete this view"
                                Foreground="{StaticResource CriticalBrush}">
                            <TextBlock Text="&#xE74D;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13" />
                        </Button>
                    </StackPanel>

                    <!-- State pills - shift-click shows only that one. -->
                    <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Orientation="Horizontal" Margin="0,12,0,0">
                        <ToggleButton IsChecked="{Binding ShowUp}" Tag="{x:Static vm:NeighbourState.Up}" PreviewMouseLeftButtonDown="StateBadge_PreviewMouseLeftButtonDown" Style="{StaticResource CountBadgeToggleStyle}" ToolTip="Show/hide those that are up (shift-click to show only these)" Margin="0,0,10,0">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="9" Height="9" Fill="{StaticResource OkBrush}" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding UpCount}" FontWeight="SemiBold" Margin="8,0,5,0" />
                                <TextBlock Text="up" Style="{StaticResource SubtleTextStyle}" VerticalAlignment="Center" />
                            </StackPanel>
                        </ToggleButton>
                        <ToggleButton IsChecked="{Binding ShowDown}" Tag="{x:Static vm:NeighbourState.Down}" PreviewMouseLeftButtonDown="StateBadge_PreviewMouseLeftButtonDown" Style="{StaticResource CountBadgeToggleStyle}" ToolTip="Show/hide those that are down - the device itself, its switch port, or the switch (shift-click to show only these)" Margin="0,0,10,0">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="9" Height="9" Fill="{StaticResource CriticalBrush}" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding DownCount}" FontWeight="SemiBold" Margin="8,0,5,0" />
                                <TextBlock Text="down" Style="{StaticResource SubtleTextStyle}" VerticalAlignment="Center" />
                            </StackPanel>
                        </ToggleButton>
                        <ToggleButton IsChecked="{Binding ShowOther}" Tag="{x:Static vm:NeighbourState.Other}" PreviewMouseLeftButtonDown="StateBadge_PreviewMouseLeftButtonDown" Style="{StaticResource CountBadgeToggleStyle}" ToolTip="Show/hide shut-down ports, disabled or in-maintenance devices, and ones LibreNMS no longer sees (shift-click to show only these)"
                                      Visibility="{Binding HasOther, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="9" Height="9" Fill="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding OtherCount}" FontWeight="SemiBold" Margin="8,0,5,0" />
                                <TextBlock Text="other" Style="{StaticResource SubtleTextStyle}" VerticalAlignment="Center" />
                            </StackPanel>
                        </ToggleButton>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ======================== Error banner ======================== -->
            <Border Grid.Row="1"
                    Background="#33DA3633"
                    BorderBrush="{StaticResource CriticalBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="18,10"
                    Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap" />
            </Border>

            <!-- ======================== Neighbour list ======================== -->
            <!-- Right-click a column header to show or hide columns - the
                 extra port details start hidden. -->
            <Grid Grid.Row="2">
                <DataGrid x:Name="NeighboursGrid"
                          ItemsSource="{Binding ItemsView}"
                          SelectedItem="{Binding SelectedItem}"
                          SelectionMode="Single"
                          IsReadOnly="True"
                          PreviewMouseRightButtonUp="NeighboursGrid_HeaderRightClick"
                          Visibility="{Binding LoadState.HasVisibleItems, Converter={StaticResource BoolToVisibility}}">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="State" Width="120" SortMemberPath="State">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="10,0">
                                        <Ellipse Width="9"
                                                 Height="9"
                                                 Margin="0,0,7,0"
                                                 VerticalAlignment="Center"
                                                 Fill="{Binding Severity, Converter={StaticResource SeverityToBrush}}" />
                                        <TextBlock Text="{Binding StateText}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="Name" Width="*" MinWidth="160" SortMemberPath="Name">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Grid Margin="10,0" VerticalAlignment="Center" ToolTip="{Binding ToolTip}">
                                        <!-- A LibreNMS device of its own links to it. -->
                                        <TextBlock Cursor="Hand"
                                                   TextTrimming="CharacterEllipsis"
                                                   Visibility="{Binding IsMonitored, Converter={StaticResource BoolToVisibility}}">
                                            <Hyperlink Command="{Binding DataContext.OpenDeviceCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                       CommandParameter="{Binding}">
                                                <Run Text="{Binding Name, Mode=OneWay}" />
                                            </Hyperlink>
                                        </TextBlock>
                                        <TextBlock Text="{Binding Name}"
                                                   TextTrimming="CharacterEllipsis"
                                                   Visibility="{Binding IsMonitored, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}" />
                                    </Grid>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="Description" Width="*" MinWidth="150" SortMemberPath="DescriptionText">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding DescriptionText}" ToolTip="{Binding DescriptionText}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="10,0" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="IP address" Width="120" Binding="{Binding IpText}" />

                        <DataGridTemplateColumn Header="Switch" Width="*" MinWidth="140" SortMemberPath="SwitchName">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Margin="10,0" VerticalAlignment="Center" Cursor="Hand" TextTrimming="CharacterEllipsis">
                                        <Hyperlink Command="{Binding DataContext.OpenSwitchCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                   CommandParameter="{Binding}"
                                                   ToolTip="Open this switch's Device Details">
                                            <Run Text="{Binding SwitchName, Mode=OneWay}" />
                                        </Hyperlink>
                                    </TextBlock>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="Port" Width="100" Binding="{Binding PortText}" />
                        <DataGridTextColumn Header="Port description" Width="140" Binding="{Binding PortDescriptionText}" Visibility="Collapsed" />
                        <DataGridTextColumn Header="In" Width="90" Binding="{Binding InText}" SortMemberPath="InBps" />
                        <DataGridTextColumn Header="Out" Width="90" Binding="{Binding OutText}" SortMemberPath="OutBps" />
                        <DataGridTemplateColumn Header="Errors" Width="80" SortMemberPath="ErrorsPerSecond">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding ErrorsText}" ToolTip="{Binding ErrorsToolTip}" VerticalAlignment="Center" Margin="10,0" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Utilisation" Width="90" Binding="{Binding UtilisationText}" SortMemberPath="UtilisationPercent" Visibility="Collapsed" />
                        <DataGridTextColumn Header="Packets in" Width="95" Binding="{Binding PacketsInText}" SortMemberPath="PacketsInPerSecond" Visibility="Collapsed" />
                        <DataGridTextColumn Header="Packets out" Width="95" Binding="{Binding PacketsOutText}" SortMemberPath="PacketsOutPerSecond" Visibility="Collapsed" />
                        <DataGridTextColumn Header="Speed" Width="80" Binding="{Binding SpeedText}" Visibility="Collapsed" />
                        <DataGridTextColumn Header="Duplex" Width="70" Binding="{Binding DuplexText}" Visibility="Collapsed" />
                        <DataGridTextColumn Header="VLAN" Width="60" Binding="{Binding VlanText}" Visibility="Collapsed" />
                        <DataGridTextColumn Header="MTU" Width="60" Binding="{Binding MtuText}" Visibility="Collapsed" />
                        <DataGridTextColumn Header="Last change" Width="100" Binding="{Binding LastChangeText}" SortMemberPath="SecondsSinceChange" Visibility="Collapsed" />
                        <DataGridTextColumn Header="MAC" Width="140" Binding="{Binding MacText}" />
                        <DataGridTextColumn Header="Announced port" Width="140" Binding="{Binding AnnouncedPortText}" Visibility="Collapsed" />
                        <DataGridTextColumn Header="Protocol" Width="70" Binding="{Binding ProtocolText}" Visibility="Collapsed" />
                    </DataGrid.Columns>
                </DataGrid>

                <TextBlock Text="Loading neighbours..."
                           Style="{StaticResource SubtleTextStyle}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Visibility="{Binding LoadState.IsLoading, Converter={StaticResource BoolToVisibility}}" />

                <TextBlock Text="Nothing your switches see matches this view's rules."
                           Style="{StaticResource SubtleTextStyle}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Visibility="{Binding LoadState.IsEmpty, Converter={StaticResource BoolToVisibility}}" />

                <TextBlock Text="Nothing matches your search or filters."
                           Style="{StaticResource SubtleTextStyle}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Visibility="{Binding LoadState.IsNoMatches, Converter={StaticResource BoolToVisibility}}" />
            </Grid>

            <!-- ======================== Selected neighbour's port graphs ======================== -->
            <!-- Traffic, packets and errors for its switch port, two across.
                 The chevron folds it down to this header line, so the
                 table can have the full height. -->
            <Border Grid.Row="3"
                    Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,1,0,0"
                    Padding="18,8,18,12"
                    Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibility}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0"
                                Command="{Binding ToggleGraphsCommand}"
                                Style="{StaticResource IconButtonStyle}"
                                ToolTip="Show or hide the port graphs"
                                VerticalAlignment="Center"
                                Margin="0,0,8,0">
                            <TextBlock Text="{Binding GraphsToggleGlyph}" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12" />
                        </Button>
                        <TextBlock Grid.Column="1" VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                            <Run Text="{Binding SelectedItem.Name, Mode=OneWay}" FontWeight="SemiBold" />
                            <Run Text=" - port " Foreground="{StaticResource TextSecondaryBrush}" />
                            <Run Text="{Binding SelectedItem.PortText, Mode=OneWay}" Foreground="{StaticResource TextSecondaryBrush}" />
                            <Run Text=" on " Foreground="{StaticResource TextSecondaryBrush}" />
                            <Run Text="{Binding SelectedItem.SwitchName, Mode=OneWay}" Foreground="{StaticResource TextSecondaryBrush}" />
                        </TextBlock>
                        <views:GraphTimeRangePicker x:Name="GraphTimeRange"
                                                    Grid.Column="2"
                                                    DataContext="{Binding TimeRange}"
                                                    VerticalAlignment="Center" />
                    </Grid>

                    <ScrollViewer Grid.Row="1"
                                  Height="420"
                                  Margin="0,10,0,0"
                                  VerticalScrollBarVisibility="Auto"
                                  Visibility="{Binding IsGraphsCollapsed, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}">
                        <ItemsControl ItemsSource="{Binding PortGraphs}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="2" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource SurfaceAltBrush}"
                                            CornerRadius="5"
                                            Padding="10,8"
                                            Margin="0,0,10,10">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="170" />
                                            </Grid.RowDefinitions>
                                            <TextBlock Grid.Row="0" Text="{Binding Title}" Style="{StaticResource SectionHeaderStyle}" Margin="0,0,0,6" />
                                            <Grid Grid.Row="1">
                                                <svgc:SvgViewbox SvgSource="{Binding Svg}"
                                                                 Stretch="Uniform"
                                                                 HorizontalAlignment="Left"
                                                                 VerticalAlignment="Top"
                                                                 Visibility="{Binding Svg, Converter={StaticResource NullToVisibility}}" />
                                                <TextBlock Text="Loading graph..."
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           IsHitTestVisible="False"
                                                           Style="{StaticResource SubtleTextStyle}"
                                                           Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}" />
                                                <TextBlock Text="{Binding ErrorMessage}"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           TextWrapping="Wrap"
                                                           IsHitTestVisible="False"
                                                           Style="{StaticResource SubtleTextStyle}"
                                                           Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}" />
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
