<UserControl x:Class="DesktopNMS.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:DesktopNMS.ViewModels"
             xmlns:views="clr-namespace:DesktopNMS.Views"
             xmlns:svgc="clr-namespace:SharpVectors.Converters;assembly=SharpVectors.Converters.Wpf"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:DashboardViewModel}"
             d:DesignHeight="600" d:DesignWidth="1100"
             Loaded="OnLoaded"
             PreviewKeyDown="OnPreviewKeyDown"
             Focusable="True"
             FocusVisualStyle="{x:Null}">

    <UserControl.Resources>

        <!-- ======================== Shared widget row pieces (#212) ======================== -->
        <!-- Every list widget reads the same way, set by the Top widgets: flat
             two-line rows that tint on hover and open on click, small headings
             lined up over right-aligned numbers, and a status dot. -->
        <Style x:Key="WidgetRowButtonStyle" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="RowBorder" Background="Transparent" CornerRadius="6" Padding="8,5">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="RowBorder" Property="Background" Value="{StaticResource SurfaceAltBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- A clickable count (Alerts gauge, Device status): no chrome, a tint on hover. -->
        <Style x:Key="WidgetCountButtonStyle" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="2" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="CountBorder" Background="Transparent" CornerRadius="8" Padding="4,6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CountBorder" Property="Background" Value="{StaticResource SurfaceAltBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="WidgetHeadingStyle" TargetType="TextBlock" BasedOn="{StaticResource SubtleTextStyle}">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="WidgetSubtitleStyle" TargetType="TextBlock" BasedOn="{StaticResource SubtleTextStyle}">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Margin" Value="14,1,8,0" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <Style x:Key="WidgetDotStyle" TargetType="Ellipse">
            <Setter Property="Width" Value="7" />
            <Setter Property="Height" Value="7" />
            <Setter Property="Margin" Value="0,1,7,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- Loading, empty and no-matches messages: centred, subtle, the same everywhere. -->
        <Style x:Key="WidgetStateTextStyle" TargetType="TextBlock" BasedOn="{StaticResource SubtleTextStyle}">
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="MaxWidth" Value="260" />
            <Setter Property="IsHitTestVisible" Value="False" />
        </Style>

        <!-- ======================== Sensor widget body ======================== -->
        <!-- Resolved automatically wherever a widget's content is presented via a
             plain ContentControl, based on the bound view model's runtime type. -->
        <DataTemplate DataType="{x:Type vm:SensorWidgetViewModel}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>


                <!-- Body: a plain read-only list normally; once editing, either
                     the current sensors (each removable) or the "Add sensor"
                     picker, whichever IsPickerOpen selects. -->
                <Grid Grid.Row="1">

                    <!-- Viewing (not editing): plain, uncluttered sensor readout. -->
                    <Grid>
                        <!-- Two-line rows (#212): device and sensor, with the value
                             on the right coloured by its severity - no Status column. -->
                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      Visibility="{Binding LoadState.HasVisibleItems, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel Margin="-2,0,-2,0">
                                <Grid Margin="8,0,8,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Device · sensor" Style="{StaticResource WidgetHeadingStyle}" />
                                    <TextBlock Grid.Column="1" Text="Value" Style="{StaticResource WidgetHeadingStyle}" />
                                </Grid>
                                <ItemsControl ItemsSource="{Binding Sensors}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Style="{StaticResource WidgetRowButtonStyle}"
                                                    Command="{Binding DataContext.OpenDeviceDetailsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    ToolTip="{Binding LastUpdateText}">
                                                <Button.ContextMenu>
                                                    <ContextMenu>
                                                        <MenuItem Header="Open device in LibreNMS"
                                                                  Command="{Binding PlacementTarget.Tag.OpenDeviceCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                  CommandParameter="{Binding}" />
                                                    </ContextMenu>
                                                </Button.ContextMenu>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>
                                                    <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="0,0,8,0">
                                                        <Ellipse Style="{StaticResource WidgetDotStyle}" Fill="{Binding Severity, Converter={StaticResource SeverityToBrush}}" />
                                                        <TextBlock Text="{Binding DeviceName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding Description}" Style="{StaticResource WidgetSubtitleStyle}" />
                                                    <TextBlock x:Name="SensorValue" Grid.Column="1" Grid.RowSpan="2" Text="{Binding ValueText}" TextAlignment="Right" VerticalAlignment="Center" />
                                                </Grid>
                                            </Button>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding Severity}" Value="Warning">
                                                    <Setter TargetName="SensorValue" Property="Foreground" Value="{StaticResource WarningBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Severity}" Value="Critical">
                                                    <Setter TargetName="SensorValue" Property="Foreground" Value="{StaticResource CriticalBrush}" />
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>

                        <TextBlock Text="Loading…"
                                   Style="{StaticResource WidgetStateTextStyle}"
                                   Visibility="{Binding LoadState.IsLoading, Converter={StaticResource BoolToVisibility}}" />

                        <TextBlock Text="No sensors yet. Choose some from ⋯, Set up…"
                                   Style="{StaticResource WidgetStateTextStyle}"
                                   Visibility="{Binding LoadState.IsEmpty, Converter={StaticResource BoolToVisibility}}" />

                        <TextBlock Text="The sensors on this widget weren't found. They may have been removed."
                                   Style="{StaticResource WidgetStateTextStyle}"
                                   Visibility="{Binding LoadState.IsNoMatches, Converter={StaticResource BoolToVisibility}}" />
                    </Grid>


                </Grid>
            </Grid>
        </DataTemplate>

        <!-- ======================== Alerts widget body ======================== -->
        <!-- A compact feed of alerts fed by the app-wide alert monitor - see
             AlertsWidgetViewModel. Its severity and acknowledged toggles are
             always in the title bar (a viewing preference, not a structural
             edit), unlike the Sensors widget's "manage" controls which only
             appear while editing. -->
        <DataTemplate DataType="{x:Type vm:AlertsWidgetViewModel}">
            <Grid>
                <!-- Two-line rows (#212): a severity dot, the device, the alert
                     underneath and its age on the right. The severity and
                     acknowledged toggles are in the title bar - see the
                     AlertsWidgetHeader template below. -->
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              Visibility="{Binding LoadState.HasVisibleItems, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel Margin="-2,0,-2,0">
                        <Grid Margin="8,0,8,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Device · alert" Style="{StaticResource WidgetHeadingStyle}" />
                            <TextBlock Grid.Column="1" Text="Age" Style="{StaticResource WidgetHeadingStyle}" />
                        </Grid>
                        <ItemsControl ItemsSource="{Binding Alerts}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource WidgetRowButtonStyle}"
                                            Command="{Binding DataContext.OpenDeviceDetailsCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}"
                                            Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=ItemsControl}}">
                                        <Button.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="Open alert in LibreNMS"
                                                          Command="{Binding PlacementTarget.Tag.OpenAlertCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                          CommandParameter="{Binding}" />
                                                <MenuItem Header="Open device in LibreNMS"
                                                          Command="{Binding PlacementTarget.Tag.OpenDeviceCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                          CommandParameter="{Binding}" />
                                            </ContextMenu>
                                        </Button.ContextMenu>
                                        <Grid x:Name="AlertRow">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="0,0,8,0">
                                                <Ellipse Style="{StaticResource WidgetDotStyle}" Fill="{Binding Severity, Converter={StaticResource SeverityToBrush}}" />
                                                <TextBlock Text="{Binding DeviceName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding RuleName}" Style="{StaticResource WidgetSubtitleStyle}" />
                                            <TextBlock Grid.Column="1" Grid.RowSpan="2" Text="{Binding AgeText}" TextAlignment="Right" VerticalAlignment="Center" Style="{StaticResource SubtleTextStyle}" />
                                        </Grid>
                                    </Button>
                                    <DataTemplate.Triggers>
                                        <!-- Acknowledged ones are dimmed, as on the Alerts tab. -->
                                        <DataTrigger Binding="{Binding IsAcknowledged}" Value="True">
                                            <Setter TargetName="AlertRow" Property="Opacity" Value="0.6" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>

                <TextBlock Text="Loading…"
                           Style="{StaticResource WidgetStateTextStyle}"
                           Visibility="{Binding LoadState.IsLoading, Converter={StaticResource BoolToVisibility}}" />

                <TextBlock Text="No active alerts."
                           Style="{StaticResource WidgetStateTextStyle}"
                           Visibility="{Binding LoadState.IsEmpty, Converter={StaticResource BoolToVisibility}}" />

                <TextBlock Text="No alerts match the toggles above."
                           Style="{StaticResource WidgetStateTextStyle}"
                           Visibility="{Binding LoadState.IsNoMatches, Converter={StaticResource BoolToVisibility}}" />
            </Grid>
        </DataTemplate>

        <!-- The Alerts widget's title-bar controls (#212): Critical, Warning and
             Acknowledged toggles, each with its count. Shift-click a severity to
             show only that one. -->
        <DataTemplate DataType="{x:Type vm:AlertsWidgetHeader}">
            <StackPanel Orientation="Horizontal">
                <ToggleButton Style="{StaticResource ChipToggleStyle}"
                              Tag="Critical"
                              Margin="0,0,4,0"
                              IsChecked="{Binding Widget.ShowCritical}"
                              PreviewMouseLeftButtonDown="AlertSeverityBadge_PreviewMouseLeftButtonDown"
                              ToolTip="Critical - shift-click to show only critical">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="7" Height="7" Margin="0,0,5,0" VerticalAlignment="Center" Fill="{StaticResource CriticalBrush}" />
                        <TextBlock Text="{Binding Widget.CriticalCount}" />
                    </StackPanel>
                </ToggleButton>
                <ToggleButton Style="{StaticResource ChipToggleStyle}"
                              Tag="Warning"
                              Margin="0,0,4,0"
                              IsChecked="{Binding Widget.ShowWarning}"
                              PreviewMouseLeftButtonDown="AlertSeverityBadge_PreviewMouseLeftButtonDown"
                              ToolTip="Warning - shift-click to show only warning">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="7" Height="7" Margin="0,0,5,0" VerticalAlignment="Center" Fill="{StaticResource WarningBrush}" />
                        <TextBlock Text="{Binding Widget.WarningCount}" />
                    </StackPanel>
                </ToggleButton>
                <ToggleButton Style="{StaticResource ChipToggleStyle}"
                              IsChecked="{Binding Widget.IncludeAcknowledged}"
                              ToolTip="Include acknowledged alerts">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE73E;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="11" Margin="0,1,5,0" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding Widget.AcknowledgedCount}" />
                    </StackPanel>
                </ToggleButton>
            </StackPanel>
        </DataTemplate>

        <!-- ======================== Alerts gauge widget body ======================== -->
        <!-- Three ring gauges - unacknowledged critical, unacknowledged
             warning, and acknowledged (any severity) - each a share of all
             active alerts, drawn with GaugeArcConverter inside a fixed
             100x100 local space that a Viewbox scales to whatever room the
             widget has. -->
        <DataTemplate DataType="{x:Type vm:AlertsGaugeWidgetViewModel}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" Style="{StaticResource WidgetCountButtonStyle}" Command="{Binding OpenCriticalCommand}">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Viewbox Width="80" Height="80">
                            <Grid Width="100" Height="100">
                                <Ellipse Width="80"
                                         Height="80"
                                         Margin="10"
                                         Stroke="{StaticResource BorderBrush}"
                                         StrokeThickness="10" />
                                <Path Data="{Binding CriticalFraction, Converter={StaticResource GaugeArc}}"
                                      Stroke="{StaticResource CriticalBrush}"
                                      StrokeThickness="10"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round" />
                                <TextBlock Text="{Binding CriticalCount}"
                                           FontSize="26"
                                           FontFamily="{StaticResource DisplayFont}"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Grid>
                        </Viewbox>
                        <TextBlock Text="Critical" HorizontalAlignment="Center" Margin="0,8,0,0" Style="{StaticResource SubtleTextStyle}" />
                    </StackPanel>
                    </Button>

                    <Button Grid.Column="1" Style="{StaticResource WidgetCountButtonStyle}" Command="{Binding OpenWarningCommand}">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Viewbox Width="80" Height="80">
                            <Grid Width="100" Height="100">
                                <Ellipse Width="80"
                                         Height="80"
                                         Margin="10"
                                         Stroke="{StaticResource BorderBrush}"
                                         StrokeThickness="10" />
                                <Path Data="{Binding WarningFraction, Converter={StaticResource GaugeArc}}"
                                      Stroke="{StaticResource WarningBrush}"
                                      StrokeThickness="10"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round" />
                                <TextBlock Text="{Binding WarningCount}"
                                           FontSize="26"
                                           FontFamily="{StaticResource DisplayFont}"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Grid>
                        </Viewbox>
                        <TextBlock Text="Warning" HorizontalAlignment="Center" Margin="0,8,0,0" Style="{StaticResource SubtleTextStyle}" />
                    </StackPanel>
                    </Button>

                    <Button Grid.Column="2" Style="{StaticResource WidgetCountButtonStyle}" Command="{Binding OpenAllCommand}">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Viewbox Width="80" Height="80">
                            <Grid Width="100" Height="100">
                                <Ellipse Width="80"
                                         Height="80"
                                         Margin="10"
                                         Stroke="{StaticResource BorderBrush}"
                                         StrokeThickness="10" />
                                <Path Data="{Binding AcknowledgedFraction, Converter={StaticResource GaugeArc}}"
                                      Stroke="{StaticResource TextSecondaryBrush}"
                                      StrokeThickness="10"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round" />
                                <TextBlock Text="{Binding AcknowledgedCount}"
                                           FontSize="26"
                                           FontFamily="{StaticResource DisplayFont}"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Grid>
                        </Viewbox>
                        <TextBlock Text="Acknowledged" HorizontalAlignment="Center" Margin="0,8,0,0" Style="{StaticResource SubtleTextStyle}" />
                    </StackPanel>
                    </Button>
                </Grid>

                <TextBlock Grid.Row="1"
                           Text="No active alerts"
                           HorizontalAlignment="Center"
                           Margin="0,12,0,0"
                           Style="{StaticResource SubtleTextStyle}"
                           Visibility="{Binding HasNoActiveAlerts, Converter={StaticResource BoolToVisibility}}" />

                <TextBlock Grid.Row="1"
                           HorizontalAlignment="Center"
                           Margin="0,12,0,0"
                           Style="{StaticResource SubtleTextStyle}"
                           Visibility="{Binding HasNoActiveAlerts, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}">
                    <Run Text="{Binding TotalActiveText, Mode=OneWay}" />
                </TextBlock>
            </Grid>
        </DataTemplate>

        <!-- ======================== Device status widget body ======================== -->
        <!-- Four ring gauges - up, down, maintenance and disabled/ignored -
             each a share of all devices, drawn the same way as the Alerts
             gauge widget. -->
        <DataTemplate DataType="{x:Type vm:DeviceStatusWidgetViewModel}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Visibility="{Binding LoadState.HasVisibleItems, Converter={StaticResource BoolToVisibility}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" Style="{StaticResource WidgetCountButtonStyle}" Command="{Binding OpenUpCommand}">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Viewbox Width="70" Height="70">
                            <Grid Width="100" Height="100">
                                <Ellipse Width="80"
                                         Height="80"
                                         Margin="10"
                                         Stroke="{StaticResource BorderBrush}"
                                         StrokeThickness="10" />
                                <Path Data="{Binding UpFraction, Converter={StaticResource GaugeArc}}"
                                      Stroke="{StaticResource OkBrush}"
                                      StrokeThickness="10"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round" />
                                <TextBlock Text="{Binding UpCount}"
                                           FontSize="22"
                                           FontFamily="{StaticResource DisplayFont}"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Grid>
                        </Viewbox>
                        <TextBlock Text="Up" HorizontalAlignment="Center" Margin="0,8,0,0" Style="{StaticResource SubtleTextStyle}" />
                    </StackPanel>
                    </Button>

                    <Button Grid.Column="1" Style="{StaticResource WidgetCountButtonStyle}" Command="{Binding OpenDownCommand}">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Viewbox Width="70" Height="70">
                            <Grid Width="100" Height="100">
                                <Ellipse Width="80"
                                         Height="80"
                                         Margin="10"
                                         Stroke="{StaticResource BorderBrush}"
                                         StrokeThickness="10" />
                                <Path Data="{Binding DownFraction, Converter={StaticResource GaugeArc}}"
                                      Stroke="{StaticResource CriticalBrush}"
                                      StrokeThickness="10"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round" />
                                <TextBlock Text="{Binding DownCount}"
                                           FontSize="22"
                                           FontFamily="{StaticResource DisplayFont}"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Grid>
                        </Viewbox>
                        <TextBlock Text="Down" HorizontalAlignment="Center" Margin="0,8,0,0" Style="{StaticResource SubtleTextStyle}" />
                    </StackPanel>
                    </Button>

                    <Button Grid.Column="2" Style="{StaticResource WidgetCountButtonStyle}" Command="{Binding OpenMaintenanceCommand}">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Viewbox Width="70" Height="70">
                            <Grid Width="100" Height="100">
                                <Ellipse Width="80"
                                         Height="80"
                                         Margin="10"
                                         Stroke="{StaticResource BorderBrush}"
                                         StrokeThickness="10" />
                                <Path Data="{Binding MaintenanceFraction, Converter={StaticResource GaugeArc}}"
                                      Stroke="{StaticResource MaintenanceBrush}"
                                      StrokeThickness="10"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round" />
                                <TextBlock Text="{Binding MaintenanceCount}"
                                           FontSize="22"
                                           FontFamily="{StaticResource DisplayFont}"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Grid>
                        </Viewbox>
                        <TextBlock Text="Maintenance" HorizontalAlignment="Center" Margin="0,8,0,0" Style="{StaticResource SubtleTextStyle}" />
                    </StackPanel>
                    </Button>

                    <Button Grid.Column="3" Style="{StaticResource WidgetCountButtonStyle}" Command="{Binding OpenDisabledCommand}">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Viewbox Width="70" Height="70">
                            <Grid Width="100" Height="100">
                                <Ellipse Width="80"
                                         Height="80"
                                         Margin="10"
                                         Stroke="{StaticResource BorderBrush}"
                                         StrokeThickness="10" />
                                <Path Data="{Binding DisabledFraction, Converter={StaticResource GaugeArc}}"
                                      Stroke="{StaticResource TextSecondaryBrush}"
                                      StrokeThickness="10"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round" />
                                <TextBlock Text="{Binding DisabledCount}"
                                           FontSize="22"
                                           FontFamily="{StaticResource DisplayFont}"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Grid>
                        </Viewbox>
                        <TextBlock Text="Disabled" HorizontalAlignment="Center" Margin="0,8,0,0" Style="{StaticResource SubtleTextStyle}" />
                    </StackPanel>
                    </Button>
                </Grid>

                <TextBlock Grid.Row="1"
                           Text="Loading…"
                           HorizontalAlignment="Center"
                           Margin="0,12,0,0"
                           Style="{StaticResource SubtleTextStyle}"
                           Visibility="{Binding LoadState.IsLoading, Converter={StaticResource BoolToVisibility}}" />

                <TextBlock Grid.Row="1"
                           Text="No devices."
                           HorizontalAlignment="Center"
                           Margin="0,12,0,0"
                           Style="{StaticResource SubtleTextStyle}"
                           Visibility="{Binding LoadState.IsEmpty, Converter={StaticResource BoolToVisibility}}" />

                <TextBlock Grid.Row="1"
                           HorizontalAlignment="Center"
                           Margin="0,12,0,0"
                           Style="{StaticResource SubtleTextStyle}"
                           Visibility="{Binding LoadState.HasVisibleItems, Converter={StaticResource BoolToVisibility}}">
                    <Run Text="{Binding TotalText, Mode=OneWay}" />
                </TextBlock>
            </Grid>
        </DataTemplate>

        <!-- ======================== Wireless widget body (#55) ======================== -->
        <!-- The fleet's client total, then one line per wireless controller:
             state dot, name, APs, clients. A line opens the controller's
             Device Details on its Wireless section. -->
        <DataTemplate DataType="{x:Type vm:WirelessWidgetViewModel}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- The fleet's clients, then one row per controller in the shared row style (#212). -->
                <Grid Grid.Row="0" Margin="8,0,8,6" Visibility="{Binding HasControllers, Converter={StaticResource BoolToVisibility}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{Binding TotalClientsText}" FontSize="22" FontFamily="{StaticResource DisplayFont}" FontWeight="Bold" VerticalAlignment="Bottom" />
                    <TextBlock Grid.Column="1" VerticalAlignment="Bottom" Margin="6,0,0,3" Style="{StaticResource SubtleTextStyle}">
                        <Run Text="clients ·" /> <Run Text="{Binding ControllersText, Mode=OneWay}" />
                    </TextBlock>
                </Grid>

                <ScrollViewer Grid.Row="1"
                              VerticalScrollBarVisibility="Auto"
                              Visibility="{Binding HasControllers, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel Margin="-2,0,-2,0">
                        <Grid Margin="8,0,8,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="56" />
                                <ColumnDefinition Width="70" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Controller" Style="{StaticResource WidgetHeadingStyle}" />
                            <TextBlock Grid.Column="1" Text="APs" TextAlignment="Right" Style="{StaticResource WidgetHeadingStyle}" />
                            <TextBlock Grid.Column="2" Text="Clients" TextAlignment="Right" Style="{StaticResource WidgetHeadingStyle}" />
                        </Grid>
                        <ItemsControl ItemsSource="{Binding Controllers}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource WidgetRowButtonStyle}"
                                            Command="{Binding DataContext.OpenDeviceCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}"
                                            ToolTip="{Binding ToolTip}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="56" />
                                                <ColumnDefinition Width="70" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Orientation="Horizontal">
                                                <Ellipse Style="{StaticResource WidgetDotStyle}" Fill="{Binding Severity, Converter={StaticResource SeverityToBrush}}" />
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="1"
                                                       Text="Down"
                                                       Foreground="{StaticResource CriticalBrush}"
                                                       FontSize="11"
                                                       FontWeight="SemiBold"
                                                       Margin="8,0,0,0"
                                                       VerticalAlignment="Center"
                                                       Visibility="{Binding IsDown, Converter={StaticResource BoolToVisibility}}" />
                                            <TextBlock Grid.Column="2" Text="{Binding ApText}" TextAlignment="Right" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="3" Text="{Binding ClientsText}" TextAlignment="Right" VerticalAlignment="Center" />
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>

                <TextBlock Grid.Row="1"
                           Text="Loading…"
                           Style="{StaticResource WidgetStateTextStyle}"
                           Visibility="{Binding ShowLoading, Converter={StaticResource BoolToVisibility}}" />

                <TextBlock Grid.Row="1"
                           Text="No devices report wireless data."
                           Style="{StaticResource WidgetStateTextStyle}"
                           Visibility="{Binding ShowEmptyMessage, Converter={StaticResource BoolToVisibility}}" />

                <!-- Errors at the foot, as on every widget - the last data stays visible. -->
                <TextBlock Grid.Row="2"
                           Text="{Binding ErrorMessage}"
                           Margin="12,0,12,6"
                           FontSize="11"
                           TextWrapping="Wrap"
                           Foreground="{StaticResource CriticalBrush}"
                           Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}" />
            </Grid>
        </DataTemplate>

        <!-- ======================== Recently viewed widget body ======================== -->
        <!-- Same data as the Devices tab's own recently-viewed strip, as rows in
             the shared style (#212): status dot, name, hardware and location,
             and when it was opened. -->
        <DataTemplate DataType="{x:Type vm:RecentlyViewedWidgetViewModel}">
            <Grid>
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              Visibility="{Binding HasDevices, Converter={StaticResource BoolToVisibility}}">
                    <ItemsControl ItemsSource="{Binding Devices}" Margin="-2,0,-2,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource WidgetRowButtonStyle}" Command="{Binding OpenCommand}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="0,0,8,0">
                                            <Ellipse Style="{StaticResource WidgetDotStyle}"
                                                     Fill="{Binding State, Converter={StaticResource DeviceStateToBrush}}"
                                                     Visibility="{Binding HasState, Converter={StaticResource BoolToVisibility}}" />
                                            <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <TextBlock Grid.Row="1"
                                                   Text="{Binding Subtitle}"
                                                   Style="{StaticResource WidgetSubtitleStyle}"
                                                   Visibility="{Binding HasSubtitle, Converter={StaticResource BoolToVisibility}}" />
                                        <TextBlock Grid.Column="1" Grid.RowSpan="2" Text="{Binding ViewedText}" VerticalAlignment="Center" Style="{StaticResource SubtleTextStyle}" />
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <TextBlock Text="No devices viewed yet. Devices you open appear here."
                           Style="{StaticResource WidgetStateTextStyle}"
                           Visibility="{Binding HasDevices, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}" />
            </Grid>
        </DataTemplate>

        <!-- ======================== Top interfaces / errors / devices body ======================== -->
        <!-- One template for all three (#199-#201): the rows - device, port, the
             two numbers and a bar - under headings that double as the ranking
             control. The count and (errors) the eye are in the title bar - see
             the TopWidgetHeader template below. -->
        <DataTemplate DataType="{x:Type vm:TopWidgetViewModel}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="1">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  Visibility="{Binding HasRows, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel Margin="6,0,6,6">
                            <!-- Column headings, lined up with the rows' numbers. In
                                 and Out are the ranking control: click one to rank by
                                 it, click it again for Total (both lit). -->
                            <Grid Margin="8,0,8,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="78" />
                                    <ColumnDefinition Width="78" />
                                </Grid.ColumnDefinitions>
                                <Grid.Resources>
                                    <Style x:Key="TopHeadingButton" TargetType="Button">
                                        <Setter Property="Cursor" Value="Hand" />
                                        <Setter Property="HorizontalAlignment" Value="Right" />
                                        <Setter Property="ToolTip" Value="{Binding RankText}" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="Transparent" Padding="4,2,0,2">
                                                        <ContentPresenter />
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </Grid.Resources>

                                <TextBlock Grid.Column="0" Text="{Binding NameHeading}" FontSize="11" VerticalAlignment="Center" Style="{StaticResource SubtleTextStyle}" />

                                <Button Grid.Column="1" Style="{StaticResource TopHeadingButton}" Command="{Binding RankByInCommand}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock x:Name="InHeading" Text="In" FontSize="11" Style="{StaticResource SubtleTextStyle}" />
                                        <TextBlock x:Name="InArrow" Text="&#xE74B;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="9" Margin="3,1,0,0" VerticalAlignment="Center" Visibility="Collapsed" />
                                    </StackPanel>
                                </Button>
                                <Button Grid.Column="2" Style="{StaticResource TopHeadingButton}" Command="{Binding RankByOutCommand}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock x:Name="OutHeading" Text="Out" FontSize="11" Style="{StaticResource SubtleTextStyle}" />
                                        <TextBlock x:Name="OutArrow" Text="&#xE74B;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="9" Margin="3,1,0,0" VerticalAlignment="Center" Visibility="Collapsed" />
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <ItemsControl x:Name="TopRows" ItemsSource="{Binding Rows}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Command="{Binding DataContext.OpenCommand, ElementName=TopRows}"
                                                CommandParameter="{Binding}"
                                                Cursor="Hand"
                                                HorizontalContentAlignment="Stretch"
                                                ToolTip="{Binding Subtitle}">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="RowBorder" Background="Transparent" CornerRadius="6" Padding="8,5">
                                                        <ContentPresenter />
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="RowBorder" Property="Background" Value="{StaticResource SurfaceAltBrush}" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="78" />
                                                    <ColumnDefinition Width="78" />
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>

                                                <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="0,0,8,0">
                                                    <Ellipse Width="7"
                                                             Height="7"
                                                             Margin="0,1,7,0"
                                                             VerticalAlignment="Center"
                                                             Fill="{Binding DeviceState, Converter={StaticResource DeviceStateToBrush}}"
                                                             Visibility="{Binding HasDeviceState, Converter={StaticResource BoolToVisibility}}" />
                                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>

                                                <TextBlock x:Name="InValue" Grid.Column="1" Text="{Binding InText}" TextAlignment="Right" />
                                                <TextBlock x:Name="OutValue" Grid.Column="2" Text="{Binding OutText}" TextAlignment="Right" />

                                                <TextBlock Grid.Row="1"
                                                           Grid.Column="0"
                                                           Text="{Binding Subtitle}"
                                                           FontSize="11"
                                                           Margin="14,1,8,0"
                                                           TextTrimming="CharacterEllipsis"
                                                           Style="{StaticResource SubtleTextStyle}"
                                                           Visibility="{Binding HasSubtitle, Converter={StaticResource BoolToVisibility}}" />

                                                <!-- How full: a port against its speed, a device against the top row. -->
                                                <Border Grid.Row="1"
                                                        Grid.Column="1"
                                                        Grid.ColumnSpan="2"
                                                        Height="4"
                                                        Margin="12,6,0,0"
                                                        VerticalAlignment="Center"
                                                        CornerRadius="2"
                                                        Background="{StaticResource BorderBrush}">
                                                    <Border x:Name="Bar"
                                                            HorizontalAlignment="Stretch"
                                                            CornerRadius="2"
                                                            Background="{StaticResource AccentBrush}"
                                                            RenderTransformOrigin="0,0.5">
                                                        <Border.RenderTransform>
                                                            <ScaleTransform ScaleX="{Binding BarFraction}" />
                                                        </Border.RenderTransform>
                                                    </Border>
                                                </Border>
                                            </Grid>
                                        </Button>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsWarning}" Value="True">
                                                <Setter TargetName="InValue" Property="Foreground" Value="{StaticResource WarningBrush}" />
                                                <Setter TargetName="OutValue" Property="Foreground" Value="{StaticResource WarningBrush}" />
                                                <Setter TargetName="Bar" Property="Background" Value="{StaticResource WarningBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsCritical}" Value="True">
                                                <Setter TargetName="InValue" Property="Foreground" Value="{StaticResource CriticalBrush}" />
                                                <Setter TargetName="OutValue" Property="Foreground" Value="{StaticResource CriticalBrush}" />
                                                <Setter TargetName="Bar" Property="Background" Value="{StaticResource CriticalBrush}" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>

                    <TextBlock Text="Loading…"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Style="{StaticResource SubtleTextStyle}"
                               Visibility="{Binding ShowLoading, Converter={StaticResource BoolToVisibility}}" />
                    <TextBlock Text="{Binding EmptyText}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Style="{StaticResource SubtleTextStyle}"
                               Visibility="{Binding ShowEmptyMessage, Converter={StaticResource BoolToVisibility}}" />
                </Grid>

                <StackPanel Grid.Row="2" Margin="12,0,12,6">
                    <TextBlock Text="{Binding ErrorMessage}"
                               TextWrapping="Wrap"
                               FontSize="11"
                               Foreground="{StaticResource CriticalBrush}"
                               Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}" />
                    <TextBlock Text="{Binding FootnoteText}"
                               TextWrapping="Wrap"
                               FontSize="11"
                               Style="{StaticResource SubtleTextStyle}"
                               Visibility="{Binding HasFootnote, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsInRanked}" Value="True">
                    <Setter TargetName="InHeading" Property="Foreground" Value="{StaticResource AccentBrush}" />
                    <Setter TargetName="InArrow" Property="Foreground" Value="{StaticResource AccentBrush}" />
                    <Setter TargetName="InArrow" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsOutRanked}" Value="True">
                    <Setter TargetName="OutHeading" Property="Foreground" Value="{StaticResource AccentBrush}" />
                    <Setter TargetName="OutArrow" Property="Foreground" Value="{StaticResource AccentBrush}" />
                    <Setter TargetName="OutArrow" Property="Visibility" Value="Visible" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- A Top widget's title-bar controls: "Top 3 ▾" and, for errors, the
             eye that hides ports with no errors. -->
        <DataTemplate DataType="{x:Type vm:TopWidgetHeader}">
            <StackPanel Orientation="Horizontal">
                <ComboBox ItemsSource="{Binding CountChoices}"
                          SelectedItem="{Binding Widget.SelectedCount}"
                          ItemStringFormat="Top {0}"
                          FontSize="12"
                          MinWidth="72"
                          Height="28"
                          VerticalContentAlignment="Center"
                          ToolTip="How many to show" />
                <ToggleButton x:Name="QuietToggle"
                              IsChecked="{Binding Widget.HideQuiet}"
                              Width="28"
                              Height="28"
                              Margin="4,0,0,0"
                              Cursor="Hand"
                              ToolTip="Hiding ports with no errors - click to show them"
                              Visibility="{Binding Widget.OffersHideQuiet, Converter={StaticResource BoolToVisibility}}">
                    <ToggleButton.Template>
                        <ControlTemplate TargetType="ToggleButton">
                            <Border x:Name="Back" Background="Transparent" CornerRadius="6">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Back" Property="Background" Value="{StaticResource SurfaceAltBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </ToggleButton.Template>
                    <TextBlock x:Name="QuietGlyph"
                               Text="&#xED1A;"
                               FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                               FontSize="13"
                               Foreground="{StaticResource TextSecondaryBrush}" />
                </ToggleButton>
            </StackPanel>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Widget.HideQuiet}" Value="False">
                    <Setter TargetName="QuietGlyph" Property="Text" Value="&#xE7B3;" />
                    <Setter TargetName="QuietToggle" Property="ToolTip" Value="Showing every port - click to hide ports with no errors" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- ======================== Event log and Graylog widget body ======================== -->
        <!-- Two-line rows (#202, #203): who it's about with a tag (the event
             type, or Graylog's level with its dot), the message underneath and
             the time on the right. Entries new since the last refresh are
             tinted for a few seconds. The filters are in the title bar - see
             the LogFeedHeader template below. -->
        <DataTemplate DataType="{x:Type vm:LogFeedWidgetViewModel}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBox Grid.Row="0"
                         Style="{StaticResource SearchTextBoxStyle}"
                         Tag="{Binding SearchHint}"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=500}"
                         ToolTip="{Binding SearchHint}"
                         Margin="12,0,12,6"
                         Visibility="{Binding IsSearchOpen, Converter={StaticResource BoolToVisibility}}" />

                <Grid Grid.Row="1">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  Visibility="{Binding HasRows, Converter={StaticResource BoolToVisibility}}">
                        <ItemsControl ItemsSource="{Binding Rows}" Margin="6,0,6,6">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border x:Name="NewTint" CornerRadius="6" Background="Transparent">
                                        <Button Style="{StaticResource WidgetRowButtonStyle}"
                                                Command="{Binding DataContext.OpenCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}"
                                                ToolTip="{Binding FullTimeText}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="0,0,8,0">
                                                    <Ellipse Style="{StaticResource WidgetDotStyle}"
                                                             Fill="{Binding Severity, Converter={StaticResource SeverityToBrush}}"
                                                             Visibility="{Binding HasSeverity, Converter={StaticResource BoolToVisibility}}" />
                                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                    <Border Background="{StaticResource SurfaceAltBrush}"
                                                            CornerRadius="4"
                                                            Padding="5,0"
                                                            Margin="6,0,0,0"
                                                            VerticalAlignment="Center"
                                                            Visibility="{Binding HasTag, Converter={StaticResource BoolToVisibility}}">
                                                        <TextBlock Text="{Binding Tag}" FontSize="11" Style="{StaticResource SubtleTextStyle}" />
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding Message}" Style="{StaticResource WidgetSubtitleStyle}" Margin="0,1,8,0" />
                                                <TextBlock Grid.Column="1" Grid.RowSpan="2" Text="{Binding TimeText}" TextAlignment="Right" VerticalAlignment="Center" Style="{StaticResource SubtleTextStyle}" />
                                            </Grid>
                                        </Button>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsNew}" Value="True">
                                            <Setter TargetName="NewTint" Property="Background" Value="{StaticResource AccentSubtleBrush}" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <TextBlock Text="Loading…"
                               Style="{StaticResource WidgetStateTextStyle}"
                               Visibility="{Binding ShowLoading, Converter={StaticResource BoolToVisibility}}" />

                    <TextBlock Text="{Binding EmptyText}"
                               Style="{StaticResource WidgetStateTextStyle}"
                               Visibility="{Binding ShowEmptyMessage, Converter={StaticResource BoolToVisibility}}" />
                </Grid>

                <TextBlock Grid.Row="2"
                           Text="{Binding ErrorMessage}"
                           TextWrapping="Wrap"
                           FontSize="11"
                           Margin="12,0,12,6"
                           Foreground="{StaticResource CriticalBrush}"
                           Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}" />
            </Grid>
        </DataTemplate>

        <!-- A log feed widget's title-bar controls: the Event log's type, or
             Graylog's stream and time range; the search magnifier; the count. -->
        <DataTemplate DataType="{x:Type vm:LogFeedHeader}">
            <StackPanel Orientation="Horizontal">
                <ComboBox ItemsSource="{Binding Widget.TypeChoices}"
                          SelectedItem="{Binding Widget.SelectedType}"
                          DisplayMemberPath="Label"
                          FontSize="12"
                          MinWidth="96"
                          MaxWidth="150"
                          Height="28"
                          Margin="0,0,4,0"
                          VerticalContentAlignment="Center"
                          ToolTip="Only this type of event"
                          Visibility="{Binding Widget.OffersTypeFilter, Converter={StaticResource BoolToVisibility}}" />
                <ComboBox ItemsSource="{Binding Widget.StreamChoices}"
                          SelectedItem="{Binding Widget.SelectedStream}"
                          DisplayMemberPath="Label"
                          FontSize="12"
                          MinWidth="96"
                          MaxWidth="150"
                          Height="28"
                          Margin="0,0,4,0"
                          VerticalContentAlignment="Center"
                          ToolTip="Graylog stream"
                          Visibility="{Binding Widget.OffersStream, Converter={StaticResource BoolToVisibility}}" />
                <ComboBox ItemsSource="{Binding Widget.Ranges}"
                          SelectedItem="{Binding Widget.SelectedRange}"
                          DisplayMemberPath="Label"
                          FontSize="12"
                          MinWidth="72"
                          Height="28"
                          Margin="0,0,4,0"
                          VerticalContentAlignment="Center"
                          ToolTip="How far back"
                          Visibility="{Binding Widget.OffersStream, Converter={StaticResource BoolToVisibility}}" />
                <ToggleButton IsChecked="{Binding Widget.IsSearchOpen}"
                              Width="28"
                              Height="28"
                              Margin="0,0,4,0"
                              Cursor="Hand"
                              ToolTip="Search">
                    <ToggleButton.Template>
                        <ControlTemplate TargetType="ToggleButton">
                            <Border x:Name="Back" Background="Transparent" CornerRadius="6">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Back" Property="Background" Value="{StaticResource SurfaceAltBrush}" />
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Back" Property="Background" Value="{StaticResource AccentSubtleBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </ToggleButton.Template>
                    <TextBlock Text="&#xE721;"
                               FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                               FontSize="13"
                               Foreground="{StaticResource TextSecondaryBrush}" />
                </ToggleButton>
                <ComboBox ItemsSource="{Binding CountChoices}"
                          SelectedItem="{Binding Widget.SelectedCount}"
                          FontSize="12"
                          MinWidth="56"
                          Height="28"
                          VerticalContentAlignment="Center"
                          ToolTip="How many to show" />
            </StackPanel>
        </DataTemplate>

        <!-- ======================== Unsupported widget body ======================== -->
        <!-- A widget type from DashyNMS Mobile or a newer version (#196): say
             so plainly. Its settings are kept, so it still works where it was made. -->
        <DataTemplate DataType="{x:Type vm:UnsupportedWidgetViewModel}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="16">
                <TextBlock Text="{Binding Message}"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           Style="{StaticResource SubtleTextStyle}" />
                <TextBlock Text="{Binding WidgetType, StringFormat='Widget type: {0}'}"
                           TextAlignment="Center"
                           Margin="0,6,0,0"
                           FontSize="11"
                           Style="{StaticResource SubtleTextStyle}" />
            </StackPanel>
        </DataTemplate>

        <!-- ======================== Pinned devices widget body ======================== -->
        <!-- Same data as the Devices tab's own pinned/starred devices, as rows in
             the shared style (#212), with Unpin on hover so a device can be
             un-favourited from here too. -->
        <DataTemplate DataType="{x:Type vm:PinnedDevicesWidgetViewModel}">
            <Grid>
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              Visibility="{Binding HasDevices, Converter={StaticResource BoolToVisibility}}">
                    <ItemsControl ItemsSource="{Binding Devices}" Margin="-2,0,-2,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <!-- The row, with Unpin over its right-hand end, shown on hover. -->
                                <Grid x:Name="PinnedRow" Background="Transparent">
                                    <Button Style="{StaticResource WidgetRowButtonStyle}" Command="{Binding OpenCommand}">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,32,0">
                                                <Ellipse Style="{StaticResource WidgetDotStyle}"
                                                         Fill="{Binding State, Converter={StaticResource DeviceStateToBrush}}"
                                                         Visibility="{Binding HasState, Converter={StaticResource BoolToVisibility}}" />
                                                <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <TextBlock Grid.Row="1"
                                                       Text="{Binding Subtitle}"
                                                       Style="{StaticResource WidgetSubtitleStyle}"
                                                       Margin="14,1,32,0"
                                                       Visibility="{Binding HasSubtitle, Converter={StaticResource BoolToVisibility}}" />
                                        </Grid>
                                    </Button>
                                    <Button x:Name="UnpinButton"
                                            Command="{Binding UnpinCommand}"
                                            Style="{StaticResource IconButtonStyle}"
                                            Width="28"
                                            Height="28"
                                            Margin="0,0,4,0"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center"
                                            Visibility="Hidden"
                                            ToolTip="Unpin this device">
                                        <TextBlock Text="&#xE77A;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12" />
                                    </Button>
                                </Grid>
                                <DataTemplate.Triggers>
                                    <Trigger SourceName="PinnedRow" Property="IsMouseOver" Value="True">
                                        <Setter TargetName="UnpinButton" Property="Visibility" Value="Visible" />
                                    </Trigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <TextBlock Text="No pinned devices yet. Star a device on the Devices tab to pin it."
                           Style="{StaticResource WidgetStateTextStyle}"
                           Visibility="{Binding HasDevices, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}" />
            </Grid>
        </DataTemplate>

        <!-- ======================== Graph widget body ======================== -->
        <!-- A configurable per-device graph (issue #12) - there is no
             fleet-wide graph endpoint, so several of these side by side is
             how a fleet-wide view gets built. The toolbar (device/graph/
             time-range pickers) only shows while editing, mirroring the
             Sensors widget's own swap between "manage" and its own picker;
             the rendered graph itself stays visible underneath in both
             states, so changing the time range or graph gives instant
             feedback rather than requiring a save-and-close round trip. -->
        <DataTemplate DataType="{x:Type vm:GraphWidgetViewModel}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Which device and port a port graph is of (#285). -->
                <TextBlock Grid.Row="0"
                           Style="{StaticResource SubtleTextStyle}"
                           FontSize="11"
                           Margin="2,0,0,4"
                           TextTrimming="CharacterEllipsis"
                           Visibility="{Binding PortLabel, Converter={StaticResource NullToVisibility}}">
                    <Run Text="{Binding SelectedDeviceName, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding PortLabel, Mode=OneWay}" />
                </TextBlock>

                <Grid Grid.Row="1">
                    <!-- Click to open this graph full size in the device's
                         Device Details (issue #161). A chrome-less Button
                         rather than a click handler on the image, so it's a
                         plain command binding; only there once a graph has
                         actually rendered. -->
                    <Button Command="{Binding OpenGraphCommand}"
                            Cursor="Hand"
                            ToolTip="Open in Device Details"
                            Focusable="False"
                            Visibility="{Binding Svg, Converter={StaticResource NullToVisibility}}">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="Transparent">
                                    <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                        <svgc:SvgViewbox SvgSource="{Binding Svg}"
                                         Stretch="Uniform"
                                         HorizontalAlignment="Stretch"
                                         VerticalAlignment="Stretch" />
                    </Button>

                    <TextBlock Text="Loading…"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               IsHitTestVisible="False"
                               Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}"
                               Style="{StaticResource SubtleTextStyle}" />

                    <TextBlock Text="{Binding ErrorMessage}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               TextWrapping="Wrap"
                               MaxWidth="240"
                               TextAlignment="Center"
                               IsHitTestVisible="False"
                               Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}"
                               Style="{StaticResource SubtleTextStyle}" />

                    <TextBlock Text="No graph yet. Choose a device and graph from ⋯, Set up…"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               TextWrapping="Wrap"
                               MaxWidth="240"
                               TextAlignment="Center"
                               IsHitTestVisible="False"
                               Visibility="{Binding IsConfigured, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}"
                               Style="{StaticResource SubtleTextStyle}" />
                </Grid>
            </Grid>
        </DataTemplate>

        <!-- ======================== Widget chrome ======================== -->
        <!-- Shared by every widget type: title bar (drag handle + rename box +
             remove button, the last two only while editing), body, and a
             resize grip in edit mode. Position/size are committed once a drag
             finishes (see DashboardView.xaml.cs), not on every pixel. -->
        <DataTemplate x:Key="WidgetTemplate" DataType="{x:Type vm:DashboardWidgetViewModel}">
            <!-- The outer Grid keeps the exact cell footprint (ColumnSpan/RowSpan
                 * CellSize) that Canvas.Left/Top and every drag/resize/reflow
                 calculation in DashboardView.xaml.cs assumes - two widgets in
                 adjacent cells butt up against each other with zero gap. The
                 visible chrome lives on the inner Border instead, inset by
                 Margin so adjacent widgets still show a gutter between them
                 without changing where either widget's cell actually is. -->
            <Grid Width="{Binding ColumnSpan, Converter={StaticResource GridUnitToPixels}}"
                  Height="{Binding RowSpan, Converter={StaticResource GridUnitToPixels}}"
                  PreviewMouseLeftButtonDown="OnWidgetMouseDown">
            <Border Margin="6"
                    Background="{StaticResource SurfaceBrush}"
                    CornerRadius="6">
                <!-- Outlined in the accent while selected, set up, or just added (#204, #274, #275). -->
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
                        <Setter Property="BorderThickness" Value="1" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                <Setter Property="BorderThickness" Value="2" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsEditingWidget}" Value="True">
                                <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                <Setter Property="BorderThickness" Value="2" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsHighlighted}" Value="True">
                                <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                <Setter Property="BorderThickness" Value="2" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- In edit mode, a dashed outline says it can be moved and resized (#274). -->
                    <Rectangle Grid.RowSpan="2"
                               RadiusX="6"
                               RadiusY="6"
                               Stroke="{StaticResource TextSecondaryBrush}"
                               StrokeThickness="1"
                               StrokeDashArray="4 3"
                               Opacity="0.5"
                               IsHitTestVisible="False"
                               Visibility="{Binding DataContext.IsEditMode, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource BoolToVisibility}}" />

                    <!-- Header: in edit mode a Thumb fills the row, so any blank area
                         drags the widget; the title and buttons sit on top. -->
                    <Grid Grid.Row="0" MinHeight="44">
                        <Thumb Background="Transparent"
                               Cursor="SizeAll"
                               DragStarted="OnHeaderDragStarted"
                               DragDelta="OnHeaderDragDelta"
                               DragCompleted="OnHeaderDragCompleted"
                               Visibility="{Binding DataContext.IsEditMode, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource BoolToVisibility}}">
                            <Thumb.Template>
                                <ControlTemplate TargetType="Thumb">
                                    <Border Background="{TemplateBinding Background}" />
                                </ControlTemplate>
                            </Thumb.Template>
                        </Thumb>

                        <Grid Margin="10,6,8,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- The grip, in edit mode: drag the title bar to move it. -->
                            <TextBlock Grid.Column="0"
                                       Text="&#xE76F;"
                                       FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                       FontSize="12"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       VerticalAlignment="Center"
                                       Margin="0,0,8,0"
                                       IsHitTestVisible="False"
                                       Visibility="{Binding DataContext.IsEditMode, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource BoolToVisibility}}" />

                            <TextBlock Grid.Column="1"
                                       Text="{Binding Title}"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"
                                       IsHitTestVisible="False"
                                       Visibility="{Binding IsRenaming, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}" />
                            <!-- ⋯ › Rename, or F2: Enter or Esc, or clicking away, finishes. -->
                            <TextBox Grid.Column="1"
                                     Text="{Binding Title, UpdateSourceTrigger=LostFocus}"
                                     VerticalAlignment="Center"
                                     MinHeight="30"
                                     Margin="0,0,8,0"
                                     IsVisibleChanged="OnRenameBoxVisibleChanged"
                                     KeyDown="OnRenameBoxKeyDown"
                                     LostKeyboardFocus="OnRenameBoxLostFocus"
                                     Visibility="{Binding IsRenaming, Converter={StaticResource BoolToVisibility}}" />

                            <!-- Set up in the panel beside the dashboard (#275). -->
                            <Border Grid.Column="2"
                                    CornerRadius="9"
                                    Padding="8,1"
                                    Margin="0,0,6,0"
                                    VerticalAlignment="Center"
                                    Background="{DynamicResource AccentSubtleBrush}"
                                    Visibility="{Binding IsEditingWidget, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="Live preview" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" />
                            </Border>

                            <!-- Widget-specific controls (a Top widget's count and eye), templated by type. -->
                            <ContentControl Grid.Column="3"
                                            Content="{Binding HeaderOptions}"
                                            Focusable="False"
                                            VerticalAlignment="Center"
                                            Margin="0,0,4,0"
                                            Visibility="{Binding IsRenaming, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}" />

                            <!-- ⋯ (#274): Set up…, Rename, Size, Duplicate, Remove - in or out of edit mode. -->
                            <Button x:Name="MoreButton"
                                    Grid.Column="4"
                                    Style="{StaticResource IconButtonStyle}"
                                    ToolTip="More"
                                    AutomationProperties.Name="{Binding Title, StringFormat=More for {0}}"
                                    Opacity="0.55"
                                    Click="OnMoreClick">
                                <TextBlock Text="&#xE712;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13" />
                                <Button.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Set up…" Command="{Binding SetUpCommand}">
                                            <MenuItem.Icon><TextBlock Text="&#xE713;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" /></MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Header="Rename" InputGestureText="F2" Command="{Binding RenameCommand}">
                                            <MenuItem.Icon><TextBlock Text="&#xE8AC;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" /></MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Header="Size">
                                            <MenuItem.Icon><TextBlock Text="&#xE740;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" /></MenuItem.Icon>
                                            <MenuItem Header="Small" Command="{Binding SetSizeCommand}" CommandParameter="Small" />
                                            <MenuItem Header="Medium" Command="{Binding SetSizeCommand}" CommandParameter="Medium" />
                                            <MenuItem Header="Large" Command="{Binding SetSizeCommand}" CommandParameter="Large" />
                                            <MenuItem Header="Wide" Command="{Binding SetSizeCommand}" CommandParameter="Wide" />
                                        </MenuItem>
                                        <MenuItem Header="Duplicate"
                                                  InputGestureText="Ctrl+D"
                                                  Command="{Binding DuplicateCommand}"
                                                  Visibility="{Binding AllowsSeveral, Converter={StaticResource BoolToVisibility}}">
                                            <MenuItem.Icon><TextBlock Text="&#xE8C8;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" /></MenuItem.Icon>
                                        </MenuItem>
                                        <Separator />
                                        <MenuItem Header="Remove" InputGestureText="Del" Command="{Binding RemoveCommand}">
                                            <MenuItem.Icon><TextBlock Text="&#xE74D;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" /></MenuItem.Icon>
                                        </MenuItem>
                                    </ContextMenu>
                                </Button.ContextMenu>
                            </Button>
                        </Grid>
                    </Grid>

                    <Border Grid.Row="1"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="0,1,0,0"
                            Padding="8">
                        <ContentControl Content="{Binding}" Focusable="False" />
                    </Border>

                    <!-- Resize grip, bottom-right corner, in edit mode. -->
                    <Thumb Grid.Row="1"
                           Width="16"
                           Height="16"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Bottom"
                           Cursor="SizeNWSE"
                           DragStarted="OnResizeDragStarted"
                           DragDelta="OnResizeDragDelta"
                           DragCompleted="OnResizeDragCompleted"
                           Visibility="{Binding DataContext.IsEditMode, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource BoolToVisibility}}">
                        <Thumb.Template>
                            <ControlTemplate TargetType="Thumb">
                                <Path Data="M 14,2 L 14,14 L 2,14"
                                      Stroke="{StaticResource TextSecondaryBrush}"
                                      StrokeThickness="2" />
                            </ControlTemplate>
                        </Thumb.Template>
                    </Thumb>
                </Grid>
            </Border>
            </Grid>
            <DataTemplate.Triggers>
                <!-- The ⋯ is quiet until the widget's hovered, or in edit mode. -->
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="MoreButton" Property="Opacity" Value="1" />
                </Trigger>
                <DataTrigger Binding="{Binding DataContext.IsEditMode, RelativeSource={RelativeSource AncestorType=ItemsControl}}" Value="True">
                    <Setter TargetName="MoreButton" Property="Opacity" Value="1" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

    </UserControl.Resources>

    <Grid Background="{StaticResource BackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ======================== Toolbar ======================== -->
        <!-- Not editing: one glyph to start editing (#274), as on the app's other toolbars. -->
        <Border Grid.Row="0"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="18,8"
                Visibility="{Binding IsEditMode, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource IconButtonStyle}"
                        ToolTip="Edit dashboard"
                        AutomationProperties.Name="Edit dashboard"
                        Command="{Binding EditCommand}">
                    <TextBlock Text="&#xE70F;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14" />
                </Button>
            </StackPanel>
        </Border>

        <!-- Editing (#274): the one edit bar - Undo, Tidy up and Add widgets as
             glyphs, then Cancel and Done. Add widgets lives only here (#277). -->
        <Border Grid.Row="0"
                Background="{DynamicResource AccentSubtleBrush}"
                BorderBrush="{DynamicResource AccentBrush}"
                BorderThickness="0,0,0,1"
                Padding="18,8"
                Visibility="{Binding IsEditMode, Converter={StaticResource BoolToVisibility}}">
            <DockPanel LastChildFill="False">
                <TextBlock DockPanel.Dock="Left" Text="&#xE70F;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,10,0" />
                <TextBlock DockPanel.Dock="Left" Text="Editing dashboard" FontWeight="SemiBold" VerticalAlignment="Center" />
                <TextBlock DockPanel.Dock="Left"
                           Style="{StaticResource SubtleTextStyle}"
                           VerticalAlignment="Center"
                           Margin="12,0,0,0"
                           Text="Drag a title bar to move it, a corner to resize. Arrows move the selected widget, Shift + arrows resize it." />

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Style="{StaticResource IconButtonStyle}" ToolTip="{Binding UndoToolTip}" ToolTipService.ShowOnDisabled="True" AutomationProperties.Name="Undo" Command="{Binding UndoCommand}" Margin="0,0,2,0">
                        <TextBlock Text="&#xE7A7;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14" />
                    </Button>
                    <Button Style="{StaticResource IconButtonStyle}" ToolTip="Tidy up - close the gaps" AutomationProperties.Name="Tidy up" Command="{Binding TidyUpCommand}" Margin="0,0,2,0">
                        <TextBlock Text="&#xF0E2;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14" />
                    </Button>
                    <Button Style="{StaticResource IconButtonStyle}" ToolTip="Add widgets" AutomationProperties.Name="Add widgets" Command="{Binding AddWidgetCommand}">
                        <TextBlock Text="&#xE710;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14" />
                    </Button>
                    <Rectangle Width="1" Height="22" Fill="{StaticResource BorderBrush}" Margin="10,0" />
                    <Button Content="Cancel"
                            Command="{Binding CancelCommand}"
                            ToolTip="Put the dashboard back as it was"
                            Padding="12,5"
                            Margin="0,0,8,0" />
                    <Button Content="Done" Command="{Binding DoneCommand}" Style="{StaticResource PrimaryButtonStyle}" Padding="14,5" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ======================== Error banner ======================== -->
        <Border Grid.Row="1"
                Background="#33DA3633"
                BorderBrush="{StaticResource CriticalBrush}"
                BorderThickness="0,0,0,1"
                Padding="18,10"
                Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap" />
        </Border>

        <!-- ======================== Widget canvas ======================== -->
        <!-- The Canvas is sized to exactly fill the ScrollViewer's own
             viewport (not some arbitrary large fixed size), so a widget can
             always be dragged flush to every edge - X/Y of 0 is the actual
             top-left corner the user sees, not a spot buried under padding. -->
        <Grid Grid.Row="2" Margin="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <ScrollViewer x:Name="CanvasScroll"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto"
                          SizeChanged="OnCanvasSizeChanged">
                <Grid>
                    <!-- The "+ Add widget" space (#277): where the next widget fits. -->
                    <Canvas Visibility="{Binding ShowAddSpace, Converter={StaticResource BoolToVisibility}}">
                        <Button Canvas.Left="{Binding AddSpaceLeft}"
                                Canvas.Top="{Binding AddSpaceTop}"
                                Width="{Binding AddSpaceWidth}"
                                Height="{Binding AddSpaceHeight}"
                                Command="{Binding AddWidgetCommand}"
                                Cursor="Hand"
                                ToolTip="Add widgets here">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Grid Margin="6">
                                        <Rectangle x:Name="Outline"
                                                   RadiusX="6"
                                                   RadiusY="6"
                                                   Stroke="{StaticResource TextSecondaryBrush}"
                                                   StrokeThickness="1.5"
                                                   StrokeDashArray="4 3"
                                                   Fill="Transparent"
                                                   Opacity="0.6" />
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock Text="&#xE710;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{StaticResource TextSecondaryBrush}" />
                                            <TextBlock Text="Add widget" Foreground="{StaticResource TextSecondaryBrush}" />
                                        </StackPanel>
                                    </Grid>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Outline" Property="Stroke" Value="{DynamicResource AccentBrush}" />
                                            <Setter TargetName="Outline" Property="Fill" Value="{DynamicResource AccentSubtleBrush}" />
                                            <Setter TargetName="Outline" Property="Opacity" Value="1" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Canvas>

                    <ItemsControl x:Name="WidgetsHost" ItemsSource="{Binding Widgets}" ItemTemplate="{StaticResource WidgetTemplate}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <Canvas x:Name="WidgetsCanvas" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemContainerStyle>
                            <Style TargetType="ContentPresenter">
                                <Setter Property="Canvas.Left" Value="{Binding Column, Converter={StaticResource GridUnitToPixels}}" />
                                <Setter Property="Canvas.Top" Value="{Binding Row, Converter={StaticResource GridUnitToPixels}}" />
                            </Style>
                        </ItemsControl.ItemContainerStyle>
                    </ItemsControl>

                    <!-- Alignment guides while dragging or resizing (#278) - drawn by the code-behind. -->
                    <Canvas x:Name="GuideLayer" IsHitTestVisible="False" />
                </Grid>
            </ScrollViewer>

            <!-- Turned off with "Don't show again": just say how to start. -->
            <TextBlock Text="Your dashboard is empty. Click the pencil to edit it, then + to add widgets."
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       IsHitTestVisible="False">
                <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource SubtleTextStyle}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding Widgets.Count}" Value="0" />
                                    <Condition Binding="{Binding ShowWelcome}" Value="False" />
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Visibility" Value="Visible" />
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <!-- Welcome (#233): a new user's first view, until the first
                 widget is added or "Don't show again". -->
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          Visibility="{Binding ShowWelcome, Converter={StaticResource BoolToVisibility}}">
                <Border DataContext="{Binding Welcome}"
                        Background="{StaticResource SurfaceBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="26,22"
                        Margin="0,24"
                        MaxWidth="520"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                    <StackPanel>
                        <DockPanel>
                            <views:HeartbeatLogo Width="48" Height="48" Margin="0,0,16,0" />
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Welcome to DashyNMS" Style="{StaticResource HeadingTextStyle}" FontSize="20" />
                                <TextBlock Text="{Binding ServerSummary}" Style="{StaticResource SubtleTextStyle}" TextWrapping="Wrap" Margin="0,2,0,0" />
                            </StackPanel>
                        </DockPanel>

                        <TextBlock Text="Your dashboard is empty. Start with a ready-made one, or pick the widgets you want."
                                   Style="{StaticResource SubtleTextStyle}"
                                   TextWrapping="Wrap"
                                   Margin="0,16,0,12" />

                        <WrapPanel>
                            <Button Command="{Binding UseStarterCommand}" Style="{StaticResource PrimaryButtonStyle}" Padding="12,6" Margin="0,0,8,6">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xF0E2;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <TextBlock Text="Use the starter dashboard" />
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding ChooseWidgetsCommand}" Padding="12,6" Margin="0,0,8,6">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE710;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <TextBlock Text="Choose widgets…" />
                                </StackPanel>
                            </Button>
                        </WrapPanel>
                        <TextBlock Style="{StaticResource SubtleTextStyle}" FontSize="11.5" TextWrapping="Wrap">
                            <Run Text="Starter:" />
                            <Run Text="{Binding StarterContents, Mode=OneWay}" />
                        </TextBlock>

                        <Rectangle Height="1" Fill="{StaticResource BorderBrush}" Margin="0,16,0,12" />
                        <TextBlock Text="Jump in" Style="{StaticResource SubtleTextStyle}" Margin="0,0,0,8" />
                        <WrapPanel>
                            <Button Content="Devices" Command="{Binding OpenTabCommand}" CommandParameter="{x:Static vm:MainTab.Devices}" Padding="10,4" Margin="0,0,6,6" />
                            <Button Content="Alerts" Command="{Binding OpenTabCommand}" CommandParameter="{x:Static vm:MainTab.Alerts}" Padding="10,4" Margin="0,0,6,6" />
                            <Button Content="Network map" Command="{Binding OpenTabCommand}" CommandParameter="{x:Static vm:MainTab.MapsNetwork}" Padding="10,4" Margin="0,0,6,6" />
                            <Button Content="Neighbours" Command="{Binding OpenTabCommand}" CommandParameter="{x:Static vm:MainTab.Neighbours}" Padding="10,4" Margin="0,0,6,6" />
                        </WrapPanel>

                        <Rectangle Height="1" Fill="{StaticResource BorderBrush}" Margin="0,10,0,10" />
                        <DockPanel Margin="0,0,0,4">
                            <TextBlock DockPanel.Dock="Right" Text="{Binding StepsText}" Style="{StaticResource SubtleTextStyle}" />
                            <TextBlock Text="Get set up" Style="{StaticResource SubtleTextStyle}" />
                        </DockPanel>
                        <ItemsControl ItemsSource="{Binding Steps}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="0,4">
                                        <Border x:Name="Tick"
                                                Width="16"
                                                Height="16"
                                                CornerRadius="8"
                                                BorderThickness="1.5"
                                                BorderBrush="{StaticResource TextSecondaryBrush}"
                                                Margin="0,0,10,0"
                                                VerticalAlignment="Center">
                                            <TextBlock x:Name="TickGlyph"
                                                       Text="&#xE73E;"
                                                       FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                       FontSize="9"
                                                       Foreground="White"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       Visibility="Collapsed" />
                                        </Border>
                                        <TextBlock DockPanel.Dock="Right"
                                                   VerticalAlignment="Center"
                                                   Visibility="{Binding ShowAction, Converter={StaticResource BoolToVisibility}}">
                                            <Hyperlink Command="{Binding Action}">
                                                <Run Text="{Binding ActionText, Mode=OneWay}" />
                                            </Hyperlink>
                                        </TextBlock>
                                        <TextBlock x:Name="StepText" Text="{Binding Text}" VerticalAlignment="Center" TextWrapping="Wrap" />
                                    </DockPanel>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsDone}" Value="True">
                                            <Setter TargetName="Tick" Property="Background" Value="{StaticResource OkBrush}" />
                                            <Setter TargetName="Tick" Property="BorderBrush" Value="{StaticResource OkBrush}" />
                                            <Setter TargetName="TickGlyph" Property="Visibility" Value="Visible" />
                                            <Setter TargetName="StepText" Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                                            <Setter TargetName="StepText" Property="TextDecorations" Value="Strikethrough" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock HorizontalAlignment="Right" Margin="0,12,0,0" FontSize="11.5">
                            <Hyperlink Command="{Binding DismissCommand}" Foreground="{StaticResource TextSecondaryBrush}">
                                <Run Text="Don't show again" />
                            </Hyperlink>
                        </TextBlock>
                    </StackPanel>
                </Border>
            </ScrollViewer>

            <!-- Removed or duplicated, with Undo (#276, #279). -->
            <Border Grid.Column="0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Bottom"
                    Margin="0,0,0,18"
                    Padding="16,6,8,6"
                    CornerRadius="10"
                    Background="{StaticResource SurfaceAltBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    Visibility="{Binding IsToastVisible, Converter={StaticResource BoolToVisibility}}">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.45" />
                </Border.Effect>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding ToastText}" VerticalAlignment="Center" Margin="0,0,14,0" />
                    <Button Content="Set up…"
                            Command="{Binding ToastSetUpCommand}"
                            Padding="10,4"
                            Margin="0,0,6,0"
                            Visibility="{Binding ToastCanSetUp, Converter={StaticResource BoolToVisibility}}" />
                    <Button Content="Undo" Command="{Binding UndoCommand}" Style="{StaticResource PrimaryButtonStyle}" Padding="12,4" Margin="0,0,4,0" />
                    <Button Style="{StaticResource IconButtonStyle}" ToolTip="Dismiss" Command="{Binding DismissToastCommand}">
                        <TextBlock Text="&#xE711;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="10" />
                    </Button>
                </StackPanel>
            </Border>

            <!-- The set-up panel (#275): one widget's options, the widget updating beside it. -->
            <Border Grid.Column="1"
                    Width="380"
                    Margin="12,0,0,0"
                    Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Visibility="{Binding HasSetUpWidget, Converter={StaticResource BoolToVisibility}}">
                <DockPanel>
                    <Border DockPanel.Dock="Top" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="16,12">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource IconButtonStyle}" ToolTip="Close" Command="{Binding CloseSetUpCommand}" VerticalAlignment="Top">
                                <TextBlock Text="&#xE711;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="11" />
                            </Button>
                            <StackPanel>
                                <TextBlock Text="{Binding SetUpKind}" Style="{StaticResource SectionHeaderStyle}" Margin="0" />
                                <TextBlock Text="{Binding SetUpWidget.Title}" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="16,10">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="Done" Command="{Binding CloseSetUpCommand}" Style="{StaticResource PrimaryButtonStyle}" Padding="14,5" />
                            <TextBlock VerticalAlignment="Center">
                                <Hyperlink Command="{Binding SetUpWidget.RemoveCommand}" Foreground="{StaticResource CriticalBrush}">Remove widget</Hyperlink>
                            </TextBlock>
                        </DockPanel>
                    </Border>

                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16,12">
                        <StackPanel DataContext="{Binding SetUpWidget}">
                            <TextBlock Text="TITLE" Style="{StaticResource SectionHeaderStyle}" Margin="0,0,0,6" />
                            <TextBox Text="{Binding Title, UpdateSourceTrigger=LostFocus}" />

                            <TextBlock Text="SIZE" Style="{StaticResource SectionHeaderStyle}" Margin="0,16,0,6" />
                            <UniformGrid Columns="4">
                                <Button Content="Small" Command="{Binding SetSizeCommand}" CommandParameter="Small" Margin="0,0,4,0" Padding="4,6" />
                                <Button Content="Medium" Command="{Binding SetSizeCommand}" CommandParameter="Medium" Margin="2,0" Padding="4,6" />
                                <Button Content="Large" Command="{Binding SetSizeCommand}" CommandParameter="Large" Margin="2,0" Padding="4,6" />
                                <Button Content="Wide" Command="{Binding SetSizeCommand}" CommandParameter="Wide" Margin="4,0,0,0" Padding="4,6" />
                            </UniformGrid>

                            <!-- The kind's own options: its set-up template below, or its title-bar options. -->
                            <ContentControl Content="{Binding}" Focusable="False" Margin="0,16,0,0">
                                <ContentControl.Resources>
                                    <!-- Any widget: the same options as its title bar, if it has any. -->
                                    <DataTemplate DataType="{x:Type vm:DashboardWidgetViewModel}">
                                        <StackPanel>
                                            <TextBlock Text="OPTIONS" Style="{StaticResource SectionHeaderStyle}" Margin="0,0,0,6"
                                                       Visibility="{Binding HeaderOptions, Converter={StaticResource NullToVisibility}}" />
                                            <ContentControl Content="{Binding HeaderOptions}" Focusable="False" HorizontalAlignment="Left" />
                                            <TextBlock Text="Nothing else to set up for this widget."
                                                       Style="{StaticResource SubtleTextStyle}"
                                                       Visibility="{Binding HeaderOptions, Converter={StaticResource NullToVisibility}, ConverterParameter=invert}" />
                                        </StackPanel>
                                    </DataTemplate>

                                    <!-- Sensors: the ones on it, each removable, and a search to add more. -->
                                    <DataTemplate DataType="{x:Type vm:SensorWidgetViewModel}">
                                        <StackPanel>
                                            <DockPanel Margin="0,0,0,6">
                                                <Button DockPanel.Dock="Right"
                                                        Content="Add sensor"
                                                        Padding="8,3"
                                                        Command="{Binding TogglePickerCommand}"
                                                        Visibility="{Binding IsPickerOpen, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}" />
                                                <Button DockPanel.Dock="Right"
                                                        Style="{StaticResource IconButtonStyle}"
                                                        ToolTip="Back to the sensors on it"
                                                        Command="{Binding TogglePickerCommand}"
                                                        Visibility="{Binding IsPickerOpen, Converter={StaticResource BoolToVisibility}}">
                                                    <TextBlock Text="&#xE72B;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12" />
                                                </Button>
                                                <TextBlock Text="SENSORS" Style="{StaticResource SectionHeaderStyle}" Margin="0" VerticalAlignment="Center" />
                                            </DockPanel>

                                            <!-- On it: each with Remove. -->
                                            <StackPanel Visibility="{Binding IsPickerOpen, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}">
                                                <ItemsControl ItemsSource="{Binding Sensors}" Focusable="False">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <DockPanel Margin="0,3">
                                                                <Button DockPanel.Dock="Right"
                                                                        ToolTip="Remove from widget"
                                                                        Style="{StaticResource IconButtonStyle}"
                                                                        VerticalAlignment="Center"
                                                                        Command="{Binding DataContext.RemoveSensorCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                        CommandParameter="{Binding}">
                                                                    <TextBlock Text="&#xE74D;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="11" />
                                                                </Button>
                                                                <StackPanel VerticalAlignment="Center">
                                                                    <TextBlock Text="{Binding DeviceName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                                    <TextBlock Text="{Binding Description}" Style="{StaticResource SubtleTextStyle}" TextTrimming="CharacterEllipsis" />
                                                                </StackPanel>
                                                            </DockPanel>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                <TextBlock Text="None yet. Add sensor finds them by device or sensor."
                                                           TextWrapping="Wrap"
                                                           Style="{StaticResource SubtleTextStyle}"
                                                           Visibility="{Binding LoadState.HasVisibleItems, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}" />
                                            </StackPanel>

                                            <!-- Adding: search, then Add. -->
                                            <StackPanel Visibility="{Binding IsPickerOpen, Converter={StaticResource BoolToVisibility}}">
                                                <TextBox Text="{Binding PickerSearchText, UpdateSourceTrigger=PropertyChanged, Delay=200}"
                                                         Style="{StaticResource SearchTextBoxStyle}"
                                                         Tag="Search by device or sensor"
                                                         Margin="0,0,0,8" />
                                                <ItemsControl ItemsSource="{Binding PickerResults}" Focusable="False">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <DockPanel Margin="0,3">
                                                                <Button DockPanel.Dock="Right"
                                                                        Content="Add"
                                                                        Padding="8,3"
                                                                        VerticalAlignment="Center"
                                                                        Command="{Binding DataContext.AddSensorCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                        CommandParameter="{Binding}" />
                                                                <StackPanel VerticalAlignment="Center">
                                                                    <TextBlock Text="{Binding DeviceName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                                    <TextBlock Text="{Binding Description}" Style="{StaticResource SubtleTextStyle}" TextTrimming="CharacterEllipsis" />
                                                                </StackPanel>
                                                            </DockPanel>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                <TextBlock Text="No matching sensors. Sensors must be visible on the Health tab to show up here."
                                                           TextWrapping="Wrap"
                                                           Style="{StaticResource SubtleTextStyle}"
                                                           Visibility="{Binding HasPickerResults, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </DataTemplate>

                                    <!-- Graph: the device, the graph and the range. -->
                                    <DataTemplate DataType="{x:Type vm:GraphWidgetViewModel}">
                                        <StackPanel>
                                            <TextBlock Text="DEVICE" Style="{StaticResource SectionHeaderStyle}" Margin="0,0,0,6" />
                                            <!-- Choosing: search the devices. -->
                                            <StackPanel Visibility="{Binding IsDevicePickerOpen, Converter={StaticResource BoolToVisibility}}">
                                                <DockPanel Margin="0,0,0,6">
                                                    <Button DockPanel.Dock="Right"
                                                            ToolTip="Back"
                                                            Style="{StaticResource IconButtonStyle}"
                                                            Command="{Binding ToggleDevicePickerCommand}">
                                                        <TextBlock Text="&#xE72B;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12" />
                                                    </Button>
                                                    <TextBox Text="{Binding DevicePickerSearchText, UpdateSourceTrigger=PropertyChanged, Delay=200}"
                                                             Style="{StaticResource SearchTextBoxStyle}"
                                                             Tag="Search devices"
                                                             Margin="0,0,8,0" />
                                                </DockPanel>
                                                <ItemsControl ItemsSource="{Binding DevicePickerResults}" Focusable="False">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Button Content="{Binding DisplayName}"
                                                                    Command="{Binding DataContext.SelectDeviceCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                    CommandParameter="{Binding}"
                                                                    HorizontalAlignment="Stretch"
                                                                    HorizontalContentAlignment="Left"
                                                                    Padding="8,6"
                                                                    Margin="0,0,0,2" />
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                <TextBlock Text="No matching devices."
                                                           Style="{StaticResource SubtleTextStyle}"
                                                           Visibility="{Binding HasDevicePickerResults, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}" />
                                            </StackPanel>

                                            <!-- Chosen: the device, then its graph and range. -->
                                            <StackPanel Visibility="{Binding IsDevicePickerOpen, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}">
                                                <Button HorizontalAlignment="Stretch"
                                                        HorizontalContentAlignment="Left"
                                                        Padding="8,6"
                                                        Command="{Binding ToggleDevicePickerCommand}"
                                                        ToolTip="Choose a device">
                                                    <Button.Style>
                                                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                            <Setter Property="Content" Value="Choose a device" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding HasSelectedDevice}" Value="True">
                                                                    <Setter Property="Content" Value="{Binding SelectedDeviceName}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>

                                                <StackPanel Visibility="{Binding HasSelectedDevice, Converter={StaticResource BoolToVisibility}}">
                                                    <!-- The device's graphs, or one of its ports' (#285). -->
                                                    <StackPanel Visibility="{Binding HasSources, Converter={StaticResource BoolToVisibility}}">
                                                        <TextBlock Text="SHOW" Style="{StaticResource SectionHeaderStyle}" Margin="0,16,0,6" />
                                                        <ComboBox ItemsSource="{Binding Sources}"
                                                                  SelectedItem="{Binding SelectedSource}"
                                                                  DisplayMemberPath="Name"
                                                                  IsTextSearchEnabled="True"
                                                                  ToolTip="The device's own graphs, or one of its ports" />
                                                    </StackPanel>
                                                    <TextBlock Text="GRAPH" Style="{StaticResource SectionHeaderStyle}" Margin="0,16,0,6" />
                                                    <ComboBox ItemsSource="{Binding AvailableGraphs}"
                                                              SelectedItem="{Binding SelectedGraph}"
                                                              DisplayMemberPath="Description" />
                                                    <TextBlock Text="RANGE" Style="{StaticResource SectionHeaderStyle}" Margin="0,16,0,6" />
                                                    <views:GraphTimeRangePicker DataContext="{Binding TimeRange}" HorizontalAlignment="Left" />
                                                </StackPanel>
                                            </StackPanel>
                                        </StackPanel>
                                    </DataTemplate>
                                </ContentControl.Resources>
                            </ContentControl>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>

        <!-- ======================== Status bar ======================== -->
        <Border Grid.Row="3"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="18,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <TextBlock Text="Refreshing..."
                               Style="{StaticResource SubtleTextStyle}"
                               Margin="0,0,10,0"
                               Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
                    <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource SubtleTextStyle}" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <TextBlock Text="{Binding LastUpdatedText, StringFormat=updated {0}}"
                               Style="{StaticResource SubtleTextStyle}"
                               Margin="0,0,14,0" />
                    <TextBlock Text="{Binding NextRefreshText, StringFormat=next in {0}}" Style="{StaticResource SubtleTextStyle}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
