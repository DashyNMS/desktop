<UserControl x:Class="DesktopNMS.Views.FleetLogsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:DesktopNMS.Views"
             xmlns:vm="clr-namespace:DesktopNMS.ViewModels">

    <!-- The Logs tab's Event log and Alert log (#287): every device's
         entries, with filters across the top, as the Graylog view has. -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ==================== Header ==================== -->
        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" VerticalAlignment="Center">
                <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource HeadingTextStyle}">
                        <Setter Property="Text" Value="Event log" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ShowingAlertLog}" Value="True">
                                <Setter Property="Text" Value="Alert log" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <Grid Grid.Column="1" Margin="0,0,8,0" VerticalAlignment="Center">
                <views:CsvExportButton Export="{Binding EventsCsv}" Visibility="{Binding ShowingEventLog, Converter={StaticResource BoolToVisibility}}" />
                <views:CsvExportButton Export="{Binding AlertsCsv}" Visibility="{Binding ShowingAlertLog, Converter={StaticResource BoolToVisibility}}" />
            </Grid>
            <Button Grid.Column="2" Content="Refresh" Command="{Binding RefreshCommand}" Padding="10,7" />
        </Grid>

        <!-- ==================== Filters ==================== -->
        <WrapPanel Grid.Row="1" Margin="0,0,0,10">
            <TextBox Style="{StaticResource SearchTextBoxStyle}"
                     Tag="Search"
                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=300}"
                     ToolTip="Searches the device, message, rule and detail"
                     Width="240"
                     Margin="0,0,8,6" />
            <!-- Editable so a device can be found by typing its name. The server filters by device. -->
            <ComboBox ItemsSource="{Binding DeviceOptions}"
                      SelectedItem="{Binding SelectedDevice}"
                      IsEditable="True"
                      IsTextSearchEnabled="True"
                      Width="200"
                      ToolTip="Whose entries"
                      Margin="0,0,8,6" />
            <ComboBox ItemsSource="{Binding TypeOptions}"
                      SelectedItem="{Binding SelectedType}"
                      Width="150"
                      ToolTip="One type of event"
                      Margin="0,0,8,6"
                      Visibility="{Binding ShowingEventLog, Converter={StaticResource BoolToVisibility}}" />
            <ComboBox ItemsSource="{Binding Source={x:Static vm:FleetLogsViewModel.StateOptions}}"
                      SelectedItem="{Binding SelectedState}"
                      DisplayMemberPath="Label"
                      Width="150"
                      ToolTip="One state"
                      Margin="0,0,8,6"
                      Visibility="{Binding ShowingAlertLog, Converter={StaticResource BoolToVisibility}}" />
            <ComboBox ItemsSource="{Binding Source={x:Static vm:FleetLogsViewModel.RangeOptions}}"
                      SelectedItem="{Binding SelectedRange}"
                      DisplayMemberPath="Label"
                      Width="140"
                      ToolTip="How far back"
                      Margin="0,0,8,6" />
            <Button Content="Clear filters"
                    Command="{Binding ClearFiltersCommand}"
                    Style="{StaticResource ChipButtonStyle}"
                    VerticalAlignment="Center"
                    Margin="0,0,8,6"
                    Visibility="{Binding HasActiveFilters, Converter={StaticResource BoolToVisibility}}" />
        </WrapPanel>

        <!-- ==================== Entries ==================== -->
        <Grid Grid.Row="2">
            <DataGrid ItemsSource="{Binding Events}"
                      SelectedItem="{Binding SelectedEvent}"
                      IsReadOnly="True"
                      SelectionMode="Single"
                      HeadersVisibility="Column"
                      MouseDoubleClick="OnRowDoubleClick"
                      Visibility="{Binding ShowingEventLog, Converter={StaticResource BoolToVisibility}}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Time" Binding="{Binding TimeText}" SortMemberPath="Local" Width="130" />
                    <DataGridTextColumn Header="Device" Binding="{Binding DeviceName}" Width="170" />
                    <DataGridTextColumn Header="Type" Binding="{Binding TypeText}" Width="110" />
                    <DataGridTextColumn Header="Message" Binding="{Binding Message}" Width="*" />
                    <DataGridTextColumn Header="User" Binding="{Binding Username}" Width="100" />
                </DataGrid.Columns>
            </DataGrid>

            <DataGrid ItemsSource="{Binding Alerts}"
                      SelectedItem="{Binding SelectedAlert}"
                      IsReadOnly="True"
                      SelectionMode="Single"
                      HeadersVisibility="Column"
                      MouseDoubleClick="OnRowDoubleClick"
                      Visibility="{Binding ShowingAlertLog, Converter={StaticResource BoolToVisibility}}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Time" Binding="{Binding TimeText}" SortMemberPath="Local" Width="130" />
                    <DataGridTextColumn Header="Device" Binding="{Binding DeviceName}" Width="170" />
                    <DataGridTemplateColumn Header="Rule" Width="220" SortMemberPath="RuleName">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="8,0">
                                    <Ellipse Width="9"
                                             Height="9"
                                             Margin="0,0,7,0"
                                             VerticalAlignment="Center"
                                             Fill="{Binding Severity, Converter={StaticResource SeverityToBrush}}" />
                                    <TextBlock Text="{Binding RuleName}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding SeverityText}" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="State" Binding="{Binding StateText}" SortMemberPath="State" Width="110" />
                    <DataGridTextColumn Header="Detail" Binding="{Binding DetailText}" Width="*" />
                </DataGrid.Columns>
            </DataGrid>

            <views:LoadingOverlay Text="Loading…" Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}" />

            <TextBlock Text="{Binding EmptyText}"
                       Style="{StaticResource SubtleTextStyle}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       IsHitTestVisible="False"
                       Visibility="{Binding ShowsEmpty, Converter={StaticResource BoolToVisibility}}" />

            <Border HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    MaxWidth="460"
                    Padding="18,14"
                    CornerRadius="8"
                    Background="{StaticResource SurfaceAltBrush}"
                    Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" />
            </Border>
        </Grid>

        <!-- ==================== Footer ==================== -->
        <DockPanel Grid.Row="3" Margin="0,10,0,0">
            <Button DockPanel.Dock="Right"
                    Content="Load more"
                    Command="{Binding LoadMoreCommand}"
                    Padding="12,6"
                    Visibility="{Binding CanLoadMore, Converter={StaticResource BoolToVisibility}}" />
            <TextBlock Text="{Binding CountText}"
                       Style="{StaticResource SubtleTextStyle}"
                       VerticalAlignment="Center"
                       ToolTip="Double-click an entry to open that device's log in Device Details" />
        </DockPanel>
    </Grid>
</UserControl>
