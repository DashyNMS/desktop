<UserControl x:Class="DesktopNMS.Views.GraylogMessagesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:DesktopNMS.Views">

    <!-- Graylog messages (issue #114), shared by Device Details' Graylog tab
         and the Logs tab (see GraylogMessagesViewModel): LibreNMS's filters
         over a paged table with its columns, newest first, plus a details
         pane with every field of the selected message. The Logs tab also
         gets a device filter, auto-update and row actions (IsFleet). -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="120" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ==================== Header ==================== -->
        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Graylog" Style="{StaticResource HeadingTextStyle}" VerticalAlignment="Center" />

            <TextBlock Grid.Column="1"
                       Text="{Binding LastUpdatedText}"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Right"
                       TextTrimming="CharacterEllipsis"
                       Margin="16,0,12,0">
                <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource SubtleTextStyle}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasUpdateError}" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource WarningBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <StackPanel Grid.Column="2"
                        Orientation="Horizontal"
                        Margin="0,0,12,0"
                        Visibility="{Binding IsFleet, Converter={StaticResource BoolToVisibility}}">
                <CheckBox Content="Auto-update"
                          IsChecked="{Binding AutoUpdate}"
                          VerticalAlignment="Center"
                          ToolTip="Fetch the newest messages on a timer while this tab is showing. Only the first page updates, so an older page you're reading never shifts." />
                <ComboBox ItemsSource="{Binding AutoUpdateIntervalOptions}"
                          SelectedItem="{Binding SelectedAutoUpdateInterval}"
                          DisplayMemberPath="Label"
                          IsEnabled="{Binding AutoUpdate}"
                          Width="150"
                          Margin="8,0,0,0" />
            </StackPanel>

            <Button Grid.Column="3"
                    Content="Refresh"
                    Command="{Binding RefreshCommand}"
                    Padding="10,7" />
        </Grid>

        <!-- ==================== Filters ==================== -->
        <WrapPanel Grid.Row="1" Margin="0,0,0,10">
            <TextBox Style="{StaticResource SearchTextBoxStyle}"
                     Tag="Search messages"
                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=500}"
                     ToolTip="Searches the message text"
                     Width="240"
                     Margin="0,0,8,6" />
            <!-- Editable so a device can be found by typing its name. -->
            <ComboBox ItemsSource="{Binding DeviceOptions}"
                      SelectedItem="{Binding SelectedDevice}"
                      DisplayMemberPath="Label"
                      TextSearch.TextPath="Label"
                      IsEditable="True"
                      IsTextSearchEnabled="True"
                      ToolTip="Device - type to find one"
                      Width="200"
                      Margin="0,0,8,6"
                      Visibility="{Binding IsFleet, Converter={StaticResource BoolToVisibility}}" />
            <ComboBox ItemsSource="{Binding Streams}"
                      SelectedItem="{Binding SelectedStream}"
                      DisplayMemberPath="Label"
                      ToolTip="Stream"
                      Width="190"
                      Margin="0,0,8,6" />
            <ComboBox ItemsSource="{Binding LevelOptions}"
                      SelectedItem="{Binding SelectedLevel}"
                      DisplayMemberPath="Label"
                      ToolTip="Show this level and everything more severe"
                      Width="150"
                      Margin="0,0,8,6" />
            <ComboBox ItemsSource="{Binding RangeOptions}"
                      SelectedItem="{Binding SelectedRange}"
                      DisplayMemberPath="Label"
                      ToolTip="How far back to search"
                      Width="140"
                      Margin="0,0,8,6" />
            <Button Content="Clear filters"
                    Command="{Binding ClearFiltersCommand}"
                    ToolTip="Clear filters (Ctrl+L)"
                    Padding="10,5"
                    Margin="0,0,0,6" />
        </WrapPanel>

        <!-- ==================== Messages ==================== -->
        <Grid Grid.Row="2">
            <DataGrid x:Name="MessagesGrid"
                      ItemsSource="{Binding Messages}"
                      SelectedItem="{Binding SelectedMessage}"
                      IsReadOnly="True"
                      CanUserSortColumns="False"
                      SelectionMode="Single"
                      HeadersVisibility="Column"
                      MouseDoubleClick="OnGridDoubleClick">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Width="26">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Ellipse Width="9"
                                         Height="9"
                                         HorizontalAlignment="Center"
                                         VerticalAlignment="Center"
                                         ToolTip="{Binding LevelText}">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="{StaticResource MaintenanceBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Severity}" Value="Critical">
                                                    <Setter Property="Fill" Value="{StaticResource CriticalBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Severity}" Value="Warning">
                                                    <Setter Property="Fill" Value="{StaticResource WarningBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Severity}" Value="Debug">
                                                    <Setter Property="Fill" Value="{StaticResource TextSecondaryBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Origin" Width="120" Binding="{Binding OriginText}" />
                    <DataGridTextColumn Header="Timestamp" Width="145" Binding="{Binding TimestampText}" />
                    <DataGridTextColumn Header="Level" Width="120" Binding="{Binding LevelText}" />
                    <DataGridTextColumn Header="Source" Width="130" Binding="{Binding SourceText}" />
                    <DataGridTextColumn Header="Message" Width="*" MinWidth="200" Binding="{Binding MessageText}" />
                    <DataGridTextColumn Header="Facility" Width="150" Binding="{Binding FacilityText}" />
                </DataGrid.Columns>
                <DataGrid.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Filter by this device"
                                  Command="{Binding FilterToDeviceCommand}"
                                  CommandParameter="{Binding SelectedMessage}"
                                  Visibility="{Binding IsFleet, Converter={StaticResource BoolToVisibility}}" />
                        <MenuItem Header="Open device"
                                  Command="{Binding OpenDeviceCommand}"
                                  CommandParameter="{Binding SelectedMessage}"
                                  FontWeight="SemiBold" />
                    </ContextMenu>
                </DataGrid.ContextMenu>
            </DataGrid>

            <views:LoadingOverlay Text="Searching Graylog..."
                                  Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}" />

            <TextBlock Text="{Binding EmptyMessageText}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       TextWrapping="Wrap"
                       IsHitTestVisible="False"
                       Visibility="{Binding ShowEmptyMessage, Converter={StaticResource BoolToVisibility}}"
                       Style="{StaticResource SubtleTextStyle}" />

            <Border HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    MaxWidth="520"
                    Padding="16,12"
                    CornerRadius="6"
                    Background="{StaticResource SurfaceAltBrush}"
                    Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <TextBlock Text="Couldn't search Graylog" FontWeight="SemiBold" Foreground="{StaticResource CriticalBrush}" />
                    <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" Margin="0,6,0,0" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- ==================== Paging ==================== -->
        <Grid Grid.Row="3" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0"
                       Text="{Binding PageSummaryText}"
                       Style="{StaticResource SubtleTextStyle}"
                       VerticalAlignment="Center" />
            <ComboBox Grid.Column="1"
                      ItemsSource="{Binding PageSizeOptions}"
                      SelectedItem="{Binding SelectedPageSize}"
                      Width="70"
                      VerticalAlignment="Center" />
            <TextBlock Grid.Column="2"
                       Text="per page"
                       Style="{StaticResource SubtleTextStyle}"
                       VerticalAlignment="Center"
                       Margin="6,0,16,0" />
            <Button Grid.Column="3"
                    Content="Previous"
                    Command="{Binding PreviousPageCommand}"
                    Padding="10,5" />
            <TextBlock Grid.Column="4"
                       Style="{StaticResource SubtleTextStyle}"
                       VerticalAlignment="Center"
                       Margin="10,0">
                <Run Text="Page" />
                <Run Text="{Binding Page, Mode=OneWay}" />
                <Run Text="of" />
                <Run Text="{Binding PageCount, Mode=OneWay}" />
            </TextBlock>
            <Button Grid.Column="5"
                    Content="Next"
                    Command="{Binding NextPageCommand}"
                    Padding="10,5" />
        </Grid>

        <!-- ==================== Selected message ==================== -->
        <Border Grid.Row="4"
                Margin="0,12,0,0"
                Padding="14,12"
                CornerRadius="6"
                Background="{StaticResource SurfaceAltBrush}"
                Visibility="{Binding HasSelectedMessage, Converter={StaticResource BoolToVisibility}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Message" Style="{StaticResource SectionHeaderStyle}" Margin="0,0,0,6" />
                    <TextBox Text="{Binding SelectedMessage.FullText, Mode=OneWay}"
                             IsReadOnly="True"
                             TextWrapping="Wrap"
                             FontFamily="Consolas"
                             VerticalScrollBarVisibility="Auto"
                             Height="170" />
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="All fields" Style="{StaticResource SectionHeaderStyle}" Margin="0,0,0,6" />
                    <DataGrid ItemsSource="{Binding SelectedMessageFields}"
                              IsReadOnly="True"
                              HeadersVisibility="None"
                              Height="170"
                              ToolTip="Select rows and press Ctrl+C to copy">
                        <DataGrid.Columns>
                            <DataGridTextColumn Width="160" Binding="{Binding Name}" />
                            <DataGridTextColumn Width="*" Binding="{Binding Value}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
