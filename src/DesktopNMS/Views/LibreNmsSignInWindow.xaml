<Window x:Class="DesktopNMS.Views.LibreNmsSignInWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:DesktopNMS.Views"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Sign in with LibreNMS"
        Width="960"
        Height="760"
        MinWidth="560"
        MinHeight="480"
        Icon="pack://application:,,,/Assets/app.ico"
        Background="{StaticResource BackgroundBrush}"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">

    <!-- "Sign in with LibreNMS" (mobile#162): the server's own website, where
         the user signs in however their server allows. While the app works
         (opening the page, creating the token) the page is hidden behind the
         busy overlay, so the new token never shows on screen. -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="16,10">
            <Grid>
                <Button Content="Cancel"
                        IsCancel="True"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Click="OnCancel" />
                <!-- The server's name under the title, so it's clear whose page this is. -->
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="Sign in with LibreNMS" FontWeight="SemiBold" FontSize="15" HorizontalAlignment="Center" />
                    <TextBlock x:Name="HostText" Style="{StaticResource SubtleTextStyle}" HorizontalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <!-- Hidden rather than collapsed while busy, so it keeps loading; it's
                 a native window, so nothing WPF draws can sit on top of it. -->
            <wv2:WebView2 x:Name="Web" Visibility="Hidden" />
            <views:LoadingOverlay x:Name="Busy" Text="Opening LibreNMS…" />
        </Grid>
    </Grid>
</Window>
