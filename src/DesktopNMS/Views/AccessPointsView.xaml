<UserControl x:Class="DesktopNMS.Views.AccessPointsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:DesktopNMS.ViewModels"
             xmlns:views="clr-namespace:DesktopNMS.Views"
             xmlns:svgc="clr-namespace:SharpVectors.Converters;assembly=SharpVectors.Converters.Wpf"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:AccessPointsViewModel}"
             d:DesignHeight="600" d:DesignWidth="1100">

    <!-- The Access points page (#55) - see AccessPointsViewModel. Every AP
         the switches see over LLDP, with its switch port's state; selecting
         one shows that port's traffic graph underneath. -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ======================== Summary + search ======================== -->
        <Border Grid.Row="0"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="18,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- State pills - the AP's switch port, which is what LibreNMS's
                     API has; shift-click shows only that one. -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <ToggleButton IsChecked="{Binding ShowUp}" Tag="{x:Static vm:AccessPointState.Up}" PreviewMouseLeftButtonDown="StateBadge_PreviewMouseLeftButtonDown" Style="{StaticResource CountBadgeToggleStyle}" ToolTip="Show/hide APs that are up - their switch and switch port are up (shift-click to show only these)" Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="9" Height="9" Fill="{StaticResource OkBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding UpCount}" FontWeight="SemiBold" Margin="8,0,5,0" />
                            <TextBlock Text="up" Style="{StaticResource SubtleTextStyle}" VerticalAlignment="Center" />
                        </StackPanel>
                    </ToggleButton>
                    <ToggleButton IsChecked="{Binding ShowDown}" Tag="{x:Static vm:AccessPointState.Down}" PreviewMouseLeftButtonDown="StateBadge_PreviewMouseLeftButtonDown" Style="{StaticResource CountBadgeToggleStyle}" ToolTip="Show/hide APs that are down - their switch port, or the switch itself, is down (shift-click to show only these)" Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="9" Height="9" Fill="{StaticResource CriticalBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding DownCount}" FontWeight="SemiBold" Margin="8,0,5,0" />
                            <TextBlock Text="down" Style="{StaticResource SubtleTextStyle}" VerticalAlignment="Center" />
                        </StackPanel>
                    </ToggleButton>
                    <ToggleButton IsChecked="{Binding ShowOther}" Tag="{x:Static vm:AccessPointState.Unknown}" PreviewMouseLeftButtonDown="StateBadge_PreviewMouseLeftButtonDown" Style="{StaticResource CountBadgeToggleStyle}" ToolTip="Show/hide APs on a shut-down port, or whose port LibreNMS doesn't know (shift-click to show only these)"
                                  Visibility="{Binding HasOther, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="9" Height="9" Fill="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding OtherCount}" FontWeight="SemiBold" Margin="8,0,5,0" />
                            <TextBlock Text="other" Style="{StaticResource SubtleTextStyle}" VerticalAlignment="Center" />
                        </StackPanel>
                    </ToggleButton>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBox x:Name="SearchBox"
                             Width="240"
                             Style="{StaticResource SearchTextBoxStyle}"
                             Tag="Search access points"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=200}"
                             ToolTip="Filter by name, model, switch, port or MAC"
                             Margin="0,0,8,0" />

                    <Button Command="{Binding ClearFiltersCommand}"
                            Style="{StaticResource IconButtonStyle}"
                            ToolTip="Clear search and filters"
                            Visibility="{Binding HasAnyFilterApplied, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="&#xE711;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ======================== Error banner ======================== -->
        <Border Grid.Row="1"
                Background="#33DA3633"
                BorderBrush="{StaticResource CriticalBrush}"
                BorderThickness="0,0,0,1"
                Padding="18,10"
                Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap" />
        </Border>

        <!-- ======================== AP list ======================== -->
        <Grid Grid.Row="2">
            <DataGrid x:Name="AccessPointsGrid"
                      ItemsSource="{Binding ItemsView}"
                      SelectedItem="{Binding SelectedItem}"
                      SelectionMode="Single"
                      IsReadOnly="True"
                      Visibility="{Binding LoadState.HasVisibleItems, Converter={StaticResource BoolToVisibility}}">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="State" Width="120" SortMemberPath="State">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="10,0">
                                    <Ellipse Width="9"
                                             Height="9"
                                             Margin="0,0,7,0"
                                             VerticalAlignment="Center"
                                             Fill="{Binding Severity, Converter={StaticResource SeverityToBrush}}" />
                                    <TextBlock Text="{Binding StateText}" VerticalAlignment="Center" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="Access point" Width="*" MinWidth="180" SortMemberPath="Name">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}" ToolTip="{Binding ToolTip}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="10,0" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn Header="Model" Width="90" Binding="{Binding ModelText}" />

                    <DataGridTemplateColumn Header="Switch" Width="*" MinWidth="160" SortMemberPath="SwitchName">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Margin="10,0" VerticalAlignment="Center" Cursor="Hand" TextTrimming="CharacterEllipsis">
                                    <Hyperlink Command="{Binding DataContext.OpenSwitchCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                               CommandParameter="{Binding}"
                                               ToolTip="Open this switch's Device Details">
                                        <Run Text="{Binding SwitchName, Mode=OneWay}" />
                                    </Hyperlink>
                                </TextBlock>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn Header="Port" Width="110" Binding="{Binding PortText}" />
                    <DataGridTextColumn Header="Speed" Width="90" Binding="{Binding SpeedText}" />
                    <DataGridTextColumn Header="Traffic" Width="230" Binding="{Binding TrafficText}" SortMemberPath="InBps" />
                    <DataGridTextColumn Header="MAC" Width="150" Binding="{Binding MacText}" />
                </DataGrid.Columns>
            </DataGrid>

            <TextBlock Text="Loading access points..."
                       Style="{StaticResource SubtleTextStyle}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Visibility="{Binding LoadState.IsLoading, Converter={StaticResource BoolToVisibility}}" />

            <TextBlock Text="No access points found - none of your switches see an AP over LLDP."
                       Style="{StaticResource SubtleTextStyle}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Visibility="{Binding LoadState.IsEmpty, Converter={StaticResource BoolToVisibility}}" />

            <TextBlock Text="No access points match your search."
                       Style="{StaticResource SubtleTextStyle}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Visibility="{Binding LoadState.IsNoMatches, Converter={StaticResource BoolToVisibility}}" />
        </Grid>

        <!-- ======================== Selected AP's port graphs ======================== -->
        <!-- Traffic, packets and errors for the selected AP's switch port,
             two across. -->
        <Border Grid.Row="3"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="18,12"
                Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibility}}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="420" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                        <Run Text="{Binding SelectedItem.Name, Mode=OneWay}" FontWeight="SemiBold" />
                        <Run Text=" - port " Foreground="{StaticResource TextSecondaryBrush}" />
                        <Run Text="{Binding SelectedItem.PortText, Mode=OneWay}" Foreground="{StaticResource TextSecondaryBrush}" />
                        <Run Text=" on " Foreground="{StaticResource TextSecondaryBrush}" />
                        <Run Text="{Binding SelectedItem.SwitchName, Mode=OneWay}" Foreground="{StaticResource TextSecondaryBrush}" />
                    </TextBlock>
                    <views:GraphTimeRangePicker Grid.Column="1" DataContext="{Binding TimeRange}" VerticalAlignment="Center" />
                </Grid>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding PortGraphs}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="2" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource SurfaceAltBrush}"
                                        CornerRadius="5"
                                        Padding="10,8"
                                        Margin="0,0,10,10">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="170" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Text="{Binding Title}" Style="{StaticResource SectionHeaderStyle}" Margin="0,0,0,6" />
                                        <Grid Grid.Row="1">
                                            <svgc:SvgViewbox SvgSource="{Binding Svg}"
                                                             Stretch="Uniform"
                                                             HorizontalAlignment="Left"
                                                             VerticalAlignment="Top"
                                                             Visibility="{Binding Svg, Converter={StaticResource NullToVisibility}}" />
                                            <TextBlock Text="Loading graph..."
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       IsHitTestVisible="False"
                                                       Style="{StaticResource SubtleTextStyle}"
                                                       Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}" />
                                            <TextBlock Text="{Binding ErrorMessage}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       TextWrapping="Wrap"
                                                       IsHitTestVisible="False"
                                                       Style="{StaticResource SubtleTextStyle}"
                                                       Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}" />
                                        </Grid>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>
