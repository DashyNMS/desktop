<Window x:Class="DesktopNMS.Views.BulkAddDevicesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:DesktopNMS.ViewModels"
        xmlns:views="clr-namespace:DesktopNMS.Views"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:BulkAddDevicesViewModel}"
        Title="Bulk add devices"
        Width="1040"
        Height="760"
        MinWidth="820"
        MinHeight="560"
        ShowInTaskbar="False"
        Icon="pack://application:,,,/Assets/app.ico"
        Background="{StaticResource BackgroundBrush}"
        WindowStartupLocation="CenterOwner">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Bulk add devices" Style="{StaticResource HeadingTextStyle}" />
            <TextBlock Style="{StaticResource SubtleTextStyle}"
                       TextWrapping="Wrap"
                       Margin="0,6,0,0"
                       Text="List the devices on the right and choose the settings they share on the left. A CSV can also set anything per device - its values win over the shared ones." />
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340" />
                <ColumnDefinition Width="24" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ==================== Shared settings ==================== -->
            <Border Grid.Column="0"
                    Background="{StaticResource SurfaceAltBrush}"
                    CornerRadius="6"
                    Padding="16,14,6,14"
                    IsEnabled="{Binding IsNotRunning}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top"
                               Text="Settings for every device"
                               Style="{StaticResource SectionHeaderStyle}"
                               Margin="0,0,0,10" />
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,10,0">
                        <views:DeviceAddOptionsView DataContext="{Binding Options}" />
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- ==================== Devices ==================== -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        Style="{StaticResource NavTabTrackStyle}"
                        HorizontalAlignment="Left"
                        Margin="0,0,0,10"
                        IsEnabled="{Binding IsNotRunning}">
                    <StackPanel Orientation="Horizontal">
                        <ToggleButton Content="Paste a list" Style="{StaticResource NavTabButtonStyle}" IsChecked="{Binding IsPasteMode}" />
                        <ToggleButton Content="Import a CSV" Style="{StaticResource NavTabButtonStyle}" IsChecked="{Binding IsCsvMode}" />
                    </StackPanel>
                </Border>

                <!-- Paste -->
                <StackPanel Grid.Row="1"
                            Margin="0,0,0,12"
                            Visibility="{Binding IsPasteMode, Converter={StaticResource BoolToVisibility}}">
                    <TextBox x:Name="PasteBox"
                             Text="{Binding PasteText, UpdateSourceTrigger=PropertyChanged, Delay=300}"
                             IsEnabled="{Binding IsNotRunning}"
                             AcceptsReturn="True"
                             AcceptsTab="False"
                             TextWrapping="NoWrap"
                             FontFamily="Consolas"
                             Height="140"
                             VerticalContentAlignment="Top"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Auto" />
                    <TextBlock Style="{StaticResource SubtleTextStyle}"
                               TextWrapping="Wrap"
                               Margin="0,4,0,0"
                               Text="One hostname or IP per line - commas and spaces work too, so a pasted column or list is fine. Lines starting with # are ignored." />
                </StackPanel>

                <!-- CSV -->
                <StackPanel Grid.Row="1"
                            Margin="0,0,0,12"
                            Visibility="{Binding IsCsvMode, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Choose file..." Command="{Binding ImportCsvCommand}" Padding="12,6" />
                        <Button Content="Save template..." Command="{Binding SaveTemplateCommand}" Padding="12,6" Margin="8,0,0,0" />
                        <TextBlock Text="{Binding CsvFileName}"
                                   VerticalAlignment="Center"
                                   FontWeight="SemiBold"
                                   Margin="14,0,0,0"
                                   Visibility="{Binding HasCsv, Converter={StaticResource BoolToVisibility}}" />
                        <Button Content="Clear"
                                Command="{Binding ClearCsvCommand}"
                                Padding="10,4"
                                Margin="10,0,0,0"
                                Visibility="{Binding HasCsv, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                    <TextBlock Text="{Binding CsvMessage}"
                               TextWrapping="Wrap"
                               Foreground="{StaticResource WarningBrush}"
                               Margin="0,8,0,0"
                               Visibility="{Binding HasCsvMessage, Converter={StaticResource BoolToVisibility}}" />
                    <TextBlock Style="{StaticResource SubtleTextStyle}"
                               TextWrapping="Wrap"
                               Margin="0,8,0,0"
                               Text="The first row names the columns - LibreNMS's own add device fields: hostname (the only one needed), snmpver, community, authlevel, authname, authpass, authalgo, cryptopass, cryptoalgo, port, transport, poller_group, location, display_template, overwrite_ip, force_add, ping_fallback, snmp_disable, os, sysName, hardware. A blank cell uses the shared setting. The template has an example of each kind of device." />
                </StackPanel>

                <!-- The list -->
                <Grid Grid.Row="2">
                    <DataGrid ItemsSource="{Binding Items}"
                              IsReadOnly="True"
                              HeadersVisibility="Column"
                              SelectionMode="Extended"
                              Visibility="{Binding HasItems, Converter={StaticResource BoolToVisibility}}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Line" Width="50" Binding="{Binding Line}" />
                            <DataGridTextColumn Header="Hostname or IP" Width="190" Binding="{Binding Hostname}" />
                            <DataGridTextColumn Header="Settings" Width="160" Binding="{Binding SettingsText}" />
                            <DataGridTemplateColumn Header="Status" Width="110" SortMemberPath="StatusText">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" Margin="8,0">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Status}" Value="{x:Static vm:BulkDeviceStatus.Added}">
                                                            <Setter Property="Foreground" Value="{StaticResource OkBrush}" />
                                                            <Setter Property="FontWeight" Value="SemiBold" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="{x:Static vm:BulkDeviceStatus.Failed}">
                                                            <Setter Property="Foreground" Value="{StaticResource CriticalBrush}" />
                                                            <Setter Property="FontWeight" Value="SemiBold" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="{x:Static vm:BulkDeviceStatus.Invalid}">
                                                            <Setter Property="Foreground" Value="{StaticResource CriticalBrush}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="{x:Static vm:BulkDeviceStatus.Exists}">
                                                            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="{x:Static vm:BulkDeviceStatus.Adding}">
                                                            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Details" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Message}"
                                                   ToolTip="{Binding Message}"
                                                   TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center"
                                                   Margin="8,0" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <Border BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Visibility="{Binding HasItems, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}">
                        <TextBlock Text="{Binding SummaryText}"
                                   Style="{StaticResource SubtleTextStyle}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                </Grid>

                <TextBlock Grid.Row="3"
                           Text="{Binding SummaryText}"
                           Style="{StaticResource SubtleTextStyle}"
                           Margin="0,8,0,0"
                           Visibility="{Binding HasItems, Converter={StaticResource BoolToVisibility}}" />
            </Grid>
        </Grid>

        <!-- ==================== Actions ==================== -->
        <Grid Grid.Row="2" Margin="0,18,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0"
                    Content="Copy results"
                    Command="{Binding CopyResultsCommand}"
                    ToolTip="Copy every device with its status and message, as CSV"
                    Padding="12,6" />
            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <Button Content="Stop"
                        Command="{Binding StopCommand}"
                        ToolTip="Finish the devices being added now and don't start any more"
                        Padding="12,6"
                        Margin="0,0,8,0"
                        Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibility}}" />
                <Button Content="Retry failed"
                        Command="{Binding RetryFailedCommand}"
                        Padding="12,6"
                        Margin="0,0,8,0" />
                <Button Content="Close"
                        Click="OnCloseClick"
                        IsCancel="True"
                        Padding="12,6"
                        Margin="0,0,8,0" />
                <Button Content="{Binding AddButtonText}"
                        Command="{Binding AddCommand}"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Padding="14,6" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
