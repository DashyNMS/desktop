<UserControl x:Class="DesktopNMS.Views.IntelligenceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Intelligence: ask about the network, answered by the user's own
         ChatGPT plan using DashyNMS's read-only network tools. -->
    <Grid Margin="24,18,24,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header: account, model, network. -->
        <DockPanel Grid.Row="0" Margin="0,0,0,12">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center"
                        Visibility="{Binding IsSignedIn, Converter={StaticResource BoolToVisibility}}">
                <ComboBox ItemsSource="{Binding Models}"
                          SelectedItem="{Binding SelectedModel}"
                          DisplayMemberPath="DisplayName"
                          Width="180"
                          ToolTip="Which ChatGPT model answers"
                          Margin="0,0,8,0" />
                <Button Content="Manage usage" Command="{Binding ManageUsageCommand}" Padding="12,6" Margin="0,0,8,0" />
                <Button Content="New conversation" Command="{Binding ClearCommand}" Padding="12,6" Margin="0,0,8,0" />
                <Button Content="Disconnect" Command="{Binding DisconnectCommand}" Padding="12,6" />
            </StackPanel>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Intelligence" Style="{StaticResource HeadingTextStyle}" />
                <TextBlock Style="{StaticResource SubtleTextStyle}" Margin="0,2,0,0"
                           Visibility="{Binding IsSignedIn, Converter={StaticResource BoolToVisibility}}">
                    <Run Text="{Binding AccountText, Mode=OneWay}" /><Run Text="  ·  " /><Run Text="{Binding NetworkText, Mode=OneWay}" />
                </TextBlock>
            </StackPanel>
        </DockPanel>

        <!-- Errors that say what to do. -->
        <Border Grid.Row="1"
                Background="#33DA3633"
                BorderBrush="{StaticResource CriticalBrush}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="14,10"
                Margin="0,0,0,12"
                Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Text="{Binding ErrorText}" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap" />
        </Border>

        <!-- Not signed in. -->
        <Border Grid.Row="2"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                MaxWidth="520"
                Padding="28,24"
                CornerRadius="8"
                Background="{StaticResource SurfaceAltBrush}"
                Visibility="{Binding IsSignedOut, Converter={StaticResource BoolToVisibility}}">
            <StackPanel>
                <TextBlock Text="Ask about your network" Style="{StaticResource HeadingTextStyle}" />
                <TextBlock Style="{StaticResource SubtleTextStyle}" TextWrapping="Wrap" Margin="0,8,0,16"
                           Text="Ask what's alerting, how a device is doing, where an address is plugged in or what changed overnight. Intelligence answers using your own ChatGPT plan, looking things up in LibreNMS with read-only tools - it can't change anything. Needs ChatGPT Plus or Pro." />
                <Button Content="Continue with ChatGPT"
                        Style="{StaticResource PrimaryButtonStyle}"
                        HorizontalAlignment="Left"
                        Padding="16,8"
                        Command="{Binding ConnectCommand}" />
                <TextBlock Style="{StaticResource SubtleTextStyle}" TextWrapping="Wrap" Margin="0,12,0,0"
                           Text="Your browser opens to sign in. DashyNMS never sees your ChatGPT password." />
            </StackPanel>
        </Border>

        <!-- Before the first question: what leaves this computer. -->
        <Border Grid.Row="2"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                MaxWidth="560"
                Padding="28,24"
                CornerRadius="8"
                Background="{StaticResource SurfaceAltBrush}"
                Visibility="{Binding NeedsConsent, Converter={StaticResource BoolToVisibility}}">
            <StackPanel>
                <TextBlock Text="Before you ask" Style="{StaticResource HeadingTextStyle}" />
                <TextBlock Style="{StaticResource SubtleTextStyle}" TextWrapping="Wrap" Margin="0,8,0,8"
                           Text="Your questions, and what DashyNMS looks up to answer them - device names, addresses, alerts, ports and log lines from your network - are sent to OpenAI to be processed, using your ChatGPT plan." />
                <TextBlock Style="{StaticResource SubtleTextStyle}" TextWrapping="Wrap" Margin="0,0,0,16"
                           Text="Passwords, tokens and SNMP communities are never sent, and config backups are summarised (when they changed, and by how much) rather than sent." />
                <Button Content="OK, continue"
                        Style="{StaticResource PrimaryButtonStyle}"
                        HorizontalAlignment="Left"
                        Padding="16,8"
                        Command="{Binding AcceptConsentCommand}" />
            </StackPanel>
        </Border>

        <!-- The conversation. -->
        <Grid Grid.Row="2" Visibility="{Binding ShowConversation, Converter={StaticResource BoolToVisibility}}">
            <ScrollViewer x:Name="Transcript" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding Messages}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,0,12">
                                <!-- You -->
                                <Border HorizontalAlignment="Right"
                                        MaxWidth="640"
                                        Padding="14,10"
                                        CornerRadius="10"
                                        Background="{StaticResource AccentSubtleBrush}"
                                        Visibility="{Binding IsUser, Converter={StaticResource BoolToVisibility}}">
                                    <TextBox Text="{Binding Text, Mode=OneWay}" IsReadOnly="True" BorderThickness="0" Background="Transparent"
                                             Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap" />
                                </Border>
                                <!-- Intelligence -->
                                <Border HorizontalAlignment="Stretch"
                                        Padding="16,12"
                                        CornerRadius="10"
                                        Background="{StaticResource SurfaceAltBrush}"
                                        Visibility="{Binding IsAssistant, Converter={StaticResource BoolToVisibility}}">
                                    <StackPanel>
                                        <ItemsControl ItemsSource="{Binding Activity}" Margin="0,0,0,6">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding}" Style="{StaticResource SubtleTextStyle}" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBox Text="{Binding Text, Mode=OneWay}" IsReadOnly="True" BorderThickness="0" Background="Transparent"
                                                 Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap" />
                                        <TextBlock Text="Thinking…" Style="{StaticResource SubtleTextStyle}" Margin="0,4,0,0"
                                                   Visibility="{Binding IsStreaming, Converter={StaticResource BoolToVisibility}}" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- Somewhere to start. -->
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                        Visibility="{Binding ShowSuggestions, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="Ask about your network" Style="{StaticResource HeadingTextStyle}" HorizontalAlignment="Center" Margin="0,0,0,12" />
                <ItemsControl ItemsSource="{Binding Suggestions}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Content="{Binding}"
                                    Command="{Binding DataContext.AskSuggestionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}"
                                    HorizontalAlignment="Center"
                                    Padding="14,7"
                                    Margin="0,0,0,8" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Grid>

        <!-- Ask. -->
        <Grid Grid.Row="3" Margin="0,12,0,0" Visibility="{Binding ShowConversation, Converter={StaticResource BoolToVisibility}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="QuestionBox"
                     Text="{Binding Question, UpdateSourceTrigger=PropertyChanged}"
                     AcceptsReturn="False"
                     TextWrapping="Wrap"
                     MaxHeight="120"
                     Padding="10,8"
                     VerticalContentAlignment="Center"
                     KeyDown="OnQuestionKeyDown" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="8,0,0,0">
                <Button Content="Ask" Style="{StaticResource PrimaryButtonStyle}" Padding="18,8" Command="{Binding SendCommand}"
                        Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}" />
                <Button Content="Stop" Padding="18,8" Command="{Binding StopCommand}"
                        Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
