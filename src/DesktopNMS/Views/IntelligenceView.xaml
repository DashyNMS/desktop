<UserControl x:Class="DesktopNMS.Views.IntelligenceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:DesktopNMS.Views">

    <UserControl.Resources>
        <Style x:Key="PaneHeaderStyle" TargetType="Border">
            <Setter Property="Height" Value="57" />
            <Setter Property="Padding" Value="18,10" />
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
        </Style>
        <Style x:Key="PaneTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </UserControl.Resources>

    <!-- Intelligence: ask about the network, answered with the user's own
         ChatGPT plan using DashyNMS's read-only network tools. The account
         lives in Settings › Intelligence, not here. The context sidebar on
         the right hides itself when the window is narrow. -->
    <Grid x:Name="Root" SizeChanged="OnRootSizeChanged" PreviewKeyDown="OnRootKeyDown">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

    <Grid x:Name="ConversationPane" Grid.Column="1" AutomationProperties.Name="Intelligence conversation">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ======================== Top bar ======================== -->
        <Border x:Name="IntelligenceHeader" Grid.Row="0" Style="{StaticResource PaneHeaderStyle}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource IconButtonStyle}"
                            ToolTip="Intelligence settings"
                            Command="{Binding OpenSettingsCommand}">
                        <TextBlock Text="&#xE713;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="15" />
                    </Button>
                    <!-- Brings the context sidebar back once it's been collapsed
                         (shown only then, and only when there's room for it) -
                         at the far right, by the edge it opens from. -->
                    <Button x:Name="ShowContextButton"
                            Style="{StaticResource IconButtonStyle}"
                            ToolTip="Show the context sidebar"
                            AutomationProperties.Name="Show context"
                            Click="OnShowContextClick"
                            Margin="8,0,0,0"
                            Visibility="Collapsed">
                        <TextBlock Text="&#xE8A0;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="15" />
                    </Button>
                </StackPanel>
                <Grid VerticalAlignment="Center">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal">
                    <Path Data="{x:Static views:RailIcon.RouteSparkle}" Width="18" Height="18" Stretch="Uniform" Margin="0,0,8,0"
                          Stroke="{StaticResource TextPrimaryBrush}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                    <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Intelligence" Style="{StaticResource PaneTitleStyle}" />
                    <TextBlock Text="{Binding Chats.SelectedChat.Title}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"
                               MaxWidth="160" TextTrimming="CharacterEllipsis" ToolTip="{Binding Chats.SelectedChat.Title}"
                               Visibility="{Binding ShowConversation, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                    </StackPanel>
                    <!-- Spotlight: what the agent is kept to. -->
                    <Border Grid.Column="1" Background="{StaticResource AccentSubtleBrush}" CornerRadius="10" Padding="9,2,4,2" Margin="8,0,8,0" VerticalAlignment="Center" HorizontalAlignment="Left" MaxWidth="320"
                            Visibility="{Binding Context.HasSpotlight, Converter={StaticResource BoolToVisibility}}">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource IconButtonStyle}" Width="20" Height="20" Margin="4,0,0,0"
                                    ToolTip="Back to the whole network" AutomationProperties.Name="Clear Spotlight" Command="{Binding Context.ClearSpotlightCommand}">
                                <TextBlock Text="&#xE711;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="9" />
                            </Button>
                            <TextBlock DockPanel.Dock="Left" Text="&#xE7B3;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="11"
                                       Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBlock FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" MaxWidth="320" TextTrimming="CharacterEllipsis">
                                <Run Text="Spotlight: " /><Run Text="{Binding Context.SpotlightSummary, Mode=OneWay}" FontWeight="SemiBold" />
                            </TextBlock>
                        </DockPanel>
                    </Border>
                </Grid>
            </DockPanel>
        </Border>

        <!-- ======================== Error banner ======================== -->
        <Border Grid.Row="1"
                Background="#33DA3633"
                BorderBrush="{StaticResource CriticalBrush}"
                BorderThickness="0,0,0,1"
                Padding="18,10"
                Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Text="{Binding ErrorText}" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap" />
        </Border>

        <!-- ======================== Not connected ======================== -->
        <Border Grid.Row="2"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                MaxWidth="520"
                Padding="28,24"
                CornerRadius="8"
                Background="{StaticResource SurfaceAltBrush}"
                Visibility="{Binding IsSignedOut, Converter={StaticResource BoolToVisibility}}">
            <StackPanel>
                <TextBlock Text="Ask about your network" Style="{StaticResource HeadingTextStyle}" />
                <TextBlock Style="{StaticResource SubtleTextStyle}" TextWrapping="Wrap" Margin="0,8,0,16"
                           Text="Ask what's alerting, how a device is doing, where an address is plugged in or what changed overnight. Intelligence answers using your own ChatGPT plan, looking things up with read-only tools - it can't change anything. Needs ChatGPT Plus or Pro." />
                <Button Content="Continue with ChatGPT"
                        Style="{StaticResource PrimaryButtonStyle}"
                        HorizontalAlignment="Left"
                        Padding="16,8"
                        Command="{Binding ConnectCommand}" />
                <TextBlock Style="{StaticResource SubtleTextStyle}" TextWrapping="Wrap" Margin="0,12,0,0"
                           Text="Your browser opens to sign in. DashyNMS never sees your ChatGPT password." />
            </StackPanel>
        </Border>

        <!-- ======================== Before the first question ======================== -->
        <Border Grid.Row="2"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                MaxWidth="560"
                Padding="28,24"
                CornerRadius="8"
                Background="{StaticResource SurfaceAltBrush}"
                Visibility="{Binding NeedsConsent, Converter={StaticResource BoolToVisibility}}">
            <StackPanel>
                <TextBlock Text="Before you ask" Style="{StaticResource HeadingTextStyle}" />
                <TextBlock Style="{StaticResource SubtleTextStyle}" TextWrapping="Wrap" Margin="0,8,0,8"
                           Text="Your questions, and what DashyNMS looks up to answer them - device names, addresses, alerts, ports and log lines from your network - are sent to OpenAI to be processed, using your ChatGPT plan." />
                <TextBlock Style="{StaticResource SubtleTextStyle}" TextWrapping="Wrap" Margin="0,0,0,16"
                           Text="Passwords, tokens and SNMP communities are never sent. Config backups are summarised unless you choose otherwise in Settings › Intelligence. Web search can check public information; search terms may be sent to search providers. You can turn it off in Settings. You'll see this again only if what's sent changes." />
                <Button Content="OK, continue"
                        Style="{StaticResource PrimaryButtonStyle}"
                        HorizontalAlignment="Left"
                        Padding="16,8"
                        Command="{Binding AcceptConsentCommand}" />
            </StackPanel>
        </Border>

        <!-- ======================== Conversation ======================== -->
        <views:IntelligenceTranscript x:Name="TranscriptPane" Grid.Row="2" Visibility="{Binding ShowConversation, Converter={StaticResource BoolToVisibility}}" />

        <!-- ======================== Composer ======================== -->
        <!-- The composer, with the keyboard hint beneath and Dashy standing on top. -->
        <Grid Grid.Row="3" MaxWidth="860" Margin="24,4,24,18"
              Visibility="{Binding ShowConversation, Converter={StaticResource BoolToVisibility}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <views:IntelligenceComposer x:Name="ComposerBox" DataContext="{Binding Composer}" />
            <TextBlock Grid.Row="1" Text="Enter to ask · Shift+Enter for a new line" FontSize="12"
                       Foreground="{StaticResource TextSecondaryBrush}" Margin="2,6,0,0" TextWrapping="Wrap" />
            <!-- Anchor the feet to the composer's top edge. RenderTransform
                 lets the body overlap the transcript without reserving space.
                 The drawing's feet end at 41px in its 44px control. -->
            <views:IntelligenceMascot HorizontalAlignment="Right" VerticalAlignment="Top"
                                      Margin="0,0,6,0" Panel.ZIndex="10"
                                      Outfit="{Binding CompanionOutfit}"
                                      IsBusy="{Binding IsBusy}" HasError="{Binding HasError}"
                                      Visibility="{Binding ShowMascot, Converter={StaticResource BoolToVisibility}}">
                <views:IntelligenceMascot.RenderTransform>
                    <TranslateTransform Y="-41" />
                </views:IntelligenceMascot.RenderTransform>
            </views:IntelligenceMascot>
        </Grid>
    </Grid>

        <!-- Saved chats are local to this network and ChatGPT account. -->
        <Border x:Name="ChatSidebar" Grid.Column="0" Width="220"
                Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Border x:Name="ChatsHeader" Style="{StaticResource PaneHeaderStyle}">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource IconButtonStyle}"
                                ToolTip="New conversation" Command="{Binding ClearCommand}">
                            <TextBlock Text="&#xE710;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="15" />
                        </Button>
                        <TextBlock Text="Chats" Style="{StaticResource PaneTitleStyle}" />
                    </DockPanel>
                </Border>
                <views:IntelligenceChatList x:Name="ChatList" Grid.Row="1" DataContext="{Binding Chats}" />
            </Grid>
        </Border>

        <!-- ======================== Context sidebar ======================== -->
        <!-- What the conversation is about, from DashyNMS's own live data:
             Spotlight, the devices it mentions with their state, their open
             alerts, and what it looked at. Hidden on a narrow window. -->
        <Grid x:Name="DockedSidebarHost" Grid.Column="2">
        <Border x:Name="Sidebar"
                Width="290"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1,0,0,0"
                DataContext="{Binding Context}">
            <Border.Resources>
                <!-- A flat, full-width row that lights up on hover. -->
                <Style x:Key="ContextRowStyle" TargetType="Button">
                    <Setter Property="Cursor" Value="Hand" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Row" Background="Transparent" CornerRadius="6" Padding="8,6">
                                    <ContentPresenter HorizontalAlignment="Stretch" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Row" Property="Background" Value="{StaticResource SurfaceHoverBrush}" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>

                <!-- A status dot: ok, down (critical), warning, or other. -->
                <Style x:Key="StatusDotStyle" TargetType="Ellipse">
                    <Setter Property="Width" Value="8" />
                    <Setter Property="Height" Value="8" />
                    <Setter Property="VerticalAlignment" Value="Center" />
                    <Setter Property="Margin" Value="0,0,9,0" />
                    <Setter Property="Fill" Value="{StaticResource TextSecondaryBrush}" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Severity}" Value="ok">
                            <Setter Property="Fill" Value="{StaticResource OkBrush}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Severity}" Value="down">
                            <Setter Property="Fill" Value="{StaticResource CriticalBrush}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Severity}" Value="warning">
                            <Setter Property="Fill" Value="{StaticResource WarningBrush}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Resources>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Border x:Name="ContextHeader" Style="{StaticResource PaneHeaderStyle}">
                    <DockPanel>
                        <Button DockPanel.Dock="Right"
                                Style="{StaticResource IconButtonStyle}"
                                ToolTip="Collapse the context sidebar"
                                AutomationProperties.Name="Close context" Click="OnCloseContextClick">
                            <TextBlock Text="&#xE89F;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="15" />
                        </Button>
                        <TextBlock Text="Context" Style="{StaticResource PaneTitleStyle}" />
                    </DockPanel>
                </Border>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="12,10,12,16">

                    <!-- ===== Spotlight ===== -->
                    <DockPanel Margin="8,0,0,6">
                        <Button DockPanel.Dock="Right" Style="{StaticResource IconButtonStyle}" Width="24" Height="24"
                                ToolTip="Narrow the conversation to devices, a group or a location"
                                Command="{Binding OpenPickerCommand}">
                            <TextBlock Text="&#xE710;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="11" />
                        </Button>
                        <TextBlock Text="SPOTLIGHT" Style="{StaticResource SectionHeaderStyle}" VerticalAlignment="Center" />
                    </DockPanel>
                    <TextBlock Text="Finish or stop the answer to change Spotlight" FontSize="12" TextWrapping="Wrap" Margin="8,0,0,6"
                               Foreground="{StaticResource TextSecondaryBrush}" Visibility="{Binding IsScopeLocked, Converter={StaticResource BoolToVisibility}}" />

                    <TextBlock Text="Whole network" Style="{StaticResource SubtleTextStyle}" Margin="8,0,0,4"
                               Visibility="{Binding HasSpotlight, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}" />
                    <ItemsControl ItemsSource="{Binding Spotlight}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="8,2,0,2">
                                    <Button DockPanel.Dock="Right" Style="{StaticResource IconButtonStyle}" Width="22" Height="22"
                                            ToolTip="Remove from Spotlight"
                                            Command="{Binding DataContext.RemoveSpotlightCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}">
                                        <TextBlock Text="&#xE711;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="9" />
                                    </Button>
                                    <TextBlock Text="&#xE7B3;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="11"
                                               Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <TextBlock VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                                        <Run Text="{Binding Name, Mode=OneWay}" Foreground="{StaticResource TextPrimaryBrush}" />
                                        <Run Text="{Binding KindText, Mode=OneWay}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" />
                                    </TextBlock>
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Picking what to spotlight. -->
                    <Border Background="{StaticResource SurfaceAltBrush}" CornerRadius="8" Padding="10" Margin="0,6,0,0"
                            Visibility="{Binding PickerOpen, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel>
                            <Border Style="{StaticResource NavTabTrackStyle}" HorizontalAlignment="Left" Margin="0,0,0,8">
                                <StackPanel Orientation="Horizontal">
                                    <ToggleButton Content="Devices" Style="{StaticResource NavTabButtonStyle}"
                                                  IsChecked="{Binding IsPickingDevices, Mode=OneWay}" Command="{Binding PickDevicesCommand}" />
                                    <ToggleButton Content="Group" Style="{StaticResource NavTabButtonStyle}"
                                                  IsChecked="{Binding IsPickingGroup, Mode=OneWay}" Command="{Binding PickGroupCommand}" />
                                    <ToggleButton Content="Location" Style="{StaticResource NavTabButtonStyle}"
                                                  IsChecked="{Binding IsPickingLocation, Mode=OneWay}" Command="{Binding PickLocationCommand}" />
                                </StackPanel>
                            </Border>
                            <ComboBox ItemsSource="{Binding PickerOptions}"
                                      SelectedItem="{Binding PickerSelection}"
                                      DisplayMemberPath="Name"
                                      IsEditable="True"
                                      IsTextSearchEnabled="True"
                                      TextSearch.TextPath="Name"
                                      ToolTip="Start typing a name" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                                <Button Content="Cancel" Padding="12,5" Margin="0,0,6,0" Command="{Binding ClosePickerCommand}" />
                                <Button Content="Spotlight" Style="{StaticResource PrimaryButtonStyle}" Padding="12,5" Command="{Binding AddPickedCommand}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- ===== Mentioned devices ===== -->
                    <Rectangle Height="1" Fill="{StaticResource BorderBrush}" Margin="0,16,0,14" />
                    <TextBlock Text="MENTIONED DEVICES" Style="{StaticResource SectionHeaderStyle}" Margin="8,0,0,6" />
                    <TextBlock Text="{Binding DeviceFreshness}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="8,0,0,8" />
                    <TextBlock Style="{StaticResource SubtleTextStyle}" TextWrapping="Wrap" Margin="8,0,0,0"
                               Text="Devices the conversation mentions appear here, with their state."
                               Visibility="{Binding HasMentioned, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}" />
                    <ItemsControl ItemsSource="{Binding Mentioned}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Button Style="{StaticResource ContextRowStyle}"
                                            ToolTip="Open device"
                                            Command="{Binding DataContext.OpenDeviceCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}">
                                        <DockPanel>
                                            <Ellipse DockPanel.Dock="Left" Style="{StaticResource StatusDotStyle}" />
                                            <StackPanel Margin="0,0,26,0">
                                                <TextBlock Text="{Binding Name}" Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Style="{StaticResource SubtleTextStyle}" FontSize="11" TextTrimming="CharacterEllipsis">
                                                    <Run Text="{Binding StateText, Mode=OneWay}" /><Run Text="{Binding DetailSuffix, Mode=OneWay}" />
                                                </TextBlock>
                                            </StackPanel>
                                        </DockPanel>
                                    </Button>
                                    <Button Style="{StaticResource IconButtonStyle}" Width="24" Height="24"
                                            HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,4,0"
                                            ToolTip="Spotlight this device"
                                            Command="{Binding DataContext.SpotlightDeviceCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}">
                                        <TextBlock Text="&#xE7B3;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="11" />
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- ===== Their open alerts ===== -->
                    <StackPanel Visibility="{Binding HasAlerts, Converter={StaticResource BoolToVisibility}}">
                        <Rectangle Height="1" Fill="{StaticResource BorderBrush}" Margin="0,16,0,14" />
                        <TextBlock Text="{Binding AlertsHeader}" Style="{StaticResource SectionHeaderStyle}" Margin="8,0,0,6" />
                        <TextBlock Text="{Binding AlertCountLabel}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="8,0,0,3" />
                        <TextBlock Text="{Binding AlertFreshness}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="8,0,0,8" />
                        <ItemsControl ItemsSource="{Binding Alerts}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource ContextRowStyle}"
                                            ToolTip="Open device"
                                            Command="{Binding DataContext.OpenDeviceCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}">
                                        <DockPanel>
                                            <Ellipse DockPanel.Dock="Left" Style="{StaticResource StatusDotStyle}" />
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding Age}" Style="{StaticResource SubtleTextStyle}" FontSize="11" VerticalAlignment="Top" Margin="6,1,0,0" />
                                            <StackPanel>
                                                <TextBlock Text="{Binding Rule}" Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding DeviceName}" Style="{StaticResource SubtleTextStyle}" FontSize="11" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding StateLabel}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </DockPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!-- ===== What it looked at ===== -->
                    <StackPanel Visibility="{Binding HasLookedAt, Converter={StaticResource BoolToVisibility}}">
                        <Rectangle Height="1" Fill="{StaticResource BorderBrush}" Margin="0,16,0,14" />
                        <TextBlock Text="LOOKED AT" Style="{StaticResource SectionHeaderStyle}" Margin="8,0,0,6" />
                        <ItemsControl ItemsSource="{Binding LookedAt}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="8,2,0,2">
                                        <TextBlock Text="&#xE721;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="10"
                                                   Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                        <TextBlock Text="{Binding}" Style="{StaticResource SubtleTextStyle}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
            </Grid>
        </Border>
        </Grid>
        <Grid x:Name="ContextDrawer" Grid.Column="0" Grid.ColumnSpan="3" Visibility="Collapsed" Panel.ZIndex="30" KeyboardNavigation.TabNavigation="Cycle" AutomationProperties.Name="Context drawer">
            <Button Background="#66000000" BorderThickness="0" AutomationProperties.Name="Close context drawer" Click="OnCloseContextClick" />
        </Grid>
    </Grid>
</UserControl>
