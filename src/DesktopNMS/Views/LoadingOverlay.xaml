<UserControl x:Class="DesktopNMS.Views.LoadingOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root"
             HorizontalAlignment="Center"
             VerticalAlignment="Center"
             IsHitTestVisible="False">

    <!-- A spinning accent-coloured arc and what's being waited for, on a
         card so it reads over a busy map. Only animates while visible (see
         the code-behind), so a hidden overlay costs nothing. -->
    <Border Background="{StaticResource SurfaceBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Padding="18,14">
        <Border.Effect>
            <DropShadowEffect BlurRadius="14" ShadowDepth="2" Opacity="0.25" />
        </Border.Effect>
        <StackPanel Orientation="Horizontal">
            <Grid Width="22" Height="22" VerticalAlignment="Center">
                <Ellipse Stroke="{StaticResource BorderBrush}" StrokeThickness="3" />
                <Path x:Name="Arc"
                      Stroke="{DynamicResource AccentBrush}"
                      StrokeThickness="3"
                      StrokeStartLineCap="Round"
                      StrokeEndLineCap="Round"
                      RenderTransformOrigin="0.5,0.5"
                      Data="M 11,1.5 A 9.5,9.5 0 0 1 20.5,11">
                    <Path.RenderTransform>
                        <RotateTransform x:Name="ArcRotation" />
                    </Path.RenderTransform>
                </Path>
            </Grid>
            <TextBlock Text="{Binding Text, ElementName=Root}"
                       Style="{StaticResource SubtleTextStyle}"
                       VerticalAlignment="Center"
                       Margin="12,0,0,0" />
        </StackPanel>
    </Border>
</UserControl>
