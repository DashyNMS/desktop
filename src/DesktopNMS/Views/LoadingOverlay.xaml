<UserControl x:Class="DesktopNMS.Views.LoadingOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:DesktopNMS.Views"
             x:Name="Root"
             HorizontalAlignment="Center"
             VerticalAlignment="Center"
             IsHitTestVisible="False">

    <!-- The logo's heartbeat over what's being waited for (#228, as on
         DashyNMS Mobile), on a card so it reads over a busy map. The logo
         only beats while this is showing. -->
    <Border Background="{StaticResource SurfaceBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Padding="20,16">
        <Border.Effect>
            <DropShadowEffect BlurRadius="14" ShadowDepth="2" Opacity="0.25" />
        </Border.Effect>
        <StackPanel>
            <views:HeartbeatLogo x:Name="Logo"
                                 Width="40"
                                 Height="40"
                                 HorizontalAlignment="Center" />
            <TextBlock Text="{Binding Text, ElementName=Root}"
                       Style="{StaticResource SubtleTextStyle}"
                       HorizontalAlignment="Center"
                       TextAlignment="Center"
                       Margin="0,10,0,0" />
        </StackPanel>
    </Border>
</UserControl>
