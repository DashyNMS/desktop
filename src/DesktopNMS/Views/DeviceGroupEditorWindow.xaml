<Window x:Class="DesktopNMS.Views.DeviceGroupEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:DesktopNMS.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:DeviceGroupEditorViewModel}"
        Title="{Binding Title}"
        Width="440"
        Height="620"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Icon="pack://application:,,,/Assets/app.ico"
        Background="{StaticResource BackgroundBrush}"
        WindowStartupLocation="CenterOwner">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="{Binding Title}" Style="{StaticResource HeadingTextStyle}" />
            <TextBlock Style="{StaticResource SubtleTextStyle}"
                       TextWrapping="Wrap"
                       Margin="0,6,0,14"
                       Text="This app only creates/edits static groups - an explicit device list. A dynamic (rule-based) group's rules can only be managed from LibreNMS's own web UI." />

            <TextBlock Text="Name" Style="{StaticResource SectionHeaderStyle}" />
            <TextBox x:Name="NameBox" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />

            <TextBlock Text="Description (optional)" Style="{StaticResource SectionHeaderStyle}" Margin="0,14,0,6" />
            <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" />

            <TextBlock Text="Devices" Style="{StaticResource SectionHeaderStyle}" Margin="0,14,0,6" />
            <TextBox Style="{StaticResource SearchTextBoxStyle}"
                     Tag="Search devices"
                     Text="{Binding DeviceSearchText, UpdateSourceTrigger=PropertyChanged, Delay=200}"
                     Margin="0,0,0,8" />
        </StackPanel>

        <Border Grid.Row="1"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="5"
                Padding="10,4">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding DevicePickerView}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <CheckBox Content="{Binding Name}" IsChecked="{Binding IsChecked}" Margin="0,5" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <StackPanel Grid.Row="2">
            <Border Background="#33DA3633"
                    BorderBrush="{StaticResource CriticalBrush}"
                    BorderThickness="1"
                    CornerRadius="5"
                    Padding="12,10"
                    Margin="0,14,0,0"
                    Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" />
            </Border>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <TextBlock Text="Saving..."
                           Style="{StaticResource SubtleTextStyle}"
                           VerticalAlignment="Center"
                           Margin="0,0,12,0"
                           Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
                <Button Content="Cancel" IsCancel="True" Margin="0,0,8,0" />
                <Button Content="Save"
                        Command="{Binding SaveCommand}"
                        Style="{StaticResource PrimaryButtonStyle}"
                        IsDefault="True" />
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
