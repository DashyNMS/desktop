<UserControl x:Class="DesktopNMS.Views.LocationsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:DesktopNMS.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:LocationsViewModel}"
             d:DesignHeight="600" d:DesignWidth="1100">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ======================== Search + Add ======================== -->
        <!-- No type pills here (unlike GroupsView) - every location is the
             same kind of thing. Refresh is deliberately not duplicated here:
             the main tab bar's Refresh button (RefreshCurrentTabCommand)
             already covers whichever tab is showing. -->
        <Border Grid.Row="0"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="18,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBox x:Name="SearchBox"
                             Width="240"
                             Style="{StaticResource SearchTextBoxStyle}"
                             Tag="Search locations"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=200}"
                             ToolTip="Filter by name"
                             Margin="0,0,8,0" />

                    <Button Command="{Binding ClearFiltersCommand}"
                            Style="{StaticResource IconButtonStyle}"
                            ToolTip="Clear search"
                            Visibility="{Binding HasAnyFilterApplied, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="&#xE711;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13" />
                    </Button>
                </StackPanel>

                <Rectangle Grid.Column="2" Style="{StaticResource ToolBarSeparatorStyle}" Margin="14,4" />

                <Button Grid.Column="3"
                        Command="{Binding AddLocationCommand}"
                        Style="{StaticResource IconButtonStyle}"
                        ToolTip="Add location">
                    <TextBlock Text="+" FontFamily="Segoe UI" FontSize="20" FontWeight="SemiBold" />
                </Button>
            </Grid>
        </Border>

        <!-- ======================== Error banner ======================== -->
        <Border Grid.Row="1"
                Background="#33DA3633"
                BorderBrush="{StaticResource CriticalBrush}"
                BorderThickness="0,0,0,1"
                Padding="18,10"
                Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap" />
        </Border>

        <!-- ======================== Location list ======================== -->
        <Grid Grid.Row="2">
            <DataGrid x:Name="LocationsGrid" ItemsSource="{Binding LocationsView}" IsReadOnly="True">
                <DataGrid.Columns>

                    <DataGridTemplateColumn Header="Name" Width="*" SortMemberPath="Name">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Margin="10,0" VerticalAlignment="Center" Cursor="Hand" TextTrimming="CharacterEllipsis">
                                    <Hyperlink Command="{Binding ViewDevicesCommand}" ToolTip="Show this location's devices on the Devices tab">
                                        <Run Text="{Binding Name, Mode=OneWay}" />
                                    </Hyperlink>
                                </TextBlock>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn Header="Latitude" Width="100" Binding="{Binding LatitudeText}" SortMemberPath="Location.Latitude">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="TextAlignment" Value="Right" />
                                <Setter Property="Margin" Value="0,0,10,0" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <DataGridTextColumn Header="Longitude" Width="100" Binding="{Binding LongitudeText}" SortMemberPath="Location.Longitude">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="TextAlignment" Value="Right" />
                                <Setter Property="Margin" Value="0,0,10,0" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <DataGridTextColumn Header="Fixed" Width="70" Binding="{Binding FixedCoordinatesText}" SortMemberPath="FixedCoordinatesText"
                                         ToolTipService.ToolTip="Whether these coordinates stay fixed, or a device's own reported coordinates can overwrite them" />

                    <DataGridTextColumn Header="Devices" Width="80" Binding="{Binding MemberCountText}" SortMemberPath="MemberCount">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="TextAlignment" Value="Right" />
                                <Setter Property="Margin" Value="0,0,10,0" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <DataGridTemplateColumn Header="" Width="90" CanUserSort="False">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="6,0">
                                    <Button Command="{Binding EditCommand}"
                                            Style="{StaticResource IconButtonStyle}"
                                            Width="28"
                                            Height="28"
                                            FontSize="13"
                                            ToolTip="Edit this location">
                                        <TextBlock Text="&#xE70F;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13" />
                                    </Button>
                                    <Button Command="{Binding DeleteCommand}"
                                            Style="{StaticResource IconButtonStyle}"
                                            Width="28"
                                            Height="28"
                                            FontSize="13"
                                            ToolTip="Delete this location"
                                            Foreground="{StaticResource CriticalBrush}">
                                        <TextBlock Text="&#xE74D;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13" />
                                    </Button>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                </DataGrid.Columns>
            </DataGrid>

            <TextBlock Text="No locations yet - use + to create one."
                       Style="{StaticResource SubtleTextStyle}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Visibility="{Binding HasLocations, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}" />
        </Grid>
    </Grid>
</UserControl>
