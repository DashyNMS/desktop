<UserControl x:Class="DesktopNMS.Views.GeoMapView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:DesktopNMS.ViewModels"
             xmlns:views="clr-namespace:DesktopNMS.Views"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:GeoMapViewModel}"
             d:DesignHeight="600" d:DesignWidth="1100">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ======================== Scope + find ======================== -->
        <Border Grid.Row="0"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="18,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <WrapPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="Show"
                               Style="{StaticResource SubtleTextStyle}"
                               VerticalAlignment="Center"
                               Margin="0,0,10,0" />
                    <ComboBox ItemsSource="{Binding Scopes}"
                              SelectedItem="{Binding SelectedScope}"
                              DisplayMemberPath="DisplayName"
                              Width="240"
                              ToolTip="The whole network, or one device group"
                              VerticalAlignment="Center" />

                    <TextBlock Text="{Binding SummaryText}"
                               Style="{StaticResource SubtleTextStyle}"
                               VerticalAlignment="Center"
                               ToolTip="Devices without coordinates have no location, or a location LibreNMS hasn't got coordinates for"
                               Margin="16,0,0,0" />
                </WrapPanel>

                <TextBox Grid.Column="1"
                         x:Name="SearchBox"
                         Width="220"
                         Style="{StaticResource SearchTextBoxStyle}"
                         Tag="Find location or device"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=300}"
                         ToolTip="Find a location, or the location of a device, by name"
                         VerticalAlignment="Center" />

                <Rectangle Grid.Column="2" Style="{StaticResource ToolBarSeparatorStyle}" Margin="14,4" />

                <Button Grid.Column="3"
                        Command="{Binding FitToViewCommand}"
                        Style="{StaticResource IconButtonStyle}"
                        ToolTip="Fit every location in view"
                        VerticalAlignment="Center">
                    <TextBlock Text="&#xE9A6;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="15" />
                </Button>
            </Grid>
        </Border>

        <!-- ======================== Error banner ======================== -->
        <Border Grid.Row="1"
                Background="#33DA3633"
                BorderBrush="{StaticResource CriticalBrush}"
                BorderThickness="0,0,0,1"
                Padding="18,10"
                Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap" />
        </Border>

        <!-- ======================== Map + details ======================== -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <views:GeoMapCanvas x:Name="MapCanvas"
                                    Pins="{Binding Pins}"
                                    SelectedPins="{Binding SelectedPins}"
                                    TileTemplate="{Binding TileTemplate}"
                                    Tiles="{Binding Tiles}" />

                <views:LoadingOverlay Text="{Binding LoadingText}"
                                      Visibility="{Binding ShowLoading, Converter={StaticResource BoolToVisibility}}" />

                <!-- Colour key for the donut pins: each ring shows the share of
                     a location's devices in each state. -->
                <Border HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        Margin="12"
                        Padding="10,7"
                        CornerRadius="6"
                        Background="{StaticResource SurfaceBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        Opacity="0.92"
                        IsHitTestVisible="False">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="9" Height="9" Fill="{Binding Source={x:Static vm:MapLegend.Up}}" VerticalAlignment="Center" />
                            <TextBlock Text="Up" Style="{StaticResource SubtleTextStyle}" FontSize="11" Margin="5,0,12,0" />
                            <Ellipse Width="9" Height="9" Fill="{Binding Source={x:Static vm:MapLegend.Down}}" VerticalAlignment="Center" />
                            <TextBlock Text="Down" Style="{StaticResource SubtleTextStyle}" FontSize="11" Margin="5,0,12,0" />
                            <Ellipse Width="9" Height="9" Fill="{Binding Source={x:Static vm:MapLegend.Maintenance}}" VerticalAlignment="Center" />
                            <TextBlock Text="Maintenance" Style="{StaticResource SubtleTextStyle}" FontSize="11" Margin="5,0,12,0" />
                            <Ellipse Width="9" Height="9" Fill="{Binding Source={x:Static vm:MapLegend.Inactive}}" VerticalAlignment="Center" />
                            <TextBlock Text="Disabled" Style="{StaticResource SubtleTextStyle}" FontSize="11" Margin="5,0,0,0" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Background="{StaticResource SurfaceBrush}"
                        CornerRadius="6"
                        Padding="16,10"
                        IsHitTestVisible="False"
                        Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="None of these devices are at a location with coordinates. Set coordinates on a location in the Locations tab (or let LibreNMS geocode it) to see it here."
                               TextWrapping="Wrap"
                               MaxWidth="380"
                               TextAlignment="Center"
                               Style="{StaticResource SubtleTextStyle}" />
                </Border>

                <TextBlock Text="Scroll to zoom · drag to pan · click a pin for its devices · double-click a merged pin to zoom in"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Bottom"
                           Margin="0,0,0,0"
                           Padding="10,4"
                           FontSize="11"
                           IsHitTestVisible="False"
                           Background="{StaticResource SurfaceBrush}"
                           Opacity="0.85"
                           Style="{StaticResource SubtleTextStyle}" />

                <!-- The tile provider's credit. OpenStreetMap's licence
                     requires it on the map, with a link to their copyright
                     page; any other tile server just gets named. -->
                <Border HorizontalAlignment="Right"
                        VerticalAlignment="Bottom"
                        Background="{StaticResource SurfaceBrush}"
                        Opacity="0.85"
                        Padding="8,3">
                    <Grid>
                        <TextBlock FontSize="11"
                                   Visibility="{Binding IsOpenStreetMap, Converter={StaticResource BoolToVisibility}}">
                            <Hyperlink Command="{Binding OpenAttributionCommand}"
                                       Foreground="{StaticResource TextSecondaryBrush}">© OpenStreetMap contributors</Hyperlink>
                        </TextBlock>
                        <TextBlock Text="{Binding OtherTilesCredit}"
                                   FontSize="11"
                                   Style="{StaticResource SubtleTextStyle}"
                                   Visibility="{Binding IsOpenStreetMap, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}" />
                    </Grid>
                </Border>
            </Grid>

            <!-- ======================== Selected location(s) ======================== -->
            <Border Grid.Column="1"
                    Width="320"
                    Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1,0,0,0"
                    Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibility}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Pinned above the list, so it's there however long
                         the device list gets. -->
                    <Border Grid.Row="0"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="0,0,0,1"
                            Padding="18,14">
                        <Button Command="{Binding ShowInDevicesCommand}"
                                ToolTip="Open the Devices tab filtered to just this location"
                                HorizontalAlignment="Stretch"
                                Padding="12,7">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE71C;"
                                           FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                           FontSize="13"
                                           VerticalAlignment="Center"
                                           Margin="0,0,8,0" />
                                <TextBlock Text="{Binding ShowInDevicesLabel}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </Border>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding SelectedPins}" Margin="18,12,18,18">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:GeoPin}">
                                    <StackPanel Margin="0,6,0,12">
                                        <TextBlock Text="{Binding Name}" Style="{StaticResource HeadingTextStyle}" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding SummaryText}" Style="{StaticResource SubtleTextStyle}" Margin="0,2,0,8" />
    
                                        <ItemsControl ItemsSource="{Binding Devices}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type vm:GeoDeviceRow}">
                                                    <Button Command="{Binding DataContext.OpenDeviceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"
                                                            Cursor="Hand"
                                                            HorizontalContentAlignment="Stretch"
                                                            ToolTip="Open this device">
                                                        <Button.Template>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border x:Name="Row" Background="Transparent" CornerRadius="4" Padding="6,4">
                                                                    <ContentPresenter />
                                                                </Border>
                                                                <ControlTemplate.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter TargetName="Row" Property="Background" Value="{StaticResource SurfaceAltBrush}" />
                                                                    </Trigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Button.Template>
                                                        <StackPanel Orientation="Horizontal">
                                                            <Ellipse Width="9"
                                                                     Height="9"
                                                                     Fill="{Binding State, Converter={StaticResource DeviceStateToBrush}}"
                                                                     VerticalAlignment="Center"
                                                                     Margin="0,0,8,0" />
                                                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                                        </StackPanel>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
