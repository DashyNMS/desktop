<UserControl x:Class="DesktopNMS.Views.RulesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:DesktopNMS.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:RulesViewModel}"
             d:DesignHeight="600" d:DesignWidth="1100">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ======================== Search + Add ======================== -->
        <!-- Refresh is deliberately not duplicated here: the main tab bar's
             Refresh button (RefreshCurrentTabCommand) already covers
             whichever tab is showing. -->
        <Border Grid.Row="0"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="18,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBox x:Name="SearchBox"
                             Width="240"
                             Style="{StaticResource SearchTextBoxStyle}"
                             Tag="Search rules"
                             Text="{Binding Filtered.SearchText, UpdateSourceTrigger=PropertyChanged, Delay=200}"
                             ToolTip="Filter by name, severity, notes or target"
                             Margin="0,0,8,0" />

                    <Button Command="{Binding ClearFiltersCommand}"
                            Style="{StaticResource IconButtonStyle}"
                            ToolTip="Clear search"
                            Visibility="{Binding Filtered.SearchText, Converter={StaticResource StringToVisibility}}">
                        <TextBlock Text="&#xE711;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13" />
                    </Button>
                </StackPanel>

                <Rectangle Grid.Column="2" Style="{StaticResource ToolBarSeparatorStyle}" Margin="14,4" />

                <Button Grid.Column="3"
                        Command="{Binding AddRuleCommand}"
                        Style="{StaticResource IconButtonStyle}"
                        ToolTip="Add rule">
                    <TextBlock Text="+" FontFamily="Segoe UI" FontSize="20" FontWeight="SemiBold" />
                </Button>
            </Grid>
        </Border>

        <!-- ======================== Error banner ======================== -->
        <Border Grid.Row="1"
                Background="#33DA3633"
                BorderBrush="{StaticResource CriticalBrush}"
                BorderThickness="0,0,0,1"
                Padding="18,10"
                Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap" />
        </Border>

        <!-- ======================== Rule list ======================== -->
        <Grid Grid.Row="2">
            <DataGrid x:Name="RulesGrid"
                      ItemsSource="{Binding Filtered.View}"
                      IsReadOnly="True"
                      Visibility="{Binding LoadState.HasVisibleItems, Converter={StaticResource BoolToVisibility}}">
                <DataGrid.Columns>

                    <DataGridTemplateColumn Header="Severity" Width="90" SortMemberPath="SeverityText">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="10,0">
                                    <Ellipse Width="9"
                                             Height="9"
                                             Margin="0,0,6,0"
                                             VerticalAlignment="Center"
                                             Fill="{Binding Severity, Converter={StaticResource SeverityToBrush}}" />
                                    <TextBlock Text="{Binding SeverityText}" VerticalAlignment="Center" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn Header="Name" Width="1*" Binding="{Binding Name}" />

                    <DataGridTextColumn Header="Target" Width="1*" Binding="{Binding TargetSummary}" />

                    <!-- DataGridCheckBoxColumn's Binding defaults to TwoWay
                         regardless of IsReadOnly (that only disables the
                         interactive checkbox, not the binding mode WPF
                         constructs), and IsDisabled has no setter - so the
                         mode must be forced to OneWay explicitly or WPF
                         throws trying to build a TwoWay binding against a
                         read-only property. -->
                    <DataGridCheckBoxColumn Header="Disabled" Width="70" Binding="{Binding IsDisabled, Mode=OneWay}" IsReadOnly="True" />

                    <DataGridTextColumn Header="Notes" Width="1*" Binding="{Binding Notes}" />

                    <DataGridTemplateColumn Header="" Width="90" CanUserSort="False">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="6,0">
                                    <Button Command="{Binding EditCommand}"
                                            Style="{StaticResource IconButtonStyle}"
                                            Width="28"
                                            Height="28"
                                            FontSize="13"
                                            ToolTip="Edit this rule">
                                        <TextBlock Text="&#xE70F;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13" />
                                    </Button>
                                    <Button Command="{Binding DeleteCommand}"
                                            Style="{StaticResource IconButtonStyle}"
                                            Width="28"
                                            Height="28"
                                            FontSize="13"
                                            ToolTip="Delete this rule"
                                            Foreground="{StaticResource CriticalBrush}">
                                        <TextBlock Text="&#xE74D;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13" />
                                    </Button>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                </DataGrid.Columns>
            </DataGrid>

            <TextBlock Text="Loading rules..."
                       Style="{StaticResource SubtleTextStyle}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Visibility="{Binding LoadState.IsLoading, Converter={StaticResource BoolToVisibility}}" />

            <TextBlock Text="No alert rules yet - use + to create one."
                       Style="{StaticResource SubtleTextStyle}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Visibility="{Binding LoadState.IsEmpty, Converter={StaticResource BoolToVisibility}}" />

            <TextBlock Text="No rules match your search."
                       Style="{StaticResource SubtleTextStyle}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Visibility="{Binding LoadState.IsNoMatches, Converter={StaticResource BoolToVisibility}}" />
        </Grid>
    </Grid>
</UserControl>
