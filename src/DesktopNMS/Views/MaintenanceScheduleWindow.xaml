<Window x:Class="DesktopNMS.Views.MaintenanceScheduleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:DesktopNMS.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MaintenanceScheduleViewModel}"
        Title="{Binding Title}"
        Width="460"
        SizeToContent="Height"
        MinWidth="420"
        ShowInTaskbar="False"
        Icon="pack://application:,,,/Assets/app.ico"
        Background="{StaticResource BackgroundBrush}"
        WindowStartupLocation="CenterOwner">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{Binding Title}" Style="{StaticResource HeadingTextStyle}" Margin="0,0,0,14" />

        <StackPanel Grid.Row="1">
            <TextBlock Text="Title (optional)" Style="{StaticResource SectionHeaderStyle}" />
            <TextBox x:Name="TitleBox"
                     Text="{Binding MaintenanceTitle, UpdateSourceTrigger=PropertyChanged}"
                     ToolTip="{Binding TitlePlaceholder, StringFormat='Defaults to \{0\}'}"
                     Margin="0,0,0,14" />

            <TextBlock Text="Notes (optional)" Style="{StaticResource SectionHeaderStyle}" />
            <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,14" />

            <TextBlock Text="Start" Style="{StaticResource SectionHeaderStyle}" Margin="0,0,0,6" />
            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <RadioButton Content="Now" GroupName="Start" IsChecked="{Binding StartNow}" Margin="0,0,16,0" VerticalAlignment="Center" />
                <RadioButton Content="At a scheduled time" GroupName="Start" IsChecked="{Binding IsScheduledForLater}" VerticalAlignment="Center" />
            </StackPanel>
            <Grid Margin="0,0,0,14" Visibility="{Binding IsScheduledForLater, Converter={StaticResource BoolToVisibility}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="110" />
                </Grid.ColumnDefinitions>
                <DatePicker Grid.Column="0" SelectedDate="{Binding ScheduledDate}" />
                <TextBox Grid.Column="2" Text="{Binding ScheduledTime, UpdateSourceTrigger=PropertyChanged}" ToolTip="24-hour, e.g. 09:00 or 17:30" />
            </Grid>

            <TextBlock Text="Duration" Style="{StaticResource SectionHeaderStyle}" Margin="0,0,0,6" />
            <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" Text="{Binding DurationHoursText, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Grid.Column="1" Text="hours" Style="{StaticResource SubtleTextStyle}" VerticalAlignment="Center" Margin="6,0,0,0" />
                <TextBox Grid.Column="3" Text="{Binding DurationMinutesText, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Grid.Column="4" Text="minutes" Style="{StaticResource SubtleTextStyle}" VerticalAlignment="Center" Margin="6,0,0,0" />
            </Grid>

            <TextBlock Text="Alert behaviour" Style="{StaticResource SectionHeaderStyle}" />
            <ComboBox ItemsSource="{Binding Behaviors}" SelectedItem="{Binding SelectedBehavior}" Margin="0,0,0,4" />

            <TextBlock Text="LibreNMS has no route to cancel a maintenance window once scheduled - it can only be ended early from its own web UI."
                       Style="{StaticResource SubtleTextStyle}"
                       TextWrapping="Wrap"
                       Margin="0,10,0,0" />
        </StackPanel>

        <StackPanel Grid.Row="2">
            <Border Background="#33DA3633"
                    BorderBrush="{StaticResource CriticalBrush}"
                    BorderThickness="1"
                    CornerRadius="5"
                    Padding="12,10"
                    Margin="0,14,0,0"
                    Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" />
            </Border>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <TextBlock Text="Scheduling..."
                           Style="{StaticResource SubtleTextStyle}"
                           VerticalAlignment="Center"
                           Margin="0,0,12,0"
                           Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
                <Button Content="Cancel" IsCancel="True" Margin="0,0,8,0" />
                <Button Content="Schedule"
                        Command="{Binding SaveCommand}"
                        Style="{StaticResource PrimaryButtonStyle}"
                        IsDefault="True" />
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
