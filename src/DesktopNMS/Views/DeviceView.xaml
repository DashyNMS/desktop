<Window x:Class="DesktopNMS.Views.DeviceView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:DesktopNMS.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:DeviceDetailViewModel}"
        Title="{Binding Name}"
        Width="820"
        Height="720"
        MinWidth="560"
        MinHeight="420"
        Icon="pack://application:,,,/Assets/app.ico"
        Background="{StaticResource BackgroundBrush}"
        WindowStartupLocation="CenterOwner">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ======================== Header ======================== -->
        <Border Grid.Row="0"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="18,14">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                    <Ellipse Width="9"
                             Height="9"
                             Margin="0,0,8,0"
                             VerticalAlignment="Center"
                             Fill="{Binding State, Converter={StaticResource DeviceStateToBrush}}" />
                    <TextBlock Text="{Binding StateText}" Style="{StaticResource SubtleTextStyle}" VerticalAlignment="Center" />
                </StackPanel>

                <TextBlock Text="{Binding Name}" Style="{StaticResource HeadingTextStyle}" TextWrapping="Wrap" />
                <TextBlock Text="{Binding AlternateName}"
                           Style="{StaticResource SubtleTextStyle}"
                           TextWrapping="Wrap"
                           Visibility="{Binding HasAlternateName, Converter={StaticResource BoolToVisibility}}" />

                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="IP address" Style="{StaticResource SectionHeaderStyle}" />
                        <TextBlock Text="{Binding Ip}" TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Operating system" Style="{StaticResource SectionHeaderStyle}" />
                        <TextBlock Text="{Binding Os}" TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Uptime" Style="{StaticResource SectionHeaderStyle}" />
                        <TextBlock Text="{Binding UptimeText}" TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>

                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Hardware" Style="{StaticResource SectionHeaderStyle}" />
                        <TextBlock Text="{Binding Hardware}" TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Type" Style="{StaticResource SectionHeaderStyle}" />
                        <TextBlock Text="{Binding Type}" TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Location" Style="{StaticResource SectionHeaderStyle}" />
                        <TextBlock Text="{Binding Location}" TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <!-- ======================== Error banner ======================== -->
        <Border Grid.Row="1"
                Background="#33DA3633"
                BorderBrush="{StaticResource CriticalBrush}"
                BorderThickness="0,0,0,1"
                Padding="18,10"
                Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap" />
        </Border>

        <!-- ======================== Content ======================== -->
        <Grid Grid.Row="2" Margin="18">
            <Grid.RowDefinitions>
                <RowDefinition Height="2*" MinHeight="120" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="1.2*" MinHeight="120" />
            </Grid.RowDefinitions>

            <!-- ==================== Sensors ==================== -->
            <Border Grid.Row="0"
                    Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="6">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Text="Sensors"
                               FontWeight="SemiBold"
                               Margin="12,10" />

                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding Sensors}"
                              Visibility="{Binding HasSensors, Converter={StaticResource BoolToVisibility}}"
                              IsReadOnly="True"
                              HeadersVisibility="Column">
                        <DataGrid.Columns>

                            <DataGridTemplateColumn Header="Status" Width="90" SortMemberPath="Severity">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Margin="8,0">
                                            <Ellipse Width="9"
                                                     Height="9"
                                                     Margin="0,0,6,0"
                                                     VerticalAlignment="Center"
                                                     Fill="{Binding Severity, Converter={StaticResource SeverityToBrush}}" />
                                            <TextBlock Text="{Binding SeverityText}" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Header="Class" Width="110" Binding="{Binding Model.SensorClass}" />
                            <DataGridTextColumn Header="Sensor" Width="*" Binding="{Binding Description}" />
                            <DataGridTextColumn Header="Value" Width="100" Binding="{Binding ValueText}" />
                            <DataGridTextColumn Header="Updated" Width="140" Binding="{Binding LastUpdateText}" />

                        </DataGrid.Columns>
                    </DataGrid>

                    <TextBlock Grid.Row="1"
                               Text="No sensors reported for this device."
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               IsHitTestVisible="False"
                               Visibility="{Binding HasSensors, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}"
                               Style="{StaticResource SubtleTextStyle}" />
                </Grid>
            </Border>

            <GridSplitter Grid.Row="1"
                          Height="4"
                          HorizontalAlignment="Stretch"
                          Background="Transparent"
                          Margin="0,8" />

            <!-- ==================== Alert history ==================== -->
            <Border Grid.Row="2"
                    Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="6">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Text="Alert history"
                               FontWeight="SemiBold"
                               Margin="12,10" />

                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding AlertHistory}"
                              Visibility="{Binding HasAlertHistory, Converter={StaticResource BoolToVisibility}}"
                              IsReadOnly="True"
                              HeadersVisibility="Column">
                        <DataGrid.Columns>

                            <DataGridTemplateColumn Header="Severity" Width="90" SortMemberPath="Severity">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Margin="8,0">
                                            <Ellipse Width="9"
                                                     Height="9"
                                                     Margin="0,0,6,0"
                                                     VerticalAlignment="Center"
                                                     Fill="{Binding Severity, Converter={StaticResource SeverityToBrush}}" />
                                            <TextBlock Text="{Binding SeverityText}" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Header="Rule" Width="*" Binding="{Binding RuleName}" />
                            <DataGridTextColumn Header="State" Width="110" Binding="{Binding StateText}" />
                            <DataGridTextColumn Header="Time" Width="150" Binding="{Binding TimeText}" />

                        </DataGrid.Columns>
                    </DataGrid>

                    <TextBlock Grid.Row="1"
                               Text="No alert history for this device."
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               IsHitTestVisible="False"
                               Visibility="{Binding HasAlertHistory, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}"
                               Style="{StaticResource SubtleTextStyle}" />
                </Grid>
            </Border>
        </Grid>

        <!-- ======================== Footer ======================== -->
        <Border Grid.Row="3"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="18,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="Refreshing..."
                           Style="{StaticResource SubtleTextStyle}"
                           VerticalAlignment="Center"
                           Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="Refresh" Command="{Binding RefreshCommand}" Padding="12,7" Margin="0,0,8,0" />
                    <Button Content="Show alerts for this device" Command="{Binding ShowAlertsCommand}" Padding="12,7" Margin="0,0,8,0" />
                    <Button Content="Open in LibreNMS" Command="{Binding OpenInLibreNmsCommand}" Style="{StaticResource PrimaryButtonStyle}" Padding="12,7" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
