<Window x:Class="DesktopNMS.Views.DeviceView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:DesktopNMS.ViewModels"
        xmlns:views="clr-namespace:DesktopNMS.Views"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        xmlns:svgc="clr-namespace:SharpVectors.Converters;assembly=SharpVectors.Converters.Wpf"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:DeviceDetailViewModel}"
        Title="{Binding Name}"
        Width="1200"
        Height="800"
        MinWidth="640"
        MinHeight="480"
        Icon="pack://application:,,,/Assets/app.ico"
        Background="{StaticResource BackgroundBrush}"
        WindowStartupLocation="CenterOwner">

    <!-- Its own title bar, like the main window's (see TitleBar below). -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40"
                      ResizeBorderThickness="6"
                      CornerRadius="0"
                      GlassFrameThickness="0,0,0,1"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- ======================== Sidebar ======================== -->
        <!-- A compact sidebar item with an icon: the Segoe glyph goes in Tag,
             the label in Content. Tighter than Settings' own nav items, since
             this sidebar holds a lot more. -->
        <Style x:Key="DeviceNavItemStyle" TargetType="ToggleButton">
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <!-- The main window's sidebar look: a soft accent tint
                             and an accent bar when selected. -->
                        <Grid Background="Transparent">
                        <Border x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="28" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="Glyph"
                                           Grid.Column="0"
                                           Text="{TemplateBinding Tag}"
                                           FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                           FontSize="14"
                                           TextAlignment="Center"
                                           Foreground="{TemplateBinding Foreground}"
                                           VerticalAlignment="Center" />
                                <!-- Plain-text labels are drawn by this
                                     string-only template, not the presenter's
                                     own TextBlock, which the app-wide implicit
                                     TextBlock style would reset (colour, size)
                                     so it wouldn't follow the button's state.
                                     Keyed by type, it leaves panel content
                                     (the Alerts item's badge) alone - a
                                     ContentTemplate would blank that. -->
                                <ContentPresenter Grid.Column="1" VerticalAlignment="Center">
                                    <ContentPresenter.Resources>
                                        <DataTemplate DataType="{x:Type sys:String}">
                                            <TextBlock Text="{Binding}"
                                                       FontSize="13"
                                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" />
                                        </DataTemplate>
                                    </ContentPresenter.Resources>
                                </ContentPresenter>
                            </Grid>
                        </Border>
                        <Border x:Name="Bar"
                                Width="3"
                                Height="16"
                                CornerRadius="1.5"
                                HorizontalAlignment="Left"
                                Background="{DynamicResource AccentBrush}"
                                Visibility="Collapsed" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                                <Setter TargetName="Root" Property="Background" Value="{StaticResource SurfaceHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource AccentSubtleBrush}" />
                                <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="Bar" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Icons only: an item's label shows as its tooltip instead. -->
        <Style x:Key="DeviceNavItemTipStyle" TargetType="ToggleButton" BasedOn="{StaticResource DeviceNavItemStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsDeviceNavExpanded}" Value="False">
                    <Setter Property="ToolTip" Value="{Binding Content, RelativeSource={RelativeSource Self}}" />
                    <Setter Property="ToolTipService.Placement" Value="Right" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- The sidebar's collapse button: an item's look, never selected. -->
        <Style x:Key="DeviceNavActionStyle" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
            <Setter Property="Height" Value="34" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="Transparent" CornerRadius="8" Padding="12,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="28" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Text="{TemplateBinding Tag}"
                                           FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                           FontSize="14"
                                           TextAlignment="Center"
                                           Foreground="{TemplateBinding Foreground}"
                                           VerticalAlignment="Center" />
                                <ContentPresenter Grid.Column="1" VerticalAlignment="Center">
                                    <ContentPresenter.Resources>
                                        <DataTemplate DataType="{x:Type sys:String}">
                                            <TextBlock Text="{Binding}"
                                                       FontSize="13"
                                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                        </DataTemplate>
                                    </ContentPresenter.Resources>
                                </ContentPresenter>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                                <Setter TargetName="Root" Property="Background" Value="{StaticResource SurfaceHoverBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsDeviceNavExpanded}" Value="False">
                    <Setter Property="ToolTip" Value="Show labels" />
                    <Setter Property="ToolTipService.Placement" Value="Right" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- A sidebar group heading that folds its group away - chevron,
             small caps text, and whatever else the Content carries (the
             alert badge on Alerts & logs). -->
        <Style x:Key="DeviceNavGroupHeaderStyle" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="Margin" Value="0,10,0,1" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="24" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Text="{TemplateBinding Tag}"
                                           FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                           FontSize="9"
                                           Foreground="{TemplateBinding Foreground}"
                                           VerticalAlignment="Center" />
                                <!-- As DeviceNavItemStyle: text headings drawn
                                     to match Alerts & logs' explicit text. -->
                                <ContentPresenter Grid.Column="1" VerticalAlignment="Center">
                                    <ContentPresenter.Resources>
                                        <DataTemplate DataType="{x:Type sys:String}">
                                            <TextBlock Text="{Binding}"
                                                       FontSize="11"
                                                       FontWeight="SemiBold"
                                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                        </DataTemplate>
                                    </ContentPresenter.Resources>
                                </ContentPresenter>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                                <Setter TargetName="Root" Property="Background" Value="{StaticResource SurfaceHoverBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <!-- Icons only: no headings, just a line between groups. -->
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsDeviceNavExpanded}" Value="False">
                    <Setter Property="IsHitTestVisible" Value="False" />
                    <Setter Property="Margin" Value="4,9,4,8" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Button">
                                <Rectangle Height="1" Fill="{StaticResource BorderBrush}" />
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- A card that behaves like a button - jumps to the named section
             tab when clicked - without looking like one. -->
        <Style x:Key="OverviewCardButtonStyle" TargetType="Button">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{StaticResource SurfaceBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="16,14">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ======================== Overview cards ======================== -->

        <!-- A plain (not clickable) Overview card. -->
        <Style x:Key="OverviewCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="16,14" />
        </Style>

        <!-- A card's heading: small caps, muted - "ACTIVE ALERTS". -->
        <Style x:Key="CardTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource SubtleTextStyle}">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>

        <!-- The note at a card heading's right: "2 open". -->
        <Style x:Key="CardNoteStyle" TargetType="TextBlock" BasedOn="{StaticResource SubtleTextStyle}">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="Opacity" Value="0.75" />
        </Style>

        <!-- The Device card's labels. -->
        <Style x:Key="KeyTextStyle" TargetType="TextBlock" BasedOn="{StaticResource SubtleTextStyle}">
            <Setter Property="Width" Value="112" />
            <Setter Property="Opacity" Value="0.8" />
        </Style>

        <Style x:Key="KeyRowStyle" TargetType="DockPanel">
            <Setter Property="Margin" Value="0,0,0,9" />
        </Style>

        <!-- A stat tile: a number and its label, with a coloured bar down the
             left edge (Tag, a brush) - the outer border's colour shows through
             its left padding. -->
        <Style x:Key="StatTileStyle" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Tag}" CornerRadius="12" Padding="3,0,0,0">
                            <Border x:Name="Root"
                                    Background="{StaticResource SurfaceBrush}"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="0,1,1,1"
                                    CornerRadius="9,12,12,9"
                                    Padding="14,12">
                                <ContentPresenter />
                            </Border>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{StaticResource SurfaceHoverBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- A thin usage bar: set its two columns' widths from a percentage. -->
        <Style x:Key="UsageTrackStyle" TargetType="Border">
            <Setter Property="Height" Value="5" />
            <Setter Property="CornerRadius" Value="2.5" />
            <Setter Property="Background" Value="{StaticResource SurfaceHoverBrush}" />
            <Setter Property="Margin" Value="0,5,0,0" />
        </Style>

        <!-- A borderless row inside a card that opens something (a neighbour). -->
        <Style x:Key="CardRowButtonStyle" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="Transparent" CornerRadius="6" Padding="4,7">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{StaticResource SurfaceHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Window buttons, as the main window's. -->
        <Style x:Key="DeviceCaptionButtonStyle" TargetType="Button" BasedOn="{StaticResource CaptionButtonStyle}">
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
        </Style>

        <!-- Unimus diff row tints - the status colours, faded right down so
             the line text stays readable on top of them. -->
        <SolidColorBrush x:Key="DiffRemovedRowBrush" Color="{StaticResource CriticalColor}" Opacity="0.18" />
        <SolidColorBrush x:Key="DiffAddedRowBrush" Color="{StaticResource OkColor}" Opacity="0.18" />
    </Window.Resources>

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ======================== Title bar ======================== -->
        <!-- Drawn by the app, like the main window's: the way here as a
             breadcrumb (#58 - each earlier device links back to it), back,
             forward and refresh, then the window buttons. Alt+Left/Right and
             the mouse's back/forward buttons work too. -->
        <Border Grid.Row="0"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                    <Image Source="pack://application:,,,/Assets/app.ico"
                           Width="18"
                           Height="18"
                           Margin="0,0,10,0"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock Text="Device" Style="{StaticResource SubtleTextStyle}" FontSize="13" VerticalAlignment="Center" />
                    <TextBlock Text="&#xE76C;"
                               FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                               FontSize="9"
                               Margin="8,0"
                               VerticalAlignment="Center"
                               Style="{StaticResource SubtleTextStyle}" />
                    <ItemsControl ItemsSource="{Binding History.Crumbs}"
                                  VerticalAlignment="Center"
                                  WindowChrome.IsHitTestVisibleInChrome="True">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Cursor="Hand" VerticalAlignment="Center" FontSize="13">
                                        <Hyperlink Command="{Binding DataContext.History.GoToCrumbCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                   CommandParameter="{Binding}"
                                                   ToolTip="Back to this device">
                                            <Run Text="{Binding Name, Mode=OneWay}" />
                                        </Hyperlink>
                                    </TextBlock>
                                    <TextBlock Text="&#xE76C;"
                                               FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                               FontSize="9"
                                               Margin="8,0"
                                               VerticalAlignment="Center"
                                               Style="{StaticResource SubtleTextStyle}" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="{Binding Name}"
                               FontSize="13"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                    <Button Command="{Binding History.BackCommand}"
                            IsEnabled="{Binding History.CanGoBack, FallbackValue=False}"
                            Style="{StaticResource IconButtonStyle}"
                            WindowChrome.IsHitTestVisibleInChrome="True"
                            Width="30"
                            Height="30"
                            ToolTip="Back (Alt+Left)">
                        <TextBlock Text="&#xE72B;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12" />
                    </Button>
                    <Button Command="{Binding History.ForwardCommand}"
                            IsEnabled="{Binding History.CanGoForward, FallbackValue=False}"
                            Style="{StaticResource IconButtonStyle}"
                            WindowChrome.IsHitTestVisibleInChrome="True"
                            Width="30"
                            Height="30"
                            ToolTip="Forward (Alt+Right)">
                        <TextBlock Text="&#xE72A;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12" />
                    </Button>
                    <Button Command="{Binding RefreshCommand}"
                            Style="{StaticResource IconButtonStyle}"
                            WindowChrome.IsHitTestVisibleInChrome="True"
                            Width="30"
                            Height="30"
                            ToolTip="Refresh now">
                        <TextBlock Text="&#xE72C;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13" />
                    </Button>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Style="{StaticResource DeviceCaptionButtonStyle}" ToolTip="Minimise" Click="OnMinimiseClick">
                        <TextBlock Text="&#xE921;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="10" />
                    </Button>
                    <Button x:Name="MaximiseButton" Style="{StaticResource DeviceCaptionButtonStyle}" ToolTip="Maximise" Click="OnMaximiseClick">
                        <TextBlock x:Name="MaximiseGlyph" Text="&#xE922;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="10" />
                    </Button>
                    <Button Style="{StaticResource CaptionCloseButtonStyle}"
                            WindowChrome.IsHitTestVisibleInChrome="True"
                            ToolTip="Close"
                            Click="OnCloseClick">
                        <TextBlock Text="&#xE8BB;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="10" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ======================== Error banner ======================== -->
        <Border Grid.Row="1"
                Background="#33DA3633"
                BorderBrush="{StaticResource CriticalBrush}"
                BorderThickness="0,0,0,1"
                Padding="18,10"
                Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap" />
        </Border>

        <!-- ======================== Sidebar + section content ======================== -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ==================== Section nav ==================== -->
            <!-- Grouped rather than one flat row: a handful of sections reads
                 fine as a row of tabs, but this window is growing towards a
                 dozen (FDB, ARP, routing, VLANs, ... alongside what is here
                 already) - a flat row would just run off the window edge,
                 where a vertical list keeps scaling by scrolling instead. -->
            <!-- Icons and labels, or icons only from the button at the
                 bottom (IsDeviceNavExpanded, remembered): 68px then, the
                 icons centred, with lines in place of the group headings. -->
            <Border Grid.Column="0"
                    Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,0,1,0"
                    ClipToBounds="True">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Width" Value="208" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsDeviceNavExpanded}" Value="False">
                                <Setter Property="Width" Value="68" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <DockPanel>
                <StackPanel DockPanel.Dock="Bottom" Margin="8,0,8,10">
                    <Rectangle Height="1" Fill="{StaticResource BorderBrush}" Margin="4,0,4,8" />
                    <Button Style="{StaticResource DeviceNavActionStyle}"
                            Tag="&#xE700;"
                            Content="Collapse"
                            Command="{Binding ToggleDeviceNavCommand}" />
                </StackPanel>
                <ScrollViewer>
                    <ScrollViewer.Style>
                        <Style TargetType="ScrollViewer">
                            <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
                            <Style.Triggers>
                                <!-- Icons only: a scrollbar would push them off centre; the wheel still scrolls. -->
                                <DataTrigger Binding="{Binding IsDeviceNavExpanded}" Value="False">
                                    <Setter Property="VerticalScrollBarVisibility" Value="Hidden" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ScrollViewer.Style>
                    <!-- Compact items with icons in foldable groups: each group
                         heading folds its items away (remembered in settings,
                         shared by every device window) - except the group
                         holding the open section, which always stays open. An
                         item hides once its section has loaded and found
                         nothing (ShowXNav stays true while loading, so items
                         don't pop in and shift the list), and a heading hides
                         with the last of its items. -->
                    <StackPanel Margin="8,12">
                        <ToggleButton Content="Overview"
                                      Tag="&#xE80F;"
                                      Style="{StaticResource DeviceNavItemTipStyle}"
                                      IsChecked="{Binding IsOverviewSelected, Mode=OneWay}"
                                      Command="{Binding SelectOverviewCommand}" />

                        <!-- ==================== Health ==================== -->
                        <Button Style="{StaticResource DeviceNavGroupHeaderStyle}"
                                Tag="{Binding HealthGroup.ExpanderGlyph}"
                                Command="{Binding HealthGroup.ToggleCommand}"
                                Content="HEALTH" />
                        <StackPanel Visibility="{Binding HealthGroup.IsExpanded, Converter={StaticResource BoolToVisibility}}">
                            <ToggleButton Content="Sensors"
                                          Tag="&#xE9D9;"
                                          Style="{StaticResource DeviceNavItemTipStyle}"
                                          IsChecked="{Binding IsSensorsSelected, Mode=OneWay}"
                                          Command="{Binding SelectSensorsCommand}" />
                            <ToggleButton Content="Graphs"
                                          Tag="&#xE9D2;"
                                          Style="{StaticResource DeviceNavItemTipStyle}"
                                          IsChecked="{Binding IsGraphsSelected, Mode=OneWay}"
                                          Command="{Binding SelectGraphsCommand}" />
                        </StackPanel>

                        <!-- ==================== Hardware ==================== -->
                        <Button Style="{StaticResource DeviceNavGroupHeaderStyle}"
                                Tag="{Binding HardwareGroup.ExpanderGlyph}"
                                Command="{Binding HardwareGroup.ToggleCommand}"
                                Content="HARDWARE"
                                Visibility="{Binding ShowHardwareGroup, Converter={StaticResource BoolToVisibility}}" />
                        <StackPanel Visibility="{Binding HardwareGroup.IsExpanded, Converter={StaticResource BoolToVisibility}}">
                            <ToggleButton Content="Resources"
                                          Tag="&#xEC4A;"
                                          Style="{StaticResource DeviceNavItemTipStyle}"
                                          IsChecked="{Binding IsResourcesSelected, Mode=OneWay}"
                                          Command="{Binding SelectResourcesCommand}"
                                          Visibility="{Binding ShowResourcesNav, Converter={StaticResource BoolToVisibility}}" />
                            <ToggleButton Content="Inventory"
                                          Tag="&#xE7B8;"
                                          Style="{StaticResource DeviceNavItemTipStyle}"
                                          IsChecked="{Binding IsInventorySelected, Mode=OneWay}"
                                          Command="{Binding SelectInventoryCommand}"
                                          Visibility="{Binding Inventory.ShowNav, Converter={StaticResource BoolToVisibility}}" />
                        </StackPanel>

                        <!-- ==================== Network ==================== -->
                        <Button Style="{StaticResource DeviceNavGroupHeaderStyle}"
                                Tag="{Binding NetworkGroup.ExpanderGlyph}"
                                Command="{Binding NetworkGroup.ToggleCommand}"
                                Content="NETWORK"
                                Visibility="{Binding HasNetworkSection, Converter={StaticResource BoolToVisibility}}" />
                        <StackPanel Visibility="{Binding NetworkGroup.IsExpanded, Converter={StaticResource BoolToVisibility}}">
                            <ToggleButton Content="Ports"
                                          Tag="&#xE839;"
                                          Style="{StaticResource DeviceNavItemTipStyle}"
                                          IsChecked="{Binding IsPortsSelected, Mode=OneWay}"
                                          Command="{Binding SelectPortsCommand}"
                                          Visibility="{Binding ShowPortsNav, Converter={StaticResource BoolToVisibility}}" />
                            <ToggleButton Content="VLANs"
                                          Tag="&#xE8EC;"
                                          Style="{StaticResource DeviceNavItemTipStyle}"
                                          IsChecked="{Binding IsVlansSelected, Mode=OneWay}"
                                          Command="{Binding SelectVlansCommand}"
                                          Visibility="{Binding ShowVlansNav, Converter={StaticResource BoolToVisibility}}" />
                            <ToggleButton Content="FDB"
                                          Tag="&#xE8FD;"
                                          Style="{StaticResource DeviceNavItemTipStyle}"
                                          IsChecked="{Binding IsFdbSelected, Mode=OneWay}"
                                          Command="{Binding SelectFdbCommand}"
                                          Visibility="{Binding ShowFdbNav, Converter={StaticResource BoolToVisibility}}" />
                            <ToggleButton Content="ARP"
                                          Tag="&#xE968;"
                                          Style="{StaticResource DeviceNavItemTipStyle}"
                                          IsChecked="{Binding IsArpSelected, Mode=OneWay}"
                                          Command="{Binding SelectArpCommand}"
                                          Visibility="{Binding ShowArpNav, Converter={StaticResource BoolToVisibility}}" />
                            <ToggleButton Content="Routing"
                                          Tag="&#xE8AB;"
                                          Style="{StaticResource DeviceNavItemTipStyle}"
                                          IsChecked="{Binding IsRoutingSelected, Mode=OneWay}"
                                          Command="{Binding SelectRoutingCommand}"
                                          Visibility="{Binding Routing.ShowNav, Converter={StaticResource BoolToVisibility}}" />
                            <ToggleButton Content="Wireless"
                                          Tag="&#xE701;"
                                          Style="{StaticResource DeviceNavItemTipStyle}"
                                          IsChecked="{Binding IsWirelessSelected, Mode=OneWay}"
                                          Command="{Binding SelectWirelessCommand}"
                                          Visibility="{Binding Wireless.ShowNav, Converter={StaticResource BoolToVisibility}}" />
                        </StackPanel>

                        <!-- ==================== Alerts & logs ==================== -->
                        <!-- Folded, the heading carries the active-alert badge
                             instead, so alerts are never out of sight. -->
                        <Button Style="{StaticResource DeviceNavGroupHeaderStyle}"
                                Tag="{Binding LogsGroup.ExpanderGlyph}"
                                Command="{Binding LogsGroup.ToggleCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="ALERTS &amp; LOGS"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                <Border Background="{StaticResource CriticalBrush}"
                                        CornerRadius="7"
                                        MinWidth="16"
                                        Height="16"
                                        Padding="4,0"
                                        Margin="8,0,0,0"
                                        VerticalAlignment="Center"
                                        ToolTip="Active alerts on this device"
                                        Visibility="{Binding ShowCollapsedAlertBadge, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Text="{Binding ActiveAlerts.Count, Mode=OneWay}"
                                               Foreground="White"
                                               FontSize="10"
                                               FontWeight="SemiBold"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Border>
                            </StackPanel>
                        </Button>
                        <StackPanel Visibility="{Binding LogsGroup.IsExpanded, Converter={StaticResource BoolToVisibility}}">
                            <Grid>
                            <ToggleButton Tag="&#xE7BA;"
                                          IsChecked="{Binding IsAlertsSelected, Mode=OneWay}"
                                          Command="{Binding SelectAlertsCommand}">
                                <!-- Its content is a panel, not text, so its
                                     icons-only tooltip is spelt out. -->
                                <ToggleButton.Style>
                                    <Style TargetType="ToggleButton" BasedOn="{StaticResource DeviceNavItemStyle}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsDeviceNavExpanded}" Value="False">
                                                <Setter Property="ToolTip" Value="Alerts" />
                                                <Setter Property="ToolTipService.Placement" Value="Right" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ToggleButton.Style>
                                <!-- A red count badge only while there are active
                                     alerts (#100) - it reads as "needs attention",
                                     unlike a plain count in brackets. -->
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Alerts"
                                               FontSize="13"
                                               VerticalAlignment="Center"
                                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" />
                                    <Border Background="{StaticResource CriticalBrush}"
                                            CornerRadius="8"
                                            MinWidth="18"
                                            Height="18"
                                            Padding="5,0"
                                            Margin="8,0,0,0"
                                            VerticalAlignment="Center"
                                            ToolTip="Active alerts on this device"
                                            Visibility="{Binding HasActiveAlerts, Converter={StaticResource BoolToVisibility}}">
                                        <TextBlock Text="{Binding ActiveAlerts.Count, Mode=OneWay}"
                                                   Foreground="White"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                    </Border>
                                </StackPanel>
                            </ToggleButton>
                            <!-- Icons only, the count sits on the icon instead. -->
                            <Border Background="{StaticResource CriticalBrush}"
                                    CornerRadius="7"
                                    MinWidth="15"
                                    Height="15"
                                    Padding="4,0"
                                    Margin="28,2,0,0"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Top"
                                    IsHitTestVisible="False"
                                    Visibility="{Binding ShowRailAlertBadge, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="{Binding ActiveAlerts.Count, Mode=OneWay}"
                                           Foreground="White"
                                           FontSize="9.5"
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Border>
                            </Grid>
                            <ToggleButton Content="Event log"
                                          Tag="&#xE81C;"
                                          Style="{StaticResource DeviceNavItemTipStyle}"
                                          IsChecked="{Binding IsEventLogSelected, Mode=OneWay}"
                                          Command="{Binding SelectEventLogCommand}" />
                        </StackPanel>

                        <!-- ==================== Integrations ==================== -->
                        <!-- Unimus only shows once this device actually has
                             something to show (a confirmed match, or a real
                             error checking); Graylog whenever it's set up (see
                             ShowGraylogSection for why). -->
                        <Button Style="{StaticResource DeviceNavGroupHeaderStyle}"
                                Tag="{Binding IntegrationsGroup.ExpanderGlyph}"
                                Command="{Binding IntegrationsGroup.ToggleCommand}"
                                Content="INTEGRATIONS"
                                Visibility="{Binding ShowIntegrationsGroup, Converter={StaticResource BoolToVisibility}}" />
                        <StackPanel Visibility="{Binding IntegrationsGroup.IsExpanded, Converter={StaticResource BoolToVisibility}}">
                            <ToggleButton Content="Graylog"
                                          Tag="&#xE8A5;"
                                          Style="{StaticResource DeviceNavItemTipStyle}"
                                          IsChecked="{Binding IsGraylogSelected, Mode=OneWay}"
                                          Command="{Binding SelectGraylogCommand}"
                                          Visibility="{Binding ShowGraylogSection, Converter={StaticResource BoolToVisibility}}" />
                            <ToggleButton Content="Unimus"
                                          Tag="&#xE90F;"
                                          Style="{StaticResource DeviceNavItemTipStyle}"
                                          IsChecked="{Binding IsConfigSelected, Mode=OneWay}"
                                          Command="{Binding SelectConfigCommand}"
                                          Visibility="{Binding ShowUnimusSection, Converter={StaticResource BoolToVisibility}}" />
                        </StackPanel>

                        <!-- No sidebar entry for Edit - the header's own Edit
                             button (next to Refresh) is the one way in, so
                             there is only one place to look for it rather
                             than two that both have to stay in sync. -->
                    </StackPanel>
                </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- ==================== Section content ==================== -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

            <!-- ==================== Device header ==================== -->
            <!-- Above every section: what the device is and its state, with
                 Open in, Edit and Show alerts. Rediscover lives in Edit. -->
            <Grid Grid.Row="0" Margin="24,18,24,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Width="48"
                        Height="48"
                        CornerRadius="12"
                        Margin="0,0,16,0"
                        VerticalAlignment="Center"
                        Background="{DynamicResource AccentSubtleBrush}">
                    <TextBlock Text="{Binding TypeGlyph}"
                               FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                               FontSize="22"
                               Foreground="{DynamicResource AccentBrush}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Border>

                <TextBlock Grid.Column="1"
                           Text="Loading device..."
                           Style="{StaticResource SubtleTextStyle}"
                           VerticalAlignment="Center"
                           Visibility="{Binding IsLoadingDevice, Converter={StaticResource BoolToVisibility}}" />

                <StackPanel Grid.Column="1"
                            VerticalAlignment="Center"
                            Visibility="{Binding IsLoadingDevice, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Name}" FontSize="20" FontWeight="Bold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />

                        <!-- State pill: the state's colour, faded behind its own text. -->
                        <Grid Margin="12,2,0,0" VerticalAlignment="Center">
                            <Border CornerRadius="10" Opacity="0.16" Background="{Binding State, Converter={StaticResource DeviceStateToBrush}}" />
                            <StackPanel Orientation="Horizontal" Margin="9,3">
                                <Ellipse Width="6"
                                         Height="6"
                                         Margin="0,0,6,0"
                                         VerticalAlignment="Center"
                                         Fill="{Binding State, Converter={StaticResource DeviceStateToBrush}}" />
                                <TextBlock Text="{Binding StateText}"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="{Binding State, Converter={StaticResource DeviceStateToBrush}}" />
                            </StackPanel>
                        </Grid>

                        <Border CornerRadius="10"
                                Margin="6,2,0,0"
                                Padding="9,3"
                                VerticalAlignment="Center"
                                Background="{StaticResource SurfaceHoverBrush}">
                            <TextBlock Text="{Binding Type}" FontSize="11" Style="{StaticResource SubtleTextStyle}" />
                        </Border>
                    </StackPanel>
                    <TextBlock Text="{Binding HeroSubtitle}"
                               Style="{StaticResource SubtleTextStyle}"
                               Margin="0,3,0,0"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                    <!-- Web/Telnet/SSH launch this device's own address via
                         whatever the OS has registered for that URI scheme -
                         see DeviceDetailViewModel.OpenExternal. Disabled rather
                         than hidden when the device has neither an IP nor a
                         hostname, so the tooltip still explains why. -->
                    <Button Content="Open in"
                            Style="{StaticResource ChipButtonStyle}"
                            Margin="0,0,8,0"
                            IsEnabled="{Binding CanOpenExternally}"
                            Click="OnOpenInClick"
                            ToolTip="Launch this device's address in an external tool">
                        <Button.ContextMenu>
                            <ContextMenu Placement="Bottom">
                                <MenuItem Header="Web (HTTP)" Command="{Binding OpenWebHttpCommand}" />
                                <MenuItem Header="Web (HTTPS)" Command="{Binding OpenWebHttpsCommand}" />
                                <MenuItem Header="Telnet" Command="{Binding OpenTelnetCommand}" />
                                <MenuItem Header="SSH" Command="{Binding OpenSshCommand}" />
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                    <Button Content="Edit"
                            Style="{StaticResource ChipButtonStyle}"
                            Margin="0,0,8,0"
                            Command="{Binding SelectEditCommand}"
                            ToolTip="Edit this device" />
                    <Button Content="Show alerts"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Padding="14,6"
                            Command="{Binding SelectAlertsCommand}"
                            ToolTip="This device's active alerts and history" />
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1">

            <!-- ==================== Overview ==================== -->
            <!-- Stat tiles, then cards: the device's details down the left,
                 ping and availability, alerts, resources, sensors and
                 neighbours beside it, and its busiest ports underneath. Cards
                 that open a section do so when clicked. -->
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          Visibility="{Binding IsOverviewSelected, Converter={StaticResource BoolToVisibility}}">
                <StackPanel Margin="24,14,24,24">

                    <!-- ==================== Stat tiles ==================== -->
                    <!-- UniformGrid lays out its visible children only, so the
                         Ports tile - hidden on a device with no interfaces -
                         leaves no gap. -->
                    <UniformGrid Rows="1">
                        <Button Style="{StaticResource StatTileStyle}"
                                Tag="{Binding AvailabilityTileSeverity, Converter={StaticResource SeverityToBrush}}"
                                Command="{Binding ShowPingGraphCommand}"
                                ToolTip="Availability over the last 30 days"
                                Margin="0,0,7,0">
                            <StackPanel>
                                <TextBlock Text="{Binding Availability30DayText}"
                                           FontSize="22"
                                           FontWeight="Bold"
                                           Foreground="{Binding AvailabilityTileSeverity, Converter={StaticResource SeverityToBrush}}" />
                                <TextBlock Text="Availability · 30 days" Style="{StaticResource SubtleTextStyle}" FontSize="11.5" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource StatTileStyle}"
                                Tag="{DynamicResource AccentBrush}"
                                Command="{Binding SelectGraphsCommand}"
                                Margin="7,0">
                            <StackPanel>
                                <TextBlock Text="{Binding UptimeText}" FontSize="22" FontWeight="Bold" />
                                <TextBlock Text="Uptime" Style="{StaticResource SubtleTextStyle}" FontSize="11.5" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource StatTileStyle}"
                                Tag="{Binding PortsTileSeverity, Converter={StaticResource SeverityToBrush}}"
                                Command="{Binding SelectPortsCommand}"
                                Margin="7,0"
                                Visibility="{Binding ShowPortsNav, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel>
                                <TextBlock Text="{Binding PortsUpText}"
                                           FontSize="22"
                                           FontWeight="Bold"
                                           Foreground="{Binding PortsTileSeverity, Converter={StaticResource SeverityToBrush}}" />
                                <TextBlock Text="Ports up" Style="{StaticResource SubtleTextStyle}" FontSize="11.5" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource StatTileStyle}"
                                Tag="{Binding AlertsTileSeverity, Converter={StaticResource SeverityToBrush}}"
                                Command="{Binding SelectAlertsCommand}"
                                Margin="7,0,0,0">
                            <StackPanel>
                                <TextBlock Text="{Binding ActiveAlerts.Count}"
                                           FontSize="22"
                                           FontWeight="Bold"
                                           Foreground="{Binding AlertsTileSeverity, Converter={StaticResource SeverityToBrush}}" />
                                <TextBlock Text="Active alerts" Style="{StaticResource SubtleTextStyle}" FontSize="11.5" />
                            </StackPanel>
                        </Button>
                    </UniformGrid>

                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="4*" MinWidth="260" />
                            <ColumnDefinition Width="8*" />
                        </Grid.ColumnDefinitions>

                        <!-- ==================== Device ==================== -->
                        <Border Grid.Column="0" Style="{StaticResource OverviewCardStyle}" Margin="0,0,7,0">
                            <StackPanel>
                                <TextBlock Text="DEVICE" Style="{StaticResource CardTitleStyle}" />

                                <!-- Only when hostname, sysName and display name
                                     don't all agree (#126), one row per distinct
                                     value - names that match share a row. -->
                                <ItemsControl ItemsSource="{Binding NameDetails}"
                                              Visibility="{Binding ShowNameDetails, Converter={StaticResource BoolToVisibility}}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <DockPanel Style="{StaticResource KeyRowStyle}">
                                                <TextBlock Text="{Binding Label}" Style="{StaticResource KeyTextStyle}" />
                                                <TextBlock Text="{Binding Value}" TextWrapping="Wrap" />
                                            </DockPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <DockPanel Style="{StaticResource KeyRowStyle}">
                                    <TextBlock Text="IP address" Style="{StaticResource KeyTextStyle}" />
                                    <TextBlock Text="{Binding Ip}" TextWrapping="Wrap" />
                                </DockPanel>
                                <DockPanel Style="{StaticResource KeyRowStyle}">
                                    <TextBlock Text="Operating system" Style="{StaticResource KeyTextStyle}" />
                                    <TextBlock Text="{Binding Os}" TextWrapping="Wrap" />
                                </DockPanel>
                                <DockPanel Style="{StaticResource KeyRowStyle}">
                                    <TextBlock Text="Hardware" Style="{StaticResource KeyTextStyle}" />
                                    <TextBlock Text="{Binding Hardware}" TextWrapping="Wrap" />
                                </DockPanel>
                                <DockPanel Style="{StaticResource KeyRowStyle}" Visibility="{Binding HasSerial, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Text="Serial" Style="{StaticResource KeyTextStyle}" />
                                    <TextBlock Text="{Binding Serial}" TextWrapping="Wrap" />
                                </DockPanel>
                                <DockPanel Style="{StaticResource KeyRowStyle}">
                                    <TextBlock Text="Location" Style="{StaticResource KeyTextStyle}" />
                                    <TextBlock TextWrapping="Wrap" Cursor="Hand">
                                        <Hyperlink Command="{Binding ShowDevicesForLocationCommand}"
                                                   ToolTip="Show every device at this location">
                                            <Run Text="{Binding Location, Mode=OneWay}" />
                                        </Hyperlink>
                                    </TextBlock>
                                </DockPanel>
                                <DockPanel Style="{StaticResource KeyRowStyle}" Visibility="{Binding HasContact, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Text="Contact" Style="{StaticResource KeyTextStyle}" />
                                    <TextBlock Text="{Binding Contact}" TextWrapping="Wrap" />
                                </DockPanel>
                                <!-- Each group links to the Devices tab isolated to it. -->
                                <DockPanel Style="{StaticResource KeyRowStyle}" Visibility="{Binding HasDeviceGroups, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Text="Groups" Style="{StaticResource KeyTextStyle}" VerticalAlignment="Top" Margin="0,2,0,0" />
                                    <ItemsControl ItemsSource="{Binding DeviceGroups}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border CornerRadius="10"
                                                        Padding="8,1"
                                                        Margin="0,0,4,4"
                                                        Background="{StaticResource SurfaceHoverBrush}">
                                                    <TextBlock FontSize="11.5" Cursor="Hand">
                                                        <Hyperlink Command="{Binding ShowDevicesForGroupCommand}"
                                                                   ToolTip="{Binding Description}">
                                                            <Run Text="{Binding Name, Mode=OneWay}" />
                                                        </Hyperlink>
                                                    </TextBlock>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </DockPanel>
                                <DockPanel Style="{StaticResource KeyRowStyle}" Visibility="{Binding HasDependencyParent, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Text="Depends on" Style="{StaticResource KeyTextStyle}" />
                                    <TextBlock Text="{Binding DependencyParentText}" TextWrapping="Wrap" />
                                </DockPanel>
                                <DockPanel Style="{StaticResource KeyRowStyle}" Visibility="{Binding HasInserted, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Text="Added" Style="{StaticResource KeyTextStyle}" />
                                    <TextBlock Text="{Binding InsertedText}" TextWrapping="Wrap" />
                                </DockPanel>
                                <DockPanel Style="{StaticResource KeyRowStyle}" Visibility="{Binding HasLastDiscovered, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Text="Last discovered" Style="{StaticResource KeyTextStyle}" />
                                    <TextBlock Text="{Binding LastDiscoveredText}" TextWrapping="Wrap" />
                                </DockPanel>
                                <DockPanel Style="{StaticResource KeyRowStyle}" Visibility="{Binding HasSysObjectId, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Text="Object ID" Style="{StaticResource KeyTextStyle}" />
                                    <TextBlock Text="{Binding SysObjectId}" TextWrapping="Wrap" />
                                </DockPanel>
                                <DockPanel Style="{StaticResource KeyRowStyle}" Visibility="{Binding HasSysDescr, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Text="Description" Style="{StaticResource KeyTextStyle}" VerticalAlignment="Top" />
                                    <TextBlock Text="{Binding SysDescr}" TextWrapping="Wrap" Style="{StaticResource SubtleTextStyle}" />
                                </DockPanel>
                            </StackPanel>
                        </Border>

                        <StackPanel Grid.Column="1" Margin="7,0,0,0">
                            <!-- ==================== Ping + availability ==================== -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="5*" />
                                    <ColumnDefinition Width="3*" />
                                </Grid.ColumnDefinitions>

                                <!-- LibreNMS's own 24h ping graph; clicking opens it
                                     on the Graphs tab. Collapses quietly for a
                                     device with no ping data. -->
                                <Button Grid.Column="0"
                                        Command="{Binding ShowPingGraphCommand}"
                                        Style="{StaticResource OverviewCardButtonStyle}"
                                        Margin="0,0,7,0"
                                        Visibility="{Binding OverviewGraph.Svg, Converter={StaticResource NullToVisibility}}">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Text="PING RESPONSE" Style="{StaticResource CardTitleStyle}" />
                                        <TextBlock Grid.Row="0" Text="24h" Style="{StaticResource CardNoteStyle}" />
                                        <svgc:SvgViewbox Grid.Row="1"
                                                         SvgSource="{Binding OverviewGraph.Svg}"
                                                         Stretch="Uniform"
                                                         MaxHeight="170"
                                                         HorizontalAlignment="Stretch"
                                                         VerticalAlignment="Stretch"
                                                         IsHitTestVisible="False" />
                                    </Grid>
                                </Button>

                                <Border Grid.Column="1"
                                        Style="{StaticResource OverviewCardStyle}"
                                        Margin="7,0,0,0"
                                        Visibility="{Binding HasAvailability, Converter={StaticResource BoolToVisibility}}">
                                    <StackPanel>
                                        <TextBlock Text="AVAILABILITY" Style="{StaticResource CardTitleStyle}" />
                                        <StackPanel Orientation="Horizontal">
                                            <Viewbox Width="84" Height="84">
                                                <Grid Width="100" Height="100">
                                                    <Ellipse Width="80"
                                                             Height="80"
                                                             Margin="10"
                                                             Stroke="{StaticResource SurfaceHoverBrush}"
                                                             StrokeThickness="11" />
                                                    <Path Data="{Binding Availability30DayFraction, Converter={StaticResource GaugeArc}}"
                                                          Stroke="{Binding AvailabilityTileSeverity, Converter={StaticResource SeverityToBrush}}"
                                                          StrokeThickness="11"
                                                          StrokeStartLineCap="Round"
                                                          StrokeEndLineCap="Round" />
                                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                                        <TextBlock Text="{Binding Availability30DayText}" FontSize="15" FontWeight="Bold" HorizontalAlignment="Center" />
                                                        <TextBlock Text="30 days" FontSize="10" Style="{StaticResource SubtleTextStyle}" HorizontalAlignment="Center" />
                                                    </StackPanel>
                                                </Grid>
                                            </Viewbox>
                                            <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Style="{StaticResource SubtleTextStyle}" FontSize="12" Margin="0,0,0,4">
                                                    <Run Text="24h " /><Run Text="{Binding Availability1DayText, Mode=OneWay}" Foreground="{StaticResource TextPrimaryBrush}" />
                                                </TextBlock>
                                                <TextBlock Style="{StaticResource SubtleTextStyle}" FontSize="12" Margin="0,0,0,4">
                                                    <Run Text="7d " /><Run Text="{Binding Availability7DayText, Mode=OneWay}" Foreground="{StaticResource TextPrimaryBrush}" />
                                                </TextBlock>
                                                <TextBlock Style="{StaticResource SubtleTextStyle}" FontSize="12">
                                                    <Run Text="1y " /><Run Text="{Binding Availability1YearText, Mode=OneWay}" Foreground="{StaticResource TextPrimaryBrush}" />
                                                </TextBlock>
                                            </StackPanel>
                                        </StackPanel>

                                        <!-- One segment per day for the last 30 days,
                                             red on a day with any downtime. -->
                                        <ItemsControl ItemsSource="{Binding AvailabilityTimeline}" Margin="0,14,0,0">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <UniformGrid Rows="1" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Height="14"
                                                            Margin="0.5,0"
                                                            CornerRadius="1.5"
                                                            Background="{Binding Severity, Converter={StaticResource SeverityToBrush}}"
                                                            ToolTip="{Binding TooltipText}" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <Expander Style="{StaticResource AccordionExpanderStyle}"
                                                  IsExpanded="False"
                                                  Margin="0,10,0,0"
                                                  Visibility="{Binding HasOutages, Converter={StaticResource BoolToVisibility}}">
                                            <!-- A TextBlock header: StringFormat on Header
                                                 itself is ignored (it's typed object). -->
                                            <Expander.Header>
                                                <TextBlock Text="{Binding Outages.Count, StringFormat=Recent outages ({0})}" />
                                            </Expander.Header>
                                            <ItemsControl ItemsSource="{Binding Outages}" Margin="0,10,0,0">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Margin="0,0,0,6">
                                                            <TextBlock FontSize="12">
                                                                <Run Text="{Binding StartedText, Mode=OneWay}" /><Run Text=" &#8594; " /><Run Text="{Binding EndedText, Mode=OneWay}" />
                                                            </TextBlock>
                                                            <TextBlock Text="{Binding DurationText}" Style="{StaticResource SubtleTextStyle}" FontSize="11" />
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Expander>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- ==================== Alerts + resources ==================== -->
                            <UniformGrid Rows="1" Margin="0,14,0,0">
                                <Button Command="{Binding SelectAlertsCommand}"
                                        Style="{StaticResource OverviewCardButtonStyle}"
                                        Margin="0,0,7,0">
                                    <StackPanel>
                                        <Grid>
                                            <TextBlock Text="ACTIVE ALERTS" Style="{StaticResource CardTitleStyle}" />
                                            <TextBlock Text="{Binding ActiveAlerts.Count, StringFormat={}{0} open}" Style="{StaticResource CardNoteStyle}" />
                                        </Grid>
                                        <TextBlock Text="No active alerts."
                                                   Style="{StaticResource SubtleTextStyle}"
                                                   Visibility="{Binding HasActiveAlerts, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}" />
                                        <ItemsControl ItemsSource="{Binding ActiveAlerts}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <DockPanel Margin="0,0,0,9">
                                                        <Ellipse DockPanel.Dock="Left"
                                                                 Width="8"
                                                                 Height="8"
                                                                 Margin="0,0,10,0"
                                                                 VerticalAlignment="Center"
                                                                 Fill="{Binding Severity, Converter={StaticResource SeverityToBrush}}" />
                                                        <TextBlock DockPanel.Dock="Right"
                                                                   Text="{Binding AgeText}"
                                                                   Style="{StaticResource SubtleTextStyle}"
                                                                   FontSize="11.5"
                                                                   Margin="10,0,0,0" />
                                                        <TextBlock Text="{Binding RuleName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                    </DockPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Button>

                                <Button Command="{Binding SelectResourcesCommand}"
                                        Style="{StaticResource OverviewCardButtonStyle}"
                                        Margin="7,0,0,0"
                                        Visibility="{Binding HasOverviewResources, Converter={StaticResource BoolToVisibility}}">
                                    <StackPanel>
                                        <TextBlock Text="RESOURCES" Style="{StaticResource CardTitleStyle}" />
                                        <ItemsControl ItemsSource="{Binding OverviewResources}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Margin="0,0,0,11">
                                                        <DockPanel>
                                                            <TextBlock DockPanel.Dock="Right"
                                                                       Text="{Binding ValueText}"
                                                                       Foreground="{Binding Severity, Converter={StaticResource SeverityToBrush}}" />
                                                            <TextBlock Text="{Binding Label}" />
                                                        </DockPanel>
                                                        <Border Style="{StaticResource UsageTrackStyle}">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="{Binding PercentValue, Converter={StaticResource PercentToStarWidth}}" />
                                                                    <ColumnDefinition Width="{Binding PercentValue, Converter={StaticResource PercentToStarWidth}, ConverterParameter=invert}" />
                                                                </Grid.ColumnDefinitions>
                                                                <Border CornerRadius="2.5" Background="{Binding Severity, Converter={StaticResource SeverityToBrush}}" />
                                                            </Grid>
                                                        </Border>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Button>
                            </UniformGrid>

                            <!-- ==================== Sensors + neighbours ==================== -->
                            <UniformGrid Rows="1" Margin="0,14,0,0">
                                <Button Command="{Binding SelectSensorsCommand}"
                                        Style="{StaticResource OverviewCardButtonStyle}"
                                        Margin="0,0,7,0"
                                        Visibility="{Binding HasSensors, Converter={StaticResource BoolToVisibility}}">
                                    <StackPanel>
                                        <Grid>
                                            <TextBlock Text="SENSORS" Style="{StaticResource CardTitleStyle}" />
                                            <TextBlock Text="{Binding SensorsCardNote}" Style="{StaticResource CardNoteStyle}" />
                                        </Grid>
                                        <ItemsControl ItemsSource="{Binding OverviewSensors}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Margin="0,0,0,11">
                                                        <DockPanel>
                                                            <TextBlock DockPanel.Dock="Right"
                                                                       Text="{Binding ValueText}"
                                                                       Margin="10,0,0,0"
                                                                       Foreground="{Binding Severity, Converter={StaticResource SeverityToBrush}}" />
                                                            <TextBlock Text="{Binding Description}" TextTrimming="CharacterEllipsis" />
                                                        </DockPanel>
                                                        <Border Style="{StaticResource UsageTrackStyle}"
                                                                Visibility="{Binding HasLimitFraction, Converter={StaticResource BoolToVisibility}}">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="{Binding LimitPercent, Converter={StaticResource PercentToStarWidth}}" />
                                                                    <ColumnDefinition Width="{Binding LimitPercent, Converter={StaticResource PercentToStarWidth}, ConverterParameter=invert}" />
                                                                </Grid.ColumnDefinitions>
                                                                <Border CornerRadius="2.5" Background="{Binding Severity, Converter={StaticResource SeverityToBrush}}" />
                                                            </Grid>
                                                        </Border>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Button>

                                <!-- A row per neighbour: clicking one opens it
                                     here (#58) when LibreNMS knows it. -->
                                <Border Style="{StaticResource OverviewCardStyle}"
                                        Margin="7,0,0,0"
                                        Visibility="{Binding HasOverviewNeighbours, Converter={StaticResource BoolToVisibility}}">
                                    <StackPanel>
                                        <Grid>
                                            <TextBlock Text="NEIGHBOURS" Style="{StaticResource CardTitleStyle}" />
                                            <TextBlock Text="LLDP / CDP" Style="{StaticResource CardNoteStyle}" />
                                        </Grid>
                                        <ItemsControl ItemsSource="{Binding OverviewNeighbours}" Margin="-4,-6,-4,0">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Style="{StaticResource CardRowButtonStyle}"
                                                            Command="{Binding OpenNeighborCommand}"
                                                            IsEnabled="{Binding CanOpenNeighbor}"
                                                            ToolTip="{Binding NeighborToolTip}">
                                                        <DockPanel>
                                                            <Ellipse DockPanel.Dock="Left"
                                                                     Width="8"
                                                                     Height="8"
                                                                     Margin="0,0,10,0"
                                                                     VerticalAlignment="Center"
                                                                     Fill="{Binding StatusSeverity, Converter={StaticResource SeverityToBrush}}" />
                                                            <TextBlock DockPanel.Dock="Right"
                                                                       Text="{Binding DisplayName}"
                                                                       Style="{StaticResource SubtleTextStyle}"
                                                                       FontSize="11.5"
                                                                       Margin="10,0,0,0" />
                                                            <TextBlock Text="{Binding NeighborText}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                        </DockPanel>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </UniformGrid>
                        </StackPanel>
                    </Grid>

                    <!-- ==================== Busiest ports ==================== -->
                    <Button Command="{Binding SelectPortsCommand}"
                            Style="{StaticResource OverviewCardButtonStyle}"
                            Margin="0,14,0,0"
                            Visibility="{Binding HasOverviewPorts, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel>
                            <Grid>
                                <TextBlock Text="BUSIEST PORTS" Style="{StaticResource CardTitleStyle}" />
                                <TextBlock Text="in / out" Style="{StaticResource CardNoteStyle}" />
                            </Grid>
                            <ItemsControl ItemsSource="{Binding OverviewPorts}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,7">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="18" />
                                                    <ColumnDefinition Width="150" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="100" />
                                                    <ColumnDefinition Width="100" />
                                                </Grid.ColumnDefinitions>
                                                <Ellipse Grid.Column="0"
                                                         Width="8"
                                                         Height="8"
                                                         HorizontalAlignment="Left"
                                                         VerticalAlignment="Center"
                                                         Fill="{Binding StatusSeverity, Converter={StaticResource SeverityToBrush}}" />
                                                <TextBlock Grid.Column="1" Text="{Binding DisplayName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Grid.Column="2" Text="{Binding SecondaryName}" Style="{StaticResource SubtleTextStyle}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Grid.Column="3" Text="{Binding InRateText}" HorizontalAlignment="Right" Style="{StaticResource SubtleTextStyle}" />
                                                <TextBlock Grid.Column="4" Text="{Binding OutRateText}" HorizontalAlignment="Right" Style="{StaticResource SubtleTextStyle}" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </ScrollViewer>

            <!-- ==================== Sensors ==================== -->
            <Grid Margin="24"
                  Visibility="{Binding IsSensorsSelected, Converter={StaticResource BoolToVisibility}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBox Grid.Column="0"
                             Style="{StaticResource SearchTextBoxStyle}"
                             Tag="Search sensors"
                             Text="{Binding SensorSearchText, UpdateSourceTrigger=PropertyChanged, Delay=200}"
                             ToolTip="Search by device name, description or sensor id"
                             Width="320"
                             HorizontalAlignment="Left" />

                    <!-- One quick link per sensor class the device actually
                         reports (issue #9), jumping to that class's
                         aggregate graph - see DeviceDetailViewModel.RebuildSensorGraphLinks. -->
                    <ItemsControl Grid.Column="1"
                                  ItemsSource="{Binding SensorGraphLinks}"
                                  HorizontalAlignment="Right"
                                  VerticalAlignment="Center">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Content="{Binding Label, StringFormat={}{0} graph}"
                                        Command="{Binding Command}"
                                        Style="{StaticResource ChipButtonStyle}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>

                <Grid Grid.Row="1">
                <!-- A card per group rather than a grouped DataGrid: this list
                     needs no sorting or selection, and an ItemsControl lays
                     its rows out at full width without fighting DataGrid's
                     grouping internals. -->
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              Visibility="{Binding HasVisibleSensorGroups, Converter={StaticResource BoolToVisibility}}">
                    <ItemsControl ItemsSource="{Binding SensorGroups}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource SurfaceBrush}"
                                        BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="12"
                                        Margin="0,0,0,12">
                                    <StackPanel>

                                        <Border BorderBrush="{StaticResource BorderBrush}"
                                                BorderThickness="0,0,0,1"
                                                Padding="14,10">
                                            <StackPanel Orientation="Horizontal">
                                                <Ellipse Width="9"
                                                         Height="9"
                                                         Margin="0,0,8,0"
                                                         VerticalAlignment="Center"
                                                         Fill="{Binding WorstSeverity, Converter={StaticResource SeverityToBrush}}" />
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding Count, StringFormat=({0})}"
                                                           Style="{StaticResource SubtleTextStyle}"
                                                           Margin="6,0,0,0"
                                                           VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Border>

                                        <ItemsControl ItemsSource="{Binding Sensors}" Margin="0,4,0,6">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="14,6">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="100" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="120" />
                                                            <ColumnDefinition Width="150" />
                                                        </Grid.ColumnDefinitions>

                                                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                            <Ellipse Width="9"
                                                                     Height="9"
                                                                     Margin="0,0,6,0"
                                                                     VerticalAlignment="Center"
                                                                     Fill="{Binding Severity, Converter={StaticResource SeverityToBrush}}" />
                                                            <TextBlock Text="{Binding SeverityText}"
                                                                       Style="{StaticResource SubtleTextStyle}"
                                                                       VerticalAlignment="Center" />
                                                        </StackPanel>

                                                        <TextBlock Grid.Column="1"
                                                                   Text="{Binding RowLabel}"
                                                                   VerticalAlignment="Center"
                                                                   TextTrimming="CharacterEllipsis" />

                                                        <TextBlock Grid.Column="2"
                                                                   Text="{Binding ValueText}"
                                                                   FontWeight="SemiBold"
                                                                   VerticalAlignment="Center" />

                                                        <TextBlock Grid.Column="3"
                                                                   Text="{Binding LastUpdateText}"
                                                                   Style="{StaticResource SubtleTextStyle}"
                                                                   VerticalAlignment="Center" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <TextBlock Text="Loading sensors..."
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           IsHitTestVisible="False"
                           Visibility="{Binding IsLoadingSensors, Converter={StaticResource BoolToVisibility}}"
                           Style="{StaticResource SubtleTextStyle}" />

                <TextBlock Text="No sensors reported for this device."
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           IsHitTestVisible="False"
                           Visibility="{Binding ShowSensorsEmptyMessage, Converter={StaticResource BoolToVisibility}}"
                           Style="{StaticResource SubtleTextStyle}" />

                <TextBlock Text="No sensors match your search."
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           IsHitTestVisible="False"
                           Visibility="{Binding ShowSensorsNoMatchesMessage, Converter={StaticResource BoolToVisibility}}"
                           Style="{StaticResource SubtleTextStyle}" />
                </Grid>
            </Grid>

            <!-- ==================== Ports ==================== -->
            <Grid Margin="24"
                  Visibility="{Binding IsPortsSelected, Converter={StaticResource BoolToVisibility}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBox Grid.Row="0"
                         Style="{StaticResource SearchTextBoxStyle}"
                         Tag="Search ports"
                         Text="{Binding PortSearchText, UpdateSourceTrigger=PropertyChanged, Delay=200}"
                         ToolTip="Search by interface name or description"
                         Width="320"
                         HorizontalAlignment="Left"
                         Margin="0,0,0,10" />

                <Grid Grid.Row="1">
                <DataGrid x:Name="PortsGrid"
                          ItemsSource="{Binding PortsView}"
                          SelectedItem="{Binding SelectedPort}"
                          SelectionMode="Single"
                          Visibility="{Binding HasVisiblePorts, Converter={StaticResource BoolToVisibility}}"
                          IsReadOnly="True"
                          HeadersVisibility="Column">
                    <DataGrid.Columns>

                        <DataGridTemplateColumn Header="Status" Width="90" SortMemberPath="IsUp">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="8,0">
                                        <Ellipse Width="9"
                                                 Height="9"
                                                 Margin="0,0,6,0"
                                                 VerticalAlignment="Center"
                                                 Fill="{Binding StatusSeverity, Converter={StaticResource SeverityToBrush}}" />
                                        <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="#" Width="36" Binding="{Binding Model.IfIndex}" />

                        <DataGridTemplateColumn Header="Interface" Width="*" MinWidth="140" SortMemberPath="DisplayName">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="8,4" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding SecondaryName}"
                                                   Style="{StaticResource SubtleTextStyle}"
                                                   FontSize="11"
                                                   TextTrimming="CharacterEllipsis"
                                                   Visibility="{Binding HasSecondaryName, Converter={StaticResource BoolToVisibility}}" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="Media" Width="90" Binding="{Binding MediaText}" />

                        <DataGridTemplateColumn Header="Traffic" Width="120" SortMemberPath="InRateText">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="8,4" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#x2190; " Foreground="{StaticResource OkBrush}" FontWeight="Bold" />
                                            <TextBlock Text="{Binding InRateText}" Foreground="{StaticResource OkBrush}" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#x2192; " Foreground="{DynamicResource AccentBrush}" FontWeight="Bold" />
                                            <TextBlock Text="{Binding OutRateText}" Foreground="{DynamicResource AccentBrush}" />
                                        </StackPanel>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="Speed" Width="90" SortMemberPath="SpeedText">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="8,4" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding SpeedText}" />
                                        <TextBlock Text="{Binding DuplexText}"
                                                   Style="{StaticResource SubtleTextStyle}"
                                                   FontSize="11"
                                                   Visibility="{Binding HasDuplex, Converter={StaticResource BoolToVisibility}}" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="Errors" Width="70" SortMemberPath="ErrorCount">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding ErrorCount}"
                                               Margin="8,0"
                                               VerticalAlignment="Center"
                                               Foreground="{StaticResource CriticalBrush}"
                                               Visibility="{Binding HasErrors, Converter={StaticResource BoolToVisibility}}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="MAC Address" Width="140" SortMemberPath="MacAddressText">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="8,4" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding MacAddressText}" />
                                        <TextBlock Style="{StaticResource SubtleTextStyle}" FontSize="11">
                                            <Run Text="MTU " /><Run Text="{Binding MtuText, Mode=OneWay}" />
                                        </TextBlock>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="IP address" Width="160" Binding="{Binding IpAddressesText}">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                    <Setter Property="VerticalAlignment" Value="Center" />
                                    <Setter Property="ToolTip" Value="{Binding IpAddressesText}" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTemplateColumn Header="Neighbour" Width="180" SortMemberPath="NeighborText">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Grid Margin="8,0">
                                        <!-- Clickable: shown only when the neighbour is itself a monitored device. -->
                                        <TextBlock VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"
                                                   Cursor="Hand"
                                                   ToolTip="{Binding NeighborToolTip}"
                                                   Visibility="{Binding CanOpenNeighbor, Converter={StaticResource BoolToVisibility}}">
                                            <Hyperlink Command="{Binding OpenNeighborCommand}">
                                                <Run Text="{Binding NeighborText, Mode=OneWay}" />
                                            </Hyperlink>
                                        </TextBlock>
                                        <!-- Plain text: an unmonitored neighbour, or none at all. -->
                                        <TextBlock Text="{Binding NeighborText}"
                                                   Style="{StaticResource SubtleTextStyle}"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"
                                                   Visibility="{Binding CanOpenNeighbor, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}" />
                                    </Grid>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                    </DataGrid.Columns>
                </DataGrid>

                <TextBlock Text="Loading ports..."
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           IsHitTestVisible="False"
                           Visibility="{Binding IsLoadingPorts, Converter={StaticResource BoolToVisibility}}"
                           Style="{StaticResource SubtleTextStyle}" />

                <TextBlock Text="No ports reported for this device."
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           IsHitTestVisible="False"
                           Visibility="{Binding ShowPortsEmptyMessage, Converter={StaticResource BoolToVisibility}}"
                           Style="{StaticResource SubtleTextStyle}" />

                <TextBlock Text="No ports match your search."
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           IsHitTestVisible="False"
                           Visibility="{Binding ShowPortsNoMatchesMessage, Converter={StaticResource BoolToVisibility}}"
                           Style="{StaticResource SubtleTextStyle}" />
                </Grid>

                <!-- The picked port's graphs (#8) - traffic, packets and
                     errors; the chevron folds them away. -->
                <views:PortGraphsPanel Grid.Row="2" Margin="-24,12,-24,-24" DataContext="{Binding PortGraphs}" />
            </Grid>

            <!-- ==================== VLANs ==================== -->
            <Grid Margin="24"
                  Visibility="{Binding IsVlansSelected, Converter={StaticResource BoolToVisibility}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBox Grid.Row="0"
                         Style="{StaticResource SearchTextBoxStyle}"
                         Tag="Search VLANs"
                         Text="{Binding VlanSearchText, UpdateSourceTrigger=PropertyChanged, Delay=200}"
                         ToolTip="Search by VLAN number, name or port"
                         Width="320"
                         HorizontalAlignment="Left"
                         Margin="0,0,0,10" />

                <Grid Grid.Row="1">
                    <DataGrid x:Name="VlansGrid"
                              ItemsSource="{Binding VlansView}"
                              Visibility="{Binding HasVisibleVlans, Converter={StaticResource BoolToVisibility}}"
                              IsReadOnly="True"
                              HeadersVisibility="Column">
                        <DataGrid.Columns>

                            <DataGridTextColumn Header="VLAN" Width="90" Binding="{Binding NumberText}" />
                            <DataGridTextColumn Header="Name" Width="200" Binding="{Binding NameText}" />

                            <!-- Every port carrying the VLAN, untagged ones
                                 marked (U), as LibreNMS's VLAN page lists them
                                 - from each port's VLAN memberships (#99, see
                                 VlanMembership). A device that reports none
                                 falls back to each port's own VLAN, all (U). -->
                            <DataGridTemplateColumn Width="*" SortMemberPath="PortsSummaryText">
                                <DataGridTemplateColumn.Header>
                                    <TextBlock Text="Ports"
                                               ToolTip="Ports carrying this VLAN. (U) is untagged - an access port, or a trunk's native VLAN; the rest carry it tagged." />
                                </DataGridTemplateColumn.Header>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding PortsSummaryText}"
                                                   ToolTip="{Binding PortsSummaryText}"
                                                   TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center"
                                                   Margin="8,0" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                        </DataGrid.Columns>
                    </DataGrid>

                    <TextBlock Text="Loading VLANs..."
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               IsHitTestVisible="False"
                               Visibility="{Binding IsLoadingVlans, Converter={StaticResource BoolToVisibility}}"
                               Style="{StaticResource SubtleTextStyle}" />

                    <TextBlock Text="No VLANs reported for this device."
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               IsHitTestVisible="False"
                               Visibility="{Binding ShowVlansEmptyMessage, Converter={StaticResource BoolToVisibility}}"
                               Style="{StaticResource SubtleTextStyle}" />

                    <TextBlock Text="No VLANs match your search."
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               IsHitTestVisible="False"
                               Visibility="{Binding ShowVlansNoMatchesMessage, Converter={StaticResource BoolToVisibility}}"
                               Style="{StaticResource SubtleTextStyle}" />
                </Grid>
            </Grid>

            <!-- ==================== FDB ==================== -->
            <Grid Margin="24"
                  Visibility="{Binding IsFdbSelected, Converter={StaticResource BoolToVisibility}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBox Grid.Row="0"
                         Style="{StaticResource SearchTextBoxStyle}"
                         Tag="Search the FDB"
                         Text="{Binding FdbSearchText, UpdateSourceTrigger=PropertyChanged, Delay=200}"
                         ToolTip="Search by MAC address, port or VLAN"
                         Width="320"
                         HorizontalAlignment="Left"
                         Margin="0,0,0,10" />

                <Grid Grid.Row="1">
                    <DataGrid x:Name="FdbGrid"
                              ItemsSource="{Binding FdbView}"
                              Visibility="{Binding HasVisibleFdbEntries, Converter={StaticResource BoolToVisibility}}"
                              IsReadOnly="True"
                              HeadersVisibility="Column">
                        <DataGrid.Columns>

                            <DataGridTextColumn Header="MAC address" Width="150" Binding="{Binding MacAddressText}" />
                            <DataGridTextColumn Header="Port" Width="140" Binding="{Binding PortText}" />

                            <DataGridTemplateColumn Header="VLAN" Width="150" SortMemberPath="VlanText">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="8,4" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding VlanText}" />
                                            <TextBlock Text="{Binding VlanNameText}"
                                                       Style="{StaticResource SubtleTextStyle}"
                                                       FontSize="11"
                                                       TextTrimming="CharacterEllipsis"
                                                       Visibility="{Binding HasVlanName, Converter={StaticResource BoolToVisibility}}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Header="Last seen" Width="150" Binding="{Binding UpdatedText}" />

                        </DataGrid.Columns>
                    </DataGrid>

                    <TextBlock Text="Loading the FDB..."
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               IsHitTestVisible="False"
                               Visibility="{Binding IsLoadingFdb, Converter={StaticResource BoolToVisibility}}"
                               Style="{StaticResource SubtleTextStyle}" />

                    <TextBlock Text="No FDB entries reported for this device."
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               IsHitTestVisible="False"
                               Visibility="{Binding ShowFdbEmptyMessage, Converter={StaticResource BoolToVisibility}}"
                               Style="{StaticResource SubtleTextStyle}" />

                    <TextBlock Text="No FDB entries match your search."
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               IsHitTestVisible="False"
                               Visibility="{Binding ShowFdbNoMatchesMessage, Converter={StaticResource BoolToVisibility}}"
                               Style="{StaticResource SubtleTextStyle}" />
                </Grid>
            </Grid>

            <!-- ==================== ARP ==================== -->
            <Grid Margin="24"
                  Visibility="{Binding IsArpSelected, Converter={StaticResource BoolToVisibility}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBox Grid.Row="0"
                         Style="{StaticResource SearchTextBoxStyle}"
                         Tag="Search the ARP table"
                         Text="{Binding ArpSearchText, UpdateSourceTrigger=PropertyChanged, Delay=200}"
                         ToolTip="Search by IP address, MAC address or port"
                         Width="320"
                         HorizontalAlignment="Left"
                         Margin="0,0,0,10" />

                <Grid Grid.Row="1">
                    <DataGrid x:Name="ArpGrid"
                              ItemsSource="{Binding ArpView}"
                              Visibility="{Binding HasVisibleArpEntries, Converter={StaticResource BoolToVisibility}}"
                              IsReadOnly="True"
                              HeadersVisibility="Column">
                        <DataGrid.Columns>

                            <DataGridTextColumn Header="IP address" Width="160" Binding="{Binding Ipv4AddressText}" />
                            <DataGridTextColumn Header="MAC address" Width="150" Binding="{Binding MacAddressText}" />
                            <DataGridTextColumn Header="Port" Width="140" Binding="{Binding PortText}" />

                        </DataGrid.Columns>
                    </DataGrid>

                    <TextBlock Text="Loading the ARP table..."
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               IsHitTestVisible="False"
                               Visibility="{Binding IsLoadingArp, Converter={StaticResource BoolToVisibility}}"
                               Style="{StaticResource SubtleTextStyle}" />

                    <TextBlock Text="No ARP entries reported for this device."
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               IsHitTestVisible="False"
                               Visibility="{Binding ShowArpEmptyMessage, Converter={StaticResource BoolToVisibility}}"
                               Style="{StaticResource SubtleTextStyle}" />

                    <TextBlock Text="No ARP entries match your search."
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               IsHitTestVisible="False"
                               Visibility="{Binding ShowArpNoMatchesMessage, Converter={StaticResource BoolToVisibility}}"
                               Style="{StaticResource SubtleTextStyle}" />
                </Grid>
            </Grid>

            <!-- ==================== Graphs ==================== -->
            <!-- Device-wide only (issues #14/#13/#17/#20) - LibreNMS's
                 per-port and per-sensor graph routes 500/404 via the API
                 token this app authenticates with everywhere else
                 (confirmed live), so only the device-wide graphs listed by
                 GET /devices/{id}/graphs are offered here. -->
            <Grid Margin="24"
                  Visibility="{Binding IsGraphsSelected, Converter={StaticResource BoolToVisibility}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <views:GraphTimeRangePicker Grid.Column="0"
                                                 DataContext="{Binding Graphs.TimeRange}"
                                                 VerticalAlignment="Center" />

                    <ComboBox Grid.Column="1"
                              ItemsSource="{Binding Graphs.AvailableGraphs}"
                              SelectedItem="{Binding Graphs.SelectedGraph}"
                              DisplayMemberPath="Description"
                              Width="280"
                              Margin="14,0,0,0" />
                </Grid>

                <Grid Grid.Row="1">
                    <svgc:SvgViewbox SvgSource="{Binding Graphs.CurrentSvg}"
                                     Stretch="Uniform"
                                     HorizontalAlignment="Left"
                                     VerticalAlignment="Top"
                                     Visibility="{Binding Graphs.CurrentSvg, Converter={StaticResource NullToVisibility}}" />

                    <TextBlock Text="Loading graph..."
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               IsHitTestVisible="False"
                               Visibility="{Binding Graphs.IsLoading, Converter={StaticResource BoolToVisibility}}"
                               Style="{StaticResource SubtleTextStyle}" />

                    <TextBlock Text="{Binding Graphs.ErrorMessage}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               TextWrapping="Wrap"
                               MaxWidth="480"
                               IsHitTestVisible="False"
                               Visibility="{Binding Graphs.HasError, Converter={StaticResource BoolToVisibility}}"
                               Style="{StaticResource SubtleTextStyle}" />
                </Grid>
            </Grid>

            <!-- ==================== Resources ==================== -->
            <!-- CPU/memory/disk each get their own card rather than one grid:
                 the row shape differs (a disk/pool shows a used/total byte
                 figure a CPU has no equivalent for), and a device may report
                 any mix of the three. -->
            <Grid Margin="24"
                  Visibility="{Binding IsResourcesSelected, Converter={StaticResource BoolToVisibility}}">
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          Visibility="{Binding HasResources, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>

                    <!-- Processors -->
                    <Border Background="{StaticResource SurfaceBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="16"
                            Margin="0,0,0,12"
                            Visibility="{Binding HasProcessors, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding Processors.Count, StringFormat=Processors ({0})}" Style="{StaticResource SectionHeaderStyle}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Cursor="Hand">
                                    <Hyperlink Command="{Binding ShowProcessorGraphCommand}" ToolTip="View the processor graph">View graph</Hyperlink>
                                </TextBlock>
                            </Grid>
                            <ItemsControl ItemsSource="{Binding Processors}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="200" />
                                                <ColumnDefinition Width="55" />
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0" Text="{Binding Description}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,10,0" />

                                            <Grid Grid.Column="1" Height="8" VerticalAlignment="Center">
                                                <Border Background="{StaticResource SurfaceAltBrush}" CornerRadius="4" />
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="{Binding UsagePercent, Converter={StaticResource PercentToStarWidth}}" />
                                                        <ColumnDefinition Width="{Binding UsagePercent, Converter={StaticResource PercentToStarWidth}, ConverterParameter=invert}" />
                                                    </Grid.ColumnDefinitions>
                                                    <Border Grid.Column="0" CornerRadius="4" Background="{Binding Severity, Converter={StaticResource SeverityToBrush}}" />
                                                </Grid>
                                            </Grid>

                                            <TextBlock Grid.Column="2" Text="{Binding UsageText}" VerticalAlignment="Center" TextAlignment="Right" Margin="10,0,0,0" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- Memory pools -->
                    <Border Background="{StaticResource SurfaceBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="16"
                            Margin="0,0,0,12"
                            Visibility="{Binding HasMempools, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding Mempools.Count, StringFormat=Memory ({0})}" Style="{StaticResource SectionHeaderStyle}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Cursor="Hand">
                                    <Hyperlink Command="{Binding ShowMempoolGraphCommand}" ToolTip="View the memory pool graph">View graph</Hyperlink>
                                </TextBlock>
                            </Grid>
                            <ItemsControl ItemsSource="{Binding Mempools}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="200" />
                                                <ColumnDefinition Width="55" />
                                                <ColumnDefinition Width="150" />
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0" Text="{Binding Description}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,10,0" />

                                            <Grid Grid.Column="1" Height="8" VerticalAlignment="Center">
                                                <Border Background="{StaticResource SurfaceAltBrush}" CornerRadius="4" />
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="{Binding UsagePercent, Converter={StaticResource PercentToStarWidth}}" />
                                                        <ColumnDefinition Width="{Binding UsagePercent, Converter={StaticResource PercentToStarWidth}, ConverterParameter=invert}" />
                                                    </Grid.ColumnDefinitions>
                                                    <Border Grid.Column="0" CornerRadius="4" Background="{Binding Severity, Converter={StaticResource SeverityToBrush}}" />
                                                </Grid>
                                            </Grid>

                                            <TextBlock Grid.Column="2" Text="{Binding UsageText}" VerticalAlignment="Center" TextAlignment="Right" Margin="10,0,0,0" />
                                            <TextBlock Grid.Column="3" Text="{Binding DetailText}" Style="{StaticResource SubtleTextStyle}" VerticalAlignment="Center" TextAlignment="Right" Margin="10,0,0,0" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- Storage -->
                    <Border Background="{StaticResource SurfaceBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="16"
                            Margin="0,0,0,12"
                            Visibility="{Binding HasStorage, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding Storage.Count, StringFormat=Storage ({0})}" Style="{StaticResource SectionHeaderStyle}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Cursor="Hand">
                                    <Hyperlink Command="{Binding ShowStorageGraphCommand}" ToolTip="View the storage graph">View graph</Hyperlink>
                                </TextBlock>
                            </Grid>
                            <ItemsControl ItemsSource="{Binding Storage}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="200" />
                                                <ColumnDefinition Width="55" />
                                                <ColumnDefinition Width="150" />
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0" Text="{Binding Description}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,10,0" />

                                            <Grid Grid.Column="1" Height="8" VerticalAlignment="Center">
                                                <Border Background="{StaticResource SurfaceAltBrush}" CornerRadius="4" />
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="{Binding UsagePercent, Converter={StaticResource PercentToStarWidth}}" />
                                                        <ColumnDefinition Width="{Binding UsagePercent, Converter={StaticResource PercentToStarWidth}, ConverterParameter=invert}" />
                                                    </Grid.ColumnDefinitions>
                                                    <Border Grid.Column="0" CornerRadius="4" Background="{Binding Severity, Converter={StaticResource SeverityToBrush}}" />
                                                </Grid>
                                            </Grid>

                                            <TextBlock Grid.Column="2" Text="{Binding UsageText}" VerticalAlignment="Center" TextAlignment="Right" Margin="10,0,0,0" />
                                            <TextBlock Grid.Column="3" Text="{Binding DetailText}" Style="{StaticResource SubtleTextStyle}" VerticalAlignment="Center" TextAlignment="Right" Margin="10,0,0,0" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- PoE budget (#54): LibreNMS has no per-port PoE data
                         for most switches, only each PSE's used/total power. -->
                    <Border Background="{StaticResource SurfaceBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="16"
                            Margin="0,0,0,12"
                            Visibility="{Binding HasPoe, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="PoE" Style="{StaticResource SectionHeaderStyle}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{Binding PoeDevicesConnectedText}" Style="{StaticResource SubtleTextStyle}" VerticalAlignment="Center" />
                            </Grid>
                            <ItemsControl ItemsSource="{Binding PoeBudgets}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,8" ToolTip="{Binding RemainingText}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="200" />
                                                <ColumnDefinition Width="55" />
                                                <ColumnDefinition Width="150" />
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0" Text="{Binding Label}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,10,0" />

                                            <Grid Grid.Column="1" Height="8" VerticalAlignment="Center">
                                                <Border Background="{StaticResource SurfaceAltBrush}" CornerRadius="4" />
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="{Binding UsagePercent, Converter={StaticResource PercentToStarWidth}}" />
                                                        <ColumnDefinition Width="{Binding UsagePercent, Converter={StaticResource PercentToStarWidth}, ConverterParameter=invert}" />
                                                    </Grid.ColumnDefinitions>
                                                    <Border Grid.Column="0" CornerRadius="4" Background="{Binding Severity, Converter={StaticResource SeverityToBrush}}" />
                                                </Grid>
                                            </Grid>

                                            <TextBlock Grid.Column="2" Text="{Binding PercentText}" VerticalAlignment="Center" TextAlignment="Right" Margin="10,0,0,0" />
                                            <TextBlock Grid.Column="3" Text="{Binding UsageText}" Style="{StaticResource SubtleTextStyle}" VerticalAlignment="Center" TextAlignment="Right" Margin="10,0,0,0" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>

                <TextBlock Text="Loading resources..."
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           IsHitTestVisible="False"
                           Visibility="{Binding IsLoadingResources, Converter={StaticResource BoolToVisibility}}"
                           Style="{StaticResource SubtleTextStyle}" />

                <TextBlock Text="No CPU, memory or disk data reported for this device."
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           IsHitTestVisible="False"
                           Visibility="{Binding ShowResourcesEmptyMessage, Converter={StaticResource BoolToVisibility}}"
                           Style="{StaticResource SubtleTextStyle}" />
            </Grid>

            <!-- ==================== Alerts ==================== -->
            <!-- Active and historical together: what is on fire right now,
                 and everything that has ever fired, in one place - rather
                 than needing the Overview tab for one and this tab for the
                 other. -->
            <Grid Margin="24"
                  Visibility="{Binding IsAlertsSelected, Converter={StaticResource BoolToVisibility}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Active -->
                <Border Grid.Row="0"
                        Background="{StaticResource SurfaceBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="20"
                        Margin="0,0,0,16">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" FontWeight="SemiBold" VerticalAlignment="Center">
                                <Run Text="Active" />
                                <Run Text="{Binding ActiveAlerts.Count, Mode=OneWay, StringFormat=({0})}" />
                            </TextBlock>

                            <Button Grid.Column="1"
                                    Content="Show alerts for this device"
                                    Command="{Binding ShowAlertsCommand}"
                                    Padding="10,5"
                                    Visibility="{Binding HasActiveAlerts, Converter={StaticResource BoolToVisibility}}" />
                        </Grid>

                        <ItemsControl ItemsSource="{Binding ActiveAlerts}"
                                      Margin="0,12,0,0"
                                      Visibility="{Binding HasActiveAlerts, Converter={StaticResource BoolToVisibility}}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <Ellipse Grid.Column="0"
                                                     Width="9"
                                                     Height="9"
                                                     Margin="0,0,10,0"
                                                     VerticalAlignment="Center"
                                                     Fill="{Binding Severity, Converter={StaticResource SeverityToBrush}}" />
                                            <TextBlock Grid.Column="1" Text="{Binding RuleName}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="2"
                                                       Text="{Binding AgeText}"
                                                       Style="{StaticResource SubtleTextStyle}"
                                                       VerticalAlignment="Center"
                                                       Margin="12,0,0,0" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="Loading active alerts..."
                                   Style="{StaticResource SubtleTextStyle}"
                                   Margin="0,12,0,0"
                                   Visibility="{Binding IsLoadingActiveAlerts, Converter={StaticResource BoolToVisibility}}" />

                        <TextBlock Text="No active alerts."
                                   Style="{StaticResource SubtleTextStyle}"
                                   Margin="0,12,0,0"
                                   Visibility="{Binding ShowNoActiveAlertsMessage, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                </Border>

                <!-- History -->
                <TextBlock Grid.Row="1" Text="{Binding AlertHistory.Count, StringFormat=History ({0})}" Style="{StaticResource SectionHeaderStyle}" Margin="0,0,0,6" />

                <Grid Grid.Row="2">
                    <DataGrid x:Name="AlertHistoryGrid"
                              ItemsSource="{Binding AlertHistory}"
                              Visibility="{Binding HasAlertHistory, Converter={StaticResource BoolToVisibility}}"
                              IsReadOnly="True"
                              HeadersVisibility="Column">
                        <DataGrid.Columns>

                            <DataGridTemplateColumn Header="Severity" Width="90" SortMemberPath="Severity">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Margin="8,0">
                                            <Ellipse Width="9"
                                                     Height="9"
                                                     Margin="0,0,6,0"
                                                     VerticalAlignment="Center"
                                                     Fill="{Binding Severity, Converter={StaticResource SeverityToBrush}}" />
                                            <TextBlock Text="{Binding SeverityText}" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="Rule" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="8,4" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding RuleName}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding DetailText}"
                                                       Style="{StaticResource SubtleTextStyle}"
                                                       FontSize="11"
                                                       TextTrimming="CharacterEllipsis"
                                                       Visibility="{Binding HasDetail, Converter={StaticResource BoolToVisibility}}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="State" Width="110" Binding="{Binding StateText}" />
                            <DataGridTextColumn Header="Time" Width="150" Binding="{Binding TimeText}" />

                        </DataGrid.Columns>
                    </DataGrid>

                    <TextBlock Text="Loading alert history..."
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               IsHitTestVisible="False"
                               Visibility="{Binding IsLoadingAlertHistory, Converter={StaticResource BoolToVisibility}}"
                               Style="{StaticResource SubtleTextStyle}" />

                    <TextBlock Text="No alert history for this device."
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               IsHitTestVisible="False"
                               Visibility="{Binding ShowNoAlertHistoryMessage, Converter={StaticResource BoolToVisibility}}"
                               Style="{StaticResource SubtleTextStyle}" />
                </Grid>
            </Grid>

            <!-- ==================== Event log ==================== -->
            <Grid Margin="24"
                  Visibility="{Binding IsEventLogSelected, Converter={StaticResource BoolToVisibility}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0"
                             Style="{StaticResource SearchTextBoxStyle}"
                             Tag="Search the event log"
                             Text="{Binding EventLogSearchText, UpdateSourceTrigger=PropertyChanged, Delay=200}"
                             ToolTip="Search by message, type or user"
                             Width="320"
                             HorizontalAlignment="Left" />
                    <Button Grid.Column="1"
                            Content="Export"
                            Padding="10,7"
                            Margin="8,0,0,0"
                            Click="OnExportEventLogButtonClick">
                        <Button.ContextMenu>
                            <ContextMenu Placement="Bottom">
                                <MenuItem Header="Copy as CSV" Command="{Binding CopyEventLogCsvCommand}" />
                                <MenuItem Header="Save as CSV..." Command="{Binding ExportEventLogCsvCommand}" />
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                </Grid>

                <Grid Grid.Row="1">
                    <!-- Loading more appends past the bottom rather than
                         replacing the grid, so ScrollChanged is watched on
                         this DataGrid itself (see DeviceView.xaml.cs) to fetch
                         the next page automatically as it is scrolled into
                         view - "Load more" below is the fallback for anyone
                         who never scrolls that far. -->
                    <DataGrid x:Name="EventLogGrid"
                              ItemsSource="{Binding EventLogView}"
                              Visibility="{Binding HasVisibleEventLog, Converter={StaticResource BoolToVisibility}}"
                              IsReadOnly="True"
                              HeadersVisibility="Column">
                        <DataGrid.Columns>

                            <DataGridTextColumn Header="Type" Width="110" Binding="{Binding TypeText}" />
                            <DataGridTextColumn Header="Message" Width="*" Binding="{Binding Message}" />
                            <DataGridTextColumn Header="User" Width="110" Binding="{Binding Username}" />
                            <DataGridTextColumn Header="Time" Width="150" Binding="{Binding TimeText}" />

                        </DataGrid.Columns>
                    </DataGrid>

                    <TextBlock Text="Loading the event log..."
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               IsHitTestVisible="False"
                               Visibility="{Binding IsLoadingEventLog, Converter={StaticResource BoolToVisibility}}"
                               Style="{StaticResource SubtleTextStyle}" />

                    <TextBlock Text="No event log entries for this device."
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               IsHitTestVisible="False"
                               Visibility="{Binding ShowEventLogEmptyMessage, Converter={StaticResource BoolToVisibility}}"
                               Style="{StaticResource SubtleTextStyle}" />

                    <TextBlock Text="No event log entries match your search."
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               IsHitTestVisible="False"
                               Visibility="{Binding ShowEventLogNoMatchesMessage, Converter={StaticResource BoolToVisibility}}"
                               Style="{StaticResource SubtleTextStyle}" />
                </Grid>

                <StackPanel Grid.Row="2"
                            Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            Margin="0,10,0,0">
                    <TextBlock Text="Loading more..."
                               Style="{StaticResource SubtleTextStyle}"
                               Visibility="{Binding IsLoadingMoreEventLog, Converter={StaticResource BoolToVisibility}}" />
                    <Button Content="Load more"
                            Command="{Binding LoadMoreEventLogCommand}"
                            Padding="12,6">
                        <Button.Style>
                            <!-- BasedOn the app's own default: an override
                                 with no BasedOn replaces the themed look
                                 entirely, leaving bare OS button chrome. -->
                            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding HasMoreEventLog}" Value="True" />
                                            <Condition Binding="{Binding IsLoadingMoreEventLog}" Value="False" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible" />
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- ==================== Unimus (issue #115) ==================== -->
            <Grid Margin="24"
                  Visibility="{Binding IsConfigSelected, Converter={StaticResource BoolToVisibility}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Unimus" Style="{StaticResource HeadingTextStyle}" VerticalAlignment="Center" />
                    <Button Grid.Column="1"
                            Content="Refresh"
                            Command="{Binding RefreshConfigCommand}"
                            Padding="10,7"
                            Margin="0,0,8,0" />
                    <!-- Rediscover isn't a Unimus concept - it's LibreNMS's
                         own discovery (the same command Edit's Device
                         management card uses) - it's here too because
                         "rediscover or back up this device" reads as one
                         action group, not because Unimus triggers it. -->
                    <Button Grid.Column="2"
                            Content="Rediscover now"
                            Command="{Binding RediscoverCommand}"
                            ToolTip="Ask LibreNMS to rediscover this device now"
                            Padding="10,7"
                            Margin="0,0,8,0" />
                    <Button Grid.Column="3"
                            Content="Backup now"
                            Command="{Binding BackupNowCommand}"
                            ToolTip="Ask Unimus to back up this device's configuration now"
                            Padding="10,7" />
                </Grid>

                <!-- This whole tab only shows once HasUnimusMatch or
                     HasConfigError is true (see ShowUnimusSection gating the
                     nav item) - so row 1 only ever needs to choose between
                     those two, never a "no match"/"still checking" state. -->
                <Grid Grid.Row="1" Visibility="{Binding HasConfigError, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="320" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- ==================== Backup list ==================== -->
                    <!-- No checkbox column or per-row button: the grid's own
                         row selection is the whole interaction (see
                         DeviceView.xaml.cs's SelectionChanged handler) -
                         click a row to view it, ctrl/shift-click a second to
                         diff them automatically. -->
                    <DataGrid Grid.Column="0"
                              x:Name="UnimusBackupsGrid"
                              ItemsSource="{Binding ConfigBackups}"
                              IsReadOnly="True"
                              AutoGenerateColumns="False"
                              HeadersVisibility="Column"
                              SelectionMode="Extended"
                              SelectionUnit="FullRow"
                              CanUserAddRows="False"
                              SelectionChanged="OnUnimusBackupsSelectionChanged">
                        <DataGrid.Columns>
                            <!-- A tick box that shows the row's own selection, not
                                 separate state (so a plain row click still ticks
                                 just that one). Clicking anywhere in this cell
                                 toggles the row in or out of the selection like
                                 ctrl-click - handled in code-behind, see
                                 OnUnimusTickPreviewMouseLeftButtonDown for why
                                 a plain two-way IsSelected binding can't. Two
                                 ticked rows then diff automatically. -->
                            <DataGridTemplateColumn Width="36" CanUserResize="False" CanUserSort="False">
                                <DataGridTemplateColumn.HeaderTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="✓"
                                                   HorizontalAlignment="Center"
                                                   ToolTip="Tick two backups to compare them" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.HeaderTemplate>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Background="Transparent"
                                                ToolTip="Tick two backups to compare them"
                                                PreviewMouseLeftButtonDown="OnUnimusTickPreviewMouseLeftButtonDown">
                                            <CheckBox HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"
                                                      Focusable="False"
                                                      IsHitTestVisible="False"
                                                      IsChecked="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=DataGridRow}, Mode=OneWay}" />
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Date" Width="*" Binding="{Binding DateText}" />
                            <DataGridTextColumn Header="Status" Width="90" Binding="{Binding StatusText}" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- ==================== Content / diff viewer ==================== -->
                    <Border Grid.Column="2"
                            Background="{StaticResource SurfaceAltBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="12">
                        <Grid Margin="12">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <!-- ==================== Viewer toolbar ==================== -->
                            <!-- What's being shown on the left; diff-only options
                                 and change navigation in the middle; Copy on the
                                 right for both modes. -->
                            <Grid Grid.Row="0"
                                  Margin="0,0,0,10"
                                  Visibility="{Binding HasConfigLines, Converter={StaticResource BoolToVisibility}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0"
                                            VerticalAlignment="Center"
                                            Visibility="{Binding HasDiff, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Text="{Binding DiffHeaderText}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding DiffSummaryText}" Style="{StaticResource SubtleTextStyle}" Margin="0,2,0,0" />
                                </StackPanel>
                                <StackPanel Grid.Column="0"
                                            VerticalAlignment="Center"
                                            Visibility="{Binding HasSelectedBackup, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Text="{Binding SelectedBackup.DateText}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding SelectedBackup.StatusText}" Style="{StaticResource SubtleTextStyle}" Margin="0,2,0,0" />
                                </StackPanel>

                                <StackPanel Grid.Column="1"
                                            Orientation="Horizontal"
                                            VerticalAlignment="Center"
                                            Margin="12,0,0,0"
                                            Visibility="{Binding HasDiff, Converter={StaticResource BoolToVisibility}}">
                                    <CheckBox Content="Only changed lines"
                                              IsChecked="{Binding DiffOnlyChanged}"
                                              ToolTip="Collapse unchanged lines away from any change - click a collapsed row to show it"
                                              VerticalAlignment="Center"
                                              Margin="0,0,14,0" />
                                    <CheckBox Content="Ignore empty lines"
                                              IsChecked="{Binding DiffIgnoreEmptyLines}"
                                              ToolTip="Leave out blank lines, including changes that only add or remove them"
                                              VerticalAlignment="Center" />
                                </StackPanel>

                                <StackPanel Grid.Column="2"
                                            Orientation="Horizontal"
                                            VerticalAlignment="Center"
                                            Margin="16,0,0,0"
                                            Visibility="{Binding HasDiffDifferences, Converter={StaticResource BoolToVisibility}}">
                                    <Button Content="↑"
                                            Command="{Binding PreviousChangeCommand}"
                                            ToolTip="Previous change"
                                            Padding="10,4"
                                            Margin="0,0,4,0" />
                                    <Button Content="↓"
                                            Command="{Binding NextChangeCommand}"
                                            ToolTip="Next change"
                                            Padding="10,4"
                                            Margin="0,0,8,0" />
                                    <TextBlock Text="{Binding ChangePositionText}"
                                               Style="{StaticResource SubtleTextStyle}"
                                               VerticalAlignment="Center"
                                               MinWidth="48" />
                                </StackPanel>

                                <StackPanel Grid.Column="3"
                                            Orientation="Horizontal"
                                            Margin="12,0,0,0"
                                            VerticalAlignment="Center">
                                    <Button Content="Copy"
                                            Command="{Binding CopyConfigLinesCommand}"
                                            ToolTip="Copy what's shown here to the clipboard"
                                            Padding="10,4"
                                            Margin="0,0,6,0" />
                                    <Button Content="Export..."
                                            Command="{Binding ExportConfigCommand}"
                                            ToolTip="Save this backup, or this comparison as a .diff, to a file"
                                            Padding="10,4" />
                                </StackPanel>
                            </Grid>

                            <TextBlock Grid.Row="1"
                                       Text="Click a backup to view it, or tick two to compare them."
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       TextWrapping="Wrap"
                                       MaxWidth="320"
                                       TextAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource SubtleTextStyle}">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasConfigLines}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding HasTooManySelected}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsDiffing}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <TextBlock Grid.Row="1"
                                       Text="Comparing..."
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Style="{StaticResource SubtleTextStyle}"
                                       Visibility="{Binding IsDiffing, Converter={StaticResource BoolToVisibility}}" />

                            <TextBlock Grid.Row="1"
                                       Text="Tick exactly two backups to compare them."
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       TextWrapping="Wrap"
                                       MaxWidth="320"
                                       TextAlignment="Center"
                                       Style="{StaticResource SubtleTextStyle}"
                                       Visibility="{Binding HasTooManySelected, Converter={StaticResource BoolToVisibility}}" />

                            <!-- ==================== Line viewer ==================== -->
                            <!-- One virtualized list for both a single backup and a
                                 diff - configs run to thousands of lines. Item-based
                                 scrolling (CanContentScroll) makes the scroll offset
                                 a row index, which is what change navigation and the
                                 overview ruler both work in. -->
                            <Grid Grid.Row="1"
                                  Visibility="{Binding HasConfigLines, Converter={StaticResource BoolToVisibility}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <ItemsControl Grid.Column="0"
                                              x:Name="ConfigLinesList"
                                              ItemsSource="{Binding ConfigLines}"
                                              VirtualizingPanel.IsVirtualizing="True"
                                              VirtualizingPanel.VirtualizationMode="Recycling"
                                              VirtualizingPanel.ScrollUnit="Item">
                                    <ItemsControl.Template>
                                        <ControlTemplate TargetType="ItemsControl">
                                            <ScrollViewer x:Name="LinesScroll"
                                                          CanContentScroll="True"
                                                          Focusable="False"
                                                          VerticalScrollBarVisibility="Auto"
                                                          HorizontalScrollBarVisibility="Auto">
                                                <ItemsPresenter />
                                            </ScrollViewer>
                                        </ControlTemplate>
                                    </ItemsControl.Template>
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <VirtualizingStackPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:UnimusDiffLineViewModel}">
                                            <Border x:Name="RowBackground"
                                                    Background="Transparent"
                                                    MouseLeftButtonUp="OnConfigLineClick">
                                                <Grid TextElement.FontFamily="Consolas" TextElement.FontSize="12">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="46" />
                                                        <ColumnDefinition Width="46" />
                                                        <ColumnDefinition Width="22" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0"
                                                               Text="{Binding OldNumberText}"
                                                               Foreground="{StaticResource TextSecondaryBrush}"
                                                               TextAlignment="Right"
                                                               Margin="0,1,8,1" />
                                                    <!-- The second (new-side) number only means
                                                         anything in a diff - a single backup has
                                                         one set of line numbers. -->
                                                    <TextBlock Grid.Column="1"
                                                               x:Name="NewNumber"
                                                               Text="{Binding NewNumberText}"
                                                               Foreground="{StaticResource TextSecondaryBrush}"
                                                               TextAlignment="Right"
                                                               Margin="0,1,8,1"
                                                               Visibility="{Binding DataContext.HasDiff, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource BoolToVisibility}}" />
                                                    <TextBlock Grid.Column="2"
                                                               x:Name="Prefix"
                                                               Text="{Binding Prefix}"
                                                               FontWeight="Bold"
                                                               TextAlignment="Center"
                                                               Margin="0,1" />
                                                    <TextBlock Grid.Column="3"
                                                               x:Name="LineText"
                                                               Text="{Binding Text}"
                                                               Foreground="{StaticResource TextPrimaryBrush}"
                                                               TextWrapping="NoWrap"
                                                               Margin="0,1,12,1" />
                                                </Grid>
                                            </Border>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding IsRemoved}" Value="True">
                                                    <Setter TargetName="RowBackground" Property="Background" Value="{StaticResource DiffRemovedRowBrush}" />
                                                    <Setter TargetName="Prefix" Property="Foreground" Value="{StaticResource CriticalBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsAdded}" Value="True">
                                                    <Setter TargetName="RowBackground" Property="Background" Value="{StaticResource DiffAddedRowBrush}" />
                                                    <Setter TargetName="Prefix" Property="Foreground" Value="{StaticResource OkBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsHidden}" Value="True">
                                                    <Setter TargetName="RowBackground" Property="Background" Value="{StaticResource SurfaceBrush}" />
                                                    <Setter TargetName="RowBackground" Property="Cursor" Value="Hand" />
                                                    <Setter TargetName="LineText" Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                                                    <Setter TargetName="LineText" Property="FontStyle" Value="Italic" />
                                                    <Setter TargetName="LineText" Property="Margin" Value="0,4,12,4" />
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- Where the changes are in the whole diff, and
                                     which part of it is in view - click or drag
                                     to jump there. -->
                                <views:DiffOverviewRuler Grid.Column="1"
                                                         x:Name="DiffRuler"
                                                         Width="12"
                                                         Margin="6,0,0,0"
                                                         Lines="{Binding ConfigLines}"
                                                         ToolTip="Changes in this comparison - click to jump there"
                                                         Visibility="{Binding HasDiff, Converter={StaticResource BoolToVisibility}}" />
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>

                <TextBlock Grid.Row="1"
                           Text="{Binding ConfigErrorMessage}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           TextWrapping="Wrap"
                           MaxWidth="360"
                           TextAlignment="Center"
                           Foreground="{StaticResource CriticalBrush}"
                           Visibility="{Binding HasConfigError, Converter={StaticResource BoolToVisibility}}" />
            </Grid>

            <!-- ==================== Routing (#53) ==================== -->
            <Grid Margin="24"
                  Visibility="{Binding IsRoutingSelected, Converter={StaticResource BoolToVisibility}}">
                <views:RoutingView DataContext="{Binding Routing}" />
            </Grid>

            <!-- ==================== Wireless (#55) ==================== -->
            <Grid Margin="24"
                  Visibility="{Binding IsWirelessSelected, Converter={StaticResource BoolToVisibility}}">
                <views:WirelessView DataContext="{Binding Wireless}" />
            </Grid>

            <!-- ==================== Inventory (#164) ==================== -->
            <Grid Margin="24"
                  Visibility="{Binding IsInventorySelected, Converter={StaticResource BoolToVisibility}}">
                <views:InventoryView DataContext="{Binding Inventory}" />
            </Grid>

            <!-- ==================== Graylog (issue #114) ==================== -->
            <!-- Shared with the Logs tab - see GraylogMessagesView. -->
            <Grid Margin="24"
                  Visibility="{Binding IsGraylogSelected, Converter={StaticResource BoolToVisibility}}">
                <views:GraylogMessagesView DataContext="{Binding Graylog}" />
            </Grid>

            <!-- ==================== Edit ==================== -->
            <!-- Full-width rather than pinned to a narrow left-aligned
                 column - a card with three or four short fields looked lost
                 in a sea of empty space on anything wider than a laptop
                 screen. Each card still caps its own internal field rows via
                 2-3 star-width columns so a very wide window doesn't stretch
                 a single TextBox absurdly, but the cards themselves now use
                 the space the window actually offers. -->
            <ScrollViewer Visibility="{Binding IsEditSelected, Converter={StaticResource BoolToVisibility}}"
                          VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24">
                <TextBlock Text="Edit device" Style="{StaticResource HeadingTextStyle}" Margin="0,0,0,14" />

                <!-- Device-management actions come first - a single home for
                     "change this device" (Rediscover, Delete) that's the
                     first thing you see, rather than scattering them across
                     the header or burying them under every field card below. -->
                <Border Background="{StaticResource SurfaceAltBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="14,12"
                        Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="Device management" Style="{StaticResource SectionHeaderStyle}" Margin="0,0,0,10" />
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Rediscover"
                                    Command="{Binding RediscoverCommand}"
                                    ToolTip="Ask LibreNMS to rediscover this device now"
                                    HorizontalAlignment="Left"
                                    Padding="12,7" />
                            <Button Content="Schedule maintenance..."
                                    Command="{Binding ScheduleMaintenanceCommand}"
                                    ToolTip="Suppress or mute alerts for this device for a set duration"
                                    HorizontalAlignment="Left"
                                    Padding="12,7"
                                    Margin="10,0,0,0" />
                            <Button Content="Delete device"
                                    Command="{Binding DeleteCommand}"
                                    ToolTip="Permanently remove this device from LibreNMS"
                                    Foreground="{StaticResource CriticalBrush}"
                                    BorderBrush="{StaticResource CriticalBrush}"
                                    HorizontalAlignment="Left"
                                    Padding="12,7"
                                    Margin="10,0,0,0" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Background="{StaticResource SurfaceAltBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="14,12"
                        Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="General" Style="{StaticResource SectionHeaderStyle}" Margin="0,0,0,10" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Hostname / IP" Style="{StaticResource SectionHeaderStyle}" />
                                <TextBox Text="{Binding EditHostname, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="The address LibreNMS actually polls - changing this renames the device rather than just relabelling it." />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Display name" Style="{StaticResource SectionHeaderStyle}" />
                                <TextBox Text="{Binding EditDisplayName, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="A literal name, or a LibreNMS {{ $hostname }}-style template - blank uses LibreNMS's own default naming" />
                            </StackPanel>
                            <StackPanel Grid.Column="4">
                                <TextBlock Text="Type" Style="{StaticResource SectionHeaderStyle}" />
                                <TextBox Text="{Binding EditType, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="Description" Style="{StaticResource SectionHeaderStyle}" Margin="0,14,0,0" />
                        <TextBox Text="{Binding EditPurpose, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                </Border>

                <Border Background="{StaticResource SurfaceAltBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="14,12"
                        Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="Location &amp; contact" Style="{StaticResource SectionHeaderStyle}" Margin="0,0,0,10" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="24" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Location" Style="{StaticResource SectionHeaderStyle}" />
                                <TextBox Text="{Binding EditLocation, UpdateSourceTrigger=PropertyChanged}" />
                                <CheckBox Content="Override sysLocation"
                                          IsChecked="{Binding EditOverrideSysLocation}"
                                          Margin="0,8,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Contact" Style="{StaticResource SectionHeaderStyle}" />
                                <TextBox Text="{Binding EditContact, UpdateSourceTrigger=PropertyChanged}" />
                                <CheckBox Content="Override sysContact"
                                          IsChecked="{Binding EditOverrideSysContact}"
                                          Margin="0,8,0,0" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Background="{StaticResource SurfaceAltBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="14,12"
                        Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="Poller &amp; status" Style="{StaticResource SectionHeaderStyle}" Margin="0,0,0,10" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="24" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Poller group" Style="{StaticResource SectionHeaderStyle}" />
                                <ComboBox ItemsSource="{Binding PollerGroups}"
                                          SelectedItem="{Binding SelectedPollerGroup}"
                                          DisplayMemberPath="GroupName" />
                                <TextBlock Style="{StaticResource SubtleTextStyle}"
                                           TextWrapping="Wrap"
                                           Margin="0,6,0,0"
                                           Text="For a distributed-poller setup." />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Status" Style="{StaticResource SectionHeaderStyle}" />
                                <CheckBox Content="Disabled (stops polling and alerting)" IsChecked="{Binding EditDisabled}" Margin="0,4,0,0" />
                                <CheckBox Content="Ignore (keeps polling, suppresses alerts)" IsChecked="{Binding EditIgnore}" Margin="0,8,0,0" />
                                <CheckBox Content="Ignore status (excludes from availability figures)" IsChecked="{Binding EditIgnoreStatus}" Margin="0,8,0,0" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Background="{StaticResource SurfaceAltBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="14,12"
                        Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="Notes" Style="{StaticResource SectionHeaderStyle}" Margin="0,0,0,10" />
                        <TextBox Text="{Binding EditNotes, UpdateSourceTrigger=PropertyChanged}"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 Height="90"
                                 VerticalContentAlignment="Top"
                                 VerticalScrollBarVisibility="Auto" />
                    </StackPanel>
                </Border>

                <!-- ==================== SNMP ==================== -->
                <Border Background="{StaticResource SurfaceAltBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="14,12"
                        Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="SNMP" Style="{StaticResource SectionHeaderStyle}" Margin="0,0,0,10" />

                        <!-- LibreNMS's read API never returns stored SNMP
                             credentials, so this can only set new ones, not
                             show current ones - unchecked by default every
                             time Edit opens, so saving the rest of this form
                             can never accidentally touch SNMP at all. -->
                        <CheckBox Content="Change SNMP settings" IsChecked="{Binding EditChangeSnmp}" />
                        <TextBlock Style="{StaticResource SubtleTextStyle}"
                                   TextWrapping="Wrap"
                                   Margin="0,6,0,0"
                                   Text="LibreNMS does not return stored credentials, so this only sets new ones - leave unchecked to leave SNMP untouched."
                                   Visibility="{Binding ShowSnmpEditFields, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}" />

                        <StackPanel Visibility="{Binding ShowSnmpEditFields, Converter={StaticResource BoolToVisibility}}" Margin="0,14,0,0">
                            <Border Style="{StaticResource NavTabTrackStyle}" HorizontalAlignment="Left">
                                <StackPanel Orientation="Horizontal">
                                    <ToggleButton Content="Yes" Style="{StaticResource NavTabButtonStyle}" IsChecked="{Binding EditIsSnmpEnabled}" />
                                    <ToggleButton Content="No (ping only)" Style="{StaticResource NavTabButtonStyle}" IsChecked="{Binding EditIsPingOnly}" />
                                </StackPanel>
                            </Border>

                            <!-- ==================== SNMP enabled ==================== -->
                            <StackPanel Visibility="{Binding ShowEditSnmpFields, Converter={StaticResource BoolToVisibility}}">
                                <Border Style="{StaticResource NavTabTrackStyle}" HorizontalAlignment="Left" Margin="0,14,0,0">
                                    <StackPanel Orientation="Horizontal">
                                        <ToggleButton Content="v2c" Style="{StaticResource NavTabButtonStyle}" IsChecked="{Binding EditIsSnmpV2c}" />
                                        <ToggleButton Content="v1" Style="{StaticResource NavTabButtonStyle}" IsChecked="{Binding EditIsSnmpV1}" />
                                        <ToggleButton Content="v3" Style="{StaticResource NavTabButtonStyle}" IsChecked="{Binding EditIsSnmpV3}" />
                                    </StackPanel>
                                </Border>

                                <StackPanel Visibility="{Binding ShowEditCommunity, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Text="Community" Style="{StaticResource SectionHeaderStyle}" Margin="0,14,0,6" />
                                    <TextBox Text="{Binding EditCommunity, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>

                                <StackPanel Visibility="{Binding ShowEditV3Fields, Converter={StaticResource BoolToVisibility}}">
                                    <Grid Margin="0,14,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="16" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Auth level" Style="{StaticResource SectionHeaderStyle}" />
                                            <ComboBox SelectedValuePath="Content" SelectedValue="{Binding EditAuthLevel}">
                                                <ComboBoxItem Content="noAuthNoPriv" />
                                                <ComboBoxItem Content="authNoPriv" />
                                                <ComboBoxItem Content="authPriv" />
                                            </ComboBox>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Auth algorithm" Style="{StaticResource SectionHeaderStyle}" />
                                            <ComboBox SelectedValuePath="Content" SelectedValue="{Binding EditAuthAlgo}">
                                                <ComboBoxItem Content="MD5" />
                                                <ComboBoxItem Content="SHA" />
                                            </ComboBox>
                                        </StackPanel>
                                    </Grid>

                                    <TextBlock Text="Auth username" Style="{StaticResource SectionHeaderStyle}" Margin="0,10,0,6" />
                                    <TextBox Text="{Binding EditAuthName, UpdateSourceTrigger=PropertyChanged}" />

                                    <TextBlock Text="Auth password" Style="{StaticResource SectionHeaderStyle}" Margin="0,10,0,6" />
                                    <PasswordBox x:Name="EditAuthPassBox" PasswordChanged="OnEditAuthPassChanged" />

                                    <Grid Margin="0,10,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="16" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Privacy algorithm" Style="{StaticResource SectionHeaderStyle}" />
                                            <ComboBox SelectedValuePath="Content" SelectedValue="{Binding EditCryptoAlgo}">
                                                <ComboBoxItem Content="AES" />
                                                <ComboBoxItem Content="DES" />
                                            </ComboBox>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Privacy password" Style="{StaticResource SectionHeaderStyle}" />
                                            <PasswordBox x:Name="EditCryptoPassBox" PasswordChanged="OnEditCryptoPassChanged" />
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>

                                <Grid Margin="0,14,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="16" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Port (optional)" Style="{StaticResource SectionHeaderStyle}" />
                                        <TextBox Text="{Binding EditPort, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Transport (optional)" Style="{StaticResource SectionHeaderStyle}" />
                                        <ComboBox SelectedValuePath="Content" SelectedValue="{Binding EditTransport}">
                                            <ComboBoxItem Content="" />
                                            <ComboBoxItem Content="udp" />
                                            <ComboBoxItem Content="tcp" />
                                            <ComboBoxItem Content="udp6" />
                                            <ComboBoxItem Content="tcp6" />
                                        </ComboBox>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>

                            <!-- ==================== Ping only ==================== -->
                            <StackPanel Visibility="{Binding ShowEditPingOnlyFields, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="sysName" Style="{StaticResource SectionHeaderStyle}" Margin="0,14,0,6" />
                                <TextBox Text="{Binding EditSysNameOverride, UpdateSourceTrigger=PropertyChanged}" />

                                <TextBlock Text="Hardware" Style="{StaticResource SectionHeaderStyle}" Margin="0,10,0,6" />
                                <TextBox Text="{Binding EditHardwareOverride, UpdateSourceTrigger=PropertyChanged}" />

                                <TextBlock Text="OS" Style="{StaticResource SectionHeaderStyle}" Margin="0,10,0,6" />
                                <ComboBox IsEditable="True"
                                          Text="{Binding EditSnmpOs, UpdateSourceTrigger=PropertyChanged}"
                                          ItemsSource="{Binding KnownOperatingSystems}" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Background="#33DA3633"
                        BorderBrush="{StaticResource CriticalBrush}"
                        BorderThickness="1"
                        CornerRadius="5"
                        Padding="12,10"
                        Margin="0,0,0,14"
                        Visibility="{Binding HasEditError, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="{Binding EditErrorMessage}" TextWrapping="Wrap" />
                </Border>

                <Border Background="#332EA043"
                        BorderBrush="{StaticResource OkBrush}"
                        BorderThickness="1"
                        CornerRadius="5"
                        Padding="12,10"
                        Margin="0,0,0,14"
                        Visibility="{Binding HasEditSuccess, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="{Binding EditSuccessMessage}" TextWrapping="Wrap" />
                </Border>

                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Saving..."
                               Style="{StaticResource SubtleTextStyle}"
                               VerticalAlignment="Center"
                               Margin="0,0,12,0"
                               Visibility="{Binding IsSavingEdit, Converter={StaticResource BoolToVisibility}}" />
                    <Button Content="Save"
                            Command="{Binding SaveEditCommand}"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Padding="16,7" />
                </StackPanel>
            </StackPanel>
            </ScrollViewer>
            </Grid>
            </Grid>
        </Grid>

        <!-- ======================== Status bar ======================== -->
        <Border Grid.Row="3"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="18,8">
            <TextBlock Text="Refreshing..."
                       Style="{StaticResource SubtleTextStyle}"
                       Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
        </Border>
    </Grid>
</Window>
