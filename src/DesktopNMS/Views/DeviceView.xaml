<Window x:Class="DesktopNMS.Views.DeviceView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:DesktopNMS.ViewModels"
        xmlns:views="clr-namespace:DesktopNMS.Views"
        xmlns:svgc="clr-namespace:SharpVectors.Converters;assembly=SharpVectors.Converters.Wpf"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:DeviceDetailViewModel}"
        Title="{Binding Name}"
        Width="1200"
        Height="800"
        MinWidth="640"
        MinHeight="480"
        Icon="pack://application:,,,/Assets/app.ico"
        Background="{StaticResource BackgroundBrush}"
        WindowStartupLocation="CenterOwner">

    <Window.Resources>
        <!-- A card that behaves like a button - jumps to the named section
             tab when clicked - without looking like one. -->
        <Style x:Key="OverviewCardButtonStyle" TargetType="Button">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{StaticResource SurfaceBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="20">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ======================== Header ======================== -->
        <Border Grid.Row="0"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="24,18">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Loading device..."
                               Style="{StaticResource SubtleTextStyle}"
                               Visibility="{Binding IsLoadingDevice, Converter={StaticResource BoolToVisibility}}" />

                    <StackPanel Visibility="{Binding IsLoadingDevice, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <Ellipse Width="9"
                                     Height="9"
                                     Margin="0,0,8,0"
                                     VerticalAlignment="Center"
                                     Fill="{Binding State, Converter={StaticResource DeviceStateToBrush}}" />
                            <TextBlock Text="{Binding StateText}" Style="{StaticResource SubtleTextStyle}" VerticalAlignment="Center" />
                        </StackPanel>

                        <TextBlock Text="{Binding Name}" Style="{StaticResource HeadingTextStyle}" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding AlternateName}"
                                   Style="{StaticResource SubtleTextStyle}"
                                   TextWrapping="Wrap"
                                   Visibility="{Binding HasAlternateName, Converter={StaticResource BoolToVisibility}}" />
                        <TextBlock Text="{Binding SysDescr}"
                                   Style="{StaticResource SubtleTextStyle}"
                                   TextWrapping="Wrap"
                                   Visibility="{Binding HasSysDescr, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Web/Telnet/SSH launch this device's own address via
                         whatever the OS has registered for that URI scheme -
                         see DeviceDetailViewModel.OpenExternal. Hidden by
                         IsEnabled rather than Visibility when the device has
                         neither an IP nor a hostname, so the button stays put
                         and the tooltip still explains why. -->
                    <Button Content="Open in"
                            Style="{StaticResource ChipButtonStyle}"
                            Margin="0,0,8,0"
                            IsEnabled="{Binding CanOpenExternally}"
                            Click="OnOpenInClick"
                            ToolTip="Launch this device's address in an external tool">
                        <Button.ContextMenu>
                            <ContextMenu Placement="Bottom">
                                <MenuItem Header="Web (HTTP)" Command="{Binding OpenWebHttpCommand}" />
                                <MenuItem Header="Web (HTTPS)" Command="{Binding OpenWebHttpsCommand}" />
                                <MenuItem Header="Telnet" Command="{Binding OpenTelnetCommand}" />
                                <MenuItem Header="SSH" Command="{Binding OpenSshCommand}" />
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>

                    <!-- Rediscover now lives inside the Edit section, alongside
                         the editable fields and (eventually) Delete - a
                         single home for "change this device" rather than
                         scattering device-management actions across the
                         header. -->
                    <Button Content="Edit"
                            Style="{StaticResource ChipButtonStyle}"
                            Margin="0,0,8,0"
                            Command="{Binding SelectEditCommand}"
                            ToolTip="Edit this device" />

                    <Button Command="{Binding RefreshCommand}"
                            Style="{StaticResource IconButtonStyle}"
                            ToolTip="Refresh now">
                        <TextBlock Text="&#xE72C;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="15" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ======================== Error banner ======================== -->
        <Border Grid.Row="1"
                Background="#33DA3633"
                BorderBrush="{StaticResource CriticalBrush}"
                BorderThickness="0,0,0,1"
                Padding="18,10"
                Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap" />
        </Border>

        <!-- ======================== Sidebar + section content ======================== -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ==================== Section nav ==================== -->
            <!-- Grouped rather than one flat row: a handful of sections reads
                 fine as a row of tabs, but this window is growing towards a
                 dozen (FDB, ARP, routing, VLANs, ... alongside what is here
                 already) - a flat row would just run off the window edge,
                 where a vertical list keeps scaling by scrolling instead. -->
            <Border Grid.Column="0"
                    Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,0,1,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="10,16">
                        <ToggleButton Content="Overview"
                                      Style="{StaticResource SettingsNavItemStyle}"
                                      IsChecked="{Binding IsOverviewSelected, Mode=OneWay}"
                                      Command="{Binding SelectOverviewCommand}" />

                        <TextBlock Text="HEALTH" Style="{StaticResource SectionHeaderStyle}" Margin="14,16,0,6" />
                        <ToggleButton Style="{StaticResource SettingsNavItemStyle}"
                                      IsChecked="{Binding IsSensorsSelected, Mode=OneWay}"
                                      Command="{Binding SelectSensorsCommand}">
                            <!-- Content is typed object, not string, so Binding.StringFormat is
                                 silently ignored when applied directly to it - an explicit
                                 TextBlock.Text (a real string property) is needed instead. -->
                            <TextBlock Text="{Binding Sensors.Count, Mode=OneWay, StringFormat=Sensors ({0})}" />
                        </ToggleButton>
                        <ToggleButton Content="Resources"
                                      Style="{StaticResource SettingsNavItemStyle}"
                                      IsChecked="{Binding IsResourcesSelected, Mode=OneWay}"
                                      Command="{Binding SelectResourcesCommand}"
                                      Visibility="{Binding ShowResourcesNav, Converter={StaticResource BoolToVisibility}}" />
                        <ToggleButton Content="Graphs"
                                      Style="{StaticResource SettingsNavItemStyle}"
                                      IsChecked="{Binding IsGraphsSelected, Mode=OneWay}"
                                      Command="{Binding SelectGraphsCommand}" />

                        <!-- ShowXNav (not HasX) stays visible while its section
                             is still loading, only disappearing once loading
                             has finished and genuinely found nothing - so it
                             does not pop into existence after the window
                             opens and shift every item below it (see
                             DeviceDetailViewModel's remarks on IsLoadingPorts
                             and friends). -->
                        <TextBlock Text="NETWORK"
                                   Style="{StaticResource SectionHeaderStyle}"
                                   Margin="14,16,0,6"
                                   Visibility="{Binding HasNetworkSection, Converter={StaticResource BoolToVisibility}}" />
                        <ToggleButton Style="{StaticResource SettingsNavItemStyle}"
                                      IsChecked="{Binding IsPortsSelected, Mode=OneWay}"
                                      Command="{Binding SelectPortsCommand}"
                                      Visibility="{Binding ShowPortsNav, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="{Binding Ports.Count, Mode=OneWay, StringFormat=Ports ({0})}" />
                        </ToggleButton>
                        <ToggleButton Style="{StaticResource SettingsNavItemStyle}"
                                      IsChecked="{Binding IsVlansSelected, Mode=OneWay}"
                                      Command="{Binding SelectVlansCommand}"
                                      Visibility="{Binding ShowVlansNav, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="{Binding VlanEntries.Count, Mode=OneWay, StringFormat=VLANs ({0})}" />
                        </ToggleButton>
                        <ToggleButton Style="{StaticResource SettingsNavItemStyle}"
                                      IsChecked="{Binding IsFdbSelected, Mode=OneWay}"
                                      Command="{Binding SelectFdbCommand}"
                                      Visibility="{Binding ShowFdbNav, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="{Binding FdbEntries.Count, Mode=OneWay, StringFormat=FDB ({0})}" />
                        </ToggleButton>
                        <ToggleButton Style="{StaticResource SettingsNavItemStyle}"
                                      IsChecked="{Binding IsArpSelected, Mode=OneWay}"
                                      Command="{Binding SelectArpCommand}"
                                      Visibility="{Binding ShowArpNav, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="{Binding ArpEntries.Count, Mode=OneWay, StringFormat=ARP ({0})}" />
                        </ToggleButton>

                        <TextBlock Text="ALERTS &amp; LOGS" Style="{StaticResource SectionHeaderStyle}" Margin="14,16,0,6" />
                        <ToggleButton Style="{StaticResource SettingsNavItemStyle}"
                                      IsChecked="{Binding IsAlertsSelected, Mode=OneWay}"
                                      Command="{Binding SelectAlertsCommand}">
                            <TextBlock Text="{Binding ActiveAlerts.Count, Mode=OneWay, StringFormat=Alerts ({0})}" />
                        </ToggleButton>
                        <ToggleButton Style="{StaticResource SettingsNavItemStyle}"
                                      IsChecked="{Binding IsEventLogSelected, Mode=OneWay}"
                                      Command="{Binding SelectEventLogCommand}">
                            <TextBlock Text="{Binding EventLog.Count, Mode=OneWay, StringFormat=Event log ({0})}" />
                        </ToggleButton>

                        <!-- No sidebar entry for Edit - the header's own Edit
                             button (next to Refresh) is the one way in, so
                             there is only one place to look for it rather
                             than two that both have to stay in sync. -->
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- ==================== Section content ==================== -->
            <Grid Grid.Column="1">

            <!-- ==================== Overview ==================== -->
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          Visibility="{Binding IsOverviewSelected, Converter={StaticResource BoolToVisibility}}">
                <StackPanel Margin="24">

                    <!-- Four themed cards rather than one wide grid: each
                         stays a sensible, tight size regardless of how wide
                         the window is (a UniformGrid row, same pattern as
                         the shortcut-card row lower on this page), instead
                         of a single card whose columns stretch to fill an
                         arbitrary window width and leave huge gaps around
                         short values. Identity/Location/Status always show
                         something (Ip/Location/UptimeText all fall back to
                         "-"); only "Technical" can disappear entirely, for a
                         device with none of Object ID/Serial/Depends-on. -->
                    <UniformGrid Rows="1">
                        <Border Background="{StaticResource SurfaceBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="20"
                                Margin="0,0,6,0">
                            <StackPanel>
                                <TextBlock Text="IP address" Style="{StaticResource SectionHeaderStyle}" Margin="0,0,0,0" />
                                <TextBlock Text="{Binding Ip}" TextWrapping="Wrap" Margin="0,0,0,14" />
                                <TextBlock Text="Operating system" Style="{StaticResource SectionHeaderStyle}" Margin="0,0,0,0" />
                                <TextBlock Text="{Binding Os}" TextWrapping="Wrap" Margin="0,0,0,14" />
                                <TextBlock Text="Hardware" Style="{StaticResource SectionHeaderStyle}" Margin="0,0,0,0" />
                                <TextBlock Text="{Binding Hardware}" TextWrapping="Wrap" Margin="0,0,0,14" />
                                <TextBlock Text="Type" Style="{StaticResource SectionHeaderStyle}" Margin="0,0,0,0" />
                                <TextBlock Text="{Binding Type}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <Border Background="{StaticResource SurfaceBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="20"
                                Margin="6,0">
                            <StackPanel>
                                <TextBlock Text="Location" Style="{StaticResource SectionHeaderStyle}" />
                                <TextBlock TextWrapping="Wrap" Margin="0,0,0,14" Cursor="Hand">
                                    <Hyperlink Command="{Binding ShowDevicesForLocationCommand}"
                                               ToolTip="Show every device at this location">
                                        <Run Text="{Binding Location, Mode=OneWay}" />
                                    </Hyperlink>
                                </TextBlock>
                                <TextBlock Text="Contact" Style="{StaticResource SectionHeaderStyle}" Visibility="{Binding HasContact, Converter={StaticResource BoolToVisibility}}" />
                                <TextBlock Text="{Binding Contact}" TextWrapping="Wrap" Visibility="{Binding HasContact, Converter={StaticResource BoolToVisibility}}" />
                            </StackPanel>
                        </Border>

                        <!-- Hidden entirely for a device in no groups (most
                             of them) - see DeviceDetailViewModel.HasDeviceGroups.
                             Each name is its own link: clicking closes this
                             window and jumps to the Devices tab isolated down
                             to that one group, same action as the Location
                             link above. -->
                        <Border Background="{StaticResource SurfaceBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="20"
                                Margin="6,0"
                                Visibility="{Binding HasDeviceGroups, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel>
                                <TextBlock Text="Device groups" Style="{StaticResource SectionHeaderStyle}" Margin="0,0,0,0" />
                                <ItemsControl ItemsSource="{Binding DeviceGroups}" Margin="0,4,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock TextWrapping="Wrap" Cursor="Hand" Margin="0,2">
                                                <Hyperlink Command="{Binding ShowDevicesForGroupCommand}"
                                                           ToolTip="{Binding Description}">
                                                    <Run Text="{Binding Name, Mode=OneWay}" />
                                                </Hyperlink>
                                            </TextBlock>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <Border Background="{StaticResource SurfaceBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="20"
                                Margin="6,0">
                            <StackPanel>
                                <TextBlock Text="Uptime" Style="{StaticResource SectionHeaderStyle}" />
                                <TextBlock Text="{Binding UptimeText}" TextWrapping="Wrap" Margin="0,0,0,14" />
                                <TextBlock Text="Device added" Style="{StaticResource SectionHeaderStyle}" Visibility="{Binding HasInserted, Converter={StaticResource BoolToVisibility}}" />
                                <TextBlock Text="{Binding InsertedText}" TextWrapping="Wrap" Visibility="{Binding HasInserted, Converter={StaticResource BoolToVisibility}}" Margin="0,0,0,14" />
                                <TextBlock Text="Last discovered" Style="{StaticResource SectionHeaderStyle}" Visibility="{Binding HasLastDiscovered, Converter={StaticResource BoolToVisibility}}" />
                                <TextBlock Text="{Binding LastDiscoveredText}" TextWrapping="Wrap" Visibility="{Binding HasLastDiscovered, Converter={StaticResource BoolToVisibility}}" />
                            </StackPanel>
                        </Border>

                        <Border Background="{StaticResource SurfaceBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="20"
                                Margin="6,0,0,0"
                                Visibility="{Binding HasTechnicalDetails, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel>
                                <TextBlock Text="Object ID" Style="{StaticResource SectionHeaderStyle}" Visibility="{Binding HasSysObjectId, Converter={StaticResource BoolToVisibility}}" />
                                <TextBlock Text="{Binding SysObjectId}" TextWrapping="Wrap" Visibility="{Binding HasSysObjectId, Converter={StaticResource BoolToVisibility}}" Margin="0,0,0,14" />
                                <TextBlock Text="Serial number" Style="{StaticResource SectionHeaderStyle}" Visibility="{Binding HasSerial, Converter={StaticResource BoolToVisibility}}" />
                                <TextBlock Text="{Binding Serial}" TextWrapping="Wrap" Visibility="{Binding HasSerial, Converter={StaticResource BoolToVisibility}}" Margin="0,0,0,14" />
                                <TextBlock Text="Depends on" Style="{StaticResource SectionHeaderStyle}" Visibility="{Binding HasDependencyParent, Converter={StaticResource BoolToVisibility}}" />
                                <TextBlock Text="{Binding DependencyParentText}" TextWrapping="Wrap" Visibility="{Binding HasDependencyParent, Converter={StaticResource BoolToVisibility}}" />
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <Border Margin="0,16,0,0"
                            Background="{StaticResource SurfaceBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="20"
                            Visibility="{Binding HasAvailability, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel>
                            <TextBlock Text="Availability" Style="{StaticResource SectionHeaderStyle}" Margin="0,0,0,10" />

                            <UniformGrid Rows="1" Columns="4">
                                <StackPanel Margin="0,0,10,0">
                                    <TextBlock Text="24 hours" Style="{StaticResource SubtleTextStyle}" />
                                    <TextBlock Text="{Binding Availability1DayText}" FontSize="18" FontWeight="SemiBold" />
                                </StackPanel>
                                <StackPanel Margin="0,0,10,0">
                                    <TextBlock Text="7 days" Style="{StaticResource SubtleTextStyle}" />
                                    <TextBlock Text="{Binding Availability7DayText}" FontSize="18" FontWeight="SemiBold" />
                                </StackPanel>
                                <StackPanel Margin="0,0,10,0">
                                    <TextBlock Text="30 days" Style="{StaticResource SubtleTextStyle}" />
                                    <TextBlock Text="{Binding Availability30DayText}" FontSize="18" FontWeight="SemiBold" />
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="1 year" Style="{StaticResource SubtleTextStyle}" />
                                    <TextBlock Text="{Binding Availability1YearText}" FontSize="18" FontWeight="SemiBold" />
                                </StackPanel>
                            </UniformGrid>

                            <!-- A compact status-page-style history bar: one segment per day
                                 over the last 30 days, red if the device had any downtime
                                 that day. UniformGrid with a fixed Rows="1" spaces the
                                 segments evenly across the full width regardless of count. -->
                            <ItemsControl ItemsSource="{Binding AvailabilityTimeline}" Margin="0,16,0,0">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Rows="1" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Height="28"
                                                Margin="1,0"
                                                CornerRadius="2"
                                                Background="{Binding Severity, Converter={StaticResource SeverityToBrush}}"
                                                ToolTip="{Binding TooltipText}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Grid Margin="0,4,0,0">
                                <TextBlock Text="30 days ago" Style="{StaticResource SubtleTextStyle}" FontSize="10" HorizontalAlignment="Left" />
                                <TextBlock Text="Today" Style="{StaticResource SubtleTextStyle}" FontSize="10" HorizontalAlignment="Right" />
                            </Grid>

                            <Expander Style="{StaticResource AccordionExpanderStyle}"
                                      IsExpanded="False"
                                      Margin="0,16,0,0"
                                      Visibility="{Binding HasOutages, Converter={StaticResource BoolToVisibility}}">
                                <!-- StringFormat has no effect on Header directly - it is
                                     typed object, not string, so WPF silently skips the
                                     format and shows the raw count instead. A TextBlock
                                     as the header content sidesteps that. -->
                                <Expander.Header>
                                    <TextBlock Text="{Binding Outages.Count, StringFormat=Recent outages ({0})}" />
                                </Expander.Header>
                                <ItemsControl ItemsSource="{Binding Outages}" Margin="0,10,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,0,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" VerticalAlignment="Center">
                                                    <Run Text="{Binding StartedText, Mode=OneWay}" /><Run Text=" &#8594; " /><Run Text="{Binding EndedText, Mode=OneWay}" />
                                                </TextBlock>
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding DurationText}"
                                                           Style="{StaticResource SubtleTextStyle}"
                                                           VerticalAlignment="Center"
                                                           Margin="12,0,0,0" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Expander>
                        </StackPanel>
                    </Border>

                    <!-- UniformGrid sizes itself from its visible children only, so the
                         Ports tile - hidden entirely on a device with no
                         interfaces - does not leave a blank gap behind it. -->
                    <UniformGrid Rows="1" Margin="0,12,0,0">
                        <Button Command="{Binding SelectSensorsCommand}"
                                Style="{StaticResource OverviewCardButtonStyle}"
                                Margin="4,0">
                            <StackPanel HorizontalAlignment="Left">
                                <TextBlock Text="Sensors" Style="{StaticResource SectionHeaderStyle}" />
                                <TextBlock Text="{Binding Sensors.Count}" Style="{StaticResource HeadingTextStyle}" />
                                <TextBlock Text="{Binding SensorAlertSummaryText}"
                                           Style="{StaticResource SubtleTextStyle}"
                                           Visibility="{Binding SensorAlertSummaryText, Converter={StaticResource StringToVisibility}}" />
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding SelectPortsCommand}"
                                Style="{StaticResource OverviewCardButtonStyle}"
                                Margin="4,0"
                                Visibility="{Binding ShowPortsNav, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel HorizontalAlignment="Left">
                                <TextBlock Text="Ports" Style="{StaticResource SectionHeaderStyle}" />
                                <TextBlock Text="{Binding Ports.Count}" Style="{StaticResource HeadingTextStyle}" />
                                <TextBlock Style="{StaticResource SubtleTextStyle}">
                                    <Run Text="{Binding PortsUpCount, Mode=OneWay}" /><Run Text=" up, " /><Run Text="{Binding PortsDownCount, Mode=OneWay}" /><Run Text=" down" />
                                </TextBlock>
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding SelectAlertsCommand}"
                                Style="{StaticResource OverviewCardButtonStyle}"
                                Margin="4,0">
                            <StackPanel HorizontalAlignment="Left">
                                <TextBlock Text="Alerts" Style="{StaticResource SectionHeaderStyle}" />
                                <TextBlock Text="{Binding ActiveAlerts.Count}" Style="{StaticResource HeadingTextStyle}" />
                                <TextBlock Text="{Binding ActiveAlertSummaryText}"
                                           Style="{StaticResource SubtleTextStyle}"
                                           Visibility="{Binding ActiveAlertSummaryText, Converter={StaticResource StringToVisibility}}" />
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding SelectResourcesCommand}"
                                Style="{StaticResource OverviewCardButtonStyle}"
                                Margin="4,0"
                                Visibility="{Binding ShowResourcesNav, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel HorizontalAlignment="Left">
                                <TextBlock Text="Resources" Style="{StaticResource SectionHeaderStyle}" />
                                <TextBlock Text="{Binding Processors.Count, StringFormat={}{0} CPUs}" Style="{StaticResource HeadingTextStyle}" />
                                <TextBlock Text="{Binding ResourceSummaryText}" Style="{StaticResource SubtleTextStyle}" />
                            </StackPanel>
                        </Button>
                    </UniformGrid>
                </StackPanel>
            </ScrollViewer>

            <!-- ==================== Sensors ==================== -->
            <Grid Margin="24"
                  Visibility="{Binding IsSensorsSelected, Converter={StaticResource BoolToVisibility}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBox Grid.Column="0"
                             Style="{StaticResource SearchTextBoxStyle}"
                             Tag="Search sensors"
                             Text="{Binding SensorSearchText, UpdateSourceTrigger=PropertyChanged, Delay=200}"
                             ToolTip="Search by device name, description or sensor id"
                             Width="320"
                             HorizontalAlignment="Left" />

                    <!-- One quick link per sensor class the device actually
                         reports (issue #9), jumping to that class's
                         aggregate graph - see DeviceDetailViewModel.RebuildSensorGraphLinks. -->
                    <ItemsControl Grid.Column="1"
                                  ItemsSource="{Binding SensorGraphLinks}"
                                  HorizontalAlignment="Right"
                                  VerticalAlignment="Center">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Content="{Binding Label, StringFormat={}{0} graph}"
                                        Command="{Binding Command}"
                                        Style="{StaticResource ChipButtonStyle}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>

                <Grid Grid.Row="1">
                <!-- A card per group rather than a grouped DataGrid: this list
                     needs no sorting or selection, and an ItemsControl lays
                     its rows out at full width without fighting DataGrid's
                     grouping internals. -->
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              Visibility="{Binding HasVisibleSensorGroups, Converter={StaticResource BoolToVisibility}}">
                    <ItemsControl ItemsSource="{Binding SensorGroups}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource SurfaceBrush}"
                                        BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Margin="0,0,0,12">
                                    <StackPanel>

                                        <Border BorderBrush="{StaticResource BorderBrush}"
                                                BorderThickness="0,0,0,1"
                                                Padding="14,10">
                                            <StackPanel Orientation="Horizontal">
                                                <Ellipse Width="9"
                                                         Height="9"
                                                         Margin="0,0,8,0"
                                                         VerticalAlignment="Center"
                                                         Fill="{Binding WorstSeverity, Converter={StaticResource SeverityToBrush}}" />
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding Count, StringFormat=({0})}"
                                                           Style="{StaticResource SubtleTextStyle}"
                                                           Margin="6,0,0,0"
                                                           VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Border>

                                        <ItemsControl ItemsSource="{Binding Sensors}" Margin="0,4,0,6">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="14,6">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="100" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="120" />
                                                            <ColumnDefinition Width="150" />
                                                        </Grid.ColumnDefinitions>

                                                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                            <Ellipse Width="9"
                                                                     Height="9"
                                                                     Margin="0,0,6,0"
                                                                     VerticalAlignment="Center"
                                                                     Fill="{Binding Severity, Converter={StaticResource SeverityToBrush}}" />
                                                            <TextBlock Text="{Binding SeverityText}"
                                                                       Style="{StaticResource SubtleTextStyle}"
                                                                       VerticalAlignment="Center" />
                                                        </StackPanel>

                                                        <TextBlock Grid.Column="1"
                                                                   Text="{Binding RowLabel}"
                                                                   VerticalAlignment="Center"
                                                                   TextTrimming="CharacterEllipsis" />

                                                        <TextBlock Grid.Column="2"
                                                                   Text="{Binding ValueText}"
                                                                   FontWeight="SemiBold"
                                                                   VerticalAlignment="Center" />

                                                        <TextBlock Grid.Column="3"
                                                                   Text="{Binding LastUpdateText}"
                                                                   Style="{StaticResource SubtleTextStyle}"
                                                                   VerticalAlignment="Center" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <TextBlock Text="Loading sensors..."
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           IsHitTestVisible="False"
                           Visibility="{Binding IsLoadingSensors, Converter={StaticResource BoolToVisibility}}"
                           Style="{StaticResource SubtleTextStyle}" />

                <TextBlock Text="No sensors reported for this device."
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           IsHitTestVisible="False"
                           Visibility="{Binding ShowSensorsEmptyMessage, Converter={StaticResource BoolToVisibility}}"
                           Style="{StaticResource SubtleTextStyle}" />

                <TextBlock Text="No sensors match your search."
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           IsHitTestVisible="False"
                           Visibility="{Binding ShowSensorsNoMatchesMessage, Converter={StaticResource BoolToVisibility}}"
                           Style="{StaticResource SubtleTextStyle}" />
                </Grid>
            </Grid>

            <!-- ==================== Ports ==================== -->
            <Grid Margin="24"
                  Visibility="{Binding IsPortsSelected, Converter={StaticResource BoolToVisibility}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBox Grid.Row="0"
                         Style="{StaticResource SearchTextBoxStyle}"
                         Tag="Search ports"
                         Text="{Binding PortSearchText, UpdateSourceTrigger=PropertyChanged, Delay=200}"
                         ToolTip="Search by interface name or description"
                         Width="320"
                         HorizontalAlignment="Left"
                         Margin="0,0,0,10" />

                <Grid Grid.Row="1">
                <DataGrid x:Name="PortsGrid"
                          ItemsSource="{Binding PortsView}"
                          Visibility="{Binding HasVisiblePorts, Converter={StaticResource BoolToVisibility}}"
                          IsReadOnly="True"
                          HeadersVisibility="Column">
                    <DataGrid.Columns>

                        <DataGridTemplateColumn Header="Status" Width="90" SortMemberPath="IsUp">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="8,0">
                                        <Ellipse Width="9"
                                                 Height="9"
                                                 Margin="0,0,6,0"
                                                 VerticalAlignment="Center"
                                                 Fill="{Binding StatusSeverity, Converter={StaticResource SeverityToBrush}}" />
                                        <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="#" Width="36" Binding="{Binding Model.IfIndex}" />

                        <DataGridTemplateColumn Header="Interface" Width="*" MinWidth="140" SortMemberPath="DisplayName">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="8,4" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding SecondaryName}"
                                                   Style="{StaticResource SubtleTextStyle}"
                                                   FontSize="11"
                                                   TextTrimming="CharacterEllipsis"
                                                   Visibility="{Binding HasSecondaryName, Converter={StaticResource BoolToVisibility}}" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="Media" Width="90" Binding="{Binding MediaText}" />

                        <DataGridTemplateColumn Header="Traffic" Width="120" SortMemberPath="InRateText">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="8,4" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#x2190; " Foreground="{StaticResource OkBrush}" FontWeight="Bold" />
                                            <TextBlock Text="{Binding InRateText}" Foreground="{StaticResource OkBrush}" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#x2192; " Foreground="{DynamicResource AccentBrush}" FontWeight="Bold" />
                                            <TextBlock Text="{Binding OutRateText}" Foreground="{DynamicResource AccentBrush}" />
                                        </StackPanel>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="Speed" Width="90" SortMemberPath="SpeedText">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="8,4" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding SpeedText}" />
                                        <TextBlock Text="{Binding DuplexText}"
                                                   Style="{StaticResource SubtleTextStyle}"
                                                   FontSize="11"
                                                   Visibility="{Binding HasDuplex, Converter={StaticResource BoolToVisibility}}" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="Errors" Width="70" SortMemberPath="ErrorCount">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding ErrorCount}"
                                               Margin="8,0"
                                               VerticalAlignment="Center"
                                               Foreground="{StaticResource CriticalBrush}"
                                               Visibility="{Binding HasErrors, Converter={StaticResource BoolToVisibility}}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="MAC Address" Width="140" SortMemberPath="MacAddressText">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="8,4" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding MacAddressText}" />
                                        <TextBlock Style="{StaticResource SubtleTextStyle}" FontSize="11">
                                            <Run Text="MTU " /><Run Text="{Binding MtuText, Mode=OneWay}" />
                                        </TextBlock>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="IP address" Width="160" Binding="{Binding IpAddressesText}">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                    <Setter Property="VerticalAlignment" Value="Center" />
                                    <Setter Property="ToolTip" Value="{Binding IpAddressesText}" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTemplateColumn Header="Neighbour" Width="180" SortMemberPath="NeighborText">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Grid Margin="8,0">
                                        <!-- Clickable: shown only when the neighbour is itself a monitored device. -->
                                        <TextBlock VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"
                                                   Cursor="Hand"
                                                   Visibility="{Binding CanOpenNeighbor, Converter={StaticResource BoolToVisibility}}">
                                            <Hyperlink Command="{Binding OpenNeighborCommand}">
                                                <Run Text="{Binding NeighborText, Mode=OneWay}" />
                                            </Hyperlink>
                                        </TextBlock>
                                        <!-- Plain text: an unmonitored neighbour, or none at all. -->
                                        <TextBlock Text="{Binding NeighborText}"
                                                   Style="{StaticResource SubtleTextStyle}"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"
                                                   Visibility="{Binding CanOpenNeighbor, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}" />
                                    </Grid>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                    </DataGrid.Columns>
                </DataGrid>

                <TextBlock Text="Loading ports..."
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           IsHitTestVisible="False"
                           Visibility="{Binding IsLoadingPorts, Converter={StaticResource BoolToVisibility}}"
                           Style="{StaticResource SubtleTextStyle}" />

                <TextBlock Text="No ports reported for this device."
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           IsHitTestVisible="False"
                           Visibility="{Binding ShowPortsEmptyMessage, Converter={StaticResource BoolToVisibility}}"
                           Style="{StaticResource SubtleTextStyle}" />

                <TextBlock Text="No ports match your search."
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           IsHitTestVisible="False"
                           Visibility="{Binding ShowPortsNoMatchesMessage, Converter={StaticResource BoolToVisibility}}"
                           Style="{StaticResource SubtleTextStyle}" />
                </Grid>
            </Grid>

            <!-- ==================== VLANs ==================== -->
            <Grid Margin="24"
                  Visibility="{Binding IsVlansSelected, Converter={StaticResource BoolToVisibility}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBox Grid.Row="0"
                         Style="{StaticResource SearchTextBoxStyle}"
                         Tag="Search VLANs"
                         Text="{Binding VlanSearchText, UpdateSourceTrigger=PropertyChanged, Delay=200}"
                         ToolTip="Search by VLAN number, name or port"
                         Width="320"
                         HorizontalAlignment="Left"
                         Margin="0,0,0,10" />

                <Grid Grid.Row="1">
                    <DataGrid x:Name="VlansGrid"
                              ItemsSource="{Binding VlansView}"
                              Visibility="{Binding HasVisibleVlans, Converter={StaticResource BoolToVisibility}}"
                              IsReadOnly="True"
                              HeadersVisibility="Column">
                        <DataGrid.Columns>

                            <DataGridTextColumn Header="VLAN" Width="90" Binding="{Binding NumberText}" />
                            <DataGridTextColumn Header="Name" Width="200" Binding="{Binding NameText}" />

                            <!-- Labelled "Access ports", not just "Ports": this only
                                 reflects each port's own untagged/native VLAN
                                 (SNMP dot1qPvid). A trunk port carrying this VLAN
                                 tagged alongside others is not included - LibreNMS's
                                 own per-VLAN trunk-membership endpoint 500s on this
                                 server (see VlanItemViewModel.AccessPorts), so this
                                 is the reliable subset the API actually gives back. -->
                            <DataGridTemplateColumn Width="*" SortMemberPath="AccessPortsSummaryText">
                                <DataGridTemplateColumn.Header>
                                    <TextBlock Text="Access ports"
                                               ToolTip="Ports where this is the untagged/native VLAN. Trunk ports carrying it as a tagged VLAN aren't included - LibreNMS has no working way to report that on this server." />
                                </DataGridTemplateColumn.Header>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding AccessPortsSummaryText}"
                                                   ToolTip="{Binding AccessPortsSummaryText}"
                                                   TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center"
                                                   Margin="8,0" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                        </DataGrid.Columns>
                    </DataGrid>

                    <TextBlock Text="Loading VLANs..."
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               IsHitTestVisible="False"
                               Visibility="{Binding IsLoadingVlans, Converter={StaticResource BoolToVisibility}}"
                               Style="{StaticResource SubtleTextStyle}" />

                    <TextBlock Text="No VLANs reported for this device."
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               IsHitTestVisible="False"
                               Visibility="{Binding ShowVlansEmptyMessage, Converter={StaticResource BoolToVisibility}}"
                               Style="{StaticResource SubtleTextStyle}" />

                    <TextBlock Text="No VLANs match your search."
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               IsHitTestVisible="False"
                               Visibility="{Binding ShowVlansNoMatchesMessage, Converter={StaticResource BoolToVisibility}}"
                               Style="{StaticResource SubtleTextStyle}" />
                </Grid>
            </Grid>

            <!-- ==================== FDB ==================== -->
            <Grid Margin="24"
                  Visibility="{Binding IsFdbSelected, Converter={StaticResource BoolToVisibility}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBox Grid.Row="0"
                         Style="{StaticResource SearchTextBoxStyle}"
                         Tag="Search the FDB"
                         Text="{Binding FdbSearchText, UpdateSourceTrigger=PropertyChanged, Delay=200}"
                         ToolTip="Search by MAC address, port or VLAN"
                         Width="320"
                         HorizontalAlignment="Left"
                         Margin="0,0,0,10" />

                <Grid Grid.Row="1">
                    <DataGrid x:Name="FdbGrid"
                              ItemsSource="{Binding FdbView}"
                              Visibility="{Binding HasVisibleFdbEntries, Converter={StaticResource BoolToVisibility}}"
                              IsReadOnly="True"
                              HeadersVisibility="Column">
                        <DataGrid.Columns>

                            <DataGridTextColumn Header="MAC address" Width="150" Binding="{Binding MacAddressText}" />
                            <DataGridTextColumn Header="Port" Width="140" Binding="{Binding PortText}" />

                            <DataGridTemplateColumn Header="VLAN" Width="150" SortMemberPath="VlanText">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="8,4" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding VlanText}" />
                                            <TextBlock Text="{Binding VlanNameText}"
                                                       Style="{StaticResource SubtleTextStyle}"
                                                       FontSize="11"
                                                       TextTrimming="CharacterEllipsis"
                                                       Visibility="{Binding HasVlanName, Converter={StaticResource BoolToVisibility}}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Header="Last seen" Width="150" Binding="{Binding UpdatedText}" />

                        </DataGrid.Columns>
                    </DataGrid>

                    <TextBlock Text="Loading the FDB..."
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               IsHitTestVisible="False"
                               Visibility="{Binding IsLoadingFdb, Converter={StaticResource BoolToVisibility}}"
                               Style="{StaticResource SubtleTextStyle}" />

                    <TextBlock Text="No FDB entries reported for this device."
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               IsHitTestVisible="False"
                               Visibility="{Binding ShowFdbEmptyMessage, Converter={StaticResource BoolToVisibility}}"
                               Style="{StaticResource SubtleTextStyle}" />

                    <TextBlock Text="No FDB entries match your search."
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               IsHitTestVisible="False"
                               Visibility="{Binding ShowFdbNoMatchesMessage, Converter={StaticResource BoolToVisibility}}"
                               Style="{StaticResource SubtleTextStyle}" />
                </Grid>
            </Grid>

            <!-- ==================== ARP ==================== -->
            <Grid Margin="24"
                  Visibility="{Binding IsArpSelected, Converter={StaticResource BoolToVisibility}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBox Grid.Row="0"
                         Style="{StaticResource SearchTextBoxStyle}"
                         Tag="Search the ARP table"
                         Text="{Binding ArpSearchText, UpdateSourceTrigger=PropertyChanged, Delay=200}"
                         ToolTip="Search by IP address, MAC address or port"
                         Width="320"
                         HorizontalAlignment="Left"
                         Margin="0,0,0,10" />

                <Grid Grid.Row="1">
                    <DataGrid x:Name="ArpGrid"
                              ItemsSource="{Binding ArpView}"
                              Visibility="{Binding HasVisibleArpEntries, Converter={StaticResource BoolToVisibility}}"
                              IsReadOnly="True"
                              HeadersVisibility="Column">
                        <DataGrid.Columns>

                            <DataGridTextColumn Header="IP address" Width="160" Binding="{Binding Ipv4AddressText}" />
                            <DataGridTextColumn Header="MAC address" Width="150" Binding="{Binding MacAddressText}" />
                            <DataGridTextColumn Header="Port" Width="140" Binding="{Binding PortText}" />

                        </DataGrid.Columns>
                    </DataGrid>

                    <TextBlock Text="Loading the ARP table..."
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               IsHitTestVisible="False"
                               Visibility="{Binding IsLoadingArp, Converter={StaticResource BoolToVisibility}}"
                               Style="{StaticResource SubtleTextStyle}" />

                    <TextBlock Text="No ARP entries reported for this device."
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               IsHitTestVisible="False"
                               Visibility="{Binding ShowArpEmptyMessage, Converter={StaticResource BoolToVisibility}}"
                               Style="{StaticResource SubtleTextStyle}" />

                    <TextBlock Text="No ARP entries match your search."
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               IsHitTestVisible="False"
                               Visibility="{Binding ShowArpNoMatchesMessage, Converter={StaticResource BoolToVisibility}}"
                               Style="{StaticResource SubtleTextStyle}" />
                </Grid>
            </Grid>

            <!-- ==================== Graphs ==================== -->
            <!-- Device-wide only (issues #14/#13/#17/#20) - LibreNMS's
                 per-port and per-sensor graph routes 500/404 via the API
                 token this app authenticates with everywhere else
                 (confirmed live), so only the device-wide graphs listed by
                 GET /devices/{id}/graphs are offered here. -->
            <Grid Margin="24"
                  Visibility="{Binding IsGraphsSelected, Converter={StaticResource BoolToVisibility}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <views:GraphTimeRangePicker Grid.Column="0"
                                                 DataContext="{Binding Graphs.TimeRange}"
                                                 VerticalAlignment="Center" />

                    <ComboBox Grid.Column="1"
                              ItemsSource="{Binding Graphs.AvailableGraphs}"
                              SelectedItem="{Binding Graphs.SelectedGraph}"
                              DisplayMemberPath="Description"
                              Width="280"
                              Margin="14,0,0,0" />
                </Grid>

                <Grid Grid.Row="1">
                    <svgc:SvgViewbox SvgSource="{Binding Graphs.CurrentSvg}"
                                     Stretch="Uniform"
                                     HorizontalAlignment="Left"
                                     VerticalAlignment="Top"
                                     Visibility="{Binding Graphs.CurrentSvg, Converter={StaticResource NullToVisibility}}" />

                    <TextBlock Text="Loading graph..."
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               IsHitTestVisible="False"
                               Visibility="{Binding Graphs.IsLoading, Converter={StaticResource BoolToVisibility}}"
                               Style="{StaticResource SubtleTextStyle}" />

                    <TextBlock Text="{Binding Graphs.ErrorMessage}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               TextWrapping="Wrap"
                               MaxWidth="480"
                               IsHitTestVisible="False"
                               Visibility="{Binding Graphs.HasError, Converter={StaticResource BoolToVisibility}}"
                               Style="{StaticResource SubtleTextStyle}" />
                </Grid>
            </Grid>

            <!-- ==================== Resources ==================== -->
            <!-- CPU/memory/disk each get their own card rather than one grid:
                 the row shape differs (a disk/pool shows a used/total byte
                 figure a CPU has no equivalent for), and a device may report
                 any mix of the three. -->
            <Grid Margin="24"
                  Visibility="{Binding IsResourcesSelected, Converter={StaticResource BoolToVisibility}}">
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          Visibility="{Binding HasResources, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>

                    <!-- Processors -->
                    <Border Background="{StaticResource SurfaceBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="16"
                            Margin="0,0,0,12"
                            Visibility="{Binding HasProcessors, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding Processors.Count, StringFormat=Processors ({0})}" Style="{StaticResource SectionHeaderStyle}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Cursor="Hand">
                                    <Hyperlink Command="{Binding ShowProcessorGraphCommand}" ToolTip="View the processor graph">View graph</Hyperlink>
                                </TextBlock>
                            </Grid>
                            <ItemsControl ItemsSource="{Binding Processors}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="200" />
                                                <ColumnDefinition Width="55" />
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0" Text="{Binding Description}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,10,0" />

                                            <Grid Grid.Column="1" Height="8" VerticalAlignment="Center">
                                                <Border Background="{StaticResource SurfaceAltBrush}" CornerRadius="4" />
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="{Binding UsagePercent, Converter={StaticResource PercentToStarWidth}}" />
                                                        <ColumnDefinition Width="{Binding UsagePercent, Converter={StaticResource PercentToStarWidth}, ConverterParameter=invert}" />
                                                    </Grid.ColumnDefinitions>
                                                    <Border Grid.Column="0" CornerRadius="4" Background="{Binding Severity, Converter={StaticResource SeverityToBrush}}" />
                                                </Grid>
                                            </Grid>

                                            <TextBlock Grid.Column="2" Text="{Binding UsageText}" VerticalAlignment="Center" TextAlignment="Right" Margin="10,0,0,0" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- Memory pools -->
                    <Border Background="{StaticResource SurfaceBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="16"
                            Margin="0,0,0,12"
                            Visibility="{Binding HasMempools, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding Mempools.Count, StringFormat=Memory ({0})}" Style="{StaticResource SectionHeaderStyle}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Cursor="Hand">
                                    <Hyperlink Command="{Binding ShowMempoolGraphCommand}" ToolTip="View the memory pool graph">View graph</Hyperlink>
                                </TextBlock>
                            </Grid>
                            <ItemsControl ItemsSource="{Binding Mempools}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="200" />
                                                <ColumnDefinition Width="55" />
                                                <ColumnDefinition Width="150" />
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0" Text="{Binding Description}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,10,0" />

                                            <Grid Grid.Column="1" Height="8" VerticalAlignment="Center">
                                                <Border Background="{StaticResource SurfaceAltBrush}" CornerRadius="4" />
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="{Binding UsagePercent, Converter={StaticResource PercentToStarWidth}}" />
                                                        <ColumnDefinition Width="{Binding UsagePercent, Converter={StaticResource PercentToStarWidth}, ConverterParameter=invert}" />
                                                    </Grid.ColumnDefinitions>
                                                    <Border Grid.Column="0" CornerRadius="4" Background="{Binding Severity, Converter={StaticResource SeverityToBrush}}" />
                                                </Grid>
                                            </Grid>

                                            <TextBlock Grid.Column="2" Text="{Binding UsageText}" VerticalAlignment="Center" TextAlignment="Right" Margin="10,0,0,0" />
                                            <TextBlock Grid.Column="3" Text="{Binding DetailText}" Style="{StaticResource SubtleTextStyle}" VerticalAlignment="Center" TextAlignment="Right" Margin="10,0,0,0" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- Storage -->
                    <Border Background="{StaticResource SurfaceBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="16"
                            Visibility="{Binding HasStorage, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding Storage.Count, StringFormat=Storage ({0})}" Style="{StaticResource SectionHeaderStyle}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Cursor="Hand">
                                    <Hyperlink Command="{Binding ShowStorageGraphCommand}" ToolTip="View the storage graph">View graph</Hyperlink>
                                </TextBlock>
                            </Grid>
                            <ItemsControl ItemsSource="{Binding Storage}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="200" />
                                                <ColumnDefinition Width="55" />
                                                <ColumnDefinition Width="150" />
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0" Text="{Binding Description}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,10,0" />

                                            <Grid Grid.Column="1" Height="8" VerticalAlignment="Center">
                                                <Border Background="{StaticResource SurfaceAltBrush}" CornerRadius="4" />
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="{Binding UsagePercent, Converter={StaticResource PercentToStarWidth}}" />
                                                        <ColumnDefinition Width="{Binding UsagePercent, Converter={StaticResource PercentToStarWidth}, ConverterParameter=invert}" />
                                                    </Grid.ColumnDefinitions>
                                                    <Border Grid.Column="0" CornerRadius="4" Background="{Binding Severity, Converter={StaticResource SeverityToBrush}}" />
                                                </Grid>
                                            </Grid>

                                            <TextBlock Grid.Column="2" Text="{Binding UsageText}" VerticalAlignment="Center" TextAlignment="Right" Margin="10,0,0,0" />
                                            <TextBlock Grid.Column="3" Text="{Binding DetailText}" Style="{StaticResource SubtleTextStyle}" VerticalAlignment="Center" TextAlignment="Right" Margin="10,0,0,0" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>

                <TextBlock Text="Loading resources..."
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           IsHitTestVisible="False"
                           Visibility="{Binding IsLoadingResources, Converter={StaticResource BoolToVisibility}}"
                           Style="{StaticResource SubtleTextStyle}" />

                <TextBlock Text="No CPU, memory or disk data reported for this device."
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           IsHitTestVisible="False"
                           Visibility="{Binding ShowResourcesEmptyMessage, Converter={StaticResource BoolToVisibility}}"
                           Style="{StaticResource SubtleTextStyle}" />
            </Grid>

            <!-- ==================== Alerts ==================== -->
            <!-- Active and historical together: what is on fire right now,
                 and everything that has ever fired, in one place - rather
                 than needing the Overview tab for one and this tab for the
                 other. -->
            <Grid Margin="24"
                  Visibility="{Binding IsAlertsSelected, Converter={StaticResource BoolToVisibility}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Active -->
                <Border Grid.Row="0"
                        Background="{StaticResource SurfaceBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="20"
                        Margin="0,0,0,16">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" FontWeight="SemiBold" VerticalAlignment="Center">
                                <Run Text="Active" />
                                <Run Text="{Binding ActiveAlerts.Count, Mode=OneWay, StringFormat=({0})}" />
                            </TextBlock>

                            <Button Grid.Column="1"
                                    Content="Show alerts for this device"
                                    Command="{Binding ShowAlertsCommand}"
                                    Padding="10,5"
                                    Visibility="{Binding HasActiveAlerts, Converter={StaticResource BoolToVisibility}}" />
                        </Grid>

                        <ItemsControl ItemsSource="{Binding ActiveAlerts}"
                                      Margin="0,12,0,0"
                                      Visibility="{Binding HasActiveAlerts, Converter={StaticResource BoolToVisibility}}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <Ellipse Grid.Column="0"
                                                     Width="9"
                                                     Height="9"
                                                     Margin="0,0,10,0"
                                                     VerticalAlignment="Center"
                                                     Fill="{Binding Severity, Converter={StaticResource SeverityToBrush}}" />
                                            <TextBlock Grid.Column="1" Text="{Binding RuleName}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="2"
                                                       Text="{Binding AgeText}"
                                                       Style="{StaticResource SubtleTextStyle}"
                                                       VerticalAlignment="Center"
                                                       Margin="12,0,0,0" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="Loading active alerts..."
                                   Style="{StaticResource SubtleTextStyle}"
                                   Margin="0,12,0,0"
                                   Visibility="{Binding IsLoadingActiveAlerts, Converter={StaticResource BoolToVisibility}}" />

                        <TextBlock Text="No active alerts."
                                   Style="{StaticResource SubtleTextStyle}"
                                   Margin="0,12,0,0"
                                   Visibility="{Binding ShowNoActiveAlertsMessage, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                </Border>

                <!-- History -->
                <TextBlock Grid.Row="1" Text="{Binding AlertHistory.Count, StringFormat=History ({0})}" Style="{StaticResource SectionHeaderStyle}" Margin="0,0,0,6" />

                <Grid Grid.Row="2">
                    <DataGrid x:Name="AlertHistoryGrid"
                              ItemsSource="{Binding AlertHistory}"
                              Visibility="{Binding HasAlertHistory, Converter={StaticResource BoolToVisibility}}"
                              IsReadOnly="True"
                              HeadersVisibility="Column">
                        <DataGrid.Columns>

                            <DataGridTemplateColumn Header="Severity" Width="90" SortMemberPath="Severity">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Margin="8,0">
                                            <Ellipse Width="9"
                                                     Height="9"
                                                     Margin="0,0,6,0"
                                                     VerticalAlignment="Center"
                                                     Fill="{Binding Severity, Converter={StaticResource SeverityToBrush}}" />
                                            <TextBlock Text="{Binding SeverityText}" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="Rule" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="8,4" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding RuleName}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding DetailText}"
                                                       Style="{StaticResource SubtleTextStyle}"
                                                       FontSize="11"
                                                       TextTrimming="CharacterEllipsis"
                                                       Visibility="{Binding HasDetail, Converter={StaticResource BoolToVisibility}}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="State" Width="110" Binding="{Binding StateText}" />
                            <DataGridTextColumn Header="Time" Width="150" Binding="{Binding TimeText}" />

                        </DataGrid.Columns>
                    </DataGrid>

                    <TextBlock Text="Loading alert history..."
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               IsHitTestVisible="False"
                               Visibility="{Binding IsLoadingAlertHistory, Converter={StaticResource BoolToVisibility}}"
                               Style="{StaticResource SubtleTextStyle}" />

                    <TextBlock Text="No alert history for this device."
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               IsHitTestVisible="False"
                               Visibility="{Binding ShowNoAlertHistoryMessage, Converter={StaticResource BoolToVisibility}}"
                               Style="{StaticResource SubtleTextStyle}" />
                </Grid>
            </Grid>

            <!-- ==================== Event log ==================== -->
            <Grid Margin="24"
                  Visibility="{Binding IsEventLogSelected, Converter={StaticResource BoolToVisibility}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBox Grid.Row="0"
                         Style="{StaticResource SearchTextBoxStyle}"
                         Tag="Search the event log"
                         Text="{Binding EventLogSearchText, UpdateSourceTrigger=PropertyChanged, Delay=200}"
                         ToolTip="Search by message, type or user"
                         Width="320"
                         HorizontalAlignment="Left"
                         Margin="0,0,0,10" />

                <Grid Grid.Row="1">
                    <!-- Loading more appends past the bottom rather than
                         replacing the grid, so ScrollChanged is watched on
                         this DataGrid itself (see DeviceView.xaml.cs) to fetch
                         the next page automatically as it is scrolled into
                         view - "Load more" below is the fallback for anyone
                         who never scrolls that far. -->
                    <DataGrid x:Name="EventLogGrid"
                              ItemsSource="{Binding EventLogView}"
                              Visibility="{Binding HasVisibleEventLog, Converter={StaticResource BoolToVisibility}}"
                              IsReadOnly="True"
                              HeadersVisibility="Column">
                        <DataGrid.Columns>

                            <DataGridTextColumn Header="Type" Width="110" Binding="{Binding TypeText}" />
                            <DataGridTextColumn Header="Message" Width="*" Binding="{Binding Message}" />
                            <DataGridTextColumn Header="User" Width="110" Binding="{Binding Username}" />
                            <DataGridTextColumn Header="Time" Width="150" Binding="{Binding TimeText}" />

                        </DataGrid.Columns>
                    </DataGrid>

                    <TextBlock Text="Loading the event log..."
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               IsHitTestVisible="False"
                               Visibility="{Binding IsLoadingEventLog, Converter={StaticResource BoolToVisibility}}"
                               Style="{StaticResource SubtleTextStyle}" />

                    <TextBlock Text="No event log entries for this device."
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               IsHitTestVisible="False"
                               Visibility="{Binding ShowEventLogEmptyMessage, Converter={StaticResource BoolToVisibility}}"
                               Style="{StaticResource SubtleTextStyle}" />

                    <TextBlock Text="No event log entries match your search."
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               IsHitTestVisible="False"
                               Visibility="{Binding ShowEventLogNoMatchesMessage, Converter={StaticResource BoolToVisibility}}"
                               Style="{StaticResource SubtleTextStyle}" />
                </Grid>

                <StackPanel Grid.Row="2"
                            Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            Margin="0,10,0,0">
                    <TextBlock Text="Loading more..."
                               Style="{StaticResource SubtleTextStyle}"
                               Visibility="{Binding IsLoadingMoreEventLog, Converter={StaticResource BoolToVisibility}}" />
                    <Button Content="Load more"
                            Command="{Binding LoadMoreEventLogCommand}"
                            Padding="12,6">
                        <Button.Style>
                            <!-- BasedOn the app's own default: an override
                                 with no BasedOn replaces the themed look
                                 entirely, leaving bare OS button chrome. -->
                            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding HasMoreEventLog}" Value="True" />
                                            <Condition Binding="{Binding IsLoadingMoreEventLog}" Value="False" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible" />
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- ==================== Edit ==================== -->
            <!-- Full-width rather than pinned to a narrow left-aligned
                 column - a card with three or four short fields looked lost
                 in a sea of empty space on anything wider than a laptop
                 screen. Each card still caps its own internal field rows via
                 2-3 star-width columns so a very wide window doesn't stretch
                 a single TextBox absurdly, but the cards themselves now use
                 the space the window actually offers. -->
            <ScrollViewer Visibility="{Binding IsEditSelected, Converter={StaticResource BoolToVisibility}}"
                          VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24">
                <TextBlock Text="Edit device" Style="{StaticResource HeadingTextStyle}" Margin="0,0,0,14" />

                <!-- Device-management actions come first - a single home for
                     "change this device" (Rediscover, Delete) that's the
                     first thing you see, rather than scattering them across
                     the header or burying them under every field card below. -->
                <Border Background="{StaticResource SurfaceAltBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="14,12"
                        Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="Device management" Style="{StaticResource SectionHeaderStyle}" Margin="0,0,0,10" />
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Rediscover"
                                    Command="{Binding RediscoverCommand}"
                                    ToolTip="Ask LibreNMS to rediscover this device now"
                                    HorizontalAlignment="Left"
                                    Padding="12,7" />
                            <Button Content="Delete device"
                                    Command="{Binding DeleteCommand}"
                                    ToolTip="Permanently remove this device from LibreNMS"
                                    Foreground="{StaticResource CriticalBrush}"
                                    BorderBrush="{StaticResource CriticalBrush}"
                                    HorizontalAlignment="Left"
                                    Padding="12,7"
                                    Margin="10,0,0,0" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Background="{StaticResource SurfaceAltBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="14,12"
                        Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="General" Style="{StaticResource SectionHeaderStyle}" Margin="0,0,0,10" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Hostname / IP" Style="{StaticResource SectionHeaderStyle}" />
                                <TextBox Text="{Binding EditHostname, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="The address LibreNMS actually polls - changing this renames the device rather than just relabelling it." />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Display name" Style="{StaticResource SectionHeaderStyle}" />
                                <TextBox Text="{Binding EditDisplayName, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="A literal name, or a LibreNMS {{ $hostname }}-style template - blank uses LibreNMS's own default naming" />
                            </StackPanel>
                            <StackPanel Grid.Column="4">
                                <TextBlock Text="Type" Style="{StaticResource SectionHeaderStyle}" />
                                <TextBox Text="{Binding EditType, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="Description" Style="{StaticResource SectionHeaderStyle}" Margin="0,14,0,0" />
                        <TextBox Text="{Binding EditPurpose, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                </Border>

                <Border Background="{StaticResource SurfaceAltBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="14,12"
                        Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="Location &amp; contact" Style="{StaticResource SectionHeaderStyle}" Margin="0,0,0,10" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="24" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Location" Style="{StaticResource SectionHeaderStyle}" />
                                <TextBox Text="{Binding EditLocation, UpdateSourceTrigger=PropertyChanged}" />
                                <CheckBox Content="Override sysLocation"
                                          IsChecked="{Binding EditOverrideSysLocation}"
                                          Margin="0,8,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Contact" Style="{StaticResource SectionHeaderStyle}" />
                                <TextBox Text="{Binding EditContact, UpdateSourceTrigger=PropertyChanged}" />
                                <CheckBox Content="Override sysContact"
                                          IsChecked="{Binding EditOverrideSysContact}"
                                          Margin="0,8,0,0" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Background="{StaticResource SurfaceAltBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="14,12"
                        Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="Poller &amp; status" Style="{StaticResource SectionHeaderStyle}" Margin="0,0,0,10" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="24" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Poller group" Style="{StaticResource SectionHeaderStyle}" />
                                <ComboBox ItemsSource="{Binding PollerGroups}"
                                          SelectedItem="{Binding SelectedPollerGroup}"
                                          DisplayMemberPath="GroupName" />
                                <TextBlock Style="{StaticResource SubtleTextStyle}"
                                           TextWrapping="Wrap"
                                           Margin="0,6,0,0"
                                           Text="For a distributed-poller setup." />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Status" Style="{StaticResource SectionHeaderStyle}" />
                                <CheckBox Content="Disabled (stops polling and alerting)" IsChecked="{Binding EditDisabled}" Margin="0,4,0,0" />
                                <CheckBox Content="Ignore (keeps polling, suppresses alerts)" IsChecked="{Binding EditIgnore}" Margin="0,8,0,0" />
                                <CheckBox Content="Ignore status (excludes from availability figures)" IsChecked="{Binding EditIgnoreStatus}" Margin="0,8,0,0" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Background="{StaticResource SurfaceAltBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="14,12"
                        Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="Notes" Style="{StaticResource SectionHeaderStyle}" Margin="0,0,0,10" />
                        <TextBox Text="{Binding EditNotes, UpdateSourceTrigger=PropertyChanged}"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 Height="90"
                                 VerticalContentAlignment="Top"
                                 VerticalScrollBarVisibility="Auto" />
                    </StackPanel>
                </Border>

                <!-- ==================== SNMP ==================== -->
                <Border Background="{StaticResource SurfaceAltBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="14,12"
                        Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="SNMP" Style="{StaticResource SectionHeaderStyle}" Margin="0,0,0,10" />

                        <!-- LibreNMS's read API never returns stored SNMP
                             credentials, so this can only set new ones, not
                             show current ones - unchecked by default every
                             time Edit opens, so saving the rest of this form
                             can never accidentally touch SNMP at all. -->
                        <CheckBox Content="Change SNMP settings" IsChecked="{Binding EditChangeSnmp}" />
                        <TextBlock Style="{StaticResource SubtleTextStyle}"
                                   TextWrapping="Wrap"
                                   Margin="0,6,0,0"
                                   Text="LibreNMS does not return stored credentials, so this only sets new ones - leave unchecked to leave SNMP untouched."
                                   Visibility="{Binding ShowSnmpEditFields, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}" />

                        <StackPanel Visibility="{Binding ShowSnmpEditFields, Converter={StaticResource BoolToVisibility}}" Margin="0,14,0,0">
                            <Border Style="{StaticResource NavTabTrackStyle}" HorizontalAlignment="Left">
                                <StackPanel Orientation="Horizontal">
                                    <ToggleButton Content="Yes" Style="{StaticResource NavTabButtonStyle}" IsChecked="{Binding EditIsSnmpEnabled}" />
                                    <ToggleButton Content="No (ping only)" Style="{StaticResource NavTabButtonStyle}" IsChecked="{Binding EditIsPingOnly}" />
                                </StackPanel>
                            </Border>

                            <!-- ==================== SNMP enabled ==================== -->
                            <StackPanel Visibility="{Binding ShowEditSnmpFields, Converter={StaticResource BoolToVisibility}}">
                                <Border Style="{StaticResource NavTabTrackStyle}" HorizontalAlignment="Left" Margin="0,14,0,0">
                                    <StackPanel Orientation="Horizontal">
                                        <ToggleButton Content="v2c" Style="{StaticResource NavTabButtonStyle}" IsChecked="{Binding EditIsSnmpV2c}" />
                                        <ToggleButton Content="v1" Style="{StaticResource NavTabButtonStyle}" IsChecked="{Binding EditIsSnmpV1}" />
                                        <ToggleButton Content="v3" Style="{StaticResource NavTabButtonStyle}" IsChecked="{Binding EditIsSnmpV3}" />
                                    </StackPanel>
                                </Border>

                                <StackPanel Visibility="{Binding ShowEditCommunity, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Text="Community" Style="{StaticResource SectionHeaderStyle}" Margin="0,14,0,6" />
                                    <TextBox Text="{Binding EditCommunity, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>

                                <StackPanel Visibility="{Binding ShowEditV3Fields, Converter={StaticResource BoolToVisibility}}">
                                    <Grid Margin="0,14,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="16" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Auth level" Style="{StaticResource SectionHeaderStyle}" />
                                            <ComboBox SelectedValuePath="Content" SelectedValue="{Binding EditAuthLevel}">
                                                <ComboBoxItem Content="noAuthNoPriv" />
                                                <ComboBoxItem Content="authNoPriv" />
                                                <ComboBoxItem Content="authPriv" />
                                            </ComboBox>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Auth algorithm" Style="{StaticResource SectionHeaderStyle}" />
                                            <ComboBox SelectedValuePath="Content" SelectedValue="{Binding EditAuthAlgo}">
                                                <ComboBoxItem Content="MD5" />
                                                <ComboBoxItem Content="SHA" />
                                            </ComboBox>
                                        </StackPanel>
                                    </Grid>

                                    <TextBlock Text="Auth username" Style="{StaticResource SectionHeaderStyle}" Margin="0,10,0,6" />
                                    <TextBox Text="{Binding EditAuthName, UpdateSourceTrigger=PropertyChanged}" />

                                    <TextBlock Text="Auth password" Style="{StaticResource SectionHeaderStyle}" Margin="0,10,0,6" />
                                    <PasswordBox x:Name="EditAuthPassBox" PasswordChanged="OnEditAuthPassChanged" />

                                    <Grid Margin="0,10,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="16" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Privacy algorithm" Style="{StaticResource SectionHeaderStyle}" />
                                            <ComboBox SelectedValuePath="Content" SelectedValue="{Binding EditCryptoAlgo}">
                                                <ComboBoxItem Content="AES" />
                                                <ComboBoxItem Content="DES" />
                                            </ComboBox>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Privacy password" Style="{StaticResource SectionHeaderStyle}" />
                                            <PasswordBox x:Name="EditCryptoPassBox" PasswordChanged="OnEditCryptoPassChanged" />
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>

                                <Grid Margin="0,14,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="16" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Port (optional)" Style="{StaticResource SectionHeaderStyle}" />
                                        <TextBox Text="{Binding EditPort, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Transport (optional)" Style="{StaticResource SectionHeaderStyle}" />
                                        <ComboBox SelectedValuePath="Content" SelectedValue="{Binding EditTransport}">
                                            <ComboBoxItem Content="" />
                                            <ComboBoxItem Content="udp" />
                                            <ComboBoxItem Content="tcp" />
                                            <ComboBoxItem Content="udp6" />
                                            <ComboBoxItem Content="tcp6" />
                                        </ComboBox>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>

                            <!-- ==================== Ping only ==================== -->
                            <StackPanel Visibility="{Binding ShowEditPingOnlyFields, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="sysName" Style="{StaticResource SectionHeaderStyle}" Margin="0,14,0,6" />
                                <TextBox Text="{Binding EditSysNameOverride, UpdateSourceTrigger=PropertyChanged}" />

                                <TextBlock Text="Hardware" Style="{StaticResource SectionHeaderStyle}" Margin="0,10,0,6" />
                                <TextBox Text="{Binding EditHardwareOverride, UpdateSourceTrigger=PropertyChanged}" />

                                <TextBlock Text="OS" Style="{StaticResource SectionHeaderStyle}" Margin="0,10,0,6" />
                                <ComboBox IsEditable="True"
                                          Text="{Binding EditSnmpOs, UpdateSourceTrigger=PropertyChanged}"
                                          ItemsSource="{Binding KnownOperatingSystems}" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Background="#33DA3633"
                        BorderBrush="{StaticResource CriticalBrush}"
                        BorderThickness="1"
                        CornerRadius="5"
                        Padding="12,10"
                        Margin="0,0,0,14"
                        Visibility="{Binding HasEditError, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="{Binding EditErrorMessage}" TextWrapping="Wrap" />
                </Border>

                <Border Background="#332EA043"
                        BorderBrush="{StaticResource OkBrush}"
                        BorderThickness="1"
                        CornerRadius="5"
                        Padding="12,10"
                        Margin="0,0,0,14"
                        Visibility="{Binding HasEditSuccess, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="{Binding EditSuccessMessage}" TextWrapping="Wrap" />
                </Border>

                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Saving..."
                               Style="{StaticResource SubtleTextStyle}"
                               VerticalAlignment="Center"
                               Margin="0,0,12,0"
                               Visibility="{Binding IsSavingEdit, Converter={StaticResource BoolToVisibility}}" />
                    <Button Content="Save"
                            Command="{Binding SaveEditCommand}"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Padding="16,7" />
                </StackPanel>
            </StackPanel>
            </ScrollViewer>
            </Grid>
        </Grid>

        <!-- ======================== Status bar ======================== -->
        <Border Grid.Row="3"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="18,8">
            <TextBlock Text="Refreshing..."
                       Style="{StaticResource SubtleTextStyle}"
                       Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
        </Border>
    </Grid>
</Window>
