<Window x:Class="DesktopNMS.Views.LicencesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:DesktopNMS.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:LicencesViewModel}"
        Title="Open-source licences"
        Width="680"
        Height="640"
        MinWidth="480"
        MinHeight="400"
        ShowInTaskbar="False"
        Icon="pack://application:,,,/Assets/app.ico"
        Background="{StaticResource BackgroundBrush}"
        WindowStartupLocation="CenterOwner">

    <!-- Settings › About › Open-source licences (#266): what DashyNMS ships
         that others made, each with its copyright and licence; the full text
         opens under it. The trademark line at the foot. -->
    <DockPanel Margin="24">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,14">
            <TextBlock Text="Open-source licences" Style="{StaticResource HeadingTextStyle}" />
            <TextBlock Text="DashyNMS is built with these, and thanks the people who make them."
                       Style="{StaticResource SubtleTextStyle}"
                       TextWrapping="Wrap"
                       Margin="0,4,0,0" />
        </StackPanel>

        <DockPanel DockPanel.Dock="Bottom" Margin="0,14,0,0" LastChildFill="False">
            <Button DockPanel.Dock="Right" Content="Close" IsCancel="True" IsDefault="True" Padding="14,6" />
            <TextBlock Text="{Binding Trademarks}"
                       Style="{StaticResource SubtleTextStyle}"
                       TextWrapping="Wrap"
                       MaxWidth="460"
                       VerticalAlignment="Center" />
        </DockPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Items}" Focusable="False">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{StaticResource SurfaceBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="14,12"
                                Margin="0,0,0,8">
                            <StackPanel>
                                <DockPanel>
                                    <Button DockPanel.Dock="Right"
                                            Content="{Binding ToggleText}"
                                            Command="{Binding ToggleCommand}"
                                            Padding="10,4"
                                            VerticalAlignment="Top"
                                            Visibility="{Binding HasLicenceText, Converter={StaticResource BoolToVisibility}}" />
                                    <StackPanel Margin="0,0,12,0">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Use}" Style="{StaticResource SubtleTextStyle}" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding Copyright}" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0" />
                                        <TextBlock FontSize="12" Margin="0,2,0,0">
                                            <Hyperlink Command="{Binding OpenCommand}">
                                                <Run Text="{Binding LicenceLine, Mode=OneWay}" />
                                            </Hyperlink>
                                        </TextBlock>
                                    </StackPanel>
                                </DockPanel>
                                <TextBox Text="{Binding LicenceText, Mode=OneWay}"
                                         IsReadOnly="True"
                                         TextWrapping="Wrap"
                                         FontFamily="{StaticResource MonoFont}"
                                         FontSize="11.5"
                                         MaxHeight="280"
                                         VerticalScrollBarVisibility="Auto"
                                         Margin="0,10,0,0"
                                         Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVisibility}}" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</Window>
