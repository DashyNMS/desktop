<Window x:Class="DesktopNMS.Views.AlertTemplateEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:DesktopNMS.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:AlertTemplateEditorViewModel}"
        Title="{Binding Title}"
        Width="600"
        Height="700"
        MinWidth="480"
        MinHeight="480"
        ShowInTaskbar="False"
        Icon="pack://application:,,,/Assets/app.ico"
        Background="{StaticResource BackgroundBrush}"
        WindowStartupLocation="CenterOwner">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{Binding Title}" Style="{StaticResource HeadingTextStyle}" Margin="0,0,0,14" />

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,10,0">
                <TextBlock Text="Name" Style="{StaticResource SectionHeaderStyle}" />
                <TextBox x:Name="NameBox" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,14" />

                <TextBlock Text="Title (optional)" Style="{StaticResource SectionHeaderStyle}" />
                <TextBox Text="{Binding TemplateTitle, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,14" />

                <TextBlock Text="Recovery title (optional)" Style="{StaticResource SectionHeaderStyle}" />
                <TextBox Text="{Binding TitleRec, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,14" />

                <TextBlock Text="Template" Style="{StaticResource SectionHeaderStyle}" />
                <TextBox Text="{Binding Template, UpdateSourceTrigger=PropertyChanged}"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         FontFamily="Consolas"
                         FontSize="12"
                         Height="220"
                         Margin="0,0,0,14" />

                <TextBlock Text="Attached rules" Style="{StaticResource SectionHeaderStyle}" Margin="0,0,0,6" />
                <TextBox Style="{StaticResource SearchTextBoxStyle}"
                         Tag="Search rules"
                         Text="{Binding RulesPicker.SearchText, UpdateSourceTrigger=PropertyChanged, Delay=200}"
                         Margin="0,0,0,6" />
                <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="5" Padding="10,4" MaxHeight="160">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding RulesPicker.View}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox Content="{Binding Name}" IsChecked="{Binding IsChecked}" Margin="0,5" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2">
            <Border Background="#33DA3633"
                    BorderBrush="{StaticResource CriticalBrush}"
                    BorderThickness="1"
                    CornerRadius="5"
                    Padding="12,10"
                    Margin="0,14,0,0"
                    Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" />
            </Border>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <TextBlock Text="Saving..."
                           Style="{StaticResource SubtleTextStyle}"
                           VerticalAlignment="Center"
                           Margin="0,0,12,0"
                           Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
                <Button Content="Cancel" IsCancel="True" Margin="0,0,8,0" />
                <Button Content="Save"
                        Command="{Binding SaveCommand}"
                        Style="{StaticResource PrimaryButtonStyle}"
                        IsDefault="True" />
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
