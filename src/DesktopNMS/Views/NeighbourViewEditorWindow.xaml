<Window x:Class="DesktopNMS.Views.NeighbourViewEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:DesktopNMS.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:NeighbourViewEditorViewModel}"
        Title="{Binding Title}"
        Width="720"
        SizeToContent="Height"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Icon="pack://application:,,,/Assets/app.ico"
        Background="{StaticResource BackgroundBrush}"
        WindowStartupLocation="CenterOwner">

    <!-- See NeighbourViewEditorViewModel. -->
    <StackPanel Margin="24">

        <TextBlock Text="{Binding Title}" Style="{StaticResource HeadingTextStyle}" />
        <TextBlock Style="{StaticResource SubtleTextStyle}"
                   TextWrapping="Wrap"
                   Margin="0,4,0,0"
                   Text="Lists what your switches see over LLDP/CDP that matches the rules below - e.g. system description contains &quot;Riedel Bolero DECT Antenna&quot;." />

        <TextBlock Text="Name" Style="{StaticResource SectionHeaderStyle}" Margin="0,16,0,6" />
        <TextBox x:Name="NameBox" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />

        <Grid Margin="0,16,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Rules" Style="{StaticResource SectionHeaderStyle}" VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                <RadioButton Content="Match all rules" IsChecked="{Binding MatchAll}" GroupName="MatchMode" Margin="0,0,16,0" />
                <RadioButton Content="Match any rule" IsChecked="{Binding MatchAny}" GroupName="MatchMode" />
            </StackPanel>
        </Grid>

        <ItemsControl ItemsSource="{Binding Rules}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="0,0,0,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="190" />
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ComboBox Grid.Column="0"
                                      ItemsSource="{x:Static vm:NeighbourViewEditorViewModel.FieldChoices}"
                                      SelectedItem="{Binding Field}"
                                      Margin="0,0,8,0" />
                            <ComboBox Grid.Column="1"
                                      ItemsSource="{x:Static vm:NeighbourViewEditorViewModel.OperatorChoices}"
                                      SelectedItem="{Binding Operator}"
                                      Margin="0,0,8,0" />
                            <TextBox Grid.Column="2" Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" />
                            <Button Grid.Column="3"
                                    Command="{Binding RemoveCommand}"
                                    Style="{StaticResource IconButtonStyle}"
                                    Width="30"
                                    Height="30"
                                    Margin="6,0,0,0"
                                    ToolTip="Remove this rule">
                                <TextBlock Text="&#xE711;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12" />
                            </Button>
                        </Grid>
                        <TextBlock Text="{Binding RegexProblem}"
                                   Foreground="{StaticResource CriticalBrush}"
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   Margin="348,3,0,0"
                                   Visibility="{Binding HasRegexProblem, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <TextBlock Cursor="Hand" Margin="0,2,0,0">
            <Hyperlink Command="{Binding AddRuleCommand}">Add rule</Hyperlink>
        </TextBlock>

        <Border Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="5"
                Padding="12,10"
                Margin="0,14,0,0">
            <TextBlock Text="{Binding PreviewText}" TextWrapping="Wrap" />
        </Border>

        <CheckBox Content="Show on the network map"
                  IsChecked="{Binding ShowOnMap}"
                  ToolTip="Draw this view's neighbours on the network map, joined to their switches - those LibreNMS doesn't already monitor as devices"
                  Margin="0,14,0,0" />

        <Border Background="#33DA3633"
                BorderBrush="{StaticResource CriticalBrush}"
                BorderThickness="1"
                CornerRadius="5"
                Padding="12,10"
                Margin="0,14,0,0"
                Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" />
        </Border>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Cancel" IsCancel="True" Margin="0,0,8,0" />
            <Button Content="Save"
                    Command="{Binding SaveCommand}"
                    Style="{StaticResource PrimaryButtonStyle}"
                    IsDefault="True" />
        </StackPanel>
    </StackPanel>
</Window>
