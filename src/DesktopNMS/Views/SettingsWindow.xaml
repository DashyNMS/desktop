<Window x:Class="DesktopNMS.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:DesktopNMS.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:SettingsViewModel}"
        Title="DashyNMS settings"
        Width="760"
        Height="640"
        MinWidth="640"
        MinHeight="440"
        Icon="pack://application:,,,/Assets/app.ico"
        Background="{StaticResource BackgroundBrush}"
        WindowStartupLocation="CenterOwner">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="190" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ======================== Sidebar ======================== -->
            <!-- Grouped under headers rather than one flat list of eight -
                 the same pattern DeviceView's sidebar already uses (see its
                 HEALTH/NETWORK/ALERTS & LOGS headers) for the same reason:
                 it scales by adding to a cluster or adding a new cluster,
                 rather than by growing one undifferentiated column that gets
                 harder to scan every time a section is added. Wrapped in a
                 ScrollViewer for the same future-proofing reason, even
                 though eight items still fit without scrolling today. -->
            <Border Grid.Column="0"
                    Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,0,1,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="10,16">
                        <TextBlock Text="CONNECTION" Style="{StaticResource SectionHeaderStyle}" Margin="14,0,0,6" />
                        <ToggleButton Content="Polling"
                                      Style="{StaticResource SettingsNavItemStyle}"
                                      IsChecked="{Binding IsPollingSectionSelected, Mode=OneWay}"
                                      Command="{Binding SelectPollingSectionCommand}" />
                        <ToggleButton Content="Server"
                                      Style="{StaticResource SettingsNavItemStyle}"
                                      IsChecked="{Binding IsServerSectionSelected, Mode=OneWay}"
                                      Command="{Binding SelectServerSectionCommand}" />

                        <TextBlock Text="ALERTS &amp; HEALTH" Style="{StaticResource SectionHeaderStyle}" Margin="14,16,0,6" />
                        <ToggleButton Content="Alert display"
                                      Style="{StaticResource SettingsNavItemStyle}"
                                      IsChecked="{Binding IsAlertDisplaySectionSelected, Mode=OneWay}"
                                      Command="{Binding SelectAlertDisplaySectionCommand}" />
                        <ToggleButton Content="Health thresholds"
                                      Style="{StaticResource SettingsNavItemStyle}"
                                      IsChecked="{Binding IsHealthThresholdsSectionSelected, Mode=OneWay}"
                                      Command="{Binding SelectHealthThresholdsSectionCommand}" />
                        <ToggleButton Content="Notifications"
                                      Style="{StaticResource SettingsNavItemStyle}"
                                      IsChecked="{Binding IsNotificationsSectionSelected, Mode=OneWay}"
                                      Command="{Binding SelectNotificationsSectionCommand}" />

                        <!-- Its own group, not folded into Alerts & Health or
                             Window & Appearance, even with only one page in
                             it today - more Devices-tab settings are already
                             planned (pinning, column layout, bulk-action
                             defaults), so this is where they land rather than
                             needing another reorganisation later. -->
                        <TextBlock Text="DEVICES" Style="{StaticResource SectionHeaderStyle}" Margin="14,16,0,6" />
                        <ToggleButton Content="Devices"
                                      Style="{StaticResource SettingsNavItemStyle}"
                                      IsChecked="{Binding IsDevicesSectionSelected, Mode=OneWay}"
                                      Command="{Binding SelectDevicesSectionCommand}" />

                        <TextBlock Text="MAPS" Style="{StaticResource SectionHeaderStyle}" Margin="14,16,0,6" />
                        <ToggleButton Content="Maps"
                                      Style="{StaticResource SettingsNavItemStyle}"
                                      IsChecked="{Binding IsMapsSectionSelected, Mode=OneWay}"
                                      Command="{Binding SelectMapsSectionCommand}" />

                        <!-- Its own group, like Devices - one page per
                             integration, each talking to its service
                             directly rather than through LibreNMS. -->
                        <TextBlock Text="INTEGRATIONS" Style="{StaticResource SectionHeaderStyle}" Margin="14,16,0,6" />
                        <ToggleButton Content="Graylog"
                                      Style="{StaticResource SettingsNavItemStyle}"
                                      IsChecked="{Binding IsGraylogSectionSelected, Mode=OneWay}"
                                      Command="{Binding SelectGraylogSectionCommand}" />
                        <ToggleButton Content="Unimus"
                                      Style="{StaticResource SettingsNavItemStyle}"
                                      IsChecked="{Binding IsIntegrationsSectionSelected, Mode=OneWay}"
                                      Command="{Binding SelectIntegrationsSectionCommand}" />

                        <TextBlock Text="WINDOW &amp; APPEARANCE" Style="{StaticResource SectionHeaderStyle}" Margin="14,16,0,6" />
                        <ToggleButton Content="Window and start-up"
                                      Style="{StaticResource SettingsNavItemStyle}"
                                      IsChecked="{Binding IsWindowSectionSelected, Mode=OneWay}"
                                      Command="{Binding SelectWindowSectionCommand}" />
                        <ToggleButton Content="Appearance"
                                      Style="{StaticResource SettingsNavItemStyle}"
                                      IsChecked="{Binding IsAppearanceSectionSelected, Mode=OneWay}"
                                      Command="{Binding SelectAppearanceSectionCommand}" />

                        <!-- Standalone, like DeviceView's Overview - not
                             every item needs a cluster, just enough top
                             margin to read as separate from the group above. -->
                        <ToggleButton Content="About"
                                      Style="{StaticResource SettingsNavItemStyle}"
                                      IsChecked="{Binding IsAboutSectionSelected, Mode=OneWay}"
                                      Command="{Binding SelectAboutSectionCommand}"
                                      Margin="0,16,0,2" />
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- ======================== Content ======================== -->
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Padding="28,24">
                <Grid>

                    <!-- ==================== Polling ==================== -->
                    <StackPanel Visibility="{Binding IsPollingSectionSelected, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="Polling" Style="{StaticResource HeadingTextStyle}" Margin="0,0,0,14" />

                        <!-- Same card treatment as Appearance: each card is a
                             self-contained topic with its own heading(s) and
                             explanatory text, ordered so related settings
                             (both timing sliders; both data-fetching toggles)
                             sit together rather than reading as five
                             unrelated items in one flat list. -->
                        <Border Background="{StaticResource SurfaceAltBrush}"
                                CornerRadius="6"
                                Padding="14,12"
                                Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="Refresh interval" Style="{StaticResource SectionHeaderStyle}" Margin="0,0,0,6" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Slider Grid.Column="0"
                                            Minimum="15"
                                            Maximum="600"
                                            TickFrequency="15"
                                            IsSnapToTickEnabled="True"
                                            VerticalAlignment="Center"
                                            Value="{Binding PollIntervalSeconds}" />
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding PollIntervalSeconds, StringFormat={}{0} s}"
                                               Style="{StaticResource SubtleTextStyle}"
                                               VerticalAlignment="Center"
                                               MinWidth="52"
                                               TextAlignment="Right"
                                               Margin="12,0,0,0" />
                                </Grid>
                                <TextBlock Style="{StaticResource SubtleTextStyle}"
                                           TextWrapping="Wrap"
                                           Margin="0,6,0,0"
                                           Text="Also used for the Devices and Health tabs, once each has been opened at least once - both show a countdown to their next refresh." />

                                <TextBlock Text="Request timeout" Style="{StaticResource SectionHeaderStyle}" Margin="0,16,0,6" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Slider Grid.Column="0"
                                            Minimum="5"
                                            Maximum="120"
                                            TickFrequency="5"
                                            IsSnapToTickEnabled="True"
                                            VerticalAlignment="Center"
                                            Value="{Binding TimeoutSeconds}" />
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding TimeoutSeconds, StringFormat={}{0} s}"
                                               Style="{StaticResource SubtleTextStyle}"
                                               VerticalAlignment="Center"
                                               MinWidth="52"
                                               TextAlignment="Right"
                                               Margin="12,0,0,0" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Background="{StaticResource SurfaceAltBrush}"
                                CornerRadius="6"
                                Padding="14,12"
                                Margin="0,0,0,16">
                            <StackPanel>
                                <CheckBox Content="Also fetch recovered alerts"
                                          IsChecked="{Binding IncludeRecoveredAlerts}" />
                                <TextBlock Style="{StaticResource SubtleTextStyle}"
                                           TextWrapping="Wrap"
                                           Margin="0,6,0,0"
                                           Text="LibreNMS keeps a row for every rule and device that has ever fired, so this can return a lot of history." />

                                <CheckBox Content="The LibreNMS server stores timestamps in UTC"
                                          IsChecked="{Binding ServerTimestampsAreUtc}"
                                          Margin="0,16,0,0" />
                                <TextBlock Style="{StaticResource SubtleTextStyle}"
                                           TextWrapping="Wrap"
                                           Margin="0,6,0,0"
                                           Text="Leave this off unless alert ages look wrong by a fixed number of hours." />
                            </StackPanel>
                        </Border>

                        <Border Background="{StaticResource SurfaceAltBrush}" CornerRadius="6" Padding="14,12">
                            <StackPanel>
                                <CheckBox Content="Allow an untrusted or self-signed certificate"
                                          IsChecked="{Binding AllowUntrustedCertificate}" />
                                <TextBlock Style="{StaticResource SubtleTextStyle}"
                                           TextWrapping="Wrap"
                                           Margin="0,6,0,0"
                                           Text="Takes effect the next time you sign in." />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ==================== Alert display ==================== -->
                    <StackPanel Visibility="{Binding IsAlertDisplaySectionSelected, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="Alert display" Style="{StaticResource HeadingTextStyle}" Margin="0,0,0,14" />

                        <Border Background="{StaticResource SurfaceAltBrush}"
                                CornerRadius="6"
                                Padding="14,12"
                                Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="Alerts tab count" Style="{StaticResource SectionHeaderStyle}" Margin="0,0,0,6" />
                                <CheckBox Content="Show an alert count on the Alerts tab"
                                          IsChecked="{Binding ShowAlertTabBadge}" />
                                <CheckBox Content="Include acknowledged alerts in the count"
                                          IsChecked="{Binding AlertTabBadgeIncludesAcknowledged}"
                                          IsEnabled="{Binding ShowAlertTabBadge}"
                                          Margin="0,8,0,0" />
                                <TextBlock Style="{StaticResource SubtleTextStyle}"
                                           TextWrapping="Wrap"
                                           Margin="0,6,0,0"
                                           Text="Red while any counted alert is critical, orange otherwise. Counts every alert, whatever the Alerts tab's own filters are showing." />
                            </StackPanel>
                        </Border>

                        <!-- Three separate cards rather than grouped - unlike
                             Polling's pairs, these three genuinely don't
                             relate to each other (naming, data-fetching,
                             action-safety), so forcing them together would
                             be grouping for its own sake. -->
                        <Border Background="{StaticResource SurfaceAltBrush}"
                                CornerRadius="6"
                                Padding="14,12"
                                Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="Name devices by" Style="{StaticResource SectionHeaderStyle}" Margin="0,0,0,6" />
                                <ComboBox ItemsSource="{Binding DeviceNameOptions}"
                                          SelectedItem="{Binding DeviceName}"
                                          DisplayMemberPath="Label" />
                                <TextBlock Text="{Binding DeviceName.Description}"
                                           Style="{StaticResource SubtleTextStyle}"
                                           TextWrapping="Wrap"
                                           Margin="0,6,0,0" />
                                <TextBlock Style="{StaticResource SubtleTextStyle}"
                                           TextWrapping="Wrap"
                                           Margin="0,6,0,0"
                                           Text="The name not chosen here is shown underneath it, so you always have both." />
                            </StackPanel>
                        </Border>

                        <Border Background="{StaticResource SurfaceAltBrush}"
                                CornerRadius="6"
                                Padding="14,12"
                                Margin="0,0,0,16">
                            <StackPanel>
                                <CheckBox Content="Show what triggered the selected alert"
                                          IsChecked="{Binding LoadAlertFaults}" />
                                <TextBlock Style="{StaticResource SubtleTextStyle}"
                                           TextWrapping="Wrap"
                                           Margin="0,6,0,0"
                                           Text="Fetches the rows the alert rule matched, with their measured values. Costs one extra request each time you select an alert." />
                            </StackPanel>
                        </Border>

                        <Border Background="{StaticResource SurfaceAltBrush}" CornerRadius="6" Padding="14,12">
                            <StackPanel>
                                <CheckBox Content="Confirm before a large bulk acknowledge/unacknowledge"
                                          IsChecked="{Binding ConfirmBulkAlertActions}" />
                                <TextBlock Style="{StaticResource SubtleTextStyle}"
                                           TextWrapping="Wrap"
                                           Margin="0,6,0,0"
                                           Text="Turned off automatically if you tick &quot;don't ask me again&quot; on that prompt - check this to turn it back on." />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ==================== Health thresholds ==================== -->
                    <StackPanel Visibility="{Binding IsHealthThresholdsSectionSelected, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="Health thresholds" Style="{StaticResource HeadingTextStyle}" Margin="0,0,0,4" />
                        <TextBlock Style="{StaticResource SubtleTextStyle}"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,14"
                                   Text="Each sensor type on the Health tab has its own band of Warning/Critical colours. Expand a sensor type below to see or change them." />

                        <Border Background="{StaticResource SurfaceAltBrush}"
                                CornerRadius="6"
                                Padding="14,12"
                                Margin="0,0,0,14">
                            <StackPanel>
                                <CheckBox Content="Always use these app thresholds, ignoring each sensor's own configured limits"
                                          IsChecked="{Binding OverrideSensorLimitsWithAppThresholds}" />
                                <TextBlock Style="{StaticResource SubtleTextStyle}"
                                           TextWrapping="Wrap"
                                           Margin="0,6,0,0"
                                           Text="Off (default): a sensor's own limit, as configured in LibreNMS, wins for whichever bound it sets - these app thresholds only fill in what the sensor leaves unset. On: these app thresholds always decide, and sensor-configured limits are ignored." />
                            </StackPanel>
                        </Border>

                        <!-- Each sensor type the Health tab understands gets its
                             own Expander; a future type is a new sibling here,
                             not a new page. -->
                        <Expander Header="dBm sensors" Style="{StaticResource AccordionExpanderStyle}" IsExpanded="False" Margin="0,0,0,8">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SubtleTextStyle}"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,6"
                                           Text="Optical power (dBm) sensors on the Health tab are coloured against these bands. A weak signal is too negative; an unplugged port usually reads back near zero or positive instead." />

                                <TextBlock Text="Warning at or below (dBm)" Style="{StaticResource SectionHeaderStyle}" />
                                <TextBox Text="{Binding DbmWarningThreshold, UpdateSourceTrigger=PropertyChanged}" />

                                <TextBlock Text="Critical at or below (dBm)" Style="{StaticResource SectionHeaderStyle}" />
                                <TextBox Text="{Binding DbmCriticalThreshold, UpdateSourceTrigger=PropertyChanged}" />

                                <TextBlock Text="Treat as no signal at or above (dBm)" Style="{StaticResource SectionHeaderStyle}" />
                                <TextBox Text="{Binding DbmIgnoreAtOrAbove, UpdateSourceTrigger=PropertyChanged}" />

                                <TextBlock Text="Treat as no signal at or below (dBm)" Style="{StaticResource SectionHeaderStyle}" />
                                <TextBox Text="{Binding DbmIgnoreAtOrBelow, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Style="{StaticResource SubtleTextStyle}"
                                           TextWrapping="Wrap"
                                           Margin="0,6,0,0"
                                           Text="Some hardware reports a fixed sentinel value, high or low, for an unplugged port instead of a real reading. Sensors at or beyond either sentinel are shown as &quot;no signal&quot; rather than critical." />
                            </StackPanel>
                        </Expander>

                        <Expander Header="Signal sensors" Style="{StaticResource AccordionExpanderStyle}" IsExpanded="False" Margin="0,0,0,8">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SubtleTextStyle}"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,6"
                                           Text="LibreNMS's generic &quot;signal&quot; sensors, coloured the same way as dBm: a weak signal is bad, and a sentinel at either extreme is treated as no data rather than flagged." />

                                <TextBlock Text="Warning at or below" Style="{StaticResource SectionHeaderStyle}" />
                                <TextBox Text="{Binding SignalWarningThreshold, UpdateSourceTrigger=PropertyChanged}" />

                                <TextBlock Text="Critical at or below" Style="{StaticResource SectionHeaderStyle}" />
                                <TextBox Text="{Binding SignalCriticalThreshold, UpdateSourceTrigger=PropertyChanged}" />

                                <TextBlock Text="Treat as no data at or above" Style="{StaticResource SectionHeaderStyle}" />
                                <TextBox Text="{Binding SignalIgnoreAtOrAbove, UpdateSourceTrigger=PropertyChanged}" />

                                <TextBlock Text="Treat as no data at or below" Style="{StaticResource SectionHeaderStyle}" />
                                <TextBox Text="{Binding SignalIgnoreAtOrBelow, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </Expander>

                        <Expander Header="Temperature sensors" Style="{StaticResource AccordionExpanderStyle}" IsExpanded="False" Margin="0,0,0,8">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SubtleTextStyle}"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,6"
                                           Text="Both too hot and too cold are faults, so temperature uses a band rather than a single direction. These starting values are a generic guideline - hardware varies, so tune them for your fleet." />

                                <TextBlock Text="Critical at or below (°C)" Style="{StaticResource SectionHeaderStyle}" />
                                <TextBox Text="{Binding TemperatureLowCritical, UpdateSourceTrigger=PropertyChanged}" />

                                <TextBlock Text="Warning at or below (°C)" Style="{StaticResource SectionHeaderStyle}" />
                                <TextBox Text="{Binding TemperatureLowWarning, UpdateSourceTrigger=PropertyChanged}" />

                                <TextBlock Text="Warning at or above (°C)" Style="{StaticResource SectionHeaderStyle}" />
                                <TextBox Text="{Binding TemperatureHighWarning, UpdateSourceTrigger=PropertyChanged}" />

                                <TextBlock Text="Critical at or above (°C)" Style="{StaticResource SectionHeaderStyle}" />
                                <TextBox Text="{Binding TemperatureHighCritical, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </Expander>

                        <Expander Header="Fan speed sensors" Style="{StaticResource AccordionExpanderStyle}" IsExpanded="False">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SubtleTextStyle}"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,6"
                                           Text="A stalled or slow fan is the usual failure, but an overspeeding fan can also indicate a fault, so this uses a band too. RPM varies enormously by fan size - these are placeholders to tune per fleet." />

                                <TextBlock Text="Critical at or below (RPM)" Style="{StaticResource SectionHeaderStyle}" />
                                <TextBox Text="{Binding FanSpeedLowCritical, UpdateSourceTrigger=PropertyChanged}" />

                                <TextBlock Text="Warning at or below (RPM)" Style="{StaticResource SectionHeaderStyle}" />
                                <TextBox Text="{Binding FanSpeedLowWarning, UpdateSourceTrigger=PropertyChanged}" />

                                <TextBlock Text="Warning at or above (RPM)" Style="{StaticResource SectionHeaderStyle}" />
                                <TextBox Text="{Binding FanSpeedHighWarning, UpdateSourceTrigger=PropertyChanged}" />

                                <TextBlock Text="Critical at or above (RPM)" Style="{StaticResource SectionHeaderStyle}" />
                                <TextBox Text="{Binding FanSpeedHighCritical, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </Expander>
                    </StackPanel>

                    <!-- ==================== Notifications ==================== -->
                    <StackPanel Visibility="{Binding IsNotificationsSectionSelected, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="Notifications" Style="{StaticResource HeadingTextStyle}" Margin="0,0,0,14" />

                        <!-- The master switch stays bare above the cards,
                             like the page heading itself - it gates
                             everything below rather than being a topic of
                             its own. Critical/Warning were already card-
                             wrapped; Other events and Quiet hours now match
                             them instead of being bare labelled StackPanels. -->
                        <CheckBox Content="Show Windows notifications"
                                  IsChecked="{Binding NotificationsEnabled}"
                                  Margin="0,0,0,16" />

                        <Border Background="{StaticResource SurfaceAltBrush}"
                                CornerRadius="6"
                                Padding="14,12"
                                Margin="0,0,0,16"
                                IsEnabled="{Binding NotificationsEnabled}">
                            <StackPanel>
                                <TextBlock Text="Critical" Style="{StaticResource SectionHeaderStyle}" Margin="0,0,0,6" />
                                <CheckBox Content="Notify for critical alerts" IsChecked="{Binding CriticalEnabled}" />
                                <ComboBox ItemsSource="{Binding PersistenceOptions}"
                                          SelectedItem="{Binding CriticalPersistence}"
                                          DisplayMemberPath="Label"
                                          IsEnabled="{Binding CriticalEnabled}"
                                          Margin="0,10,0,0" />
                                <TextBlock Text="{Binding CriticalPersistence.Description}"
                                           Style="{StaticResource SubtleTextStyle}"
                                           TextWrapping="Wrap"
                                           Margin="0,6,0,0" />
                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                    <CheckBox Content="Play a sound"
                                              IsChecked="{Binding CriticalPlaySound}"
                                              IsEnabled="{Binding CriticalEnabled}"
                                              VerticalAlignment="Center" />
                                    <Button Content="Preview"
                                            Command="{Binding PreviewCriticalCommand}"
                                            Padding="10,4"
                                            Margin="16,0,0,0" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Background="{StaticResource SurfaceAltBrush}"
                                CornerRadius="6"
                                Padding="14,12"
                                Margin="0,0,0,16"
                                IsEnabled="{Binding NotificationsEnabled}">
                            <StackPanel>
                                <TextBlock Text="Warning" Style="{StaticResource SectionHeaderStyle}" Margin="0,0,0,6" />
                                <CheckBox Content="Notify for warning alerts" IsChecked="{Binding WarningEnabled}" />
                                <ComboBox ItemsSource="{Binding PersistenceOptions}"
                                          SelectedItem="{Binding WarningPersistence}"
                                          DisplayMemberPath="Label"
                                          IsEnabled="{Binding WarningEnabled}"
                                          Margin="0,10,0,0" />
                                <TextBlock Text="{Binding WarningPersistence.Description}"
                                           Style="{StaticResource SubtleTextStyle}"
                                           TextWrapping="Wrap"
                                           Margin="0,6,0,0" />
                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                    <CheckBox Content="Play a sound"
                                              IsChecked="{Binding WarningPlaySound}"
                                              IsEnabled="{Binding WarningEnabled}"
                                              VerticalAlignment="Center" />
                                    <Button Content="Preview"
                                            Command="{Binding PreviewWarningCommand}"
                                            Padding="10,4"
                                            Margin="16,0,0,0" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Background="{StaticResource SurfaceAltBrush}"
                                CornerRadius="6"
                                Padding="14,12"
                                Margin="0,0,0,16"
                                IsEnabled="{Binding NotificationsEnabled}">
                            <StackPanel>
                                <TextBlock Text="Other events" Style="{StaticResource SectionHeaderStyle}" Margin="0,0,0,6" />
                                <CheckBox Content="Notify when an alert recovers" IsChecked="{Binding NotifyOnRecovery}" />
                                <CheckBox Content="Notify when an alert is acknowledged" IsChecked="{Binding NotifyOnAcknowledge}" Margin="0,8,0,0" />
                                <CheckBox Content="Stay quiet about alerts that were already open at start-up"
                                          IsChecked="{Binding SuppressOnFirstPoll}"
                                          Margin="0,8,0,0" />

                                <TextBlock Text="Collapse into one summary above" Style="{StaticResource SectionHeaderStyle}" Margin="0,16,0,6" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Slider Grid.Column="0"
                                            Minimum="1"
                                            Maximum="25"
                                            TickFrequency="1"
                                            IsSnapToTickEnabled="True"
                                            VerticalAlignment="Center"
                                            Value="{Binding MaxToastsPerPoll}" />
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding MaxToastsPerPoll, StringFormat={}{0} toasts}"
                                               Style="{StaticResource SubtleTextStyle}"
                                               VerticalAlignment="Center"
                                               MinWidth="76"
                                               TextAlignment="Right"
                                               Margin="12,0,0,0" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Background="{StaticResource SurfaceAltBrush}"
                                CornerRadius="6"
                                Padding="14,12"
                                IsEnabled="{Binding NotificationsEnabled}">
                            <StackPanel>
                                <TextBlock Text="Quiet hours" Style="{StaticResource SectionHeaderStyle}" Margin="0,0,0,6" />
                                <CheckBox Content="Suppress notifications overnight" IsChecked="{Binding QuietHoursEnabled}" />
                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0" IsEnabled="{Binding QuietHoursEnabled}">
                                    <TextBlock Text="From" Style="{StaticResource SubtleTextStyle}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <ComboBox Width="80"
                                              ItemsSource="{Binding Hours}"
                                              SelectedItem="{Binding QuietHoursStartHour}" />
                                    <TextBlock Text="to" Style="{StaticResource SubtleTextStyle}" VerticalAlignment="Center" Margin="12,0,8,0" />
                                    <ComboBox Width="80"
                                              ItemsSource="{Binding Hours}"
                                              SelectedItem="{Binding QuietHoursEndHour}" />
                                    <TextBlock Text="(24 hour clock, local time)"
                                               Style="{StaticResource SubtleTextStyle}"
                                               VerticalAlignment="Center"
                                               Margin="12,0,0,0" />
                                </StackPanel>
                                <CheckBox Content="Still notify for critical alerts during quiet hours"
                                          IsChecked="{Binding QuietHoursAllowCritical}"
                                          IsEnabled="{Binding QuietHoursEnabled}"
                                          Margin="0,10,0,0" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ==================== Devices ==================== -->
                    <StackPanel Visibility="{Binding IsDevicesSectionSelected, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="Devices" Style="{StaticResource HeadingTextStyle}" Margin="0,0,0,14" />

                        <Border Background="{StaticResource SurfaceAltBrush}" CornerRadius="6" Padding="14,12">
                            <StackPanel>
                                <TextBlock Text="Recently viewed" Style="{StaticResource SectionHeaderStyle}" Margin="0,0,0,6" />
                                <CheckBox Content="Show recently viewed devices on the Devices tab"
                                          IsChecked="{Binding ShowRecentlyViewedDevices}" />
                                <TextBlock Style="{StaticResource SubtleTextStyle}"
                                           TextWrapping="Wrap"
                                           Margin="0,6,0,0"
                                           Text="A quick way back into a device you were just looking at. Also available as its own Dashboard widget regardless of this setting." />

                                <TextBlock Text="How many to remember" Style="{StaticResource SectionHeaderStyle}" Margin="0,16,0,6" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Slider Grid.Column="0"
                                            Minimum="1"
                                            Maximum="25"
                                            TickFrequency="1"
                                            IsSnapToTickEnabled="True"
                                            VerticalAlignment="Center"
                                            Value="{Binding RecentlyViewedDeviceCount}" />
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding RecentlyViewedDeviceCount, StringFormat={}{0} devices}"
                                               Style="{StaticResource SubtleTextStyle}"
                                               VerticalAlignment="Center"
                                               MinWidth="86"
                                               TextAlignment="Right"
                                               Margin="12,0,0,0" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Background="{StaticResource SurfaceAltBrush}" CornerRadius="6" Padding="14,12" Margin="0,12,0,0">
                            <StackPanel>
                                <TextBlock Text="Pinned devices" Style="{StaticResource SectionHeaderStyle}" Margin="0,0,0,6" />
                                <CheckBox Content="Let me pin devices to the top of the Devices tab"
                                          IsChecked="{Binding EnablePinnedDevices}" />
                                <TextBlock Style="{StaticResource SubtleTextStyle}"
                                           TextWrapping="Wrap"
                                           Margin="0,6,0,0"
                                           Text="Off hides the pin column and pin actions, stops pinned devices sorting first and removes the Pinned devices Dashboard widget from the add menu. Your pins are kept, so turning this back on restores them." />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ==================== Maps ==================== -->
                    <StackPanel Visibility="{Binding IsMapsSectionSelected, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="Maps" Style="{StaticResource HeadingTextStyle}" Margin="0,0,0,14" />

                        <Border Background="{StaticResource SurfaceAltBrush}" CornerRadius="6" Padding="14,12" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="Default map" Style="{StaticResource SectionHeaderStyle}" Margin="0,0,0,6" />
                                <ComboBox ItemsSource="{Binding DefaultMapOptions}"
                                          SelectedItem="{Binding SelectedDefaultMap}"
                                          DisplayMemberPath="Label"
                                          Width="220"
                                          HorizontalAlignment="Left" />
                                <TextBlock Style="{StaticResource SubtleTextStyle}"
                                           TextWrapping="Wrap"
                                           Margin="0,6,0,0"
                                           Text="Which map opens when you click Maps - Network, Geographical, or one of your custom maps. The others are always a hover away." />
                            </StackPanel>
                        </Border>

                        <Border Background="{StaticResource SurfaceAltBrush}" CornerRadius="6" Padding="14,12">
                            <StackPanel>
                                <TextBlock Text="Geographical map tiles" Style="{StaticResource SectionHeaderStyle}" Margin="0,0,0,6" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0"
                                             Text="{Binding MapTileUrl, UpdateSourceTrigger=PropertyChanged, Delay=300}"
                                             ToolTip="Leave blank for OpenStreetMap" />
                                    <Button Grid.Column="1"
                                            Content="Use OpenStreetMap"
                                            Command="{Binding ResetMapTileUrlCommand}"
                                            Padding="10,5"
                                            Margin="8,0,0,0" />
                                </Grid>
                                <TextBlock Text="{Binding MapTileUrlStatusText}"
                                           TextWrapping="Wrap"
                                           Margin="0,6,0,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource SubtleTextStyle}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding MapTileUrlIsInvalid}" Value="True">
                                                    <Setter Property="Foreground" Value="{StaticResource WarningBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Style="{StaticResource SubtleTextStyle}"
                                           TextWrapping="Wrap"
                                           Margin="0,10,0,0"
                                           Text="Blank uses OpenStreetMap's standard tiles, the same as LibreNMS's own world map by default. To use another tile server, enter its address with {z}/{x}/{y}, or paste LibreNMS's leaflet.tile_url setting as-is. Tiles are cached on this PC for a week." />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ==================== Window ==================== -->
                    <StackPanel Visibility="{Binding IsWindowSectionSelected, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="Window and start-up" Style="{StaticResource HeadingTextStyle}" Margin="0,0,0,14" />

                        <!-- One card, not per-item - unlike Alert display's
                             three unrelated settings, everything here is
                             genuinely one topic (how the app starts and
                             behaves as a window), so splitting it further
                             would be grouping for its own sake. -->
                        <Border Background="{StaticResource SurfaceAltBrush}" CornerRadius="6" Padding="14,12">
                            <StackPanel>
                                <CheckBox Content="Closing the window keeps DashyNMS running in the notification area"
                                          IsChecked="{Binding MinimiseToTrayOnClose}" />
                                <CheckBox Content="Start hidden in the notification area"
                                          IsChecked="{Binding StartMinimised}"
                                          Margin="0,8,0,0" />
                                <CheckBox Content="Start DashyNMS when I sign in to Windows"
                                          IsChecked="{Binding StartWithWindows}"
                                          Margin="0,8,0,0" />

                                <TextBlock Text="Tab to show at startup" Style="{StaticResource SectionHeaderStyle}" Margin="0,16,0,6" />
                                <ComboBox ItemsSource="{Binding StartupTabOptions}"
                                          SelectedItem="{Binding SelectedStartupTab}"
                                          DisplayMemberPath="Label" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ==================== Appearance ==================== -->
                    <StackPanel Visibility="{Binding IsAppearanceSectionSelected, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="Appearance" Style="{StaticResource HeadingTextStyle}" Margin="0,0,0,14" />

                        <!-- Separate cards, each self-contained with its own
                             heading and explanatory text, rather than text
                             living outside the card it describes. Theme
                             first; Accent colour last since its sliders/hex/
                             preview make it the taller of the two. -->
                        <Border Background="{StaticResource SurfaceAltBrush}"
                                CornerRadius="6"
                                Padding="14,12"
                                Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="Theme" Style="{StaticResource SectionHeaderStyle}" Margin="0,0,0,6" />
                                <Border Style="{StaticResource NavTabTrackStyle}" HorizontalAlignment="Left">
                                    <StackPanel Orientation="Horizontal">
                                        <ToggleButton Content="Dark" Style="{StaticResource NavTabButtonStyle}" IsChecked="{Binding IsDarkTheme}" />
                                        <ToggleButton Content="Light" Style="{StaticResource NavTabButtonStyle}" IsChecked="{Binding IsLightTheme}" />
                                        <ToggleButton Content="Match Windows" Style="{StaticResource NavTabButtonStyle}" IsChecked="{Binding IsSystemTheme}" />
                                    </StackPanel>
                                </Border>
                                <TextBlock Style="{StaticResource SubtleTextStyle}"
                                           TextWrapping="Wrap"
                                           Margin="0,8,0,0"
                                           Text="Match Windows uses your Windows app mode (Settings, Personalisation, Colours) each time DashyNMS starts."
                                           Visibility="{Binding IsSystemTheme, Converter={StaticResource BoolToVisibility}}" />
                                <TextBlock Style="{StaticResource SubtleTextStyle}"
                                           TextWrapping="Wrap"
                                           Margin="0,8,0,0"
                                           Text="Needs a restart to fully apply - unlike the accent colour below, changing this while DashyNMS is running does not repaint what's already open."
                                           Visibility="{Binding ThemeChangeRequiresRestart, Converter={StaticResource BoolToVisibility}}" />
                            </StackPanel>
                        </Border>

                        <!-- One aligned table (label / slider / typed value) for
                             Red, Green, Blue and Hex, rather than each channel
                             getting its own full-width header-plus-row - reads
                             as a single compact colour-picker widget instead
                             of four repeated sections. Sliders capped at
                             MaxWidth so the table reads as a deliberately-
                             sized control instead of stretching edge-to-edge
                             if the window is widened. Each channel's value is
                             also directly typeable, not just slider-drag. -->
                        <Border Background="{StaticResource SurfaceAltBrush}" CornerRadius="6" Padding="14,12">
                            <StackPanel>
                                <TextBlock Text="Accent colour" Style="{StaticResource SectionHeaderStyle}" Margin="0,0,0,14" />

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Only the slider column is flexible - the
                                         label and value columns stay fixed so
                                         they're always fully legible, and the
                                         slider itself has a floor (MinWidth)
                                         so it never shrinks to something
                                         unusable. This is what makes the whole
                                         picker adapt when the window is
                                         resized instead of clipping at
                                         whatever width it happened to be
                                         built at. -->
                                    <Grid Grid.Column="0" Margin="0,0,20,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="44" />
                                            <ColumnDefinition Width="*" MinWidth="80" />
                                            <ColumnDefinition Width="64" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Red" Style="{StaticResource SubtleTextStyle}" VerticalAlignment="Center" />
                                        <Slider Grid.Row="0" Grid.Column="1" Minimum="0" Maximum="255" IsSnapToTickEnabled="True" TickFrequency="1" Value="{Binding AccentRed}" VerticalAlignment="Center" Margin="10,0" />
                                        <TextBox Grid.Row="0" Grid.Column="2" Text="{Binding AccentRedText, UpdateSourceTrigger=PropertyChanged}" TextAlignment="Right" VerticalAlignment="Center" Padding="4,6" />

                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Green" Style="{StaticResource SubtleTextStyle}" VerticalAlignment="Center" Margin="0,10,0,0" />
                                        <Slider Grid.Row="1" Grid.Column="1" Minimum="0" Maximum="255" IsSnapToTickEnabled="True" TickFrequency="1" Value="{Binding AccentGreen}" VerticalAlignment="Center" Margin="10,10,10,0" />
                                        <TextBox Grid.Row="1" Grid.Column="2" Text="{Binding AccentGreenText, UpdateSourceTrigger=PropertyChanged}" TextAlignment="Right" VerticalAlignment="Center" Margin="0,10,0,0" Padding="4,6" />

                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Blue" Style="{StaticResource SubtleTextStyle}" VerticalAlignment="Center" Margin="0,10,0,0" />
                                        <Slider Grid.Row="2" Grid.Column="1" Minimum="0" Maximum="255" IsSnapToTickEnabled="True" TickFrequency="1" Value="{Binding AccentBlue}" VerticalAlignment="Center" Margin="10,10,10,0" />
                                        <TextBox Grid.Row="2" Grid.Column="2" Text="{Binding AccentBlueText, UpdateSourceTrigger=PropertyChanged}" TextAlignment="Right" VerticalAlignment="Center" Margin="0,10,0,0" Padding="4,6" />

                                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Hex" Style="{StaticResource SubtleTextStyle}" VerticalAlignment="Center" Margin="0,14,0,0" />
                                        <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding AccentColorHex, UpdateSourceTrigger=PropertyChanged}" MaxLength="7" HorizontalAlignment="Left" Width="100" Margin="10,14,0,0" />
                                    </Grid>

                                    <Border Grid.Column="1"
                                            Width="90"
                                            Height="90"
                                            CornerRadius="8"
                                            Background="{Binding AccentPreviewBrush}"
                                            BorderBrush="{StaticResource BorderBrush}"
                                            BorderThickness="1"
                                            VerticalAlignment="Top" />
                                </Grid>

                                <TextBlock Style="{StaticResource SubtleTextStyle}"
                                           TextWrapping="Wrap"
                                           Margin="0,14,0,0"
                                           Text="Takes effect as soon as you save - no restart needed." />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ==================== Server ==================== -->
                    <StackPanel Visibility="{Binding IsServerSectionSelected, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="Server" Style="{StaticResource HeadingTextStyle}" Margin="0,0,0,14" />

                        <!-- The connection itself, editable. Save tries the
                             server address first and, if it doesn't answer,
                             the backup address - and only saves once one of
                             them does, so a typo can't cut the app off. -->
                        <Border Background="{StaticResource SurfaceAltBrush}" CornerRadius="6" Padding="14,12" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="Server address" Style="{StaticResource SectionHeaderStyle}" Margin="0,0,0,6" />
                                <TextBox Text="{Binding ServerAddress, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="For example https://nms.example.com" />

                                <TextBlock Text="Backup address" Style="{StaticResource SectionHeaderStyle}" Margin="0,14,0,6" />
                                <TextBox Text="{Binding BackupServerAddress, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="Another address for the same server, e.g. https://192.0.2.20/" />
                                <TextBlock Text="{Binding BackupServerAddressError}"
                                           Foreground="{StaticResource CriticalBrush}"
                                           TextWrapping="Wrap"
                                           Margin="0,4,0,0"
                                           Visibility="{Binding HasBackupServerAddressError, Converter={StaticResource BoolToVisibility}}" />
                                <TextBlock Style="{StaticResource SubtleTextStyle}"
                                           TextWrapping="Wrap"
                                           Margin="0,4,0,0"
                                           Text="Optional. Another address for the same LibreNMS server, as a URL like the server address - https://192.0.2.20/ or http://nms-backup:8080/. Used if the server address stops answering twice in a row, until you switch back. If only the host differs, HTTPS still checks the certificate against the server's own name." />

                                <TextBlock Text="API token" Style="{StaticResource SectionHeaderStyle}" Margin="0,14,0,6" />
                                <PasswordBox x:Name="ServerTokenBox" PasswordChanged="OnServerTokenChanged" />
                                <TextBlock Text="Leave blank to keep the token in use."
                                           Style="{StaticResource SubtleTextStyle}"
                                           Margin="0,4,0,0" />

                                <CheckBox Content="Allow an untrusted or self-signed certificate"
                                          IsChecked="{Binding ServerAllowUntrustedCertificate}"
                                          Margin="0,14,0,0" />

                                <TextBlock Style="{StaticResource SubtleTextStyle}"
                                           TextWrapping="Wrap"
                                           Margin="0,12,0,0"
                                           Text="Changes here are checked when you save: the server address first, then the backup address if it doesn't answer. Nothing is saved until one of them does." />

                                <TextBlock Text="Checking the connection..."
                                           Style="{StaticResource SubtleTextStyle}"
                                           Margin="0,10,0,0"
                                           Visibility="{Binding IsTestingConnection, Converter={StaticResource BoolToVisibility}}" />

                                <Border Background="#33DA3633"
                                        BorderBrush="{StaticResource CriticalBrush}"
                                        BorderThickness="1"
                                        CornerRadius="5"
                                        Padding="12,10"
                                        Margin="0,10,0,0"
                                        Visibility="{Binding HasConnectionError, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Text="{Binding ConnectionError}" TextWrapping="Wrap" />
                                </Border>
                            </StackPanel>
                        </Border>


                        <!-- What the app is connected to right now - read-only,
                             with Refresh. -->
                        <Border Background="{StaticResource SurfaceAltBrush}" CornerRadius="6" Padding="14,12">
                            <StackPanel>
                                <!-- The URL is the card's header, paired with
                                     the action that refreshes what it's
                                     describing - not a caption sitting above
                                     an unrelated status line. An error (if
                                     any) shows underneath rather than
                                     replacing the URL, since it's still
                                     useful to see what was being refreshed
                                     when it failed. -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               Text="{Binding ServerUrlText}"
                                               VerticalAlignment="Center"
                                               TextWrapping="Wrap" />
                                    <Button Grid.Column="1"
                                            Content="Refresh"
                                            Command="{Binding RefreshServerInfoCommand}"
                                            Padding="10,6"
                                            Margin="12,0,0,0" />
                                </Grid>
                                <TextBlock Text="{Binding ServerInfoStatusText}"
                                           Foreground="{StaticResource CriticalBrush}"
                                           TextWrapping="Wrap"
                                           Margin="0,8,0,0"
                                           Visibility="{Binding HasServerInfoStatus, Converter={StaticResource BoolToVisibility}}" />

                                <Grid Margin="0,16,0,0" Visibility="{Binding HasServerInfo, Converter={StaticResource BoolToVisibility}}">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,10,14">
                                        <TextBlock Text="LibreNMS version" Style="{StaticResource SectionHeaderStyle}" />
                                        <TextBlock Text="{Binding ServerVersionText}" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,14">
                                        <TextBlock Text="Branch" Style="{StaticResource SectionHeaderStyle}" />
                                        <TextBlock Text="{Binding ServerBranchText}" TextWrapping="Wrap" />
                                    </StackPanel>

                                    <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,10,14">
                                        <TextBlock Text="Commit" Style="{StaticResource SectionHeaderStyle}" />
                                        <TextBlock Text="{Binding ServerCommitText}" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,0,14">
                                        <TextBlock Text="Release date" Style="{StaticResource SectionHeaderStyle}" />
                                        <TextBlock Text="{Binding ServerDateText}" TextWrapping="Wrap" />
                                    </StackPanel>

                                    <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,10,14">
                                        <TextBlock Text="Database version" Style="{StaticResource SectionHeaderStyle}" />
                                        <TextBlock Text="{Binding DatabaseVersionText}" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <StackPanel Grid.Row="2" Grid.Column="1" Margin="0,0,0,14">
                                        <TextBlock Text="Database schema" Style="{StaticResource SectionHeaderStyle}" />
                                        <TextBlock Text="{Binding DatabaseSchemaText}" TextWrapping="Wrap" />
                                    </StackPanel>

                                    <StackPanel Grid.Row="3" Grid.Column="0" Margin="0,0,10,14">
                                        <TextBlock Text="PHP version" Style="{StaticResource SectionHeaderStyle}" />
                                        <TextBlock Text="{Binding PhpVersionText}" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <StackPanel Grid.Row="3" Grid.Column="1" Margin="0,0,0,14">
                                        <TextBlock Text="Python version" Style="{StaticResource SectionHeaderStyle}" />
                                        <TextBlock Text="{Binding PythonVersionText}" TextWrapping="Wrap" />
                                    </StackPanel>

                                    <StackPanel Grid.Row="4" Grid.Column="0" Margin="0,0,10,0">
                                        <TextBlock Text="RRDtool version" Style="{StaticResource SectionHeaderStyle}" />
                                        <TextBlock Text="{Binding RrdToolVersionText}" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <StackPanel Grid.Row="4" Grid.Column="1" Margin="0,0,0,0">
                                        <TextBlock Text="Net-SNMP version" Style="{StaticResource SectionHeaderStyle}" />
                                        <TextBlock Text="{Binding NetSnmpVersionText}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Grid>

                                <TextBlock Text="Not connected to a server."
                                           Style="{StaticResource SubtleTextStyle}"
                                           Margin="0,16,0,0"
                                           Visibility="{Binding HasServerInfo, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ==================== Integrations (Unimus) ==================== -->
                    <StackPanel Visibility="{Binding IsIntegrationsSectionSelected, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="Unimus" Style="{StaticResource HeadingTextStyle}" Margin="0,0,0,14" />
                        <TextBlock Style="{StaticResource SubtleTextStyle}"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,14"
                                   Text="Shows config backups for a device, lets you diff two revisions, and trigger a backup on demand, from the Config tab in Device Details. Talks to Unimus directly with its own token - not through LibreNMS." />

                        <Border Background="{StaticResource SurfaceAltBrush}" CornerRadius="6" Padding="14,12">
                            <StackPanel>
                                <CheckBox Content="Enable Unimus integration" IsChecked="{Binding UnimusEnabled}" />

                                <TextBlock Text="Unimus URL" Style="{StaticResource SectionHeaderStyle}" Margin="0,16,0,6" />
                                <TextBox Text="{Binding UnimusUrl, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="e.g. https://unimus.example.com" />

                                <TextBlock Text="API token" Style="{StaticResource SectionHeaderStyle}" Margin="0,16,0,6" />
                                <PasswordBox x:Name="UnimusTokenBox" PasswordChanged="OnUnimusTokenChanged" />
                                <Grid Margin="0,6,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding UnimusTokenStatusText}" Style="{StaticResource SubtleTextStyle}" VerticalAlignment="Center" />
                                    <Button Grid.Column="1"
                                            Content="Clear"
                                            Command="{Binding ClearUnimusTokenCommand}"
                                            Padding="10,4" />
                                </Grid>
                                <TextBlock Style="{StaticResource SubtleTextStyle}"
                                           TextWrapping="Wrap"
                                           Margin="0,4,0,0"
                                           Text="Leave blank and save to keep the token already stored. Generate one in Unimus under User management, API tokens." />

                                <CheckBox Content="Ignore SSL certificate errors"
                                          IsChecked="{Binding UnimusAllowUntrustedCertificate}"
                                          Margin="0,16,0,0" />
                                <TextBlock Style="{StaticResource SubtleTextStyle}"
                                           TextWrapping="Wrap"
                                           Margin="0,4,0,0"
                                           Text="Only enable this if Unimus uses a self-signed or internally-issued certificate you trust." />

                                <TextBlock Text="LibreNMS discovery domain (optional)" Style="{StaticResource SectionHeaderStyle}" Margin="0,16,0,6" />
                                <TextBox Text="{Binding UnimusMyDomain, UpdateSourceTrigger=PropertyChanged}" ToolTip="e.g. internal.example.com" />
                                <TextBlock Style="{StaticResource SubtleTextStyle}"
                                           TextWrapping="Wrap"
                                           Margin="0,4,0,0"
                                           Text="LibreNMS's own 'mydomain' discovery setting, if configured - used as one of the ways a device is matched to its Unimus entry. Not required; LibreNMS's API doesn't expose this, so it has to be entered here too if it's set." />

                                <Grid Margin="0,16,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0"
                                            Content="Test connection"
                                            Command="{Binding TestUnimusConnectionCommand}"
                                            Padding="10,6" />
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding UnimusTestStatusText}"
                                               TextWrapping="Wrap"
                                               VerticalAlignment="Center"
                                               Margin="12,0,0,0"
                                               Visibility="{Binding HasUnimusTestStatus, Converter={StaticResource BoolToVisibility}}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                                <Setter Property="Foreground" Value="{StaticResource OkBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding UnimusTestSucceeded}" Value="False">
                                                        <Setter Property="Foreground" Value="{StaticResource CriticalBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ==================== Integrations (Graylog) ==================== -->
                    <!-- The same fields, order and help as LibreNMS's own
                         Settings, External, Graylog page (its graylog.*
                         config), plus the SSL option Unimus has here. -->
                    <StackPanel Visibility="{Binding IsGraylogSectionSelected, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="Graylog" Style="{StaticResource HeadingTextStyle}" Margin="0,0,0,14" />
                        <TextBlock Style="{StaticResource SubtleTextStyle}"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,14"
                                   Text="Shows a device's log messages from Graylog on the Graylog tab in Device Details, found the same way LibreNMS finds them. Talks to Graylog directly with its own credentials - not through LibreNMS - so copy these from LibreNMS's Settings, External, Graylog." />

                        <Border Background="{StaticResource SurfaceAltBrush}" CornerRadius="6" Padding="14,12" Margin="0,0,0,12">
                            <StackPanel>
                                <CheckBox Content="Enable Graylog integration" IsChecked="{Binding GraylogEnabled}" />

                                <Grid Margin="0,16,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="110" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Server" Style="{StaticResource SectionHeaderStyle}" Margin="0,0,0,6" />
                                        <TextBox Text="{Binding GraylogServer, UpdateSourceTrigger=PropertyChanged}"
                                                 ToolTip="e.g. https://graylog.example.com" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Port" Style="{StaticResource SectionHeaderStyle}" Margin="0,0,0,6" />
                                        <TextBox Text="{Binding GraylogPortText, UpdateSourceTrigger=LostFocus}"
                                                 ToolTip="e.g. 9000" />
                                    </StackPanel>
                                </Grid>
                                <TextBlock Style="{StaticResource SubtleTextStyle}"
                                           TextWrapping="Wrap"
                                           Margin="0,4,0,0"
                                           Text="The address of the Graylog server's API. With no port, 80 is used for http:// and 443 for https://." />

                                <TextBlock Text="Version" Style="{StaticResource SectionHeaderStyle}" Margin="0,16,0,6" />
                                <ComboBox ItemsSource="{Binding GraylogVersionOptions}"
                                          SelectedItem="{Binding SelectedGraylogVersion}"
                                          DisplayMemberPath="Label"
                                          Width="220"
                                          HorizontalAlignment="Left" />
                                <TextBlock Style="{StaticResource SubtleTextStyle}"
                                           TextWrapping="Wrap"
                                           Margin="0,4,0,0"
                                           Text="Used to work out where the API is. If you've changed Graylog's API address from the default, choose Other and enter its base URI." />

                                <StackPanel Visibility="{Binding IsGraylogBaseUriVisible, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Text="Base URI" Style="{StaticResource SectionHeaderStyle}" Margin="0,16,0,6" />
                                    <TextBox Text="{Binding GraylogBaseUri, UpdateSourceTrigger=PropertyChanged}"
                                             ToolTip="e.g. /api/search/universal/relative" />
                                    <TextBlock Style="{StaticResource SubtleTextStyle}"
                                               TextWrapping="Wrap"
                                               Margin="0,4,0,0"
                                               Text="The search API's path on the server, if you changed it from Graylog's default." />
                                </StackPanel>

                                <TextBlock Text="Username" Style="{StaticResource SectionHeaderStyle}" Margin="0,16,0,6" />
                                <TextBox Text="{Binding GraylogUsername, UpdateSourceTrigger=PropertyChanged}" />

                                <TextBlock Text="Password" Style="{StaticResource SectionHeaderStyle}" Margin="0,16,0,6" />
                                <PasswordBox x:Name="GraylogPasswordBox" PasswordChanged="OnGraylogPasswordChanged" />
                                <Grid Margin="0,6,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding GraylogPasswordStatusText}" Style="{StaticResource SubtleTextStyle}" VerticalAlignment="Center" />
                                    <Button Grid.Column="1"
                                            Content="Clear"
                                            Command="{Binding ClearGraylogPasswordCommand}"
                                            Padding="10,4" />
                                </Grid>
                                <TextBlock Style="{StaticResource SubtleTextStyle}"
                                           TextWrapping="Wrap"
                                           Margin="0,4,0,0"
                                           Text="Leave blank and save to keep the password already stored. To use a Graylog access token instead, enter the token as the username and the word token as the password." />

                                <CheckBox Content="Ignore SSL certificate errors"
                                          IsChecked="{Binding GraylogAllowUntrustedCertificate}"
                                          Margin="0,16,0,0" />
                                <TextBlock Style="{StaticResource SubtleTextStyle}"
                                           TextWrapping="Wrap"
                                           Margin="0,4,0,0"
                                           Text="Only enable this if Graylog uses a self-signed or internally-issued certificate you trust." />

                                <TextBlock Text="Display time zone" Style="{StaticResource SectionHeaderStyle}" Margin="0,16,0,6" />
                                <TextBox Text="{Binding GraylogTimezone, UpdateSourceTrigger=PropertyChanged, Delay=300}"
                                         ToolTip="e.g. Europe/London" />
                                <TextBlock Text="{Binding GraylogTimezoneStatusText}"
                                           TextWrapping="Wrap"
                                           Margin="0,4,0,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource SubtleTextStyle}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsGraylogTimezoneInvalid}" Value="True">
                                                    <Setter Property="Foreground" Value="{StaticResource WarningBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Style="{StaticResource SubtleTextStyle}"
                                           TextWrapping="Wrap"
                                           Margin="0,2,0,0"
                                           Text="Graylog stores times in UTC. Enter a time zone (the same name LibreNMS uses, e.g. Europe/London) to show them in that zone instead." />

                                <TextBlock Text="Query field" Style="{StaticResource SectionHeaderStyle}" Margin="0,16,0,6" />
                                <TextBox Text="{Binding GraylogQueryField, UpdateSourceTrigger=LostFocus}"
                                         Width="220"
                                         HorizontalAlignment="Left" />
                                <TextBlock Style="{StaticResource SubtleTextStyle}"
                                           TextWrapping="Wrap"
                                           Margin="0,4,0,0"
                                           Text="The Graylog message field matched against a device's addresses. LibreNMS's default is source." />

                                <CheckBox Content="Match any address"
                                          IsChecked="{Binding GraylogMatchAnyAddress}"
                                          Margin="0,16,0,0" />
                                <TextBlock Style="{StaticResource SubtleTextStyle}"
                                           TextWrapping="Wrap"
                                           Margin="0,4,0,0"
                                           Text="Match every IP address on a device, not just its hostname and primary address, against the source of a message." />

                                <Grid Margin="0,16,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0"
                                            Content="Test connection"
                                            Command="{Binding TestGraylogConnectionCommand}"
                                            Padding="10,6" />
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding GraylogTestStatusText}"
                                               TextWrapping="Wrap"
                                               VerticalAlignment="Center"
                                               Margin="12,0,0,0"
                                               Visibility="{Binding HasGraylogTestStatus, Converter={StaticResource BoolToVisibility}}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                                <Setter Property="Foreground" Value="{StaticResource OkBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding GraylogTestSucceeded}" Value="False">
                                                        <Setter Property="Foreground" Value="{StaticResource CriticalBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Background="{StaticResource SurfaceAltBrush}" CornerRadius="6" Padding="14,12">
                            <StackPanel>
                                <TextBlock Text="Device Graylog tab" Style="{StaticResource SectionHeaderStyle}" Margin="0,0,0,10" />

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="24" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Log level" Style="{StaticResource SubtleTextStyle}" Margin="0,0,0,6" />
                                        <ComboBox ItemsSource="{Binding GraylogLogLevelOptions}"
                                                  SelectedItem="{Binding SelectedGraylogLogLevel}"
                                                  DisplayMemberPath="Label"
                                                  Width="200" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Row count" Style="{StaticResource SubtleTextStyle}" Margin="0,0,0,6" />
                                        <TextBox Text="{Binding GraylogRowCountText, UpdateSourceTrigger=LostFocus}"
                                                 Width="80"
                                                 HorizontalAlignment="Left" />
                                    </StackPanel>
                                </Grid>
                                <TextBlock Style="{StaticResource SubtleTextStyle}"
                                           TextWrapping="Wrap"
                                           Margin="0,6,0,0"
                                           Text="What a device's Graylog tab starts on: the least severe level shown (each level includes everything more severe) and how many messages per page. Both can be changed on the tab itself." />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ==================== About ==================== -->
                    <StackPanel Visibility="{Binding IsAboutSectionSelected, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="About" Style="{StaticResource HeadingTextStyle}" Margin="0,0,0,4" />
                        <TextBlock Text="{Binding CurrentVersionText}" Style="{StaticResource SubtleTextStyle}" Margin="0,0,0,14" />

                        <CheckBox Content="Include preview builds"
                                  IsChecked="{Binding IncludePreviewBuilds}"
                                  Margin="0,0,0,6" />
                        <TextBlock Style="{StaticResource SubtleTextStyle}"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,14"
                                   Text="Preview builds are rollups of in-progress features and fixes published between stable releases, so you can try them early. They get less testing than a stable release - off by default." />

                        <Border Background="{StaticResource SurfaceAltBrush}" CornerRadius="6" Padding="14,12">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               Text="{Binding UpdateStatusText}"
                                               VerticalAlignment="Center"
                                               TextWrapping="Wrap" />
                                    <Button Grid.Column="1"
                                            Content="Check now"
                                            Command="{Binding CheckForUpdatesCommand}"
                                            Padding="10,6"
                                            Margin="12,0,0,0" />
                                </Grid>
                                <StackPanel Orientation="Horizontal"
                                            Margin="0,10,0,0"
                                            Visibility="{Binding IsNewerVersionAvailable, Converter={StaticResource BoolToVisibility}}">
                                    <Button Content="Restart to update"
                                            Command="{Binding InstallUpdateCommand}"
                                            Style="{StaticResource PrimaryButtonStyle}"
                                            Padding="10,6"
                                            Margin="0,0,8,0"
                                            ToolTip="DashyNMS closes, installs the update and reopens on the new version. Unsaved changes here are discarded."
                                            Visibility="{Binding IsUpdateReady, Converter={StaticResource BoolToVisibility}}" />
                                    <Button Content="View on GitHub"
                                            Command="{Binding ViewLatestReleaseCommand}"
                                            Padding="10,6" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="What's new" Style="{StaticResource SectionHeaderStyle}" />
                        <Border Background="{StaticResource SurfaceAltBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="14,12"
                                Visibility="{Binding HasLatestRelease, Converter={StaticResource BoolToVisibility}}">
                            <FlowDocumentScrollViewer Document="{Binding LatestReleaseNotes, Converter={StaticResource MarkdownToFlowDocument}}"
                                                       MaxHeight="260"
                                                       VerticalScrollBarVisibility="Auto"
                                                       Background="Transparent"
                                                       IsToolBarVisible="False" />
                        </Border>

                        <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                            <Button Content="View all releases on GitHub"
                                    Command="{Binding ViewReleasesPageCommand}"
                                    Padding="10,6" />
                            <Button Content="Report a bug"
                                    Command="{Binding ReportBugCommand}"
                                    ToolTip="Opens a new GitHub issue with your DashyNMS, Windows and LibreNMS versions filled in - nothing is sent until you submit it there"
                                    Padding="10,6"
                                    Margin="8,0,0,0" />
                        </StackPanel>
                    </StackPanel>

                </Grid>
            </ScrollViewer>
        </Grid>

        <Border Grid.Row="1"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="24,14">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" IsCancel="True" Margin="0,0,8,0" />
                <Button Content="Save"
                        Command="{Binding SaveCommand}"
                        Style="{StaticResource PrimaryButtonStyle}"
                        IsDefault="True" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
