<UserControl x:Class="DesktopNMS.Views.NetworkMapView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:DesktopNMS.ViewModels"
             xmlns:views="clr-namespace:DesktopNMS.Views"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:NetworkMapViewModel}"
             d:DesignHeight="600" d:DesignWidth="1100">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ======================== Scope + find ======================== -->
        <!-- Refresh isn't duplicated here - the main tab bar's Refresh (F5)
             covers whichever tab is showing, and re-fetches the links. -->
        <Border Grid.Row="0"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="18,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <WrapPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="Show"
                               Style="{StaticResource SubtleTextStyle}"
                               VerticalAlignment="Center"
                               Margin="0,0,10,0" />
                    <ComboBox ItemsSource="{Binding Scopes}"
                              SelectedItem="{Binding SelectedScope}"
                              DisplayMemberPath="DisplayName"
                              Width="240"
                              ToolTip="The whole network, or one device group"
                              VerticalAlignment="Center" />

                    <CheckBox Content="Devices without links"
                              IsChecked="{Binding ShowUnlinkedDevices}"
                              ToolTip="Also show devices with no discovered links to anything else shown - laid out in a grid below the map"
                              VerticalAlignment="Center"
                              Margin="16,0,0,0" />

                    <TextBlock Text="{Binding SummaryText}"
                               Style="{StaticResource SubtleTextStyle}"
                               VerticalAlignment="Center"
                               Margin="16,0,0,0" />
                </WrapPanel>

                <TextBox Grid.Column="1"
                         x:Name="SearchBox"
                         Width="220"
                         Style="{StaticResource SearchTextBoxStyle}"
                         Tag="Find device"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=300}"
                         ToolTip="Find a device on the map by name"
                         VerticalAlignment="Center" />

                <Rectangle Grid.Column="2" Style="{StaticResource ToolBarSeparatorStyle}" Margin="14,4" />

                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Command="{Binding FitToViewCommand}"
                            Style="{StaticResource IconButtonStyle}"
                            ToolTip="Fit the whole map in view"
                            Margin="0,0,4,0">
                        <TextBlock Text="&#xE9A6;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="15" />
                    </Button>
                    <Button Command="{Binding ResetLayoutCommand}"
                            Style="{StaticResource IconButtonStyle}"
                            ToolTip="Reset layout - forget moved positions and lay the map out again">
                        <TextBlock Text="&#xE7A7;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="15" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ======================== Error banner ======================== -->
        <Border Grid.Row="1"
                Background="#33DA3633"
                BorderBrush="{StaticResource CriticalBrush}"
                BorderThickness="0,0,0,1"
                Padding="18,10"
                Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap" />
        </Border>

        <!-- ======================== Map + details ======================== -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{StaticResource BackgroundBrush}">
                <Grid>
                    <views:NetworkMapCanvas x:Name="MapCanvas"
                                            Nodes="{Binding Nodes}"
                                            Edges="{Binding Edges}"
                                            SelectedNode="{Binding SelectedNode}"
                                            RenderVersion="{Binding RenderVersion}" />

                    <TextBlock Text="Loading the network map..."
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               IsHitTestVisible="False"
                               Style="{StaticResource SubtleTextStyle}"
                               Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}" />

                    <TextBlock Text="No links between these devices. LibreNMS hasn't discovered any LLDP/CDP neighbours between them - tick 'Devices without links' to show them anyway."
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               TextWrapping="Wrap"
                               MaxWidth="380"
                               TextAlignment="Center"
                               IsHitTestVisible="False"
                               Style="{StaticResource SubtleTextStyle}"
                               Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}" />

                    <TextBlock Text="Scroll to zoom · drag to pan · drag a device to move it · double-click to open"
                               HorizontalAlignment="Left"
                               VerticalAlignment="Bottom"
                               Margin="14,0,0,10"
                               FontSize="11"
                               IsHitTestVisible="False"
                               Style="{StaticResource SubtleTextStyle}" />
                </Grid>
            </Border>

            <!-- ======================== Selected device ======================== -->
            <Border Grid.Column="1"
                    Width="320"
                    Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1,0,0,0"
                    Visibility="{Binding HasSelectedNode, Converter={StaticResource BoolToVisibility}}">
                <Grid Margin="18">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0">
                        <TextBlock Text="{Binding SelectedNode.Name}"
                                   Style="{StaticResource HeadingTextStyle}"
                                   TextWrapping="Wrap" />
                        <TextBlock Text="{Binding SelectedNodeStateText}"
                                   Style="{StaticResource SubtleTextStyle}"
                                   Margin="0,4,0,0" />
                        <TextBlock Text="{Binding SelectedNodeDetail}"
                                   Style="{StaticResource SubtleTextStyle}"
                                   TextWrapping="Wrap"
                                   Margin="0,2,0,0" />
                        <Button Content="Open device"
                                Command="{Binding OpenSelectedDeviceCommand}"
                                HorizontalAlignment="Left"
                                Padding="12,6"
                                Margin="0,12,0,0" />
                    </StackPanel>

                    <TextBlock Grid.Row="1"
                               Text="Connections"
                               Style="{StaticResource SectionHeaderStyle}"
                               Margin="0,18,0,6" />

                    <!-- One row per cable: this device's port, then the
                         neighbour and its port. Click a row to jump to the
                         neighbour. -->
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding SelectedConnections}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:MapConnectionItem}">
                                    <Button Command="{Binding DataContext.SelectNeighbourCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}"
                                            Cursor="Hand"
                                            HorizontalContentAlignment="Stretch"
                                            ToolTip="Show this neighbour on the map">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="Row" Background="Transparent" CornerRadius="4" Padding="6,5">
                                                    <ContentPresenter />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Row" Property="Background" Value="{StaticResource SurfaceAltBrush}" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                        <StackPanel>
                                            <TextBlock Text="{Binding NeighbourName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Style="{StaticResource SubtleTextStyle}" FontSize="11" TextTrimming="CharacterEllipsis">
                                                <Run Text="{Binding LocalPort, Mode=OneWay}" />
                                                <Run Text=" ↔ " />
                                                <Run Text="{Binding RemotePort, Mode=OneWay}" />
                                            </TextBlock>
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
