<UserControl x:Class="DesktopNMS.Views.DevicesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:DesktopNMS.ViewModels"
             xmlns:models="clr-namespace:DesktopNMS.Core.Models;assembly=DesktopNMS.Core"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:DeviceListViewModel}"
             d:DesignHeight="600" d:DesignWidth="1100">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ======================== Counts + search + filter ======================== -->
        <Border Grid.Row="0"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="18,12">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <ToggleButton IsChecked="{Binding ShowUp}" Tag="{x:Static models:DeviceState.Up}" PreviewMouseLeftButtonDown="StatusBadge_PreviewMouseLeftButtonDown" Style="{StaticResource CountBadgeToggleStyle}" ToolTip="Show/hide up (shift-click to show only up)" Margin="0,0,10,0">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="9" Height="9" Fill="{StaticResource OkBrush}" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding UpCount}" FontWeight="SemiBold" Margin="8,0,5,0" />
                                <TextBlock Text="up" Style="{StaticResource SubtleTextStyle}" VerticalAlignment="Center" />
                            </StackPanel>
                        </ToggleButton>
                        <ToggleButton IsChecked="{Binding ShowDown}" Tag="{x:Static models:DeviceState.Down}" PreviewMouseLeftButtonDown="StatusBadge_PreviewMouseLeftButtonDown" Style="{StaticResource CountBadgeToggleStyle}" ToolTip="Show/hide down (shift-click to show only down)" Margin="0,0,10,0">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="9" Height="9" Fill="{StaticResource CriticalBrush}" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding DownCount}" FontWeight="SemiBold" Margin="8,0,5,0" />
                                <TextBlock Text="down" Style="{StaticResource SubtleTextStyle}" VerticalAlignment="Center" />
                            </StackPanel>
                        </ToggleButton>
                        <ToggleButton IsChecked="{Binding ShowMaintenance}" Tag="{x:Static models:DeviceState.Maintenance}" PreviewMouseLeftButtonDown="StatusBadge_PreviewMouseLeftButtonDown" Style="{StaticResource CountBadgeToggleStyle}" ToolTip="Show/hide maintenance (shift-click to show only maintenance)" Margin="0,0,10,0">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="9" Height="9" Fill="{StaticResource MaintenanceBrush}" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding MaintenanceCount}" FontWeight="SemiBold" Margin="8,0,5,0" />
                                <TextBlock Text="in maintenance" Style="{StaticResource SubtleTextStyle}" VerticalAlignment="Center" />
                            </StackPanel>
                        </ToggleButton>
                        <ToggleButton IsChecked="{Binding ShowDisabled}" Tag="{x:Static models:DeviceState.Disabled}" PreviewMouseLeftButtonDown="StatusBadge_PreviewMouseLeftButtonDown" Style="{StaticResource CountBadgeToggleStyle}" ToolTip="Show/hide disabled / ignored (shift-click to show only disabled / ignored)">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="9" Height="9" Fill="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding DisabledCount}" FontWeight="SemiBold" Margin="8,0,5,0" />
                                <TextBlock Text="disabled / ignored" Style="{StaticResource SubtleTextStyle}" VerticalAlignment="Center" />
                            </StackPanel>
                        </ToggleButton>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Search first, then the Filters trigger beside it -
                             the conventional left-to-right order for a table
                             toolbar (search narrows by free text, filters narrow
                             by a fixed facet), with the destructive-ish Clear
                             action set apart on the far right. -->
                        <TextBox x:Name="SearchBox"
                                 Width="240"
                                 Style="{StaticResource SearchTextBoxStyle}"
                                 Tag="Search devices"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=200}"
                                 ToolTip="Filter by name, IP, OS, hardware, location or device id"
                                 Margin="0,0,8,0" />

                        <!-- One compact trigger opening a centered dialog (see
                             DeviceFiltersWindow) with a tab for each facet
                             (DeviceListViewModel's TypeFilter/LocationFilter/
                             GroupFilter - each an open-ended, growing list)
                             rather than a button per facet or a badge per value:
                             this costs the same one button's width regardless of
                             how many types, locations or groups exist. The dot
                             is the only always-visible sign that a facet is
                             actively hiding something, since the dialog's own
                             checkboxes are not visible until it's opened. -->
                        <Grid Margin="0,0,14,0">
                            <Button Content="Filters"
                                    Command="{Binding ShowFiltersCommand}"
                                    Style="{StaticResource ChipButtonStyle}"
                                    Margin="0"
                                    ToolTip="Filter by type, location or device group" />
                            <Ellipse Width="7"
                                     Height="7"
                                     Fill="{DynamicResource AccentBrush}"
                                     HorizontalAlignment="Right"
                                     VerticalAlignment="Top"
                                     Margin="0,-2,-2,0"
                                     IsHitTestVisible="False"
                                     Visibility="{Binding IsFiltersActive, Converter={StaticResource BoolToVisibility}}" />
                        </Grid>

                        <Button Content="Clear"
                                Command="{Binding ClearFiltersCommand}"
                                IsEnabled="{Binding HasAnyFilterApplied}"
                                Padding="10,7"
                                Margin="0,0,14,0" />

                        <Button Content="Add device"
                                Command="{Binding AddDeviceCommand}"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Padding="12,7" />
                    </StackPanel>
                </Grid>

                <!-- A quick way back into something you were just looking at -
                     collapsed entirely when empty, so a fresh install or a
                     just-cleared history costs no space here at all. -->
                <StackPanel Orientation="Horizontal"
                            Margin="0,12,0,0"
                            Visibility="{Binding HasRecentlyViewedDevices, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="Recently viewed:"
                               Style="{StaticResource SubtleTextStyle}"
                               VerticalAlignment="Center"
                               Margin="0,0,10,0" />
                    <ItemsControl ItemsSource="{Binding RecentlyViewedDevices}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Content="{Binding DisplayName}"
                                        Command="{Binding OpenCommand}"
                                        Style="{StaticResource ChipButtonStyle}"
                                        Margin="0,0,8,0" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- ======================== Error banner ======================== -->
        <Border Grid.Row="1"
                Background="#33DA3633"
                BorderBrush="{StaticResource CriticalBrush}"
                BorderThickness="0,0,0,1"
                Padding="18,10"
                Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap" />
        </Border>

        <!-- ======================== Content ======================== -->
        <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="420" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="320" MinWidth="260" />
                </Grid.ColumnDefinitions>

                <DataGrid Grid.Column="0"
                          x:Name="DeviceGrid"
                          ItemsSource="{Binding DevicesView}"
                          SelectedItem="{Binding SelectedDevice}"
                          MouseDoubleClick="OnGridDoubleClick"
                          Sorting="DeviceGrid_Sorting">
                    <DataGrid.Columns>

                        <!-- Pinned devices always sort to the top - see
                             DeviceListViewModel's IsPinned SortDescription and
                             DevicesView.xaml.cs's Sorting handler, which keeps
                             it ahead of whichever column the user clicks. -->
                        <DataGridTemplateColumn Header="" Width="40" CanUserSort="False">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Command="{Binding TogglePinCommand}"
                                            Style="{StaticResource IconButtonStyle}"
                                            Width="28"
                                            Height="28"
                                            FontSize="13"
                                            ToolTip="Pin this device to the top of the list">
                                        <Grid>
                                            <TextBlock Text="&#xE735;"
                                                       FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                       FontSize="13"
                                                       Foreground="{DynamicResource AccentBrush}"
                                                       Visibility="{Binding IsPinned, Converter={StaticResource BoolToVisibility}}" />
                                            <TextBlock Text="&#xE734;"
                                                       FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                       FontSize="13"
                                                       Visibility="{Binding IsPinned, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}" />
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="State" Width="90" SortMemberPath="State">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="10,0">
                                        <Ellipse Width="9"
                                                 Height="9"
                                                 Margin="0,0,8,0"
                                                 VerticalAlignment="Center"
                                                 Fill="{Binding State, Converter={StaticResource DeviceStateToBrush}}" />
                                        <TextBlock Text="{Binding StateText}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="Device" Width="220" SortMemberPath="Name">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="10,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding AlternateName}"
                                                   Style="{StaticResource SubtleTextStyle}"
                                                   FontSize="11"
                                                   TextTrimming="CharacterEllipsis"
                                                   Visibility="{Binding HasAlternateName, Converter={StaticResource BoolToVisibility}}" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="IP" Width="130" Binding="{Binding Ip}" />
                        <DataGridTextColumn Header="OS" Width="110" Binding="{Binding Os}" />
                        <DataGridTextColumn Header="Hardware" Width="*" Binding="{Binding Hardware}" />
                        <DataGridTextColumn Header="Location" Width="140" Binding="{Binding Location}" />
                        <DataGridTextColumn Header="Uptime" Width="100" Binding="{Binding UptimeText}" />

                    </DataGrid.Columns>

                    <DataGrid.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Open device" Command="{Binding ShowDeviceDetailCommand}" />
                            <MenuItem Header="Show alerts for this device" Command="{Binding ShowAlertsCommand}" />
                        </ContextMenu>
                    </DataGrid.ContextMenu>
                </DataGrid>

                <TextBlock Grid.Column="0"
                           Text="Nothing matches the current filters."
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           IsHitTestVisible="False">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource SubtleTextStyle}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding VisibleCount}" Value="0">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch" Background="{StaticResource BorderBrush}" />

                <!-- ==================== Detail pane ==================== -->
                <Border Grid.Column="2"
                        Background="{StaticResource SurfaceBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1,0,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0"
                                   Grid.RowSpan="2"
                                   Text="Select a device to see its detail."
                                   Style="{StaticResource SubtleTextStyle}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   TextWrapping="Wrap"
                                   Margin="24"
                                   Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}" />

                        <ScrollViewer Grid.Row="0"
                                      VerticalScrollBarVisibility="Auto"
                                      Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel Margin="18" DataContext="{Binding SelectedDevice}">

                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <Ellipse Width="9"
                                             Height="9"
                                             Margin="0,0,8,0"
                                             VerticalAlignment="Center"
                                             Fill="{Binding State, Converter={StaticResource DeviceStateToBrush}}" />
                                    <TextBlock Text="{Binding StateText}" Style="{StaticResource SubtleTextStyle}" VerticalAlignment="Center" />
                                </StackPanel>

                                <TextBlock Text="{Binding Name}" Style="{StaticResource HeadingTextStyle}" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding AlternateName}"
                                           Style="{StaticResource SubtleTextStyle}"
                                           TextWrapping="Wrap"
                                           Visibility="{Binding HasAlternateName, Converter={StaticResource BoolToVisibility}}" />

                                <TextBlock Text="IP address" Style="{StaticResource SectionHeaderStyle}" />
                                <TextBlock Text="{Binding Ip}" />

                                <TextBlock Text="Operating system" Style="{StaticResource SectionHeaderStyle}" />
                                <TextBlock Text="{Binding Os}" TextWrapping="Wrap" />

                                <TextBlock Text="Hardware" Style="{StaticResource SectionHeaderStyle}" />
                                <TextBlock Text="{Binding Hardware}" TextWrapping="Wrap" />

                                <TextBlock Text="Type" Style="{StaticResource SectionHeaderStyle}" />
                                <TextBlock Text="{Binding Type}" TextWrapping="Wrap" />

                                <TextBlock Text="Location" Style="{StaticResource SectionHeaderStyle}" />
                                <TextBlock Text="{Binding Location}" TextWrapping="Wrap" />

                                <TextBlock Text="Uptime" Style="{StaticResource SectionHeaderStyle}" />
                                <TextBlock Text="{Binding UptimeText}" />

                                <TextBlock Text="Device id" Style="{StaticResource SectionHeaderStyle}" />
                                <TextBlock Text="{Binding DeviceId}" Style="{StaticResource SubtleTextStyle}" />
                            </StackPanel>
                        </ScrollViewer>

                        <Border Grid.Row="1"
                                Background="{StaticResource SurfaceBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="0,1,0,0"
                                Padding="18,14"
                                Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel>
                                <Button Content="Open device"
                                        Command="{Binding ShowDeviceDetailCommand}"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Margin="0,0,0,8" />
                                <Button Content="Show alerts for this device"
                                        Command="{Binding ShowAlertsCommand}" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>
        </Grid>

        <!-- ======================== Status bar ======================== -->
        <Border Grid.Row="3"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="18,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <TextBlock Text="Refreshing..."
                               Style="{StaticResource SubtleTextStyle}"
                               Margin="0,0,10,0"
                               Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
                    <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource SubtleTextStyle}" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <TextBlock Text="{Binding VisibleCount, StringFormat={}{0} shown}"
                               Style="{StaticResource SubtleTextStyle}"
                               Margin="0,0,14,0" />
                    <TextBlock Text="{Binding LastUpdatedText, StringFormat=updated {0}}"
                               Style="{StaticResource SubtleTextStyle}"
                               Margin="0,0,14,0" />
                    <TextBlock Text="{Binding NextRefreshText, StringFormat=next in {0}}" Style="{StaticResource SubtleTextStyle}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
