<Window x:Class="DesktopNMS.Views.AddDevicesToGroupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:DesktopNMS.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:AddDevicesToGroupViewModel}"
        Title="Add to group"
        Width="400"
        Height="480"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Icon="pack://application:,,,/Assets/app.ico"
        Background="{StaticResource BackgroundBrush}"
        WindowStartupLocation="CenterOwner">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="Add to group" Style="{StaticResource HeadingTextStyle}" />
            <TextBlock Style="{StaticResource SubtleTextStyle}"
                       TextWrapping="Wrap"
                       Margin="0,6,0,14"
                       Text="{Binding IntroText}" />
        </StackPanel>

        <Border Grid.Row="1"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="5">
            <Grid>
                <ListBox ItemsSource="{Binding StaticGroups}"
                         SelectedItem="{Binding SelectedGroup}"
                         BorderThickness="0"
                         Background="Transparent">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="4,6">
                                <TextBlock Text="{Binding Name}" />
                                <TextBlock Text="{Binding Description}"
                                           Style="{StaticResource SubtleTextStyle}"
                                           FontSize="11"
                                           TextWrapping="Wrap"
                                           Visibility="{Binding Description, Converter={StaticResource StringToVisibility}}" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <TextBlock Text="Loading groups..."
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           IsHitTestVisible="False"
                           Style="{StaticResource SubtleTextStyle}"
                           Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}" />

                <TextBlock Text="No static device groups yet - create one from the Groups tab first."
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           Margin="18"
                           IsHitTestVisible="False"
                           Style="{StaticResource SubtleTextStyle}"
                           Visibility="{Binding ShowNoStaticGroupsMessage, Converter={StaticResource BoolToVisibility}}" />
            </Grid>
        </Border>

        <StackPanel Grid.Row="2">
            <Border Background="#33DA3633"
                    BorderBrush="{StaticResource CriticalBrush}"
                    BorderThickness="1"
                    CornerRadius="5"
                    Padding="12,10"
                    Margin="0,14,0,0"
                    Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" />
            </Border>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <TextBlock Text="Adding..."
                           Style="{StaticResource SubtleTextStyle}"
                           VerticalAlignment="Center"
                           Margin="0,0,12,0"
                           Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
                <Button Content="Cancel" IsCancel="True" Margin="0,0,8,0" />
                <Button Content="Add"
                        Command="{Binding SaveCommand}"
                        Style="{StaticResource PrimaryButtonStyle}"
                        IsDefault="True" />
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
