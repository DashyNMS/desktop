<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
      The colour values every style in Dark.xaml is built from. Merged into
      Application.Resources programmatically (see App.xaml.cs, ApplyTheme)
      before Dark.xaml's own styles are parsed, so their StaticResource
      references into these keys resolve correctly on first load - swapping
      this file for Palette.Light.xaml is how the whole app repaints for a
      different theme. Requires a restart: unlike AccentBrush (see
      AccentTheme.cs), nothing here is re-resolved live.
    -->

    <Color x:Key="BackgroundColor">#FF11141A</Color>
    <Color x:Key="SurfaceColor">#FF171B23</Color>
    <Color x:Key="SurfaceAltColor">#FF1E2430</Color>
    <Color x:Key="SurfaceHoverColor">#FF262E3C</Color>
    <Color x:Key="BorderColor">#FF2C3442</Color>
    <Color x:Key="TextPrimaryColor">#FFE6EAF0</Color>
    <Color x:Key="TextSecondaryColor">#FF98A2B3</Color>
    <Color x:Key="AccentColor">#FF3B82F6</Color>

    <!-- Fixed across every theme (see AppSettings.AccentColor remarks) - duplicated
         identically in Palette.Light.xaml rather than shared, since XAML resource
         dictionaries have no import/include mechanism for a handful of keys. -->
    <Color x:Key="CriticalColor">#FFDA3633</Color>
    <Color x:Key="WarningColor">#FFDB9A04</Color>
    <Color x:Key="OkColor">#FF2EA043</Color>
    <Color x:Key="MaintenanceColor">#FF4C9AFF</Color>

    <!-- Deliberately low-contrast: a scroll bar should be findable without
         competing with the content beside it. -->
    <Color x:Key="ScrollBarThumbColor">#FF333C4C</Color>
    <Color x:Key="ScrollBarThumbHoverColor">#FF4A5568</Color>

    <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource BackgroundColor}" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
    <SolidColorBrush x:Key="SurfaceAltBrush" Color="{StaticResource SurfaceAltColor}" />
    <SolidColorBrush x:Key="SurfaceHoverBrush" Color="{StaticResource SurfaceHoverColor}" />
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <!-- The accent at low strength, behind the selected sidebar section - replaced along with AccentBrush by AccentTheme. -->
    <SolidColorBrush x:Key="AccentSubtleBrush" Color="{StaticResource AccentColor}" Opacity="0.16" />

    <!-- Overwritten alongside AccentBrush by AccentTheme.Apply, computed to
         contrast with whatever accent colour is actually chosen - white
         reads fine against this file's own default blue, so that is what
         is declared here as the fallback before Apply first runs. -->
    <SolidColorBrush x:Key="AccentForegroundBrush" Color="White" />

    <!-- The connected server's own logo (see MainWindow.xaml) sits on this
         backdrop. In Dark mode it just matches the page background, so the
         logo appears to float on the shell header with no visible box. -->
    <SolidColorBrush x:Key="LogoBackdropBrush" Color="{StaticResource BackgroundColor}" />

    <SolidColorBrush x:Key="CriticalBrush" Color="{StaticResource CriticalColor}" />
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}" />
    <SolidColorBrush x:Key="OkBrush" Color="{StaticResource OkColor}" />
    <SolidColorBrush x:Key="MaintenanceBrush" Color="{StaticResource MaintenanceColor}" />
    <SolidColorBrush x:Key="ScrollBarThumbBrush" Color="{StaticResource ScrollBarThumbColor}" />
    <SolidColorBrush x:Key="ScrollBarThumbHoverBrush" Color="{StaticResource ScrollBarThumbHoverColor}" />

</ResourceDictionary>
