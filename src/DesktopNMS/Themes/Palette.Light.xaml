<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Light counterpart to Palette.Dark.xaml - see its remarks for how this
         gets chosen and merged. Same keys throughout, so every style in
         Dark.xaml works unmodified regardless of which palette is active. -->

    <Color x:Key="BackgroundColor">#FFF5F6F8</Color>
    <Color x:Key="SurfaceColor">#FFFFFFFF</Color>
    <Color x:Key="SurfaceAltColor">#FFEEF1F5</Color>
    <Color x:Key="SurfaceHoverColor">#FFE3E7ED</Color>
    <Color x:Key="BorderColor">#FFD8DDE5</Color>
    <Color x:Key="TextPrimaryColor">#FF1A1F29</Color>
    <Color x:Key="TextSecondaryColor">#FF6B7280</Color>
    <Color x:Key="AccentColor">#FF3B82F6</Color>

    <!-- Fixed across every theme - identical to Palette.Dark.xaml, see its remarks. -->
    <Color x:Key="CriticalColor">#FFDA3633</Color>
    <Color x:Key="WarningColor">#FFDB9A04</Color>
    <Color x:Key="OkColor">#FF2EA043</Color>
    <Color x:Key="MaintenanceColor">#FF4C9AFF</Color>

    <!-- Deliberately low-contrast, the same as the dark palette's own reasoning -
         findable without competing with the content beside it. -->
    <Color x:Key="ScrollBarThumbColor">#FFC7CCD4</Color>
    <Color x:Key="ScrollBarThumbHoverColor">#FFAAB1BC</Color>

    <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource BackgroundColor}" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
    <SolidColorBrush x:Key="SurfaceAltBrush" Color="{StaticResource SurfaceAltColor}" />
    <SolidColorBrush x:Key="SurfaceHoverBrush" Color="{StaticResource SurfaceHoverColor}" />
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />

    <!-- See Palette.Dark.xaml's remarks - overwritten alongside AccentBrush by AccentTheme.Apply. -->
    <SolidColorBrush x:Key="AccentForegroundBrush" Color="White" />

    <!-- Most server logos are light-on-transparent artwork that vanishes
         against a light page background, so unlike the dark palette this
         can't just match BackgroundColor - it uses the same grey as the tab
         bar's own backdrop (SurfaceAltColor, see NavTabTrackStyle) instead. -->
    <SolidColorBrush x:Key="LogoBackdropBrush" Color="{StaticResource SurfaceAltColor}" />

    <SolidColorBrush x:Key="CriticalBrush" Color="{StaticResource CriticalColor}" />
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}" />
    <SolidColorBrush x:Key="OkBrush" Color="{StaticResource OkColor}" />
    <SolidColorBrush x:Key="MaintenanceBrush" Color="{StaticResource MaintenanceColor}" />
    <SolidColorBrush x:Key="ScrollBarThumbBrush" Color="{StaticResource ScrollBarThumbColor}" />
    <SolidColorBrush x:Key="ScrollBarThumbHoverBrush" Color="{StaticResource ScrollBarThumbHoverColor}" />

</ResourceDictionary>
