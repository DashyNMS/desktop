<Project Sdk="Microsoft.NET.Sdk">

  <!--
    A developer diagnostic (#301), not part of the app or the solution: walks a
    sample of devices on the LibreNMS you're signed in to and runs each graph
    through the same Core code the app uses, reporting what fails. Read-only.
    See Program.cs for what it records and where.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\DesktopNMS.Core\DesktopNMS.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="9.0.0" />
  </ItemGroup>

</Project>
